#: include/global_settings.php
msgid "When an admin creates a new account and an email address is entered, send an informational email to it."
msgstr "Kada administrator kreira novi račun i unese adresu e-pošte, pošalji informativnu poruku e-pošte na nju."

#: include/global_settings.php
msgid "Subject of new account message"
msgstr "Naslov poruke za novi račun"

#: include/global_settings.php
msgid "This is the Email subject that will be used for a new account message."
msgstr "Ovo je naslov e-pošte koji će se koristiti za poruku o novom računu."

#: include/global_settings.php
msgid "Email body for new account message"
msgstr "Sadržaj e-pošte za poruku o novom računu"

