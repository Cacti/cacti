#: include/global_form.php
msgid "Title (--title)"
msgstr "Naslov (--title)"

#: include/global_form.php
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Cacti documentation."
msgstr "Naziv koji se ispisuje na grafikonu. Može sadržavati zamjenske varijable kao što su |host_description| ili |query_fieldName|. Za potpunu listu podržanih zamjenskih oznaka, pogledajte Cacti dokumentaciju."

#: include/global_form.php
msgid "Vertical Label (--vertical-label)"
msgstr "Vertikalna oznaka (--vertical-label)"

#: include/global_form.php
msgid "The label vertically printed to the left of the graph."
msgstr "Oznaka ispisana vertikalno lijevo od grafikona."

#: include/global_form.php
msgid "Image Format (--imgformat)"
msgstr "Format slike (--imgformat)"

#: include/global_form.php
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "Tip grafikona koji se generiše; PNG, GIF ili SVG. Odabir tipa slike grafikona uveliko zavisi od alata RRDtool."

#: include/global_form.php
msgid "Height (--height)"
msgstr "Visina (--height)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Visina (u pikselima) područja grafikona unutar samog grafikona. Ovo područje ne uključuje legendu, oznake osa ili naslov."

#: include/global_form.php
msgid "Width (--width)"
msgstr "Širina (--width)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Širina (u pikselima) područja grafikona unutar samog grafikona. Ovo područje ne uključuje legendu, oznake osa ili naslov."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "Osnovna vrijednost (--base)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Treba biti postavljeno na 1024 za memoriju i 1000 za mjerenja saobraćaja."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "Režim nagiba (--slope-mode)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Korištenje režima nagiba zaglađuje oblik grafikona nauštrb rezolucije na ekranu."

#: include/global_form.php
msgid "Scaling Options"
msgstr "Opcije skaliranja"

#: include/global_form.php
msgid "Auto Scale"
msgstr "Automatsko skaliranje"

#: include/global_form.php
msgid "Auto scale the y-axis instead of defining an upper and lower limit. Note: if this is check both the Upper and Lower limit will be ignored."
msgstr "Automatski skalirajte y-osu umjesto definisanja gornje i donje granice. Napomena: ako je ovo označeno, i gornja i donja granica bit će zanemarene."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "Opcije automatskog skaliranja"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Koristite <br> --alt-autoscale za skaliranje na apsolutni minimum i maksimum <br> --alt-autoscale-max za skaliranje na maksimalnu vrijednost, koristeći zadatu donju granicu <br> --alt-autoscale-min za skaliranje na minimalnu vrijednost, koristeći zadatu gornju granicu <br> --alt-autoscale (sa granicama) za skaliranje koristeći i donju i gornju granicu (RRDtool podrazumijevano) <br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Koristite --alt-autoscale (zanemarujući zadate granice)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Koristite --alt-autoscale-max (prihvatajući donju granicu)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Koristite --alt-autoscale-min (prihvatajući gornju granicu)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Koristite --alt-autoscale (prihvatajući obje granice, RRDtool podrazumijevano)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Logaritamsko skaliranje (--logarithmic)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "Koristite logaritamsko skaliranje y-ose"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "SI jedinice za logaritamsko skaliranje (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Koristite SI jedinice za logaritamsko skaliranje umjesto eksponencijalne notacije.<br> Napomena: Linearni grafikoni podrazumijevano koriste SI notaciju."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Režim krutih granica (--rigid)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Nemojte proširivati donju i gornju granicu ako grafikon sadrži vrijednost izvan važećeg opsega."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "Gornja granica (--upper-limit)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "Maksimalna vertikalna vrijednost za grafikon."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "Donja granica (--lower-limit)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "Minimalna vertikalna vrijednost za grafikon."

#: include/global_form.php
msgid "Grid Options"
msgstr "Opcije mreže"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Vrijednost jedinice mreže (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Postavlja vrijednost eksponenta za brojeve na Y-osi. Napomena: Ova opcija je zastarjela i zamijenjena opcijom --y-grid. U ovoj opciji, linije mreže Y-ose pojavljuju se na svakom intervalu koraka mreže. Oznake se postavljaju na svakom broju linija određenom faktorom oznake."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Vrijednost eksponenta jedinice (--units-exponent)"

#: include/global_form.php
msgid "What unit Cacti should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Koju jedinicu Cacti treba koristiti na Y-osi. Koristite 3 za prikaz svega u \"k\" ili -6 za prikaz svega u \"u\" (mikro)."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Dužina jedinice (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Koliko cifara RRDtool treba pretpostaviti da imaju oznake y-ose? Možda ćete morati koristiti ovu opciju da napravite dovoljno prostora kada počnete podešavati označavanje y-ose."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "Bez prilagođavanja mreži (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "Kako bi izbjegao efekte zamućenja usljed zaglađivanja ivica, RRDtool poravnava tačke sa pikselima rezolucije uređaja, što daje oštriji izgled. Ako vam to ne odgovara, možete koristiti ovu opciju da isključite takvo ponašanje.<br><strong>Napomena: </strong>Prilagođavanje mreži je podrazumijevano isključeno za PDF, EPS i SVG izlaz."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Alternativna Y mreža (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Algoritam osigurava da uvijek imate mrežu, da ima dovoljno, ali ne previše linija mreže, i da je mreža metrička. Ovaj parametar će također osigurati da se prikaže dovoljno decimala čak i ako vaš grafikon ide od 69.998 do 70.001.<br><strong>Napomena: </strong>Ovaj parametar može ometati opcije --alt-autoscale."

#: include/global_form.php
msgid "Axis Options"
msgstr "Opcije osa"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Desna osa (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "Druga osa će biti nacrtana na desnoj strani grafikona. Povezana je sa lijevom osom putem parametara skale i pomaka."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Oznaka desne ose (--right-axis-label &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "Oznaka za desnu osu."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Format desne ose (--right-axis-format &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Podrazumijevano se format oznaka osa određuje automatski. Ako to želite uraditi sami, koristite ovu opciju s istim %lf argumentima koje poznajete iz PRINT i GPRINT komandi."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Formater desne ose (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Kada podešavate označavanje desne ose, primijenite pravilo na format podataka. Podržani formati uključuju \"numeric\" gdje se podaci tretiraju kao numerički, \"timestamp\" gdje se vrijednosti tumače kao UNIX vremenske oznake (broj sekundi od januara 1970. godine) i izražavaju pomoću strftime formata (podrazumijevano je \"%Y-%m-%d %H:%M:%S\"). Pogledajte također --units-length i --right-axis-format. Konačno, \"duration\" gdje se vrijednosti tumače kao trajanje u milisekundama. Formatiranje prati pravila za PRINT/GPRINT kvalifikovan sa valstrfduration."

#: include/global_form.php
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Formater lijeve ose (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Kada postavljate označavanje lijeve ose, primijenite pravilo na format podataka. Podržani formati uključuju \"numeric\" gdje se podaci tretiraju kao numerički, \"timestamp\" gdje se vrijednosti tumače kao UNIX vremenske oznake (broj sekundi od januara 1970.) i izražavaju pomoću strftime formata (podrazumijevano je \"%Y-%m-%d %H:%M:%S\"). Pogledajte također --units-length. Konačno, \"duration\" gdje se vrijednosti tumače kao trajanje u milisekundama. Formatiranje prati pravila za PRINT/GPRINT s kvalifikatorom valstrfduration."

#: include/global_form.php
msgid "Legend Options"
msgstr "Opcije legende"

#: include/global_form.php
msgid "Auto Padding"
msgstr "Automatsko popunjavanje"

#: include/global_form.php
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Popunite tekst tako da se podaci legende i grafikona uvijek poravnaju. Napomena: ovo može uzrokovati duže iscrtavanje grafikona zbog većeg opterećenja. Također, automatsko popunjavanje možda neće biti tačno na svim vrstama grafikona; dosljedno označavanje obično pomaže."

#: include/global_form.php
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Dinamičke oznake (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "Iscrtaj markere linije kao liniju."

#: include/global_form.php
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Forsiraj legendu pravila (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Forsiraj generisanje HRULE i VRULE legendi."

#: include/global_form.php
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Širina tabulatora (--tabwidth &lt;pikseli&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Podrazumijevana širina tabulatora je 40 piksela, koristite ovu opciju da je promijenite."

#: include/global_form.php
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Pozicija legende (--legend-position=&lt;pozicija&gt;)"

#: include/global_form.php
msgid "Place the legend at the given side of the graph."
msgstr "Postavite legendu na zadatu stranu grafikona."

#: include/global_form.php
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Smjer legende (--legend-direction=&lt;smjer&gt;)"

#: include/global_form.php
msgid "Place the legend items in the given vertical order."
msgstr "Postavite stavke legende u zadatom vertikalnom redoslijedu."

#: include/global_form.php lib/api_aggregate.php lib/html.php
msgid "Graph Item Type"
msgstr "Vrsta stavke grafikona"

#: include/global_form.php
msgid "How data for this item is represented visually on the graph."
msgstr "Kako se podaci za ovu stavku vizuelno prikazuju na grafikonu."

#: include/global_form.php
msgid "The data source to use for this graph item."
msgstr "Izvor podataka koji se koristi za ovu stavku grafikona."

#: include/global_form.php
msgid "The color to use for the legend."
msgstr "Boja koja će se koristiti za legendu."

#: include/global_form.php
msgid "Opacity/Alpha Channel"
msgstr "Neprozirnost/alfa kanal"

#: include/global_form.php
msgid "The opacity/alpha channel of the color."
msgstr "Neprozirnost/alfa kanal boje."

#: include/global_form.php lib/rrd.php
msgid "Consolidation Function"
msgstr "Funkcija konsolidacije"

#: include/global_form.php
msgid "How data for this item is represented statistically on the graph."
msgstr "Kako se podaci za ovu stavku statistički prikazuju na grafikonu."

#: include/global_form.php
msgid "CDEF Function"
msgstr "CDEF funkcija"

#: include/global_form.php
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "CDEF (matematička) funkcija koja se primjenjuje na ovu stavku na grafikonu ili legendi."

#: include/global_form.php
msgid "VDEF Function"
msgstr "VDEF funkcija"

#: include/global_form.php
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "VDEF (matematička) funkcija koja se primjenjuje na ovu stavku na legendi grafikona."

#: include/global_form.php
msgid "Shift Data"
msgstr "Pomjeri podatke"

#: include/global_form.php
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "Pomjerite svoje podatke na vremenskoj osi (x-osi) za iznos naveden u polju 'value'."

#: include/global_form.php
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
msgstr "[HRULE|VRULE]: Vrijednost stavke grafikona.<br/> [TICK]: Udio za liniju oznake.<br/> [SHIFT]: Vremenski pomak u sekundama."

#: include/global_form.php
msgid "GPRINT Type"
msgstr "Vrsta GPRINT-a"

#: include/global_form.php
msgid "If this graph item is a GPRINT, you can optionally choose another format here. You can define additional types under \"GPRINT Presets\"."
msgstr "Ako je ova stavka grafikona GPRINT, ovdje možete opcionalno odabrati drugi format. Dodatne vrste možete definisati pod \"GPRINT predefinisane postavke\"."

#: include/global_form.php
msgid "Text Alignment (TEXTALIGN)"
msgstr "Poravnanje teksta (TEXTALIGN)"

#: include/global_form.php
msgid "All subsequent legend line(s) will be aligned as given here.  You may use this command multiple times in a single graph.  This command does not produce tabular layout.<br/><strong>Note: </strong>You may want to insert a &lt;HR&gt; on the preceding graph item.<br/> <strong>Note: </strong>A &lt;HR&gt; on this legend line will obsolete this setting!"
msgstr "Svi naredni redovi legende bit će poravnati kako je ovdje zadato. Ovu naredbu možete koristiti više puta u jednom grafikonu. Ova naredba ne proizvodi tabelarni raspored.<br/><strong>Napomena: </strong>Možda ćete željeti umetnuti &lt;HR&gt; na prethodnu stavku grafikona.<br/> <strong>Napomena: </strong>&lt;HR&gt; na ovom redu legende učinit će ovu postavku zastarjelom!"

#: include/global_form.php
msgid "Text Format"
msgstr "Format teksta"

#: include/global_form.php
msgid "Text that will be displayed on the legend for this graph item."
msgstr "Tekst koji će biti prikazan u legendi za ovu stavku grafikona."

#: include/global_form.php
msgid "Insert Hard Return"
msgstr "Umetni tvrdi prijelom reda"

#: include/global_form.php
msgid "Forces the legend to the next line after this item."
msgstr "Prisiljava prelazak legende u sljedeći red nakon ove stavke."

#: include/global_form.php
msgid "Line Width (decimal)"
msgstr "Širina linije (decimalno)"

#: include/global_form.php
msgid "In case LINE was chosen, specify width of line here.  You must include a decimal precision, for example 2.00"
msgstr "U slučaju da je odabrano LINE, ovdje navedite širinu linije. Morate uključiti decimalnu preciznost, na primjer 2.00"

#: include/global_form.php
msgid "Dashes (dashes[=on_s[,off_s[,on_s,off_s]...]])"
msgstr "Crtice (dashes[=on_s[,off_s[,on_s,off_s]...]])"

#: include/global_form.php
msgid "The dashes modifier enables dashed line style."
msgstr "Modifikator dashes omogućava isprekidani stil linije."

#: include/global_form.php
msgid "Dash Offset (dash-offset=offset)"
msgstr "Pomak crtica (dash-offset=offset)"

#: include/global_form.php
msgid "The dash-offset parameter specifies an offset into the pattern at which the stroke begins."
msgstr "Parametar dash-offset određuje pomak unutar uzorka na kojem potez počinje."

#: include/global_form.php
msgid "The name given to this graph template."
msgstr "Naziv dodijeljen ovom šablonu grafikona."

#: include/global_form.php
msgid "Multiple Instances"
msgstr "Višestruke instance"

#: include/global_form.php
msgid "Check this checkbox if there can be more than one Graph of this type per Device."
msgstr "Označite ovo polje za potvrdu ako može postojati više od jednog grafikona ove vrste po uređaju."

#: include/global_form.php
msgid "Test Data Sources"
msgstr "Testiraj izvore podataka"

#: include/global_form.php
msgid "Check this checkbox if you wish to test the Data Sources prior to their creation.  With Test Data Sources enabled, if the Data Source does not return valid data, the Graph will not be created.  This setting is important if you wish to have a more generic Device Template that can include more Graph Templates that can be selectively applied depending on the characteristics of the Device itself.  Note: If you have a long running script as a Data Source, the time to create Graphs will be increased."
msgstr "Označite ovo polje za potvrdu ako želite testirati izvore podataka prije njihovog kreiranja. Kada je opcija Testiraj izvore podataka omogućena, ako izvor podataka ne vrati važeće podatke, grafikon neće biti kreiran. Ova postavka je važna ako želite imati generičkiji šablon uređaja koji može uključivati više šablona grafikona koji se mogu selektivno primjenjivati u zavisnosti od karakteristika samog uređaja. Napomena: Ako imate skriptu koja se dugo izvršava kao izvor podataka, vrijeme za kreiranje grafikona bit će povećano."

#: include/global_form.php
msgid "Enter a name for this graph item input, make sure it is something you recognize."
msgstr "Unesite naziv za ovaj ulaz stavke grafikona, pobrinite se da to bude nešto što prepoznajete."

#: include/global_form.php
msgid "Enter a description for this graph item input to describe what this input is used for."
msgstr "Unesite opis za ovaj unos stavke grafikona kako biste opisali za šta se ovaj unos koristi."

#: include/global_form.php
msgid "Field Type"
msgstr "Tip polja"

#: include/global_form.php
msgid "How data is to be represented on the graph."
msgstr "Kako će podaci biti predstavljeni na grafikonu."

#: include/global_form.php
msgid "General Device Options"
msgstr "Opšte opcije uređaja"

#: include/global_form.php
msgid "Give this host a meaningful description."
msgstr "Dajte ovom hostu smislen opis."

#: include/global_form.php
msgid "Fully qualified hostname or IP address for this device."
msgstr "Potpuno kvalificirani naziv hosta ili IP adresa za ovaj uređaj."

#: include/global_form.php
msgid "The physical location of the Device.  This free form text can be a room, rack location, etc."
msgstr "Fizička lokacija uređaja. Ovaj tekst slobodnog formata može biti prostorija, lokacija u reku itd."

#: include/global_form.php
msgid "Poller Association"
msgstr "Pridruživanje polera"

#: include/global_form.php
msgid "Device Site Association"
msgstr "Pridruživanje lokacije uređaja"

#: include/global_form.php
msgid "What Site is this Device associated with."
msgstr "Sa kojom lokacijom je ovaj uređaj povezan."

#: include/global_form.php
msgid "Choose the Device Template to use to define the default Graph Templates and Data Queries associated with this Device."
msgstr "Odaberite šablon uređaja koji će se koristiti za definisanje podrazumijevanih šablona grafikona i upita podataka povezanih s ovim uređajem."

#: include/global_form.php
msgid "Number of Collection Threads"
msgstr "Broj niti za prikupljanje"

