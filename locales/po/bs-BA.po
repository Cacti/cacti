msgstr "Lozinka vašeg računa je resetovana. <br>Server: <a href=\"<CACTIURL>\"><CACTIURL></a><br>Korisničko ime: <USERNAME><br>Za postavljanje nove lozinke kliknite na <a href=\"<PWDRESETLINK>\">link za resetovanje lozinke</a><br><br>"

#: include/global_settings.php
