msgstr "Putanja za sendmail"

#: include/global_settings.php
msgid "This is the path to sendmail on your server. (Only used if Sendmail is selected as the Mail Service)"
msgstr "Ovo je putanja do sendmail-a na vašem serveru. (Koristi se samo ako je Sendmail odabran kao servis e-pošte)"

