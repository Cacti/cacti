#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "Podrazumijevana kolacija koju server koristi prilikom kreiranja baza podataka i tabela."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "npr. utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Podrazumijevani skup znakova koji server koristi."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "npr. utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Skup znakova koji klijent koristi prilikom slanja naredbi serveru."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Maksimalan dozvoljeni broj istovremenih klijentskih konekcija."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Cijeli broj; podrazumijevano 151. Omogućite dovoljno za polere i prijave korisnika."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Zastarjeli naziv za keš otvorenih tabela; preimenovano u table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Cijeli broj. Koristite table_open_cache na modernim serverima."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Maksimalna veličina jednog paketa ili bilo kojeg generisanog/međuniza znakova."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Bajtovi; držite na 16M ili više za udaljene polere."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Maksimalna veličina do koje mogu rasti MEMORY tabele koje kreira korisnik."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Bajtovi; veličina u odnosu na ukupnu memoriju sistema."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Maksimalna veličina internih privremenih tabela u memoriji prije nego što se preliju na disk."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Bajtovi; veća vrijednost zadržava privremene tabele u memoriji."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Minimalna veličina bafera po spajanju za spajanja koja ne koriste indekse."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Bajtovi; dodjela po konekciji, podrazumijevano 262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "Bafer po sesiji dodijeljen za sortiranja (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Bajtovi; dodjela po konekciji, podrazumijevano 2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Pohranite svaku InnoDB tabelu i njene indekse u njenu vlastitu .ibd datoteku prostora tabela."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON ili OFF; preporučuje se ON."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "InnoDB format datoteke na disku (Antelope ili Barracuda); Barracuda je sada jedini format."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Dozvoli prefikse ključa indeksa duže od 767 bajtova (zahtijeva format Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 ili OFF/0; ovo ponašanje je sada uvijek omogućeno."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Ukupna memorija koju InnoDB koristi za keširanje podataka tabela i indeksa."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Bajtovi; uobičajeno 25%-80% ukupne memorije sistema."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Zapisuj stranice dvaput (doublewrite bafer) radi zaštite od djelimičnog zapisivanja stranica."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON ili OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "Zastarjeli skup memorije za interni rječnik podataka i strukture u InnoDB."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Bajtovi; zastarjelo na modernim serverima."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Sekunde koliko InnoDB transakcija čeka na zaključavanje reda prije odustajanja."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Sekunde; podrazumijevano 50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Metod koji se koristi za pražnjenje datoteka podataka i zapisnika na disk."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC i slično."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Kontroliše kako se redo zapisnik zapisuje i prazni prilikom potvrde transakcije."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1 ili 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Zastarjela jedinstvena postavka za InnoDB I/O niti datoteka, zamijenjena postavkama I/O niti za čitanje i pisanje."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Cijeli broj; zamijenjeno sa innodb_read_io_threads i innodb_write_io_threads."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Zapisuj i prazni InnoDB redo zapisnik svakih N sekundi."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Sekunde (1-2700); podrazumijevano 1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Broj I/O niti koje se koriste za operacije čitanja u InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; podrazumijevano 4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Broj I/O niti koje se koriste za operacije pisanja u InnoDB-u."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Broj regija na koje je podijeljen InnoDB bafer bazen."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; MariaDB je ovo uklonio u 10.6."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Procijenjeni broj I/O operacija u sekundi dostupan pozadinskim zadacima InnoDB-a."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Cijeli broj; koristite veće vrijednosti za SSD/NVMe pohranu."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "Maksimalan broj IOPS-a koji InnoDB može koristiti kada pražnjenje na disk zaostaje."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Ispraznite susjedne prljave stranice u istom ekstentu prilikom pražnjenja stranice."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1 ili 2; koristite 0 na SSD pohrani."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Koristite hardversko atomsko pisanje (MariaDB) kako bi se doublewrite bafer mogao sigurno onemogućiti."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON ili OFF; samo za MariaDB."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "Nametnite strogu izolaciju snimka stanja za InnoDB transakcije."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON ili OFF; preneseno unazad (backport) u MariaDB 10.6.18+, 10.11.8+ i 11.4.2+. Postavite na OFF za Cacti poller."

#: lib/utility.php
msgid "Removed"
msgstr "Uklonjeno"

#: lib/utility.php
msgid "Deprecated"
msgstr "Zastarjelo"

#: lib/utility.php
msgid "Not applicable to this engine"
msgstr "Nije primjenjivo na ovaj mehanizam"

#: lib/utility.php
msgid "Supported"
msgstr "Podržano"

#: lib/utility.php
#, php-format
msgid "%s Variable Capability Matrix"
msgstr "Matrica mogućnosti varijabli za %s"

#: lib/utility.php
msgid "Support by engine and version for each Cacti-recommended variable"
msgstr "Podrška po mehanizmu i verziji za svaku varijablu koju preporučuje Cacti"

#: lib/utility.php
msgid "Variable"
msgstr "Varijabla"

#: lib/utility.php
msgid "Available settings:"
msgstr "Dostupne postavke:"

#: lib/utility.php
msgid "N/A - Not applicable to this engine"
msgstr "N/A - Nije primjenjivo na ovaj mehanizam"

#: lib/utility.php
msgid "MariaDB 10.11+ and MySQL 8.4+ are the recommended, supported releases for Cacti 1.3.x (available on Rocky Linux 9 through the vendor module streams). Make sure you run the very latest release though which fixes a long standing low level networking issue that was causing spine many issues with reliability."
msgstr "MariaDB 10.11+ i MySQL 8.4+ su preporučena, podržana izdanja za Cacti 1.3.x (dostupna na sistemu Rocky Linux 9 putem tokova modula dobavljača). Ipak, obavezno koristite najnovije izdanje jer ono ispravlja dugotrajni mrežni problem niskog nivoa koji je uzrokovao mnoge probleme s pouzdanošću za Spine."

#: lib/utility.php
#, php-format
msgid "It is STRONGLY recommended that you enable InnoDB in any %s version greater than 5.5.3."
msgstr "STROGO se preporučuje da omogućite InnoDB u svakoj %s verziji većoj od 5.5.3."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4_unicode_ci collation type as some characters take more than a single byte."
msgstr "Kada koristite Cacti s jezicima koji nisu engleski, važno je koristiti tip kolacije utf8mb4_unicode_ci jer neki znakovi zauzimaju više od jednog bajta."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4 character set as some characters take more than a single byte."
msgstr "Kada koristite Cacti s jezicima koji nisu engleski, važno je koristiti skup znakova utf8mb4 jer neki znakovi zauzimaju više od jednog bajta."

#: lib/utility.php
#, php-format
msgid "It is recommended that you enable InnoDB in any %s version greater than 5.1."
msgstr "Preporučuje se da omogućite InnoDB u svakoj %s verziji većoj od 5.1."

#: lib/utility.php
#, php-format
msgid "Depending on the number of logins and use of spine data collector, %s will need many connections.  The calculation for spine is: total_connections = total_processes * (total_threads + script_servers + 1), then you must leave headroom for user connections, which will change depending on the number of concurrent login accounts."
msgstr "U zavisnosti od broja prijava i korištenja Spine sakupljača podataka, %s će trebati mnogo konekcija. Formula za Spine je: total_connections = total_processes * (total_threads + script_servers + 1), a zatim morate ostaviti dovoljno rezerve za korisničke konekcije, što će se mijenjati u zavisnosti od broja istovremeno prijavljenih naloga."

#: lib/utility.php
msgid "Keeping the table cache larger means less file open/close operations when using innodb_file_per_table."
msgstr "Održavanje većeg keša tabela znači manje operacija otvaranja/zatvaranja datoteka prilikom korištenja innodb_file_per_table."

#: lib/utility.php
msgid "With Remote polling capabilities, large amounts of data will be synced from the main server to the remote pollers.  Therefore, keep this value at or above 16M."
msgstr "Uz mogućnosti udaljenog anketiranja, velike količine podataka će se sinhronizovati s glavnog servera na udaljene anketare. Stoga držite ovu vrijednost na 16M ili više."

#: lib/utility.php
#, php-format
msgid "If using the Cacti Performance Booster and choosing a memory storage engine, you have to be careful to flush your Performance Booster buffer before the system runs out of memory table space.  This is done two ways, first reducing the size of your output column to just the right size.  This column is in the tables poller_output, and poller_output_boost.  The second thing you can do is allocate more memory to memory tables.  We have arbitrarily chosen a recommended value of 10%% of system memory, but if you are using SSD disk drives, or have a smaller system, you may ignore this recommendation or choose a different storage engine.  You may see the expected consumption of the Performance Booster tables under Console -> System Utilities -> View Boost Status."
msgstr "Ako koristite Cacti Performance Booster i odaberete memorijski mehanizam za pohranu, morate paziti da ispraznite bafer alata Performance Booster prije nego što sistemu ponestane memorijskog prostora za tabele. To se radi na dva načina: prvi je smanjenje veličine izlazne kolone na tačno odgovarajuću veličinu. Ova kolona se nalazi u tabelama poller_output i poller_output_boost. Druga stvar koju možete učiniti jeste da dodijelite više memorije memorijskim tabelama. Proizvoljno smo odabrali preporučenu vrijednost od 10%% sistemske memorije, ali ako koristite SSD diskove ili imate manji sistem, možete zanemariti ovu preporuku ili odabrati drugi mehanizam za pohranu. Očekivanu potrošnju Performance Booster tabela možete vidjeti pod Konzola -> Sistemski alati -> Prikaži Boost status."

#: lib/utility.php
msgid "When executing subqueries, having a larger temporary table size, keep those temporary tables in memory."
msgstr "Prilikom izvršavanja podupita, veća veličina privremenih tabela omogućava da te privremene tabele ostanu u memoriji."

#: lib/utility.php
msgid "If this number is negative, reduce the innodb_buffer_pool_size until the join_buffer_size turns positive, but allocate approximately from between 25%-50% of memory to the innodb_buffer_pool_size if the database is hosted on the Cacti server, or upto 80% of the systems memory if the database is separate from the Cacti web server.  However, try to not go below the default of 262,144.  When performing joins, if they are below this size, they will be kept in memory and never written to a temporary file.  As this is a per connection memory allocation, care must be taken not to increase it too high.  The sum of the join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + Core MySQL/MariaDB memory should be below 80% if the database is hosted on the Cacti web server and less if you intend to have very large RRDfiles or hundreds of thousands to millions long term."
msgstr "Ako je ovaj broj negativan, smanjite innodb_buffer_pool_size dok join_buffer_size ne postane pozitivan, ali dodijelite otprilike između 25%-50% memorije za innodb_buffer_pool_size ako se baza podataka nalazi na Cacti serveru, ili do 80% sistemske memorije ako je baza podataka odvojena od Cacti web servera. Međutim, pokušajte da ne idete ispod podrazumijevane vrijednosti od 262.144. Prilikom izvođenja spajanja, ako su ispod ove veličine, ona će se čuvati u memoriji i nikada se neće zapisivati u privremenu datoteku. Budući da je ovo dodjela memorije po konekciji, mora se paziti da se ne poveća previše. Zbir join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + osnovne MySQL/MariaDB memorije treba biti ispod 80% ako se baza podataka nalazi na Cacti web serveru, a i manji ako dugoročno planirate imati veoma velike RRD datoteke ili stotine hiljada do miliona datoteka."

#: lib/utility.php
msgid "If this number is negative, reduce the innodb_buffer_pool_size until the sort_buffer_size turns positive, but allocate approximately from between 25%-50% of memory to the innodb_buffer_pool_size if the database is hosted on the Cacti server, or upto 80% of the system memory if the database is separate from the Cacti web server.  However, try to not go below the default setting of 2,097,152.  A sort buffer performs sorts for some queries using ORDER BY or GROUP BY. Configuring sort_buffer_size decides how much memory will be allocated for sort queries.  The sort_buffer_size may need to be adjusted from the default if the workload requires a significant number of sort queries. The sort_buffer_size is defined on a per-session variable.  Use the same equation as that of the join_buffer_size to determine the per connection possible memory."
msgstr "Ako je ovaj broj negativan, smanjite innodb_buffer_pool_size dok sort_buffer_size ne postane pozitivan, ali dodijelite otprilike između 25%-50% memorije za innodb_buffer_pool_size ako se baza podataka nalazi na Cacti serveru, ili do 80% sistemske memorije ako je baza podataka odvojena od Cacti web servera. Ipak, pokušajte da ne idete ispod podrazumijevane postavke od 2,097,152. Bafer za sortiranje (sort buffer) izvršava sortiranja za neke upite koji koriste ORDER BY ili GROUP BY. Konfigurisanje sort_buffer_size određuje koliko će memorije biti dodijeljeno za upite sortiranja. Možda će biti potrebno prilagoditi sort_buffer_size u odnosu na podrazumijevanu vrijednost ako radno opterećenje zahtijeva značajan broj upita sortiranja. Vrijednost sort_buffer_size je definisana kao varijabla po sesiji. Koristite istu jednačinu kao za join_buffer_size da odredite moguću memoriju po konekciji."

#: lib/utility.php
#, php-format
msgid "When using InnoDB storage it is important to keep your table spaces separate.  This makes managing the tables simpler for long time users of %s.  If you are running with this currently off, you can migrate to the per file storage by enabling the feature, and then running an alter statement on all InnoDB tables."
msgstr "Kada koristite InnoDB pohranu, važno je držati vaše prostore tabela odvojenim. Ovo čini upravljanje tabelama jednostavnijim za dugogodišnje korisnike sistema %s. Ako vam je ova opcija trenutno isključena, možete migrirati na pohranu po datoteci tako što ćete omogućiti ovu funkciju, a zatim pokrenuti alter naredbu na svim InnoDB tabelama."

#: lib/utility.php
msgid "When using innodb_file_per_table, it is important to set the innodb_file_format to Barracuda.  This setting will allow longer indexes important for certain Cacti tables."
msgstr "Kada koristite innodb_file_per_table, važno je postaviti innodb_file_format na Barracuda. Ova postavka će omogućiti duže indekse važne za određene Cacti tabele."

#: lib/utility.php
msgid "If your tables have very large indexes, you must operate with the Barracuda innodb_file_format and the innodb_large_prefix equal to 1.  Failure to do this may result in plugins that can not properly create tables."
msgstr "Ako vaše tabele imaju veoma velike indekse, morate raditi sa Barracuda innodb_file_format i innodb_large_prefix jednakim 1. Ako to ne uradite, može doći do toga da dodaci ne mogu pravilno kreirati tabele."

#: lib/utility.php
#, no-php-format
msgid "InnoDB will hold as much tables and indexes in system memory as is possible.  Therefore, you should make the innodb_buffer_pool large enough to hold as much of the tables and index in memory.  Checking the size of the /var/lib/mysql/cacti directory will help in determining this value.  We are recommending 25%% of your systems total memory, but your requirements will vary depending on your systems size.  If you database is very large or remote, you can consider increasing this size.  If remote, it can by as high as 80% of the systems memory.  However, cautions must be taken to reduce the swappiness of the system, or to remove swap to keep the system from swapping."
msgstr "InnoDB će držati što je više moguće tabela i indeksa u sistemskoj memoriji. Stoga biste trebali podesiti innodb_buffer_pool dovoljno velikim da drži što više tabela i indeksa u memoriji. Provjera veličine direktorija /var/lib/mysql/cacti pomoći će u određivanju ove vrijednosti. Preporučujemo 25%% ukupne memorije vašeg sistema, ali vaši zahtjevi će varirati u zavisnosti od veličine vašeg sistema. Ako je vaša baza podataka veoma velika ili udaljena, možete razmotriti povećanje ove veličine. Ako je udaljena, može biti i do 80% memorije sistema. Međutim, mora se paziti da se smanji swappiness sistema ili da se ukloni swap kako bi se spriječilo da sistem koristi swap."

#: lib/utility.php
msgid "This setting should remain ON unless your Cacti instances are running on either ZFS or FusionI/O which both have internal journaling to accommodate abrupt system crashes.  However, if you have very good power, and your systems rarely go down and you have backups, turning this setting to OFF can net you almost a 50% increase in database performance."
msgstr "Ova postavka treba ostati na ON osim ako vaše Cacti instance ne rade na ZFS-u ili FusionI/O koji oba imaju interno žurnalisanje za prilagođavanje naglim padovima sistema. Međutim, ako imate veoma dobro napajanje, vaši sistemi rijetko padaju i imate sigurnosne kopije, prebacivanje ove postavke na OFF može vam donijeti skoro 50% povećanja performansi baze podataka."

#: lib/utility.php
msgid "This is where metadata is stored. If you had a lot of tables, it would be useful to increase this."
msgstr "Ovdje se pohranjuju metapodaci. Ako imate mnogo tabela, bilo bi korisno povećati ovu vrijednost."

#: lib/utility.php
msgid "Rogue queries should not for the database to go offline to others.  Kill these queries before they kill your system."
msgstr "Odmetnuti upiti ne bi trebali prisiliti bazu podataka da postane nedostupna drugima. Prekinite ove upite prije nego što obore vaš sistem."

#: lib/utility.php
msgid "Maximum I/O performance happens when you use the O_DIRECT method to flush pages."
msgstr "Maksimalne I/O performanse se postižu kada koristite metodu O_DIRECT za pražnjenje stranica."

#: lib/utility.php
#, php-format
msgid "Setting this value to 2 means that you will flush all transactions every second rather than at commit.  This allows %s to perform writing less often."
msgstr "Postavljanje ove vrijednosti na 2 znači da ćete prazniti sve transakcije svake sekunde umjesto prilikom potvrđivanja (commit). Ovo omogućava da %s rjeđe vrši pisanje."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple io threads is advantageous for applications with high io characteristics."
msgstr "Sa modernom pohranom tipa SSD, posjedovanje više io niti je prednost za aplikacije sa visokim io karakteristikama."

#: lib/utility.php
#, php-format
msgid "As of %s %s, the you can control how often %s flushes transactions to disk.  The default is 1 second, but in high I/O systems setting to a value greater than 1 can allow disk I/O to be more sequential"
msgstr "Počevši od %s %s, možete kontrolisati koliko često %s prazni transakcije na disk. Podrazumijevano je 1 sekunda, ali na sistemima sa visokim I/O opterećenjem postavljanje vrijednosti veće od 1 može omogućiti da disk I/O bude sekvencijalniji"

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Sa modernom pohranom tipa SSD, posjedovanje više io niti za čitanje je prednost za aplikacije sa visokim io karakteristikama. U zavisnosti od vaših verzija MariaDB/MySQL-a, ova vrijednost može ići i do 64. Ipak, pokušajte zadržati ovaj broj manjim od ukupnog broja SMT niti na serveru baze podataka."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Sa modernom pohranom tipa SSD, posjedovanje više io niti za pisanje je prednost za aplikacije sa visokim io karakteristikama. U zavisnosti od vaših verzija MariaDB/MySQL-a, ova vrijednost može ići i do 64. Ipak, pokušajte zadržati ovaj broj manjim od ukupnog broja SMT niti na serveru baze podataka."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MariaDB less than 10.5.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max the number of CPU cores or 64."
msgstr "%s će podijeliti innodb_buffer_pool na memorijske regije kako bi se poboljšale performanse za verzije MariaDB-a starije od 10.5. Maksimalna vrijednost je 64, ali ne smije premašiti broj CPU jezgri/niti. Kada je vaš innodb_buffer_pool manji od 1GB, trebate koristiti veličinu skupa (pool) podijeljenu sa 128MB. Nastavite koristiti ovu jednačinu do maksimalnog broja CPU jezgri ili 64."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MySQL upto and including MySQL 8.0.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max of the number of CPU cores or 64."
msgstr "%s će podijeliti innodb_buffer_pool u memorijske regije kako bi se poboljšale performanse za verzije MySQL-a do i uključujući MySQL 8.0. Maksimalna vrijednost je 64, ali ne smije premašiti broj CPU jezgri/niti. Kada je vaš innodb_buffer_pool manji od 1GB, trebate koristiti veličinu poola podijeljenu sa 128MB. Nastavite koristiti ovu jednačinu sve do maksimuma broja CPU jezgri ili 64."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 200 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 100000 can be used."
msgstr "Ako imate SSD diskove, koristite ovaj prijedlog. Ako imate fizičke tvrde diskove, koristite 200 * broj aktivnih diskova u nizu. Ako koristite NVMe ili PCIe Flash, mogu se koristiti mnogo veći brojevi, čak do 100000."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 2000 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 200000 can be used."
msgstr "Ako imate SSD diskove, koristite ovaj prijedlog. Ako imate fizičke tvrde diskove, koristite 2000 * broj aktivnih diskova u nizu. Ako koristite NVMe ili PCIe Flash, mogu se koristiti mnogo veći brojevi, čak do 200000."

#: lib/utility.php
msgid "If you have SSD disks, set this to 0. Otherwise, do not set this setting."
msgstr "Ako imate SSD diskove, postavite ovo na 0. U suprotnom, nemojte postavljati ovu postavku."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics."
msgstr "Kod modernih SSD uređaja za pohranu, više IO niti za čitanje predstavlja prednost za aplikacije sa visokim IO karakteristikama."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics."
msgstr "Kod modernih SSD uređaja za pohranu, više IO niti za pisanje predstavlja prednost za aplikacije sa visokim IO karakteristikama."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, this setting should be off if atomic writes are enabled.  Therefore, please enable atomic writes instead of the double write buffer as it will increase performance."
msgstr "Kada koristite MariaDB 10.2.4 i noviji, ova postavka treba biti isključena ako su omogućeni atomski zapisi. Stoga omogućite atomske zapise umjesto dvostrukog bafera za pisanje jer će to povećati performanse."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, you can use atomic writes over the doublewrite buffer to increase performance."
msgstr "Kada koristite MariaDB 10.2.4 i noviji, možete koristiti atomske zapise umjesto doublewrite bafera kako biste povećali performanse."

#: lib/utility.php
msgid "MariaDB 11.8 enabled innodb_snapshot_isolation=ON by default. This causes severe lock contention: UPDATE statements can block for tens of thousands of seconds on small tables under concurrent load, which stalls the Cacti poller. Set innodb_snapshot_isolation=OFF in your [mysqld] configuration. See MDEV-39628."
msgstr "MariaDB 11.8 je podrazumijevano omogućio innodb_snapshot_isolation=ON. Ovo uzrokuje ozbiljno nadmetanje za zaključavanja: UPDATE naredbe mogu blokirati na desetine hiljada sekundi na malim tabelama pod istovremenim opterećenjem, što zaustavlja Cacti poller. Postavite innodb_snapshot_isolation=OFF u vašoj [mysqld] konfiguraciji. Pogledajte MDEV-39628."

