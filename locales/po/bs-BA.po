msgstr "Ovo je ime hosta/IP adresa SMTP servera na koji ćete slati e-poštu. Za prebacivanje u slučaju otkaza (failover), odvojite hostove tačka-zarezom."

#: include/global_settings.php
msgid "SMTP Port"
msgstr "SMTP port"

#: include/global_settings.php
