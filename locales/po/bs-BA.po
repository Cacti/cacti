#: include/global_settings.php
msgid "SMTP Username"
msgstr "SMTP korisničko ime"

#: include/global_settings.php
msgid "The username to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Korisničko ime za autentifikaciju prilikom slanja putem SMTP-a. (Ostavite prazno ako ne zahtijevate autentifikaciju.)"

#: include/global_settings.php
msgid "SMTP Password"
msgstr "SMTP lozinka"

#: include/global_settings.php
msgid "The password to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Lozinka za autentifikaciju prilikom slanja putem SMTP-a. (Ostavite prazno ako ne zahtijevate autentifikaciju.)"

#: include/global_settings.php
msgid "SMTP Security"
msgstr "SMTP sigurnost"

#: include/global_settings.php
