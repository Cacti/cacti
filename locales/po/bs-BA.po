msgstr "Adresa e-pošte povezana s vašim oauth računom."

#: include/global_settings.php
msgid "OAuth2 Client ID"
msgstr "OAuth2 ID klijenta"

#: include/global_settings.php
msgid "Please enter OAuth Client"
msgstr "Molimo unesite OAuth klijenta"

#: include/global_settings.php
msgid "OAuth2 Client Secret"
msgstr "OAuth2 tajni ključ klijenta"

#: include/global_settings.php
msgid "Please enter OAuth secret"
msgstr "Molimo unesite OAuth tajni ključ"

#: include/global_settings.php
msgid "Azure Tenant ID"
msgstr "Azure Tenant ID"

#: include/global_settings.php
msgid "Only relevant for Azure"
msgstr "Relevantno samo za Azure"

#: include/global_settings.php
msgid "OAuth2 Redirect URI"
msgstr "OAuth2 URI za preusmjeravanje"

#: include/global_settings.php
msgid "Please check this URI. It could be accessible from internet."
msgstr "Molimo provjerite ovaj URI. Mogao bi biti dostupan s interneta."

#: include/global_settings.php
msgid "OAuth2 refresh token"
msgstr "OAuth2 token za osvježavanje"

#: include/global_settings.php
msgid "You can insert here OAuth2 refresh token directly, if you know it. Second option is retrieved from oauth2 provider. In this case set correct OAuth2 setting, save setting and open new browser tab or window and go to OAuth2 Redirect URI"
msgstr "Ovdje možete direktno unijeti OAuth2 token za osvježavanje, ako ga znate. Druga opcija je preuzimanje od oauth2 provajdera. U tom slučaju podesite ispravnu OAuth2 postavku, sačuvajte postavku, otvorite novu karticu ili prozor preglednika i idite na OAuth2 URI za preusmjeravanje"

#: include/global_settings.php
msgid "Reporting Presets"
msgstr "Unaprijed podešene postavke izvještavanja"

#: include/global_settings.php
msgid "Default Graph Image Format"
msgstr "Podrazumijevani format slike grafikona"

#: include/global_settings.php
msgid "When creating a new report, what image type should be used for the inline graphs."
msgstr "Prilikom kreiranja novog izvještaja, koji tip slike treba koristiti za ugrađene grafikone."

#: include/global_settings.php
msgid "Maximum E-Mail Size"
msgstr "Maksimalna veličina e-pošte"

#: include/global_settings.php
msgid "The maximum size of the E-Mail message including all attachments."
msgstr "Maksimalna veličina poruke e-pošte uključujući sve priloge."

#: include/global_settings.php
msgid "Poller Logging Level for Cacti Reporting"
msgstr "Nivo zapisivanja polera za Cacti izvještavanje"

#: include/global_settings.php
msgid "What level of detail do you want sent to the log file. WARNING: Leaving in any other status than NONE or LOW can exhaust your disk space rapidly."
msgstr "Koji nivo detalja želite slati u datoteku zapisnika. UPOZORENJE: Ostavljanje u bilo kojem drugom statusu osim NONE ili LOW može brzo iscrpiti prostor na disku."

#: include/global_settings.php
msgid "DNS Options"
msgstr "DNS opcije"

#: include/global_settings.php
msgid "Primary DNS IP Address"
msgstr "Primarna DNS IP adresa"

#: include/global_settings.php
msgid "Enter the primary DNS IP Address to utilize for reverse lookups."
msgstr "Unesite primarnu DNS IP adresu koja će se koristiti za obrnuto pretraživanje."

#: include/global_settings.php
msgid "Secondary DNS IP Address"
msgstr "Sekundarna DNS IP adresa"

#: include/global_settings.php
msgid "Enter the secondary DNS IP Address to utilize for reverse lookups."
msgstr "Unesite sekundarnu DNS IP adresu koja će se koristiti za obrnuto pretraživanje."

#: include/global_settings.php
msgid "DNS Timeout"
msgstr "Vremensko ograničenje za DNS"

#: include/global_settings.php
msgid "Please enter the DNS timeout in milliseconds.  Cacti uses a PHP based DNS resolver."
msgstr "Molimo unesite vremensko ograničenje za DNS u milisekundama. Cacti koristi DNS razrješavač zasnovan na PHP-u."

#: include/global_settings.php
msgid "Internet Proxy Settings"
msgstr "Postavke internet proksija"

#: include/global_settings.php
msgid "Internet Proxy Address"
msgstr "Adresa internet proksija"

#: include/global_settings.php
msgid "For either core Cacti Services or Plugins that require internet access, enter the proxy server and port here in the following format IP:PORT.  For example 192.168.1.1:8080."
msgstr "Za osnovne Cacti servise ili dodatke koji zahtijevaju pristup internetu, ovdje unesite proksi server i port u sljedećem formatu IP:PORT. Na primjer 192.168.1.1:8080."

#: include/global_settings.php
msgid "Internet Proxy User"
msgstr "Korisnik internet proksija"

#: include/global_settings.php
msgid "If your Internet Proxy requires a username, enter it here."
msgstr "Ako vaš internet proksi zahtijeva korisničko ime, unesite ga ovdje."

#: include/global_settings.php
msgid "Internet Proxy Password"
msgstr "Lozinka internet proksija"

#: include/global_settings.php
msgid "If your Internet Proxy requires a password, enter it here."
msgstr "Ako vaš internet proksi zahtijeva lozinku, unesite je ovdje."

#: include/global_settings.php
msgid "On-demand RRD Update Settings"
msgstr "Postavke RRD ažuriranja na zahtjev"

#: include/global_settings.php
msgid "Enable On-demand RRD Updating"
msgstr "Omogući RRD ažuriranje na zahtjev"

#: include/global_settings.php
msgid "Should Boost enable on demand RRD updating in Cacti?  If you disable, this change will not take affect until after the next polling cycle.  When you have Remote Data Collectors, this settings is required to be on."
msgstr "Treba li Boost omogućiti RRD ažuriranje na zahtjev u sistemu Cacti? Ako onemogućite, ova promjena neće stupiti na snagu sve do nakon sljedećeg ciklusa prikupljanja podataka. Kada imate udaljene prikupljače podataka, ova postavka mora biti uključena."

#: include/global_settings.php
msgid "System Level RRD Updater"
msgstr "Alat za RRD ažuriranje na nivou sistema"

#: include/global_settings.php
msgid "Before RRD On-demand Update Can be Cleared, a poller run must always pass"
msgstr "Prije nego što se RRD ažuriranje na zahtjev može očistiti, pokretanje polera uvijek mora proći"

#: include/global_settings.php
msgid "How Often Should Boost Update All RRDs"
msgstr "Koliko često Boost treba ažurirati sve RRD datoteke"

#: include/global_settings.php
msgid "When you enable boost, your RRD files are only updated when they are requested by a user, or when this time period elapses."
msgstr "Kada omogućite Boost, vaše RRD datoteke se ažuriraju samo kada ih korisnik zatraži ili kada istekne ovaj vremenski period."

#: include/global_settings.php
msgid "Number of Boost Processes"
msgstr "Broj Boost procesa"

#: include/global_settings.php
msgid "The number of concurrent boost processes to use to use to process all of the RRDs in the boost table."
msgstr "Broj istovremenih Boost procesa koji se koriste za obradu svih RRD datoteka u Boost tabeli."

#: include/global_settings.php
msgid "Maximum Records"
msgstr "Maksimalan broj zapisa"

#: include/global_settings.php
msgid "If the boost output table exceeds this size, in records, an update will take place."
msgstr "Ako izlazna Boost tabela premaši ovu veličinu, izraženu u broju zapisa, izvršit će se ažuriranje."

#: include/global_settings.php
msgid "Maximum Data Source Items Per Pass"
msgstr "Maksimalan broj stavki izvora podataka po prolazu"

#: include/global_settings.php
msgid "To optimize performance, the boost RRD updater needs to know how many Data Source Items should be retrieved in one pass.  Please be careful not to set too high as graphing performance during major updates can be compromised.  If you encounter graphing or polling slowness during updates, lower this number.  The default value is 50000."
msgstr "Radi optimizacije performansi, Boost RRD alat za ažuriranje mora znati koliko stavki izvora podataka treba preuzeti u jednom prolazu. Molimo budite oprezni da ne postavite previsoku vrijednost jer performanse iscrtavanja grafikona tokom velikih ažuriranja mogu biti ugrožene. Ako primijetite usporavanje iscrtavanja grafikona ili prikupljanja podataka tokom ažuriranja, smanjite ovaj broj. Podrazumijevana vrijednost je 50000."

#: include/global_settings.php
msgid "Maximum Argument Length"
msgstr "Maksimalna dužina argumenta"

#: include/global_settings.php
msgid "When boost sends update commands to RRDtool, it must not exceed the operating systems Maximum Argument Length.  This varies by operating system and kernel level.  For example: Windows 2000 <= 2048, FreeBSD <= 65535, Linux 2.6.22-- <= 131072, Linux 2.6.23++ unlimited"
msgstr "Kada Boost šalje komande za ažuriranje u RRDtool, one ne smiju premašiti maksimalnu dužinu argumenta operativnog sistema. To zavisi od operativnog sistema i verzije kernela. Na primjer: Windows 2000 <= 2048, FreeBSD <= 65535, Linux 2.6.22-- <= 131072, Linux 2.6.23++ neograničeno"

#: include/global_settings.php
msgid "Memory Limit for Boost and Poller"
msgstr "Ograničenje memorije za Boost i poler"

#: include/global_settings.php
msgid "The maximum amount of memory for the Cacti Poller and Boosts Poller"
msgstr "Maksimalna količina memorije za Cacti poler i Boost poler"

#: include/global_settings.php
msgid "Maximum RRD Update Script Run Time"
msgstr "Maksimalno vrijeme izvršavanja skripte za RRD ažuriranje"

#: include/global_settings.php
msgid "If the boost poller exceeds this runtime, a warning will be placed in the cacti log,"
msgstr "Ako Boost poler premaši ovo vrijeme izvršavanja, upozorenje će biti upisano u Cacti zapisnik,"

#: include/global_settings.php
msgid "Enable Boost Debugging"
msgstr "Omogući otklanjanje grešaka za Boost"

#: include/global_settings.php
msgid "If set, Boost will log debug information directly to the Boost log file.  Please note, enabling can cause a high I/O rate on the local file system."
msgstr "Ako je postavljeno, Boost će zapisivati informacije za otklanjanje grešaka direktno u datoteku Boost zapisnika. Napomena: omogućavanje može uzrokovati visok nivo I/O operacija na lokalnom sistemu datoteka."

#: include/global_settings.php utilities.php
msgid "Image Caching"
msgstr "Keširanje slika"

#: include/global_settings.php
msgid "Enable Image Caching"
msgstr "Omogući keširanje slika"

#: include/global_settings.php
msgid "Should image caching be enabled?"
msgstr "Treba li omogućiti keširanje slika?"

#: include/global_settings.php
msgid "Location for Image Files"
msgstr "Lokacija za datoteke slika"

#: include/global_settings.php
msgid "Specify the location where Boost should place your image files.  These files will be automatically purged by the poller when they expire."
msgstr "Navedite lokaciju na koju Boost treba smještati vaše datoteke slika. Poler će automatski obrisati ove datoteke kada isteknu."

#: include/global_settings.php
msgid "Data Sources Statistics"
msgstr "Statistika izvora podataka"

#: include/global_settings.php
msgid "Enable Data Source Statistics Collection"
msgstr "Omogući prikupljanje statistike izvora podataka"

#: include/global_settings.php
msgid "Should Data Source Statistics be collected for this Cacti system?"
msgstr "Treba li prikupljati statistiku izvora podataka za ovaj Cacti sistem?"

#: include/global_settings.php
msgid "Data Collection Method"
msgstr "Metoda prikupljanja podataka"

#: include/global_settings.php
msgid "Data Source Statistics can use a legacy method where it will determine peak and average values, or an advanced mode which will calculated several additional statistical values in addition to peak and average.  Using All Statistical Metrics can place additional CPU and IO load on the system."
msgstr "Statistika izvora podataka može koristiti naslijeđenu metodu koja određuje vršne i prosječne vrijednosti, ili napredni režim koji će izračunati nekoliko dodatnih statističkih vrijednosti pored vršnih i prosječnih. Korištenje opcije Sve statističke metrike može stvoriti dodatno CPU i IO opterećenje na sistemu."

#: include/global_settings.php
msgid "Peak/Average Only"
msgstr "Samo vršna/prosječna"

#: include/global_settings.php
msgid "All Statistical Metrics"
msgstr "Sve statističke metrike"

#: include/global_settings.php
msgid "Calculate Peaks Stats in Addition to Average Stats"
msgstr "Izračunaj vršnu statistiku pored prosječne statistike"

#: include/global_settings.php
msgid "This option will double the data collection time.  If will use the MAX consolidation function and calculate statistics from the max values in each of the respective time ranges."
msgstr "Ova opcija će udvostručiti vrijeme prikupljanja podataka. Koristit će funkciju konsolidacije MAX i izračunati statistiku iz maksimalnih vrijednosti u svakom od odgovarajućih vremenskih opsega."

#: include/global_settings.php
msgid "Number of DSStats Processes"
msgstr "Broj DSStats procesa"

#: include/global_settings.php
msgid "The number of concurrent DSStats processes to use to use to process all of the Data Sources."
msgstr "Broj istovremenih DSStats procesa koji se koriste za obradu svih izvora podataka."

#: include/global_settings.php
msgid "Daily Update Frequency"
msgstr "Učestalost dnevnog ažuriranja"

#: include/global_settings.php
msgid "How frequent should Daily Stats be updated?"
msgstr "Koliko često treba ažurirati dnevnu statistiku?"

#: include/global_settings.php
msgid "Hourly Average Window"
msgstr "Prozor satnog prosjeka"

#: include/global_settings.php
msgid "The number of consecutive hours that represent the hourly average.  Keep in mind that a setting too high can result in very large memory tables"
msgstr "Broj uzastopnih sati koji predstavljaju satni prosjek. Imajte na umu da previsoka postavka može dovesti do veoma velikih memorijskih tabela"

#: include/global_settings.php
msgid "Maintenance Time"
msgstr "Vrijeme održavanja"

#: include/global_settings.php
msgid "What time of day should Weekly, Monthly, and Yearly Data be updated?  Format is HH:MM [am/pm]"
msgstr "U koje doba dana treba ažurirati sedmične, mjesečne i godišnje podatke? Format je HH:MM [am/pm]"

#: include/global_settings.php
msgid "Memory Limit for Data Source Statistics Data Collector"
msgstr "Ograničenje memorije za prikupljač podataka statistike izvora podataka"

#: include/global_settings.php
msgid "The maximum amount of memory for the Cacti Poller and Data Source Statistics Poller"
msgstr "Maksimalna količina memorije za Cacti Poller i Poller statistike izvora podataka"

#: include/global_settings.php
msgid "Data Source Retention Settings"
msgstr "Postavke zadržavanja izvora podataka"

#: include/global_settings.php
msgid "Save Historical Data in Database Tables"
msgstr "Sačuvaj historijske podatke u tabelama baze podataka"

#: include/global_settings.php
msgid "Check this setting in order to keep a table for each day, week, month, and year data.  The times that these tables will be created will be based upon the following formula: Daily - One partition per day, Weekly - One Partition per Week, Monthly - One partition per Month, Yearly - One Partition per Year.  All tables will have the following suffixes by type Daily: YYYYDDD, Weekly: YYYYWW, Monthly: YYYYMM, and Yearly: YYYY suffixes."
msgstr "Označite ovu postavku kako biste čuvali tabelu za podatke svakog dana, sedmice, mjeseca i godine. Vrijeme kreiranja ovih tabela zasnivat će se na sljedećoj formuli: Dnevno - jedna particija po danu, Sedmično - jedna particija po sedmici, Mjesečno - jedna particija po mjesecu, Godišnje - jedna particija po godini. Sve tabele će imati sljedeće sufikse prema tipu: Dnevno: YYYYDDD, Sedmično: YYYYWW, Mjesečno: YYYYMM i Godišnje: sufikse YYYY."

