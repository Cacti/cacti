msgid "SNMP Agent Support Enabled"
msgstr "Hỗ trợ đại lý SNMP được kích hoạt"

#: include/global_settings.php
msgid "If this option is checked, Cacti will populate SNMP Agent tables with Cacti device and system information.  It does not enable the SNMP Agent itself."
msgstr "Nếu tùy chọn này được chọn, Cacti sẽ điền vào bảng SNMP Agent với thông tin hệ thống và thiết bị Cacti. Nó không kích hoạt SNMP Agent."

#: include/global_settings.php
msgid "Poller Type"
msgstr "Loại xe đẩy"

