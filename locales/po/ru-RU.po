msgid "The password to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Пароль для аутентификации при отправке по SMTP. (Оставьте пустым, если аутентификация не требуется.)"

#: include/global_settings.php
msgid "SMTP Security"
