msgid "Expire Password"
msgstr "Expirer le mot de passe"

#: include/global_settings.php
msgid "This is maximum number of days before a password is set to expire."
msgstr "Il s'agit du nombre maximum de jours avant l'expiration d'un mot de passe."

#: include/global_settings.php
msgid "Password History"
msgstr "Historique de mot de passe"

#: include/global_settings.php
msgid "Remember this number of old passwords and disallow reusing them."
msgstr "Mémoriser ce nombre d'anciens mots de passe et interdire leur réutilisation."

#: include/global_settings.php
