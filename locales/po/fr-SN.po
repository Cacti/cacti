msgid "When an admin creates a new account and an email address is entered, send an informational email to it."
msgstr "Lorsqu'un administrateur crée un nouveau compte et qu'une adresse e-mail est saisie, envoyez-lui un e-mail d'information."

#: include/global_settings.php
