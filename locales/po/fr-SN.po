#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "Interclassement par défaut utilisé par le serveur lors de la création des bases de données et des tables."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "ex. utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Jeu de caractères par défaut utilisé par le serveur."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "ex. utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Jeu de caractères utilisé par le client lors de l'envoi d'instructions au serveur."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Nombre maximal de connexions clientes simultanées autorisées."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Entier ; 151 par défaut. Prévoyez suffisamment de connexions pour les collecteurs et les sessions utilisateurs."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Ancien nom du cache de tables ouvertes ; renommé en table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Entier. Utilisez table_open_cache sur les serveurs modernes."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Taille maximale d'un paquet ou de toute chaîne générée/intermédiaire."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Octets ; conservez une valeur supérieure ou égale à 16M pour les collecteurs distants."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Taille maximale que peuvent atteindre les tables MEMORY créées par les utilisateurs."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Octets ; dimensionné par rapport à la mémoire totale du système."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Taille maximale des tables temporaires internes en mémoire avant qu'elles ne soient écrites sur disque."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Octets ; une valeur plus élevée conserve les tables temporaires en mémoire."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Taille minimale du tampon par jointure pour les jointures qui n'utilisent pas d'index."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Octets ; allocation par connexion, 262144 par défaut."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "Tampon par session alloué pour les tris (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Octets ; allocation par connexion, 2097152 par défaut."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Stocker chaque table InnoDB et ses index dans son propre fichier d'espace de tables .ibd."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON ou OFF ; ON est recommandé."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "Format de fichier InnoDB sur disque (Antelope ou Barracuda) ; Barracuda est désormais le seul format."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Autoriser les préfixes de clé d'index de plus de 767 octets (nécessite le format Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 ou OFF/0 ; ce comportement est désormais toujours activé."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Mémoire totale utilisée par InnoDB pour mettre en cache les données des tables et des index."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Octets ; généralement 25 % à 80 % de la mémoire système totale."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Écrire les pages deux fois (tampon de double écriture) pour protéger contre les écritures partielles de pages."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON ou OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "Pool hérité pour le dictionnaire de données et les structures internes d'InnoDB."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Octets ; obsolète sur les serveurs modernes."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Nombre de secondes pendant lesquelles une transaction InnoDB attend un verrou de ligne avant d'abandonner."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Secondes ; 50 par défaut."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Méthode utilisée pour vider les fichiers de données et de journaux sur le disque."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC et similaires."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Contrôle la manière dont le journal redo est écrit et vidé lors de la validation des transactions."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1 ou 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Ancien paramètre unique pour les threads d'E/S de fichiers InnoDB, remplacé par les paramètres de threads d'E/S en lecture/écriture."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Entier ; remplacé par innodb_read_io_threads et innodb_write_io_threads."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Écrire et vider le journal redo InnoDB toutes les N secondes."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Secondes (1-2700) ; 1 par défaut."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Nombre de threads d'E/S utilisés pour les opérations de lecture dans InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64 ; 4 par défaut."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Nombre de threads d'E/S utilisés pour les opérations d'écriture dans InnoDB."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Nombre de régions en lesquelles le pool de tampons InnoDB est divisé."

#: lib/utility.php
