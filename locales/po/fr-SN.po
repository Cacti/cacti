msgstr "Fournisseur OAuth2"

#: include/global_settings.php
msgid "Choose your OAuth2 provider."
msgstr "Choisissez votre fournisseur OAuth2."

#: include/global_settings.php
msgid "Email address connected with your oauth."
msgstr "Adresse e-mail associée à votre compte OAuth."

#: include/global_settings.php
