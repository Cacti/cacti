msgstr "Il s'agit du nom d'hôte/IP du serveur SMTP auquel vous enverrez l'e-mail. Pour le basculement, séparez vos hôtes à l'aide d'un point-virgule."

#: include/global_settings.php
msgid "SMTP Port"
msgstr "Port SMTP"

#: include/global_settings.php
msgid "The port on the SMTP Server to use."
msgstr "Port du serveur SMTP à utiliser."

#: include/global_settings.php
msgid "must be a positive integer."
msgstr "doit être un entier positif."

#: include/global_settings.php
msgid "SMTP Username"
msgstr "Nom d'utilisateur SMTP"

#: include/global_settings.php
msgid "The username to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Le nom d'utilisateur avec lequel s'authentifier lors de l'envoi via SMTP. (Laissez vide si vous n'avez pas besoin d'authentification.)"

#: include/global_settings.php
msgid "SMTP Password"
msgstr "Mot de passe SMTP"

#: include/global_settings.php
msgid "The password to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Le mot de passe avec lequel s'authentifier lors de l'envoi via SMTP. (Laissez vide si vous n'avez pas besoin d'authentification.)"

#: include/global_settings.php
msgid "SMTP Security"
msgstr "SMTP Sécurité"

#: include/global_settings.php
