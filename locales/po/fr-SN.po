msgstr "C'est le message qui sera envoyé au nouveau compte utilisateur. 1024 caractères maximum. HTML est autorisé. Il existe plusieurs étiquettes de remplacement courantes qui peuvent être utilisées dans &#060CACTIURL&#062 &#060USERNAME&#062 &#060PASSWORD&#062"

#: include/global_settings.php
msgid "New Cacti account created. <br>Server: <a href=\"<CACTIURL>\"><CACTIURL></a><br>Username: <USERNAME><br>To login and set a new password, click the <a href=\"<PWDRESETLINK>\">password reset link</a><br><br>"
msgstr "Nouveau compte Cacti créé. <br>Serveur : <a href=\"<CACTIURL>\"><CACTIURL></a><br>Nom d'utilisateur : <USERNAME><br>Pour vous connecter et définir un nouveau mot de passe, cliquez sur le <a href=\"<PWDRESETLINK>\">lien de réinitialisation du mot de passe</a><br><br>"

#: include/global_settings.php
msgid "Send email when an admin changes an account password"
msgstr "Envoyer un e-mail lorsqu'un administrateur modifie le mot de passe d'un compte"

#: include/global_settings.php
msgid "When an admin changes the password of an account and the email address for that account is entered, an informational email will be sent to that address."
msgstr "Lorsqu'un administrateur modifie le mot de passe d'un compte et que l'adresse e-mail de ce compte est renseignée, un e-mail d'information sera envoyé à cette adresse."

#: include/global_settings.php
msgid "Subject of password reset message"
msgstr "Objet du message de réinitialisation du mot de passe"

#: include/global_settings.php
msgid "This is the Email subject that will be used when an admin changes an account password or a user uses 'Forgot password'."
msgstr "Ceci est l'objet de l'e-mail qui sera utilisé lorsqu'un administrateur modifie le mot de passe d'un compte ou qu'un utilisateur clique sur « Mot de passe oublié »."

#: include/global_settings.php
msgid "Cacti password reset"
msgstr "Réinitialisation du mot de passe Cacti"

#: include/global_settings.php
msgid "Email body for password reset message"
msgstr "Corps de l'e-mail pour le message de réinitialisation du mot de passe"

#: include/global_settings.php
msgid "This is the message that will be sent when a user requests a password reset. Max 1024 characters. HTML is allowed. There are several common replacement tags that may be used in include &#060CACTIURL&#062 &#060USERNAME&#062 &#060PASSWORD&#062"
msgstr "C'est le message qui sera envoyé lorsqu'un utilisateur demande une réinitialisation de mot de passe. 1024 caractères maximum. HTML est autorisé. Il existe plusieurs étiquettes de remplacement courantes qui peuvent être utilisées dans &#060CACTIURL&#062 &#060USERNAME&#062 &#060PASSWORD&#062"

#: include/global_settings.php
msgid "Your account password has been reset. <br>Server: <a href=\"<CACTIURL>\"><CACTIURL></a><br>Username: <USERNAME><br>To set a new password, click the <a href=\"<PWDRESETLINK>\">password reset link</a><br><br>"
msgstr "Le mot de passe de votre compte a été réinitialisé. <br>Serveur : <a href=\"<CACTIURL>\"><CACTIURL></a><br>Nom d'utilisateur : <USERNAME><br>Pour définir un nouveau mot de passe, cliquez sur le <a href=\"<PWDRESETLINK>\">lien de réinitialisation du mot de passe</a><br><br>"

#: include/global_settings.php
msgid "Reset link validity"
msgstr "Réinitialiser la validité du lien"

#: include/global_settings.php
