#, php-format
msgid "%s Variable Capability Matrix"
msgstr "Matrice des capacités des variables %s"

#: lib/utility.php
msgid "Support by engine and version for each Cacti-recommended variable"
msgstr "Prise en charge par moteur et par version pour chaque variable recommandée par Cacti"

#: lib/utility.php
