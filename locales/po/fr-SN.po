msgid "The font to use for Graph Axis items.  Enter either a valid True Type Font file or valid Pango font-config value."
msgstr "La police à utiliser pour les éléments de l'axe des graphes.  Entrez un fichier de police True Type valide ou une valeur de police-config Pango valide."

#: include/global_settings.php
msgid "Unit Font Size"
msgstr "Taille de police unitaire"

