msgstr "Rechercher un nom distinctif (DN)"

#: login_providers.php
msgid "Distinguished Name for Specific Searching binding to the LDAP directory."
msgstr "Nom distinctif pour la liaison de recherche spécifique au répertoire LDAP."

#: login_providers.php
