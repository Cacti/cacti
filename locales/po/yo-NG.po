#: include/global_settings.php
msgid "FPing Binary Path"
msgstr "Ọ̀nà Bínárì FPing"

#: include/global_settings.php
msgid "The path to the FPing binary file which provides for a more precise ping command."
msgstr "Ọ̀nà sí fáìlì bínárì FPing tí ó ń pèsè àṣẹ ping tí ó péye jùlọ."

#: include/global_settings.php
msgid "Cacti Log Path"
msgstr "Ọ̀nà Àkọsílẹ̀ Cacti"

