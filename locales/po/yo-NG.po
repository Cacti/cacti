msgstr "Iye Àwọn Fódà Hash Ẹ̀rọ Tó Pọ̀ Jùlọ"

#: include/global_settings.php
msgid "The maximum number of Device Directories to be created based upon hashed Device ID's."
msgstr "Iye Àwọn Fódà Ẹ̀rọ tí ó pọ̀ jùlọ láti dá sílẹ̀ dá lórí àwọn ID Ẹ̀rọ tí a ṣe hash."

#: include/global_settings.php
msgid "Proxy Server"
msgstr "Olùpèsè Aṣojú"

