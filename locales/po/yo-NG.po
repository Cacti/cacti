msgstr "Yan orúkọ kan fún orísun dátà yìí.  Ó lè ní àwọn onírúurú ìyípadà bíi |host_description| tàbí |query_fieldName|.  Fún àkójọ kíkún ti àwọn àmì ìyípadà tí a ṣe àtìlẹ́yìn fún, jọ̀wọ́ wo ìwé àkọsílẹ̀ Cacti."

#: include/global_form.php
msgid "Data Source Path"
msgstr "Ipa-ọ̀nà Orísun Dátà"

#: include/global_form.php
msgid "The full path to the RRDfile."
msgstr "Ipa-ọ̀nà kíkún sí RRDfile náà."

#: include/global_form.php
msgid "The script/source used to gather data for this data source."
msgstr "Ìwé-àṣẹ/orísun tí a lò láti kó dátà jọ fún orísun dátà yìí."

#: include/global_form.php package_import.php
msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "Yan Ìrísí Orísun Dátà.  Ìrísí Orísun Dátà ń ṣàkóso ààrin àkókò ìwádìí, àkójọpọ̀ dátà, àti ìlànà ìdádúró fún Àwọn Orísun Dátà tí yóò jáde."

#: include/global_form.php
msgid "The amount of time in seconds between expected updates."
msgstr "Ìwọ̀n àkókò ní ìṣẹ́jú-àáyá láàárín àwọn àtúnṣe tí a ń retí."

#: include/global_form.php
msgid "Data Source Active"
msgstr "Orísun Dátà Ń Ṣiṣẹ́"

#: include/global_form.php
msgid "Whether Cacti should gather data for this data source or not."
msgstr "Bóyá kí Cacti kó dátà jọ fún orísun dátà yìí tàbí bẹ́ẹ̀ kọ́."

#: include/global_form.php
msgid "Internal Data Source Name"
msgstr "Orúkọ Orísun Dátà Inú"

#: include/global_form.php
msgid "Choose unique name to represent this piece of data inside of the RRDfile."
msgstr "Yan orúkọ àrà ọ̀tọ̀ láti dúró fún ìdá dátà yìí nínú RRDfile."

#: include/global_form.php
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "Iye Kéréje Jùlọ (\"U\" fún Kò Sí Kéréje Jùlọ)"

#: include/global_form.php
msgid "The minimum value of data that is allowed to be collected."
msgstr "Iye dátà tí ó kéré jùlọ tí a gbà láyè láti kó jọ."

#: include/global_form.php
msgid "Maximum Value (\"U\" for No Maximum)"
msgstr "Iye Púpọ̀ Jùlọ (\"U\" fún Kò Sí Púpọ̀ Jùlọ)"

#: include/global_form.php
msgid "The maximum value of data that is allowed to be collected."
msgstr "Iye dátà tí ó pọ̀ jùlọ tí a gbà láyè láti kó jọ."

#: include/global_form.php
msgid "Data Source Type"
msgstr "Irú Orísun Dátà"

#: include/global_form.php
msgid "How data is represented in the RRA."
msgstr "Bí a ṣe ṣe àfihàn dátà nínú RRA."

#: include/global_form.php
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "Àkókò tí ó pọ̀ jùlọ tí ó lè kọjá ṣáájú kí a tó tẹ dátà sílẹ̀ gẹ́gẹ́ bíi 'àìmọ̀'. (Lọ́pọ̀ ìgbà 2x300=600)"

#: include/global_form.php lib/html_utility.php
msgid "Not Selected"
msgstr "A Kò Yàn"

#: include/global_form.php
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "Nígbà tí a bá kó dátà jọ, a óò fi dátà fún pápá yìí sí inú orísun dátà yìí."

#: include/global_form.php
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "Tẹ orúkọ kan fún ìṣètò tẹ́lẹ̀ GPRINT yìí, rí i dájú pé ó jẹ́ ohun tí o lè dá mọ̀."

#: include/global_form.php
msgid "GPRINT Text"
msgstr "Ọ̀rọ̀ GPRINT"

#: include/global_form.php
msgid "Enter the custom GPRINT string here."
msgstr "Tẹ okùn GPRINT àdáni síbí."

#: include/global_form.php
msgid "Common Options"
msgstr "Àwọn Àṣàyàn Wọ́pọ̀"

#: include/global_form.php
msgid "Title (--title)"
msgstr "Àkọlé (--title)"

#: include/global_form.php
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Cacti documentation."
msgstr "Orúkọ tí a tẹ̀ sórí àwòrán náà.  Ó lè ní àwọn onírúurú ìyípadà bíi |host_description| tàbí |query_fieldName|.  Fún àkójọ kíkún ti àwọn àmì ìyípadà tí a ṣe àtìlẹ́yìn fún, jọ̀wọ́ wo ìwé àkọsílẹ̀ Cacti."

#: include/global_form.php
msgid "Vertical Label (--vertical-label)"
msgstr "Àmì Ìdúró (--vertical-label)"

#: include/global_form.php
msgid "The label vertically printed to the left of the graph."
msgstr "Àmì tí a tẹ̀ ní ìdúró ní apá òsì àwòrán náà."

#: include/global_form.php
msgid "Image Format (--imgformat)"
msgstr "Ìrísí Àwòrán (--imgformat)"

#: include/global_form.php
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "Irú àwòrán tí a ń mú jáde; PNG, GIF tàbí SVG.  Yíyan irú àwòrán dá lórí RRDtool gidigidi."

#: include/global_form.php
msgid "Height (--height)"
msgstr "Gíga (--height)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Gíga (ní àwọn píkísẹ̀ẹ̀lì) agbègbè àwòrán nínú àwòrán náà. Agbègbè yìí kò ní àkọsílẹ̀ àlàyé, àwọn àkọsílẹ̀ ààlà, tàbí àkọlé nínú."

#: include/global_form.php
msgid "Width (--width)"
msgstr "Ìfẹ̀ (--width)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Ìfẹ̀ (ní àwọn píkísẹ̀ẹ̀lì) agbègbè àwòrán nínú àwòrán náà. Agbègbè yìí kò ní àkọsílẹ̀ àlàyé, àwọn àkọsílẹ̀ ààlà, tàbí àkọlé nínú."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "Ìye Ìpìlẹ̀ (--base)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Ó yẹ kí a ṣètò rẹ̀ sí 1024 fún ìrántí àti 1000 fún wíwọn ìrìnàjò ìṣàn dátà."

#: include/global_form.php
msgid "Vertical Label Angle (--vertical-label-angle)"
msgstr "Igun Àmì-ìdámọ̀ Gíga (--vertical-label-angle)"

#: include/global_form.php
msgid "RRDtool Default"
msgstr "Àṣàyàn Àkọ́kọ́ RRDtool"

#: include/global_form.php
msgid "Label rotation in degrees counter clockwise. Requires RRDtool 1.11 or newer. Blank uses the RRDtool default. Angles other than 90 and 270 may overlap nearby content."
msgstr "Yíyí àmì-ìdámọ̀ ní ìwọ̀n dígírì sí òdì agogo. Ó nílò RRDtool 1.11 tàbí tuntun jù bẹ́ẹ̀ lọ. Òfo ń lo àṣàyàn àkọ́kọ́ RRDtool. Àwọn igun mìíràn yàtọ̀ sí 90 àti 270 lè bo àwọn àkóónú tí ó súnmọ́."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "Ìpo Ìtẹ̀sí (--slope-mode)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Lílo Ìpo Ìtẹ̀sí máa ń tún ìrísí àwọn àwòrán ṣe dọ́gba ní ìdínkù díẹ̀ lórí ìpéye àwòrán ojú ìbòjú."

#: include/global_form.php
msgid "Scaling Options"
msgstr "Àwọn Àṣàyàn Ìwọ̀n"

#: include/global_form.php
msgid "Auto Scale"
msgstr "Ìwọ̀n Àdáṣe"

#: include/global_form.php
msgid "Auto scale the y-axis instead of defining an upper and lower limit. Note: if this is check both the Upper and Lower limit will be ignored."
msgstr "Ṣe ìwọ̀n àdáṣe fún ààlà y dípò ṣíṣe àlàyé ààlà òkè àti ìsàlẹ̀. Àkíyèsí: bí a bá ṣàmì sí èyí, a ó fo ààlà Òkè àti Ìsàlẹ̀ méjèèjì dá."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "Àwọn Àṣàyàn Ìwọ̀n Àdáṣe"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Lo <br> --alt-autoscale láti ṣe ìwọ̀n sí ìye tó kéré jùlọ àti tó pọ̀ jùlọ pátápátá <br> --alt-autoscale-max láti ṣe ìwọ̀n sí ìye tó pọ̀ jùlọ, ní lílo ààlà ìsàlẹ̀ tí a pèsè <br> --alt-autoscale-min láti ṣe ìwọ̀n sí ìye tó kéré jùlọ, ní lílo ààlà òkè tí a pèsè <br> --alt-autoscale (pẹ̀lú àwọn ààlà) láti ṣe ìwọ̀n ní lílo ààlà ìsàlẹ̀ àti òkè méjèèjì (àṣàyàn àkọ́kọ́ RRDtool) <br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Lo --alt-autoscale (kíkọ àwọn ààlà tí a pèsè sílẹ̀)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Lo --alt-autoscale-max (gbígba ààlà ìsàlẹ̀)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Lo --alt-autoscale-min (gbígba ààlà òkè)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Lo --alt-autoscale (gbígba àwọn ààlà méjèèjì, àṣàyàn àkọ́kọ́ RRDtool)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Ìwọ̀n Lọ́gárídímù (--logarithmic)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "Lo ìwọ̀n ààlà y ti Lọ́gárídímù"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "Àwọn Ẹyọ SI fún Ìwọ̀n Lọ́gárídímù (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Lo Àwọn Ẹyọ SI fún Ìwọ̀n Lọ́gárídímù dípò lílo àmì ìṣàfihàn agbára nọ́ńbà.<br> Àkíyèsí: Àwọn àwòrán ìlà tààrà máa ń lo àmì SI ní àṣàyàn àkọ́kọ́."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Ìpo Àwọn Ààlà Líle (--rigid)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Má ṣe fẹ̀ ààlà ìsàlẹ̀ àti òkè bí àwòrán bá ní ìye kan níta àgbègbè tó tọ́."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "Ààlà Òkè (--upper-limit)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "Ìye gíga tó pọ̀ jùlọ fún àwòrán náà."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "Ààlà Ìsàlẹ̀ (--lower-limit)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "Ìye gíga tó kéré jùlọ fún àwòrán náà."

#: include/global_form.php
msgid "Grid Options"
msgstr "Àwọn Àṣàyàn Àwọ̀n-ìlà"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Ìye Ẹyọ Àwọ̀n-ìlà (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Ṣètò ìye agbára nọ́ńbà lórí ààlà Y fún àwọn nọ́ńbà. Àkíyèsí: Àṣàyàn yìí ti di ohun àtijọ́ a sì ti fi àṣàyàn --y-grid rọ́pò rẹ̀. Nínú àṣàyàn yìí, àwọn ìlà àwọ̀n ààlà Y máa ń farahàn ní ìgbésẹ̀ ààlà kọ̀ọ̀kan. A máa ń fi àwọn àmì-ìdámọ̀ sí gbogbo ìlà ìpín àmì-ìdámọ̀."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Ìye Agbára Nọ́ńbà Ẹyọ (--units-exponent)"

#: include/global_form.php
msgid "What unit Cacti should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Ẹyọ wo ni Cacti yẹ kí ó lò lórí ààlà Y. Lo 3 láti fi ohun gbogbo hàn ní \"k\" tàbí -6 láti fi ohun gbogbo hàn ní \"u\" (micro)."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Gígùn Ẹyọ (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Nọ́ńbà mélòó ni RRDtool yẹ kí ó gbà pé àwọn àmì-ìdámọ̀ ààlà y jẹ́? O lè nílò láti lo àṣàyàn yìí láti ṣẹ̀dá ààyè tó pọ̀ tó nígbà tí o bá bẹ̀rẹ̀ sí í ṣe àtúnṣe àmì-ìdámọ̀ ààlà y."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "Kò sí Ìbámu Àwọ̀n-ìlà (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "Láti yẹra fún ìfọ́jú àwòrán anti-aliasing, RRDtool máa ń so àwọn àmì pọ̀ mọ́ píkísẹ̀ẹ̀lì ìpéye ohun èlò, èyí sì ń fúnni ní ìrísí tó mọ́ kedere. Bí èyí kò bá tẹ́ ọ lọ́rùn, o lè lo ìyípadà yìí láti pa ìṣe yìí.<br><strong>Àkíyèsí: </strong>Ìbámu àwọ̀n-ìlà wà ní pípa fún àbájáde PDF, EPS, SVG ní àṣàyàn àkọ́kọ́."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Àwọ̀n-ìlà Y Àtúnṣe (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Àlùgọ́rídìmù náà máa ń rí i dájú pé o ní àwọ̀n-ìlà nígbà gbogbo, pé àwọn ìlà àwọ̀n-ìlà tó pọ̀ tó ṣùgbọ́n tí kò pọ̀ jù wà, àti pé àwọ̀n-ìlà náà jẹ́ ti ìwọ̀n métíríìkì. Pàrámítà yìí yóò tún rí i dájú pé o rí àwọn dẹ́símà tó pọ̀ tó ní ìfihàn kódà bí àwòrán rẹ bá lọ láti 69.998 sí 70.001.<br><strong>Àkíyèsí: </strong>Pàrámítà yìí lè dí àwọn àṣàyàn --alt-autoscale lọ́wọ́."

#: include/global_form.php
msgid "Axis Options"
msgstr "Àwọn Àṣàyàn Ààlà"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Ààlà Ọ̀tún (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "A ó fa ààlà kejì sí apá ọ̀tún àwòrán náà. Ó so mọ́ ààlà òsì nípasẹ̀ àwọn pàrámítà ìwọ̀n àti ìyípadà."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Àmì-ìdámọ̀ Ààlà Ọ̀tún (--right-axis-label &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "Àmì-ìdámọ̀ fún ààlà ọ̀tún."

#: include/global_form.php
msgid "Right Axis Label Angle (--right-axis-label-angle)"
msgstr "Igun Àmì-ìdámọ̀ Ààlà Ọ̀tún (--right-axis-label-angle)"

#: include/global_form.php
msgid "Right label rotation in degrees counter clockwise. Requires RRDtool 1.11 or newer. Blank follows the vertical label angle. Angles other than 90 and 270 may overlap nearby content."
msgstr "Yíyí àmì-ìdámọ̀ ọ̀tún ní ìwọ̀n dígírì sí òdì agogo. Ó nílò RRDtool 1.11 tàbí tuntun jù bẹ́ẹ̀ lọ. Òfo máa ń tẹ̀lé igun àmì-ìdámọ̀ gíga. Àwọn igun mìíràn yàtọ̀ sí 90 àti 270 lè bo àwọn àkóónú tí ó súnmọ́."

#: include/global_form.php
msgid "Right Axis Label Range (--right-axis-range)"
msgstr "Àgbègbè Àmì-ìdámọ̀ Ààlà Ọ̀tún (--right-axis-range)"

#: include/global_form.php
msgid "Only show right axis labels within min:max, for example 0:100. Either bound may be blank. This does not change the axis scale. Requires RRDtool 1.11 or newer. Blank leaves labels unrestricted."
msgstr "Fi àwọn àmì-ìdámọ̀ ààlà ọ̀tún hàn nìkan láàárín min:max, fún àpẹẹrẹ 0:100. Èyíkéyìí ààlà lè jẹ́ òfo. Èyí kò yí ìwọ̀n ààlà padà. Ó nílò RRDtool 1.11 tàbí tuntun jù bẹ́ẹ̀ lọ. Òfo máa ń fi àwọn àmì-ìdámọ̀ sílẹ̀ láìsí ìdènà."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Ìṣètò Ààlà Ọ̀tún (--right-axis-format &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Ní ìbẹ̀rẹ̀, a máa ń ṣe àgbékalẹ̀ ìṣàmì ìlà àwọ̀n fúnra rẹ̀.  Tí o bá fẹ́ ṣe èyí fúnra rẹ, lo àṣàyàn yìí pẹ̀lú àwọn àríyànjiyàn %lf kan náà tí o mọ̀ láti inú àwọn àṣẹ PRINT àti GPRINT."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Olùṣètò Ìlà Àwọ̀n Ọ̀tún (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Nígbà tí o bá ń ṣètò ìṣàmì ìlà àwọ̀n ọ̀tún, lo òfin kan fún ìṣètò dátà náà.  Àwọn ìṣètò tí a ṣe àtìlẹ́yìn fún pẹ̀lú \"numeric\" níbi tí a ti ń ṣe àmúlò dátà gẹ́gẹ́ bí nọ́ńbà, \"timestamp\" níbi tí a ti ń túmọ̀ àwọn ìwọ̀n gẹ́gẹ́ bí àmì àkókò UNIX (iye ìṣẹ́jú-àáyá láti oṣù Jánúárì 1970) tí a sì ń ṣàlàyé rẹ̀ pẹ̀lú ìṣètò strftime (ìbẹ̀rẹ̀ ni \"%Y-%m-%d %H:%M:%S\").  Wo --units-length àti --right-axis-format pẹ̀lú.  Níkẹyìn \"duration\" níbi tí a ti ń túmọ̀ àwọn ìwọ̀n gẹ́gẹ́ bí àkókò ìdádúró ní milliseconds.  Ìṣètò ń tẹ̀lé àwọn òfin ti valstrfduration tí ó yẹ PRINT/GPRINT."

#: include/global_form.php
msgid "Left Axis Format (--left-axis-format &lt;format&gt;)"
msgstr "Ìṣètò Ìlà Àwọ̀n Òsì (--left-axis-format &lt;format&gt;)"

#: include/global_form.php
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Olùṣètò Ìlà Àwọ̀n Òsì (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Nígbà tí o bá ń ṣètò ìṣàmì ìlà àwọ̀n òsì, lo òfin kan fún ìṣètò dátà náà.  Àwọn ìṣètò tí a ṣe àtìlẹ́yìn fún pẹ̀lú \"numeric\" níbi tí a ti ń ṣe àmúlò dátà gẹ́gẹ́ bí nọ́ńbà, \"timestamp\" níbi tí a ti ń túmọ̀ àwọn ìwọ̀n gẹ́gẹ́ bí àmì àkókò UNIX (iye ìṣẹ́jú-àáyá láti oṣù Jánúárì 1970) tí a sì ń ṣàlàyé rẹ̀ pẹ̀lú ìṣètò strftime (ìbẹ̀rẹ̀ ni \"%Y-%m-%d %H:%M:%S\").  Wo --units-length pẹ̀lú.  Níkẹyìn \"duration\" níbi tí a ti ń túmọ̀ àwọn ìwọ̀n gẹ́gẹ́ bí àkókò ìdádúró ní milliseconds.  Ìṣètò ń tẹ̀lé àwọn òfin ti valstrfduration tí ó yẹ PRINT/GPRINT."

#: include/global_form.php
msgid "Legend Options"
msgstr "Àwọn Àṣàyàn Àmì Àlàyé"

#: include/global_form.php
msgid "Auto Padding"
msgstr "Àlàfo Fúnra Rẹ̀"

#: include/global_form.php
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Fi àlàfo kún ọ̀rọ̀ kí àmì àlàyé àti dátà àwòrán ìṣirò lè máa bá ara wọn mu nígbà gbogbo. Àkíyèsí: èyí lè mú kí àwọn àwòrán ìṣirò pẹ́ díẹ̀ kí wọ́n tó farahàn nítorí iṣẹ́ àfikún tí ó pọ̀ sí i. Bákan náà, Àlàfo Fúnra Rẹ̀ lè má péye lórí gbogbo irú àwòrán ìṣirò, ṣíṣàmì déédéé sábà máa ń ràn án lọ́wọ́."

#: include/global_form.php
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Àwọn Àmì Aláyípadà (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "Fa àwọn àmì ìlà gẹ́gẹ́ bí ìlà."

#: include/global_form.php
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Fipá Mú Àmì Àlàyé Òfin (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Fipá mú ṣíṣẹ̀dá àwọn àmì àlàyé HRULE àti VRULE."

#: include/global_form.php
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Ìfẹ̀ Taàbù (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Ní ìbẹ̀rẹ̀ ìfẹ̀ taàbù jẹ́ 40 pixels, lo àṣàyàn yìí láti yí i padà."

#: include/global_form.php
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Ipò Àmì Àlàyé (--legend-position=&lt;position&gt;)"

#: include/global_form.php
msgid "Place the legend at the given side of the graph."
msgstr "Fi àmì àlàyé sí ẹ̀gbẹ́ àwòrán ìṣirò tí a tọ́ka sí."

#: include/global_form.php
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Ìtọ́sọ́nà Àmì Àlàyé (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php
msgid "Place the legend items in the given vertical order."
msgstr "To àwọn ohun àmì àlàyé ní ìtòlẹ́sẹẹsẹ òòró tí a fúnni."

#: include/global_form.php lib/api_aggregate.php
msgid "Graph Item Type"
msgstr "Irú Ohun Àwòrán Ìṣirò"

#: include/global_form.php
msgid "How data for this item is represented visually on the graph."
msgstr "Bí a ṣe ń ṣàfihàn dátà fún ohun yìí lójú àwòrán ìṣirò."

#: include/global_form.php
msgid "The data source to use for this graph item."
msgstr "Orísun dátà láti lò fún ohun àwòrán ìṣirò yìí."

#: include/global_form.php lib/html.php
msgid "Primary Color"
msgstr "Àwọ̀ Àkọ́kọ́"

#: include/global_form.php
msgid "The color to use for the canvas item and legend."
msgstr "Àwọ̀ láti lò fún ohun orí àwòrán àti àmì àlàyé."

#: include/global_form.php
msgid "Primary Opacity"
msgstr "Ìṣúkù Àwọ̀ Àkọ́kọ́"

#: include/global_form.php
msgid "The opacity of the primary color."
msgstr "Ìṣúkù ti àwọ̀ àkọ́kọ́."

#: include/global_form.php lib/html.php
msgid "Gradient Color"
msgstr "Àwọ̀ Ìyípadà Kẹ̀rẹ̀kẹ̀rẹ̀"

#: include/global_form.php
msgid "The gradient color to use for the canvas item."
msgstr "Àwọ̀ ìyípadà kẹ̀rẹ̀kẹ̀rẹ̀ láti lò fún ohun orí àwòrán."

#: include/global_form.php
msgid "Gradient Opacity"
msgstr "Ìṣúkù Àwọ̀ Ìyípadà Kẹ̀rẹ̀kẹ̀rẹ̀"

#: include/global_form.php
msgid "The opacity of the gradient color."
msgstr "Ìṣúkù ti àwọ̀ ìyípadà kẹ̀rẹ̀kẹ̀rẹ̀."

#: include/global_form.php
msgid "Gradient Height"
msgstr "Gíga Àwọ̀ Ìyípadà Kẹ̀rẹ̀kẹ̀rẹ̀"

#: include/global_form.php
msgid "The Gradient Height parameter can create three different behaviors. If it is > 0, then the gradient is a fixed height, starting at the line going down. If it is < 0, then the gradient starts at a fixed height above the x-axis, going down to the x-axis. If it is == 0, then the gradient goes from the top of the area fill to x-axis."
msgstr "Pàrámítà Gíga Àwọ̀ Ìyípadà Kẹ̀rẹ̀kẹ̀rẹ̀ lè ṣẹ̀dá ìwà ọ̀tọ̀ọ̀tọ̀ mẹ́ta. Tí ó bá > 0, nígbà náà àwọ̀ ìyípadà kẹ̀rẹ̀kẹ̀rẹ̀ náà jẹ́ gíga tí kò yípadà, tí ó bẹ̀rẹ̀ láti orí ìlà lọ sí ìsàlẹ̀. Tí ó bá < 0, nígbà náà àwọ̀ ìyípadà kẹ̀rẹ̀kẹ̀rẹ̀ náà bẹ̀rẹ̀ ní gíga tí kò yípadà lókè ìlà àwọ̀n x, tí ó ń lọ sí ìsàlẹ̀ sí ìlà àwọ̀n x. Tí ó bá == 0, nígbà náà àwọ̀ ìyípadà kẹ̀rẹ̀kẹ̀rẹ̀ náà ń lọ láti òkè ìkún agbègbè sí ìlà àwọ̀n x."

#: include/global_form.php lib/rrd.php
msgid "Consolidation Function"
msgstr "Iṣẹ́ Ìṣọ̀kan"

#: include/global_form.php
msgid "How data for this item is represented statistically on the graph."
msgstr "Bí a ṣe ń ṣàfihàn dátà fún ohun yìí ní ti ìṣirò lórí àwòrán ìṣirò."

#: include/global_form.php
msgid "CDEF Function"
msgstr "Iṣẹ́ CDEF"

#: include/global_form.php
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "Iṣẹ́ CDEF (ìṣirò) láti lò fún ohun yìí lórí àwòrán ìṣirò tàbí àmì àlàyé."

#: include/global_form.php
msgid "VDEF Function"
msgstr "Iṣẹ́ VDEF"

#: include/global_form.php
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "Iṣẹ́ VDEF (ìṣirò) láti lò fún ohun yìí lórí àmì àlàyé àwòrán ìṣirò."

#: include/global_form.php
msgid "Shift Data"
msgstr "Sún Dátà"

#: include/global_form.php
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "Sún dátà rẹ lórí ìlà àwọ̀n àkókò (ìlà àwọ̀n x) pẹ̀lú iye tí a tọ́ka sí nínú ààyè 'value'."

#: include/global_form.php
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
msgstr "[HRULE|VRULE]: Iye ohun àwòrán ìṣirò náà.<br/> [TICK]: Ìdá fún ìlà àmì.<br/> [SHIFT]: Ìyàtọ̀ àkókò ní ìṣẹ́jú-àáyá."

#: include/global_form.php
msgid "GPRINT Type"
msgstr "Irú GPRINT"

#: include/global_form.php
msgid "If this graph item is a GPRINT, you can optionally choose another format here. You can define additional types under \"GPRINT Presets\"."
msgstr "Tí ohun àwòrán ìṣirò yìí bá jẹ́ GPRINT, o lè yan ìṣètò mìíràn níbí bí o bá fẹ́. O lè ṣàlàyé àwọn irú àfikún lábẹ́ \"Àwọn Ìtòtẹ́lẹ̀ GPRINT\"."

#: include/global_form.php
msgid "Text Alignment (TEXTALIGN)"
msgstr "Ìtòlẹ́sẹẹsẹ Ọ̀rọ̀ (TEXTALIGN)"

#: include/global_form.php
msgid "All subsequent legend line(s) will be aligned as given here.  You may use this command multiple times in a single graph.  This command does not produce tabular layout.<br/><strong>Note: </strong>You may want to insert a &lt;HR&gt; on the preceding graph item.<br/> <strong>Note: </strong>A &lt;HR&gt; on this legend line will obsolete this setting!"
msgstr "Gbogbo ìlà àmì àlàyé tí ó tẹ̀lé e ni a ó tò gẹ́gẹ́ bí a ṣe fúnni níbí.  O lè lo àṣẹ yìí ní ọ̀pọ̀ ìgbà nínú àwòrán ìṣirò kan ṣoṣo.  Àṣẹ yìí kì í ṣẹ̀dá ìṣètò tábìlì.<br/><strong>Àkíyèsí: </strong>O lè fẹ́ fi &lt;HR&gt; sí orí ohun àwòrán ìṣirò tí ó ṣáájú.<br/> <strong>Àkíyèsí: </strong>&lt;HR&gt; kan lórí ìlà àmì àlàyé yìí yóò sọ ìṣètò yìí di aláìlò!"

#: include/global_form.php
msgid "Text Format"
msgstr "Ìṣètò Ọ̀rọ̀"

#: include/global_form.php
msgid "Text that will be displayed on the legend for this graph item."
msgstr "Ọ̀rọ̀ tí yóò hàn lórí àmì àlàyé fún ohun àwòrán ìṣirò yìí."

#: include/global_form.php
msgid "Legend for Export/Hover"
msgstr "Àmì Àlàyé fún Ìgbéjáde/Ìfọwọ́kọjá"

#: include/global_form.php
msgid "A Legend to be displayed when Hovering over the Graph and also used for Graph Export.  Hover requires RRDtool 1.9.1 and above.  It may work for RRDtool 1.8+, but not for Thold Legends."
msgstr "Àmì Àlàyé tí yóò hàn nígbà tí a bá gbé kọ́sọ̀ sórí Àwòrán Ìṣirò tí a sì tún ń lò fún Ìgbéjáde Àwòrán Ìṣirò.  Ìfọwọ́kọjá nílò RRDtool 1.9.1 àti sókè.  Ó lè ṣiṣẹ́ fún RRDtool 1.8+, ṣùgbọ́n kì í ṣe fún Àwọn Àmì Àlàyé Thold."

#: include/global_form.php
msgid "Insert Hard Return"
msgstr "Fi Ìpadàbọ̀ Líle Sínú"

#: include/global_form.php
msgid "Forces the legend to the next line after this item."
msgstr "Fipá mú àmì àlàyé lọ sí ìlà tí ó tẹ̀lé lẹ́yìn ohun yìí."

#: include/global_form.php
msgid "Line Width (decimal)"
msgstr "Ìfẹ̀ Ìlà (désímà)"

#: include/global_form.php
msgid "In case LINE was chosen, specify width of line here.  You must include a decimal precision, for example 2.00"
msgstr "Tí a bá yan LINE, sọ ìfẹ̀ ìlà níbí. O gbọ́dọ̀ fi ìpínrọ̀ dẹ́símà sí i, fún àpẹẹrẹ 2.00"

#: include/global_form.php
msgid "Dashes (dashes[=on_s[,off_s[,on_s,off_s]...]])"
msgstr "Àwọn ìlà gígé (dashes[=on_s[,off_s[,on_s,off_s]...]])"

#: include/global_form.php
msgid "The dashes modifier enables dashed line style."
msgstr "Olùṣàtúnṣe dashes máa ń mú àrà ìlà gígé ṣiṣẹ́."

#: include/global_form.php
msgid "Dash Offset (dash-offset=offset)"
msgstr "Ìyàtọ̀ Ìbẹ̀rẹ̀ Ìlà Gígé (dash-offset=offset)"

#: include/global_form.php
msgid "The dash-offset parameter specifies an offset into the pattern at which the stroke begins."
msgstr "Pàrámítà dash-offset máa ń sọ ibi tí ìlà yóò ti bẹ̀rẹ̀ nínú àpẹẹrẹ rẹ̀."

#: include/global_form.php
msgid "The name given to this graph template."
msgstr "Orúkọ tí a fún àdàkọ àwòrán ìṣirò yìí."

#: include/global_form.php
msgid "The Class of this Graph Template."
msgstr "Ìpele Àdàkọ Àwòrán Ìṣirò yìí."

#: include/global_form.php
msgid "The Version given to this Graph Template."
msgstr "Ẹ̀dà tí a fún Àdàkọ Àwòrán Ìṣirò yìí."

#: include/global_form.php
msgid "Multiple Instances"
msgstr "Ọ̀pọ̀lọpọ̀ Àpẹẹrẹ"

#: include/global_form.php
msgid "Check this checkbox if there can be more than one Graph of this type per Device."
msgstr "Ṣàmì sí àpótí ìṣàmì yìí tí Àwòrán Ìṣirò irú yìí bá lè ju ẹyọ kan lọ fún Ẹ̀rọ kọ̀ọ̀kan."

#: include/global_form.php
msgid "Test Data Sources"
msgstr "Dán Àwọn Orísun Dátà Wò"

#: include/global_form.php
msgid "Check this checkbox if you wish to test the Data Sources prior to their creation.  With Test Data Sources enabled, if the Data Source does not return valid data, the Graph will not be created.  This setting is important if you wish to have a more generic Device Template that can include more Graph Templates that can be selectively applied depending on the characteristics of the Device itself.  Note: If you have a long running script as a Data Source, the time to create Graphs will be increased."
msgstr "Ṣàmì sí àpótí ìṣàmì yìí tí o bá fẹ́ dán Àwọn Orísun Dátà wò kí o tó dá wọn. Tí Dán Àwọn Orísun Dátà Wò bá wà ní ṣíṣẹ́, tí Orísun Dátà kò bá dá dátà tó péye padà, a kò ní dá Àwòrán Ìṣirò náà. Ètò yìí ṣe pàtàkì tí o bá fẹ́ ní Àdàkọ Ẹ̀rọ tó gbòòrò tó lè ní àwọn Àdàkọ Àwòrán Ìṣirò púpọ̀ sí i tí a lè yàn lò ní ìbámu pẹ̀lú àwọn ànímọ́ Ẹ̀rọ náà fúnra rẹ̀. Àkíyèsí: Tí o bá ní ìwé-àṣẹ́ tó ń ṣiṣẹ́ fún ìgbà pípẹ́ gẹ́gẹ́ bí Orísun Dátà, àkókò láti dá Àwọn Àwòrán Ìṣirò yóò pọ̀ sí i."

#: include/global_form.php
msgid "Enter a name for this graph item input, make sure it is something you recognize."
msgstr "Tẹ orúkọ kan fún àtẹ̀wọlé ohun àwòrán ìṣirò yìí, rí i dájú pé ó jẹ́ ohun tí o mọ̀."

#: include/global_form.php
msgid "Enter a description for this graph item input to describe what this input is used for."
msgstr "Tẹ àpèjúwe kan fún àtẹ̀wọlé ohun àwòrán ìṣirò yìí láti ṣàlàyé ohun tí a ń lo àtẹ̀wọlé yìí fún."

