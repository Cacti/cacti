msgstr "Àkọsílẹ̀ Ìwádìí Àṣìṣe Boost"

#: include/global_settings.php
msgid "If this field is non-blank, Boost will log RRDUpdate output from the boost\tpoller process."
msgstr "Tí ààyè yìí kò bá ṣófo, Boost yóò kọ àbájáde RRDUpdate láti inú ìlànà boost\tpoller sílẹ̀."

