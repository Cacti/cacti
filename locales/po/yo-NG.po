msgid "How will Cacti handle event logging."
msgstr "Báwo ni Cacti yóò ṣe ṣe àkọsílẹ̀ àwọn ìṣẹ̀lẹ̀."

#: include/global_settings.php
msgid "Log Actions"
msgstr "Àwọn Ìgbésẹ̀ Àkọsílẹ̀"

#: include/global_settings.php
msgid "What Log Actions do you wish to provide to the Cacti Administrator.  You can grant either purge, rotate, or both purge and rotate.  Base files can be both purged and rotated, and already rotated files can only be purged if you grant that permission."
msgstr "Àwọn Ìgbésẹ̀ Àkọsílẹ̀ wo ni o fẹ́ pèsè fún Alábòójútó Cacti. O lè fúnni ní àṣẹ ìparẹ́ pátápátá, ìyípadà lẹ́sẹẹsẹ, tàbí ìparẹ́ pátápátá àti ìyípadà lẹ́sẹẹsẹ méjèèjì. A lè pa àwọn fáìlì ìpìlẹ̀ rẹ́ pátápátá kí a sì yí wọn padà, ṣùgbọ́n àwọn fáìlì tí a ti yí padà tẹ́lẹ̀ ni a lè pa rẹ́ pátápátá nìkan tí o bá fúnni ní àṣẹ náà."

#: include/global_settings.php
msgid "Generic Log Level"
msgstr "Ìpele Àkọsílẹ̀ Àpapọ̀"

#: include/global_settings.php
msgid "What level of detail do you want sent to the log file.  WARNING: Leaving in any other status than NONE or LOW can exhaust your disk space rapidly."
msgstr "Ìpele ẹ̀kúnrẹ́rẹ́ wo ni o fẹ́ ránṣẹ́ sí fáìlì àkọsílẹ̀. ÌKÌLỌ̀: Fífisílẹ̀ ní ipò mìíràn yàtọ̀ sí NONE tàbí LOW lè tán ààyè díìsìkì rẹ kíákíá."

#: include/global_settings.php
msgid "Expand log details"
msgstr "Fẹ àwọn ẹ̀kúnrẹ́rẹ́ àkọsílẹ̀"

#: include/global_settings.php
msgid "What level of expansion do you want on the log file? Increase expansion can slow search results"
msgstr "Ìpele ìfẹ̀sí wo ni o fẹ́ lórí fáìlì àkọsílẹ̀? Ìfẹ̀sí tí ó pọ̀ sí i lè fa ìfàsẹ́yìn àwọn èsì àwárí"

#: include/global_settings.php
msgid "Log Input Validation Issues"
msgstr "Kọ Àwọn Ìṣòro Ìfọwọ́sí Àbáwọlé sí Àkọsílẹ̀"

#: include/global_settings.php
msgid "Record when request fields are accessed without going through proper input validation"
msgstr "Ṣe àkọsílẹ̀ nígbà tí a bá wọ àwọn pápá ìbéèrè láì gba inú ìfọwọ́sí àbáwọlé tí ó yẹ kọjá"

#: include/global_settings.php
msgid "Data Source Tracing"
msgstr "Ìtọ́pinpin Orísun Dátà"

#: include/global_settings.php
msgid "A developer only option to trace the creation of Data Sources mainly around checks for uniqueness"
msgstr "Àṣàyàn fún olùgbéjáde nìkan láti tọ́pinpin ìṣẹ̀dá àwọn Orísun Dátà pàápàá nípa àyẹ̀wò ìyàtọ̀ ọ̀tọ̀ọ̀tọ̀"

#: include/global_settings.php
msgid "Log Ignored General Errors"
msgstr "Kọ Àwọn Àṣìṣe Àpapọ̀ Tí A Fojú Fò sí Àkọsílẹ̀"

#: include/global_settings.php
msgid "Cacti will mask certain errors that are often times considered fatal and that would otherwise disable plugins and additionally confuse some users.  If you wish to see these errors instead, check the checkbox."
msgstr "Cacti yóò bo àwọn àṣìṣe kan mọ́lẹ̀ tí a sábà máa ń kà sí àṣìṣe líle tí yóò sì mú àwọn afikún-unṣẹ́ ṣiṣẹ́ kúrò tí yóò sì tún da àwọn olùmúlò kan láàmú. Tí o bá fẹ́ rí àwọn àṣìṣe wọ̀nyí dípò rẹ̀, fi àmì sí àpótí àyẹ̀wò náà."

#: include/global_settings.php
msgid "Selective File Debug"
msgstr "Àṣàtúnṣe Àṣìṣe Fáìlì Àṣàyàn"

#: include/global_settings.php
msgid "Select which files you wish to place in Debug mode regardless of the Generic Log Level setting.  Any files selected will be treated as they are in Debug mode."
msgstr "Yan àwọn fáìlì tí o fẹ́ fi sí ipò Debug láìka ètò Ìpele Àkọsílẹ̀ Àpapọ̀ sí. Èyíkéyìí fáìlì tí a bá yan ni a óò lò bí ẹni pé ó wà ní ipò Debug."

#: include/global_settings.php
msgid "Select File(s)"
msgstr "Yan (Àwọn) Fáìlì"

#: include/global_settings.php
msgid "Files Selected"
msgstr "Àwọn Fáìlì Tí A Yan"

#: include/global_settings.php
msgid "Selective Plugin Debug"
msgstr "Àṣàtúnṣe Àṣìṣe Afikún-unṣẹ́ Àṣàyàn"

#: include/global_settings.php
msgid "Select which Plugins you wish to place in Debug mode regardless of the Generic Log Level setting.  Any files used by this plugin will be treated as they are in Debug mode."
msgstr "Yan àwọn Afikún-unṣẹ́ tí o fẹ́ fi sí ipò Debug láìka ètò Ìpele Àkọsílẹ̀ Àpapọ̀ sí. Èyíkéyìí fáìlì tí afikún-unṣẹ́ yìí bá ń lò ni a óò lò bí ẹni pé ó wà ní ipò Debug."

#: include/global_settings.php
msgid "Select Plugin(s)"
msgstr "Yan (Àwọn) Afikún-unṣẹ́"

#: include/global_settings.php
msgid "Plugins Selected"
msgstr "Àwọn Afikún-unṣẹ́ Tí A Yan"

#: include/global_settings.php
msgid "Selective Device Debug"
msgstr "Àṣàtúnṣe Àṣìṣe Ẹ̀rọ Àṣàyàn"

#: include/global_settings.php
msgid "A comma delimited list of Device ID's that you wish to be in Debug mode during data collection.  This Debug level is only in place during the Cacti polling process."
msgstr "Àtòjọ àwọn ID Ẹ̀rọ tí a fi kọ́mà pín tí o fẹ́ kí wọ́n wà ní ipò Debug nígbà ìkójọpọ̀ dátà. Ìpele Debug yìí wà nípò nígbà ìlànà ìbèrè dátà Cacti nìkan."

#: include/global_settings.php
msgid "Syslog/Eventlog Item Selection"
msgstr "Ìyàn Ohun Syslog/Eventlog"

#: include/global_settings.php
msgid "When using Syslog/Eventlog for logging, the Cacti log messages that will be forwarded to the Syslog/Eventlog."
msgstr "Nígbà tí o bá ń lo Syslog/Eventlog fún àkọsílẹ̀, àwọn ìránṣẹ́ àkọsílẹ̀ Cacti tí a óò ránṣẹ́ sí Syslog/Eventlog."

#: include/global_settings.php
msgid "Statistics"
msgstr "Àwọn Àkójọpọ̀ Ìṣirò"

#: include/global_settings.php lib/clog_webapi.php
msgid "Warnings"
msgstr "Àwọn Ìkìlọ̀"

#: include/global_settings.php
msgid "Log Rotation"
msgstr "Ìyípadà Àkọsílẹ̀ Lẹ́sẹẹsẹ"

#: include/global_settings.php lib/clog_webapi.php
msgid "Rotate the Cacti Log"
msgstr "Yí Àkọsílẹ̀ Cacti Padà Lẹ́sẹẹsẹ"

#: include/global_settings.php
msgid "This option will rotate the Cacti Log periodically."
msgstr "Àṣàyàn yìí yóò máa yí Àkọsílẹ̀ Cacti padà lẹ́sẹẹsẹ lóòrèkóòrè."

#: include/global_settings.php
msgid "Rotation Frequency"
msgstr "Ìgbàgbà Ìyípadà Lẹ́sẹẹsẹ"

#: include/global_settings.php
msgid "At what frequency would you like to rotate your logs?"
msgstr "Ìgbàgbà wo ni o fẹ́ láti máa yí àwọn àkọsílẹ̀ rẹ padà lẹ́sẹẹsẹ?"

#: include/global_settings.php
msgid "Log Retention"
msgstr "Ìpamọ́ Àkọsílẹ̀"

#: include/global_settings.php
msgid "How many log files do you wish to retain?  Use 0 to never remove any logs. (0-365)"
msgstr "Àwọn fáìlì àkọsílẹ̀ mélòó ni o fẹ́ fi pamọ́? Lo 0 láti má ṣe yọ àkọsílẹ̀ kankan kúrò láéláé. (0-365)"

#: include/global_settings.php
msgid "Internationalization (i18n)"
msgstr "Ìṣàkóso Èdè Àgbáyé (i18n)"

#: include/global_settings.php
msgid "Language Support"
msgstr "Àtìlẹ́yìn Èdè"

#: include/global_settings.php
msgid "Choose 'enabled' to allow the localization of Cacti. The strict mode requires that the requested language will also be supported by all plugins being installed at your system. If that's not the fact everything will be displayed in English."
msgstr "Yan 'enabled' láti fàyè gba ìyípadà èdè ìbílẹ̀ ti Cacti. Ipò mímú gbọdọ̀ rí i dájú pé gbogbo àwọn afikún-unṣẹ́ tí a fi sí orí ètò rẹ tún ṣe àtìlẹ́yìn fún èdè tí a béèrè. Bí èyí kò bá rí bẹ́ẹ̀, gbogbo nǹkan ni a óò fi hàn ní èdè Gẹ̀ẹ́sì."

#: include/global_settings.php
msgid "Language"
msgstr "Èdè"

#: include/global_settings.php
msgid "Default language for this system."
msgstr "Èdè àìyípadà fún ètò yìí."

#: include/global_settings.php
msgid "Auto Language Detection"
