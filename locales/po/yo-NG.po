msgid "FATAL: You must specify either 'stddev', 'variance', 'float', or 'fill' as methods."
msgstr "PÀJÁWÌRÌ: O gbọ́dọ̀ sọ ọ̀kan lára 'stddev', 'variance', 'float', tàbí 'fill' gẹ́gẹ́ bí ọ̀nà."

#: lib/spikekill.php
msgid "FATAL: The outlier-start and outlier-end arguments must be in the format of YYYY-MM-DD HH:MM or a unix timestamp."
msgstr "PÀJÁWÌRÌ: Àwọn àríyànjiyàn outlier-start àti outlier-end gbọ́dọ̀ wà ní ìrísí YYYY-MM-DD HH:MM tàbí àkókò unix."

#: lib/spikekill.php
msgid "FATAL: The number of outliers to exclude must be a positive integer."
msgstr "PÀJÁWÌRÌ: Iye àwọn ìyọkúrò tó yàtọ̀ gbọ́dọ̀ jẹ́ nọ́ńbà odidi tó pọ̀ ju odo lọ."

#: lib/spikekill.php
msgid "FATAL: Percent deviation must be a positive floating point number."
msgstr "PÀJÁWÌRÌ: Ìyàtọ̀ ìdá ọgọ́rùn-ún gbọ́dọ̀ jẹ́ nọ́ńbà oní-àkọsílẹ̀ tó pọ̀ ju odo lọ."

#: lib/spikekill.php
msgid "FATAL: Number of spikes to remove must be a positive integer"
msgstr "ÀṢÌṢE PÀTÀKÌ: Iye àwọn ìgòkè láti yọ kúrò gbọ́dọ̀ jẹ́ nọ́ńbà odidi tí ó ju odo lọ"

#: lib/spikekill.php
