#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "Ìṣètò ìfiwéra àkọ́kọ́ tí sáfà ń lò nígbà tí ó bá ń ṣẹ̀dá àwọn ibùdó-dátà àti àwọn tábìlì."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "fún àpẹẹrẹ utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Àkójọ àwọn lẹ́tà àkọ́kọ́ tí sáfà ń lò."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "fún àpẹẹrẹ utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Àkójọ àwọn lẹ́tà tí kláyẹ́ǹtì ń lò nígbà tí ó bá ń fi àwọn àṣẹ ránṣẹ́ sí sáfà."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Iye gíga jùlọ ti àwọn ìsopọ̀ kláyẹ́ǹtì lẹ́ẹ̀kan náà tí a gbà láyè."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Nọ́ńbà odidi; àkọ́kọ́ ni 151. Fi àyè tó pọ̀ tó sílẹ̀ fún àwọn olùṣèwádìí àti ìwọlé àwọn olùlò."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Orúkọ àtijọ́ fún àpamọ́ tábìlì ṣíṣí; a yí i padà sí table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Nọ́ńbà odidi. Lo table_open_cache lórí àwọn sẹ́fà òde òní."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Ìwọ̀n tó ga jù lọ fún páàkẹ́ẹ̀tì kan tàbí okùn ọ̀rọ̀ èyíkéyìí tí a ṣẹ̀dá tàbí ti àárín."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Báìtì; jẹ́ kó wà ní tàbí kó ju 16M lọ fún àwọn olùṣèwádìí òkèèrè."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Ìwọ̀n tó ga jù lọ tí àwọn tábìlì MEMORY tí olùlò ṣẹ̀dá lè dàgbà dé."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Báìtì; a fi ìwọ̀n rẹ̀ wé àpapọ̀ ìrántí ètò náà."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Ìwọ̀n tó ga jù lọ fún àwọn tábìlì ìgbà díẹ̀ inú ìrántí kí wọ́n tó dà sí orí díìsìkì."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Báìtì; iye tó pọ̀ sí i máa ń pa àwọn tábìlì ìgbà díẹ̀ mọ́ sínú ìrántí."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Ìwọ̀n bọ́fà tó kéré jù lọ fún ìdàpọ̀ kọ̀ọ̀kan fún àwọn ìdàpọ̀ tí kò lo àtọ́ka."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Báìtì; ìpín fún ìsopọ̀ kọ̀ọ̀kan, àìyípadà 262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "Bọ́fà fún ìgbà ìṣe kọ̀ọ̀kan tí a pín fún títò (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Báìtì; ìpín fún ìsopọ̀ kọ̀ọ̀kan, àìyípadà 2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Fi tábìlì InnoDB kọ̀ọ̀kan àti àwọn àtọ́ka rẹ̀ pamọ́ sínú fáìlì ààyè tábìlì .ibd tirẹ̀."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON tàbí OFF; a gbani nímọ̀ràn ON."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "Ìṣètò fáìlì InnoDB lórí díìsìkì (Antelope tàbí Barracuda); Barracuda nìkan ni ìṣètò tó wà báyìí."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Gba àwọn ìṣáájú kọ́kọ́rọ́ àtọ́ka tó gùn ju 767 báìtì lọ láàyè (ó nílò ìṣètò Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 tàbí OFF/0; ìwà yìí ti wà ní ṣíṣiṣẹ́ nígbà gbogbo báyìí."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Àpapọ̀ ìrántí tí InnoDB ń lò láti fi détà tábìlì àti àtọ́ka pamọ́ sí àpamọ́."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Báìtì; lọ́pọ̀ ìgbà 25%-80% àpapọ̀ ìrántí ètò náà."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Kọ àwọn ojú-ìwé ní ìgbà méjì (bọ́fà doublewrite) láti dáàbò bò ó lọ́wọ́ kíkọ ojú-ìwé àìpé."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON tàbí OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "Àdágún àtijọ́ fún ìwé-àtúmọ̀ détà àti ìṣètò inú InnoDB."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Báìtì; kò wúlò mọ́ lórí àwọn sẹ́fà òde òní."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Ìṣẹ́jú-àáyá tí ìṣẹ̀ṣe InnoDB kan fi ń dúró de ìtìpa ìlà kan kí ó tó jáwọ́."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Ìṣẹ́jú-àáyá; àìyípadà 50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Ọ̀nà tí a lò láti fọ détà àti àwọn fáìlì àkọsílẹ̀ sí orí díìsìkì."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC, àti irú wọn."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Ń ṣàkóso bí a ṣe ń kọ àti bí a ṣe ń fọ àkọsílẹ̀ àtúnṣe nígbà ìparí ìṣẹ̀ṣe."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1, tàbí 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Ètò kan ṣoṣo àtijọ́ fún àwọn okùn I/O fáìlì InnoDB, tí a fi àwọn ètò okùn I/O kíkà/kíkọ rọ́pò rẹ̀."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Nọ́ńbà odidi; innodb_read_io_threads àti innodb_write_io_threads ti rọ́pò rẹ̀."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Kọ kí o sì fọ àkọsílẹ̀ àtúnṣe InnoDB ní gbogbo ìṣẹ́jú-àáyá N."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Ìṣẹ́jú-àáyá (1-2700); àìyípadà 1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Iye àwọn okùn I/O tí a lò fún àwọn iṣẹ́ kíkà nínú InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; àìyípadà 4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Iye àwọn okùn I/O tí a lò fún àwọn iṣẹ́ kíkọ nínú InnoDB."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Iye àwọn agbègbè tí a pín àdágún bọ́fà InnoDB sí."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; MariaDB yọ èyí kúrò ní 10.6."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Ìṣirò iṣẹ́ I/O fún ìṣẹ́jú-àáyá kan tó wà fún àwọn iṣẹ́ ẹ̀yìn InnoDB."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Nọ́ńbà odidi; lo àwọn iye tó ga sí i fún ìpamọ́ SSD/NVMe."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "IOPS tó ga jù lọ tí InnoDB lè lò nígbà tí fífọ bá sẹ́yìn."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Fọ àwọn ojú-ìwé ẹ̀gbẹ́ tó dọ̀tí nínú ààyè kan náà nígbà tí o bá ń fọ ojú-ìwé kan."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1, tàbí 2; lo 0 lórí ìpamọ́ SSD."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Lo kíkọ àtọ́míìkì ohun-èlò (MariaDB) kí a lè pa bọ́fà doublewrite láìléwu."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON tàbí OFF; MariaDB nìkan."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
