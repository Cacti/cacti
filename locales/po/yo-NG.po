msgstr "Ọ̀rọ̀-ìgbaniwọlé Àṣírí SNMP v3 àìyípadà fún gbogbo Àwọn Ẹ̀rọ tuntun."

#: include/global_settings.php
msgid "Enter the SNMP v3 Context for all new Devices."
msgstr "Tẹ Àkóónú (Context) SNMP v3 fún gbogbo Àwọn Ẹ̀rọ tuntun."

#: include/global_settings.php
msgid "Default SNMP v3 Engine Id for all new Devices. Leave this field empty to use the SNMP Engine ID being defined per SNMPv3 Notification receiver."
msgstr "ID Ẹ̀rọ (Engine Id) SNMP v3 àìyípadà fún gbogbo Àwọn Ẹ̀rọ tuntun. Fi ààyè yìí sí òfo láti lo SNMP Engine ID tí a ṣàlàyé fún olùgbà Ìfitónilétí SNMPv3 kọ̀ọ̀kan."

#: include/global_settings.php
msgid "Port Number"
msgstr "Nọ́ńbà Pọ́ọ̀tì"

#: include/global_settings.php
msgid "Default UDP Port for all new Devices.  Typically 161."
msgstr "Pọ́ọ̀tì UDP àìyípadà fún gbogbo Àwọn Ẹ̀rọ tuntun. Lọ́pọ̀ ìgbà 161."

#: include/global_settings.php
msgid "Default SNMP timeout in milli-seconds for all new Devices."
msgstr "Àkókò ìdádúró SNMP àìyípadà ní ìṣẹ́jú-àáyá ẹlẹ́ẹ̀gbẹ̀rún (milliseconds) fún gbogbo Àwọn Ẹ̀rọ tuntun."

#: include/global_settings.php
msgid "must be a positive integer (milliseconds)."
msgstr "gbọ́dọ̀ jẹ́ nọ́ńbà odidi rere (ìṣẹ́jú-àáyá ẹlẹ́ẹ̀gbẹ̀rún)."

#: include/global_settings.php
msgid "must be between {{ min }} and {{ max }}."
msgstr "gbọ́dọ̀ wà láàárín {{ min }} àti {{ max }}."

#: include/global_settings.php
msgid "Default SNMP retries for all new Devices."
msgstr "Àwọn ìgbìyànjú SNMP àìyípadà fún gbogbo Àwọn Ẹ̀rọ tuntun."

#: include/global_settings.php
msgid "must be a non-negative integer."
msgstr "gbọ́dọ̀ jẹ́ nọ́ńbà odidi tí kì í ṣe òdì."

#: include/global_settings.php
msgid "SNMP Behavior"
msgstr "Ìhùwàsí SNMP"

#: include/global_settings.php
msgid "SNMP Agent Support Enabled"
msgstr "Àtìlẹ́yìn Aṣojú SNMP Ti Ṣiṣẹ́"

#: include/global_settings.php
msgid "If this option is checked, Cacti will populate SNMP Agent tables with Cacti device and system information.  It does not enable the SNMP Agent itself."
msgstr "Bí a bá ṣàmì sí àṣàyàn yìí, Cacti yóò fi àwọn ìwífún nípa ẹ̀rọ àti ètò Cacti kún àwọn tábìlì Aṣojú SNMP. Kò mú Aṣojú SNMP fúnra rẹ̀ ṣiṣẹ́."

#: include/global_settings.php
msgid "Enable MD5 and DES for SNMPv3"
msgstr "Mú MD5 àti DES ṣiṣẹ́ fún SNMPv3"

#: include/global_settings.php
msgid "The MD5 authentication and DES privacy algorithms are legacy, weak, and unavailable on hardened (FIPS) PHP and Net-SNMP builds.  When disabled, MD5 and DES are removed from the SNMPv3 Authentication and Privacy Protocol dropdowns shown when editing a Device and in the Automation SNMP Options, leaving only the stronger SHA and AES algorithms."
msgstr "Àwọn algoridimu ìjẹ́rìísí MD5 àti àṣírí DES jẹ́ ti àtijọ́, aláìlágbára, wọn kò sì sí lórí àwọn ìkọ́lé PHP àti Net-SNMP tí a fún lágbára (FIPS). Nígbà tí a bá pa á, MD5 àti DES yóò kúrò nínú àwọn àṣàyàn Ìlànà Ìjẹ́rìísí àti Àṣírí SNMPv3 tí a ń fi hàn nígbà tí a bá ń ṣàtúnṣe Ẹ̀rọ àti nínú Àwọn Àṣàyàn SNMP Automation, tí yóò fi àwọn algoridimu SHA àti AES tó lágbára jù nìkan sílẹ̀."

#: include/global_settings.php
msgid "Enable Credential Cache"
msgstr "Mú Àpamọ́ Ìwé-ẹ̀rí (Credential Cache) Ṣiṣẹ́"

#: include/global_settings.php
msgid "Pre-harden and cache SNMPv3 credential arguments once per credential change so each poller process reuses them instead of rebuilding them on every request.  This yields a marginal savings when collecting with SNMPv3 credentials through the Net-SNMP binaries.  The php-snmp extension handles most SNMPv3 gets in-process and bypasses this cache, but the Net-SNMP binaries (and therefore this cache) are still used for SNMP walks, hex output, requests that set a context or engine id, and protocol combinations that the running PHP version does not support.  Enable this if you collect any of those workloads with SNMPv3 credentials."
msgstr "Ṣètò tẹ́lẹ̀ kí o sì fi àwọn àríyànjiyàn ìwé-ẹ̀rí SNMPv3 pamọ́ sínú àpamọ́ (cache) lẹ́ẹ̀kan fún ìyípadà ìwé-ẹ̀rí kọ̀ọ̀kan kí ìlànà olùkójọpọ̀ kọ̀ọ̀kan lè tún un lò dípò kí ó tún un kọ́ lórí ìbéèrè kọ̀ọ̀kan. Èyí ń fúnni ní ìfowópamọ́ díẹ̀ nígbà tí a bá ń kó dátà jọ pẹ̀lú àwọn ìwé-ẹ̀rí SNMPv3 nípasẹ̀ àwọn fáìlì Net-SNMP. Àfikún php-snmp ń ṣàkóso ọ̀pọ̀lọpọ̀ ìbéèrè get ti SNMPv3 nínú ìlànà rẹ̀ ó sì ń fo àpamọ́ yìí kọjá, ṣùgbọ́n àwọn fáìlì Net-SNMP (àti nítorí náà àpamọ́ yìí) ṣì ń ṣiṣẹ́ fún àwọn ìrìn SNMP (walks), àbájáde hex, àwọn ìbéèrè tí ó ń ṣètò àkóónú (context) tàbí engine id, àti àwọn àkópọ̀ ìlànà tí ẹ̀yà PHP tó ń ṣiṣẹ́ kò ṣe àtìlẹ́yìn fún. Mú èyí ṣiṣẹ́ bí o bá ń kó èyíkéyìí nínú àwọn iṣẹ́ wọ̀nyẹn jọ pẹ̀lú àwọn ìwé-ẹ̀rí SNMPv3."

#: include/global_settings.php
msgid "Max OID Limit"
msgstr "Ìwọ̀n OID Tó Pọ̀ Jùlọ"

#: include/global_settings.php
msgid "The default maximum number of SNMP Get OIDs to issue per snmpget request.  For Devices, this setting is controlled at the Device level.  You should only use this setting when using Cacti's SNMP API natively in your scripts or plugins."
msgstr "Iye tó pọ̀ jùlọ àìyípadà ti Àwọn OID SNMP Get láti fi ránṣẹ́ fún ìbéèrè snmpget kọ̀ọ̀kan. Fún Àwọn Ẹ̀rọ, a ń ṣàkóso ètò yìí ní ìpele Ẹ̀rọ. O gbọ́dọ̀ lo ètò yìí nìkan nígbà tí o bá ń lo SNMP API ti Cacti ní tààrà nínú àwọn ìwé-àṣẹ̀ (scripts) tàbí àwọn àfikún (plugins) rẹ."

