msgid "Axis Font Setting"
msgstr "Ètò Fọ́ntì Ìlà-ìwọ̀n"

#: include/global_settings.php
msgid "The font to use for Graph Axis items.  Enter either a valid True Type Font file or valid Pango font-config value."
msgstr "Fọ́ntì láti lò fún àwọn ohun Ìlà-ìwọ̀n Àwòrán.  Tẹ fáìlì True Type Font tó tọ́ tàbí iye Pango font-config tó tọ́ sílẹ̀."

#: include/global_settings.php
msgid "Unit Font Size"
msgstr "Ìwọ̀n Fọ́ntì Ẹyọ-ìwọ̀n"

#: include/global_settings.php
