#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Saitin haruffa da abokin ciniki (client) ke amfani da shi lokacin aika umarni zuwa sabar."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Matsakaicin adadin haɗin abokan ciniki a lokaci guda da aka yarda da su."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Cikakkiyar lamba; na asali 151. A bar isasshe don masu tattara bayanai (pollers) da shigar masu amfani."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Tsohon suna na ma'ajiyar teburin da aka buɗe; an sauya masa suna zuwa table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Cikakkiyar lamba. Yi amfani da table_open_cache a sabobin zamani."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Mafi girman girman fakiti ɗaya ko kowane jerin haruffa da aka samar/na tsakiya."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Baiti; a riƙe a 16M ko sama da haka don masu tattara bayanai na nesa."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Mafi girman adadin da teburan MEMORY da mai amfani ya ƙirƙira za su iya kaiwa."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Baiti; ana auna girmansa dangane da jimlar ƙwaƙwalwar na'ura."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Mafi girman adadin teburan wucin-gadi na cikin ƙwaƙwalwa kafin su zube zuwa faifai."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Baiti; ƙima mafi girma tana riƙe teburan wucin-gadi a cikin ƙwaƙwalwa."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Mafi ƙarancin girman ma'ajiyar wucin-gadi ga kowane haɗi don haɗin da ba sa amfani da fihirisa."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Baiti; rabon kowane haɗi, na asali 262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "Ma'ajiyar wucin-gadi ta kowane zama da aka ware don jerawa (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Baiti; rabon kowane haɗi, na asali 2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Ajiye kowane teburin InnoDB da fihirisarsa a cikin nasa fayil ɗin sararin teburi na .ibd."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON ko OFF; ana ba da shawarar ON."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "Tsarin fayil na InnoDB a kan faifai (Antelope ko Barracuda); Barracuda ne kawai tsarin a yanzu."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Ba da damar maɓallan gaban fihirisa da suka fi baiti 767 tsawo (yana buƙatar tsarin Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 ko OFF/0; wannan ɗabi'ar a kunne take a koyaushe a yanzu."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Jimlar ƙwaƙwalwar da InnoDB ke amfani da ita don adana bayanan teburi da fihirisa."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Baiti; yawanci 25%-80% na jimlar ƙwaƙwalwar na'ura."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Rubuta shafuka sau biyu (ma'ajiyar doublewrite) don karewa daga rubutun shafi mara cika."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON ko OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "Tsohon rumbun ajiya don ƙamus na bayanan cikin gida na InnoDB da tsare-tsare."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Baiti; an daina amfani da shi a sabobin zamani."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Daƙiƙu da mu'amalar InnoDB ke jira don kullewar layi kafin ta haƙura."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Daƙiƙu; na asali 50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Hanyar da ake amfani da ita don tura bayanai da fayilolin rajista zuwa faifai."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC, da makamantansu."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Yana sarrafa yadda ake rubuta rajistar sake-yi da tura ta zuwa faifai lokacin tabbatar da mu'amala."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1, ko 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Tsohon saiti guda ɗaya don zaren I/O na fayilolin InnoDB, an maye gurbinsa da saitunan zaren I/O na karatu/rubutu."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Cikakkiyar lamba; innodb_read_io_threads da innodb_write_io_threads sun maye gurbinsa."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Rubuta kuma tura rajistar sake-yi ta InnoDB zuwa faifai a kowane daƙiƙa N."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Daƙiƙu (1-2700); na asali 1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Adadin zaren I/O da ake amfani da su don ayyukan karatu a cikin InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; na asali 4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Adadin zaren I/O da ake amfani da su don ayyukan rubutu a cikin InnoDB."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Adadin yankunan da aka raba rumbun ma'ajiyar InnoDB zuwa gare su."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; MariaDB ta cire wannan a 10.6."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Ƙiyasin ayyukan I/O a kowace daƙiƙa da ke samuwa don ayyukan baya na InnoDB."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Cikakkiyar lamba; yi amfani da ƙimomi masu girma don ma'ajiyar SSD/NVMe."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "Mafi girman IOPS da InnoDB za ta iya amfani da shi lokacin da tura bayanai ya koma baya."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Tura shafuka masu datti da ke maƙwabtaka a cikin yanki guda lokacin da ake tura shafi."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1, ko 2; yi amfani da 0 a kan ma'ajiyar SSD."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Yi amfani da rubutun atomic na kayan aiki (MariaDB) don a iya kashe ma'ajiyar doublewrite cikin aminci."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON ko OFF; MariaDB kawai."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "Tilasta tsauraran keɓewar hoto don mu'amalolin InnoDB."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON ko OFF; an dawo da shi zuwa MariaDB 10.6.18+, 10.11.8+ da 11.4.2+. Saita OFF don mai tattara bayanai na Cacti."

#: lib/utility.php
msgid "Removed"
msgstr "An cire"

#: lib/utility.php
msgid "Deprecated"
msgstr "An daina amfani da shi"

#: lib/utility.php
msgid "Not applicable to this engine"
msgstr "Ba ya aiki a kan wannan injin"

#: lib/utility.php
msgid "Supported"
msgstr "Ana goyon baya"

#: lib/utility.php
#, php-format
msgid "%s Variable Capability Matrix"
msgstr "Jadawalin Iyawa na Canjin %s"

#: lib/utility.php
msgid "Support by engine and version for each Cacti-recommended variable"
msgstr "Goyon baya ta inji da sigar kowane canji da Cacti ke ba da shawara"

#: lib/utility.php
msgid "Variable"
msgstr "Canji"

#: lib/utility.php
msgid "Available settings:"
msgstr "Saitunan da ke akwai:"

#: lib/utility.php
msgid "N/A - Not applicable to this engine"
msgstr "N/A - Ba ya aiki a kan wannan injin"

#: lib/utility.php
msgid "MariaDB 10.5+ and MySQL 8.0+ are the recommended, supported releases (for example, the default database streams on Rocky Linux 9). Make sure you run the very latest release though which fixes a long standing low level networking issue that was causing spine many issues with reliability."
msgstr "MariaDB 10.5+ da MySQL 8.0+ su ne nau'ikan da aka ba da shawarar amfani da su kuma ake tallafa wa (misali, tsoffin hanyoyin rumbun adana bayanai akan Rocky Linux 9). Ku tabbata kun yi amfani da sabon fitowar baya-bayan nan domin tana gyara wata tsohuwar matsalar hanyar sadarwa ta ƙasa da ta daɗe tana jawo wa Spine matsaloli da yawa game da dogaro."

#: lib/utility.php
#, php-format
msgid "It is STRONGLY recommended that you enable InnoDB in any %s version greater than 5.5.3."
msgstr "Ana ba da shawara SOSAI cewa ka kunna InnoDB a kowace sigar %s da ta fi 5.5.3."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4_unicode_ci collation type as some characters take more than a single byte."
msgstr "Lokacin amfani da Cacti da harsunan da ba Turanci ba, yana da muhimmanci a yi amfani da nau'in haɗin haruffa na utf8mb4_unicode_ci domin wasu haruffa suna ɗaukar fiye da baiti ɗaya."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4 character set as some characters take more than a single byte."
msgstr "Lokacin amfani da Cacti da harsunan da ba Turanci ba, yana da muhimmanci a yi amfani da tsarin haruffa na utf8mb4 domin wasu haruffa suna ɗaukar fiye da baiti ɗaya."

#: lib/utility.php
#, php-format
msgid "It is recommended that you enable InnoDB in any %s version greater than 5.1."
msgstr "Ana ba da shawara ka kunna InnoDB a kowace sigar %s da ta fi 5.1."

#: lib/utility.php
#, php-format
msgid "Depending on the number of logins and use of spine data collector, %s will need many connections.  The calculation for spine is: total_connections = total_processes * (total_threads + script_servers + 1), then you must leave headroom for user connections, which will change depending on the number of concurrent login accounts."
msgstr "Dangane da adadin shiga da amfani da mai tattara bayanai na spine, %s zai buƙaci haɗe-haɗe da yawa. Lissafin spine shi ne: total_connections = total_processes * (total_threads + script_servers + 1), sannan dole ne ka bar sarari don haɗe-haɗen masu amfani, wanda zai canza dangane da adadin asusun shiga a lokaci guda."

#: lib/utility.php
msgid "Keeping the table cache larger means less file open/close operations when using innodb_file_per_table."
msgstr "Ajiye ma'ajiyar teburi da girma yana nufin ƙarancin ayyukan buɗe/rufe fayil lokacin amfani da innodb_file_per_table."

#: lib/utility.php
msgid "With Remote polling capabilities, large amounts of data will be synced from the main server to the remote pollers.  Therefore, keep this value at or above 16M."
msgstr "Tare da ikon tattara bayanai na nesa, za a daidaita ɗimbin bayanai daga babbar uwar garke zuwa masu tattara bayanai na nesa. Saboda haka, a riƙe wannan ƙimar a 16M ko sama da haka."

#: lib/utility.php
#, php-format
msgid "If using the Cacti Performance Booster and choosing a memory storage engine, you have to be careful to flush your Performance Booster buffer before the system runs out of memory table space.  This is done two ways, first reducing the size of your output column to just the right size.  This column is in the tables poller_output, and poller_output_boost.  The second thing you can do is allocate more memory to memory tables.  We have arbitrarily chosen a recommended value of 10%% of system memory, but if you are using SSD disk drives, or have a smaller system, you may ignore this recommendation or choose a different storage engine.  You may see the expected consumption of the Performance Booster tables under Console -> System Utilities -> View Boost Status."
msgstr "Idan ana amfani da Cacti Performance Booster kuma aka zaɓi injin ajiya na ƙwaƙwalwa (memory storage engine), dole ne a kula wajen kwashe ma'ajiyar wucin gadi (buffer) ta Performance Booster kafin tsarin ya ƙare da sararin tebur na ƙwaƙwalwa. Ana yin wannan ta hanyoyi biyu: na farko, rage girman shafin fitarwa (output column) zuwa daidai girman da ake buƙata kawai. Wannan shafi yana cikin teburan poller_output da poller_output_boost. Abu na biyu da za ku iya yi shi ne ware ƙarin ƙwaƙwalwa ga teburan ƙwaƙwalwa. Mun zaɓi ƙimar da aka ba da shawara ba tare da ƙayyadadden dalili ba ta 10%% na ƙwaƙwalwar tsarin, amma idan kuna amfani da faifan SSD, ko kuna da ƙaramin tsari, za ku iya yin watsi da wannan shawara ko ku zaɓi wani injin ajiya na daban. Za ku iya ganin yawan amfanin da ake tsammani na teburan Performance Booster a ƙarƙashin Console -> System Utilities -> View Boost Status."

#: lib/utility.php
msgid "When executing subqueries, having a larger temporary table size, keep those temporary tables in memory."
msgstr "Lokacin aiwatar da ƙananan tambayoyin bayanai (subqueries), samun babban girman teburin wucin gadi yana riƙe waɗannan teburan wucin gadi a cikin ƙwaƙwalwa."

#: lib/utility.php
msgid "When performing joins, if they are below this size, they will be kept in memory and never written to a temporary file.  As this is a per connection memory allocation, care must be taken not to increase it too high.  The sum of the join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + Core MySQL/MariaDB memory should be below 80%.  If the recommendation is negative, you must decrease this and or the sort_buffer_size until the recommendation fits within the allowable memory."
msgstr "Lokacin yin haɗawa (joins), idan suna ƙasa da wannan girman, za a ajiye su a cikin ƙwaƙwalwar ajiya kuma ba za a taɓa rubuta su zuwa fayil na wucin gadi ba.  Saboda wannan rabon ƙwaƙwalwar ajiya ne na kowane haɗi, dole ne a kiyaye kada a ƙara shi da yawa.  Jimillar join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + ainihin ƙwaƙwalwar MySQL/MariaDB ya kamata ta kasance ƙasa da 80%.  Idan shawarar ta kasance mara kyau, dole ne ku rage wannan da/ko sort_buffer_size har sai shawarar ta dace da ƙwaƙwalwar da aka yarda da ita."

#: lib/utility.php
#, php-format
msgid "When using InnoDB storage it is important to keep your table spaces separate.  This makes managing the tables simpler for long time users of %s.  If you are running with this currently off, you can migrate to the per file storage by enabling the feature, and then running an alter statement on all InnoDB tables."
msgstr "Lokacin amfani da ma'ajiyar InnoDB, yana da muhimmanci a ware sararin teburanku daban-daban. Wannan yana sa sarrafa teburan ya zama mafi sauƙi ga masu amfani da %s na dogon lokaci. Idan a halin yanzu kuna aiki da wannan a kashe, za ku iya komawa zuwa ma'ajiyar kowane fayil daban ta hanyar kunna wannan fasalin, sannan ku gudanar da umarnin alter a kan dukkan teburan InnoDB."

#: lib/utility.php
msgid "When using innodb_file_per_table, it is important to set the innodb_file_format to Barracuda.  This setting will allow longer indexes important for certain Cacti tables."
msgstr "Lokacin amfani da innodb_file_per_table, yana da muhimmanci a saita innodb_file_format zuwa Barracuda. Wannan saitin zai ba da damar ƙirƙirar fihirisa (indexes) masu tsawo waɗanda ke da muhimmanci ga wasu teburan Cacti."

#: lib/utility.php
msgid "If your tables have very large indexes, you must operate with the Barracuda innodb_file_format and the innodb_large_prefix equal to 1.  Failure to do this may result in plugins that can not properly create tables."
msgstr "Idan teburanku suna da manyan fihirisa (indexes) sosai, dole ne ku yi aiki da Barracuda innodb_file_format kuma innodb_large_prefix ya zama daidai da 1. Rashin yin hakan na iya sa ƙarin manhajoji (plugins) ba za su iya ƙirƙirar tebura yadda ya kamata ba."

#: lib/utility.php
#, php-format
msgid "InnoDB will hold as much tables and indexes in system memory as is possible.  Therefore, you should make the innodb_buffer_pool large enough to hold as much of the tables and index in memory.  Checking the size of the /var/lib/mysql/cacti directory will help in determining this value.  We are recommending 25%% of your systems total memory, but your requirements will vary depending on your systems size."
msgstr "InnoDB zai riƙe teburori da fihirisa da yawa a cikin ƙwaƙwalwar tsarin yadda zai yiwu.  Saboda haka, ya kamata ku sanya innodb_buffer_pool ya yi girma sosai don riƙe yawancin teburori da fihirisa a ƙwaƙwalwar ajiya.  Duba girman kundin /var/lib/mysql/cacti zai taimaka wajen tantance wannan ƙima.  Muna ba da shawarar 25%% na jimillar ƙwaƙwalwar tsarin ku, amma buƙatun ku za su bambanta dangane da girman tsarin ku."

#: lib/utility.php
msgid "This settings should remain ON unless your Cacti instances is running on either ZFS or FusionI/O which both have internal journaling to accommodate abrupt system crashes.  However, if you have very good power, and your systems rarely go down and you have backups, turning this setting to OFF can net you almost a 50% increase in database performance."
msgstr "Wannan saitin ya kamata ya ci gaba da kasancewa a ON sai dai idan Cacti ɗinku yana aiki akan ZFS ko FusionI/O waɗanda dukkansu suna da tsarin rubuta bayanai na ciki don magance faɗuwar tsari ba zato ba tsammani.  Duk da haka, idan kuna da wutar lantarki mai kyau sosai, kuma tsarin ku ba safai yake mutuwa ba kuma kuna da ajiyar bayanai, kashe wannan saitin zuwa OFF zai iya ba ku kusan ƙarin 50% na ƙarfin aikin rumbun adana bayanai."

#: lib/utility.php
msgid "This is where metadata is stored. If you had a lot of tables, it would be useful to increase this."
msgstr "Nan ne ake adana bayanan metadata. Idan kana da teburori masu yawa, zai yi amfani a ƙara wannan."

#: lib/utility.php
msgid "Rogue queries should not for the database to go offline to others.  Kill these queries before they kill your system."
msgstr "Tambayoyin bayanai marasa kyau (rogue queries) bai kamata su tilasta wa rumbun adana bayanai ya daina aiki ga sauran masu amfani ba. Kashe waɗannan tambayoyin kafin su lalata maka tsari."

#: lib/utility.php
msgid "Maximum I/O performance happens when you use the O_DIRECT method to flush pages."
msgstr "Mafi girman ƙarfin aikin I/O yana samuwa ne idan ka yi amfani da hanyar O_DIRECT don share shafuka (flush pages)."

#: lib/utility.php
#, php-format
msgid "Setting this value to 2 means that you will flush all transactions every second rather than at commit.  This allows %s to perform writing less often."
msgstr "Saita wannan ƙimar zuwa 2 yana nufin za ka riƙa share dukkan mu'amaloli a kowace daƙiƙa maimakon a lokacin tabbatarwa (commit). Wannan yana ba %s damar rage yawan yin rubutu."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple io threads is advantageous for applications with high io characteristics."
msgstr "Da ma'ajin ajiya irin na SSD na zamani, samun zaren aiki na I/O (io threads) da yawa yana da fa'ida ga manhajojin da suke da yawan buƙatar I/O."

#: lib/utility.php
#, php-format
msgid "As of %s %s, the you can control how often %s flushes transactions to disk.  The default is 1 second, but in high I/O systems setting to a value greater than 1 can allow disk I/O to be more sequential"
msgstr "Tun daga %1$s %2$s, za ka iya sarrafa sau nawa %3$s ke share mu'amaloli zuwa faifai (disk). Tsohon saiti shi ne daƙiƙa 1, amma a tsarukan da ke da yawan I/O, saita ƙima sama da 1 zai iya sa aikin I/O na faifai ya zama mai bin tsari a jere"

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Da ma'ajin ajiya irin na SSD na zamani, samun zaren karatun I/O (read io threads) da yawa yana da fa'ida ga manhajojin da suke da yawan buƙatar I/O. Dangane da nau'ikan MariaDB/MySQL ɗinka, wannan ƙimar za ta iya kaiwa har 64. Amma ka yi ƙoƙarin sanya adadin ya kasance ƙasa da jimillar zaren SMT da ke kan sabar rumbun adana bayanai."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Da ma'ajin ajiya irin na SSD na zamani, samun zaren rubutun I/O (write io threads) da yawa yana da fa'ida ga manhajojin da suke da yawan buƙatar I/O. Dangane da nau'ikan MariaDB/MySQL ɗinka, wannan ƙimar za ta iya kaiwa har 64. Amma ka yi ƙoƙarin sanya adadin ya kasance ƙasa da jimillar zaren SMT da ke kan sabar rumbun adana bayanai."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MariaDB less than 10.5.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max the number of CPU cores or 64."
msgstr "%s zai raba innodb_buffer_pool zuwa sassan ƙwaƙwalwa (memory regions) don inganta ƙarfin aiki ga nau'ikan MariaDB da suka gaza 10.5. Mafi girman ƙima ita ce 64, amma bai kamata ta wuce adadin ƙwayoyin CPU (cores/threads) ba. Lokacin da innodb_buffer_pool ɗinka ya gaza 1GB, ya kamata ka yi amfani da girman pool ɗin a raba da 128MB. Ci gaba da amfani da wannan lissafin har zuwa iyakar adadin ƙwayoyin CPU ko 64."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MySQL upto and including MySQL 8.0.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max of the number of CPU cores or 64."
msgstr "%s zai raba innodb_buffer_pool zuwa sassan ƙwaƙwalwa (memory regions) don inganta ƙarfin aiki ga nau'ikan MySQL har zuwa MySQL 8.0. Mafi girman ƙima ita ce 64, amma bai kamata ta wuce adadin ƙwayoyin CPU (cores/threads) ba. Lokacin da innodb_buffer_pool ɗinka ya gaza 1GB, ya kamata ka yi amfani da girman pool ɗin a raba da 128MB. Ci gaba da amfani da wannan lissafin har zuwa iyakar adadin ƙwayoyin CPU ko 64."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 200 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 100000 can be used."
msgstr "Idan kana da faifan SSD, yi amfani da wannan shawarar. Idan kana da faifan hard drive na zahiri, yi amfani da 200 * adadin faifan da ke aiki a cikin rukunin (array). Idan ana amfani da NVMe ko PCIe Flash, za a iya amfani da adadi mafi girma sosai har zuwa 100000."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 2000 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 200000 can be used."
msgstr "Idan kana da faifan SSD, yi amfani da wannan shawarar. Idan kana da faifan hard drive na zahiri, yi amfani da 2000 * adadin faifan da ke aiki a cikin rukunin (array). Idan ana amfani da NVMe ko PCIe Flash, za a iya amfani da adadi mafi girma sosai har zuwa 200000."

#: lib/utility.php
msgid "If you have SSD disks, set this to 0. Otherwise, do not set this setting."
msgstr "Idan kana da faifan SSD, saita wannan zuwa 0. In ba haka ba, kada ka saita wannan saitin."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics."
msgstr "Da ma'ajin ajiya irin na SSD na zamani, samun zaren karatun I/O (read io threads) da yawa yana da fa'ida ga manhajojin da suke da yawan buƙatar I/O."

#: lib/utility.php
