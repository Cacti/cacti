msgid "The following PHP extensions are recommended, and should be installed before continuing your Cacti install.  NOTE: If you are planning on supporting SNMPv3 with IPv6, you should not install the php-snmp module at this time."
msgstr "Ezi zongezo zilandelayo ze-PHP ziyacetyiswa, kwaye kufuneka zifakwe ngaphambi kokuqhubeka nokufakwa kwe-Cacti yakho. QAPHELA: Ukuba uceba ukuxhasa i-SNMPv3 nge-IPv6, akufunekanga ufake imodyuli ye-php-snmp ngeli xesha."

#: lib/installer.php
