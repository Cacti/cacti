#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "Ukuhlela okungagqibekanga okusetyenziswa yiseva xa isenza oovimba beenkcukacha neetafile."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "umz. utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Iseti yeempawu esetyenziswa ngokungagqibekanga yiseva."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "umz. utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Iseti yeempawu esetyenziswa ngumxhasi xa ethumela iingxelo kwiseva."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Elona nani liphezulu loqhagamshelwano lwabaxhasi olwenziwa ngaxeshanye elivunyelweyo."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Inani elipheleleyo; okungagqibekanga ngu-151. Vumela okwaneleyo kwiipollers kunye nokungena kwabasebenzisi."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Igama elidala le-cache yeetafile ezivuliweyo; litshintshwe igama laba ngu-table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Inani elipheleleyo. Sebenzisa i-table_open_cache kwiiseva zanamhlanje."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Ubungakanani obukhulu bepakethi enye okanye nawuphi na umtya owenziweyo/ophakathi."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Iibhayithi; gcina ku-16M okanye ngaphezulu kwii-poller ezikude."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Ubungakanani obukhulu ezinokukhula ukuya kubo iitafile ze-MEMORY ezenziwe ngumsebenzisi."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Iibhayithi; zilinganiswa ngokubhekiselele kwimemori iyonke yenkqubo."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Ubungakanani obukhulu beetafile zethutyana ezingaphakathi kwimemori phambi kokuba zihambele kwidiski."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Iibhayithi; ixabiso elikhulu ligcina iitafile zethutyana kwimemori."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Ubungakanani obuncinci be-buffer yodibaniso ngalunye kwiidibaniso ezingasebenzisi ii-index."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Iibhayithi; ulwabiwo ngokunxibelelana ngakunye, okusisiseko ngu-262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "I-buffer yeseshoni nganye eyabelwe ukuhlela (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Iibhayithi; ulwabiwo ngokunxibelelana ngakunye, okusisiseko ngu-2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Gcina itafile nganye ye-InnoDB kunye nee-index zayo kwifayile yayo ye-tablespace ye-.ibd."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON okanye OFF; i-ON iyacetyiswa."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "Ifomathi yefayile ye-InnoDB ekwidiski (Antelope okanye Barracuda); i-Barracuda ngoku kuphela kwefomathi."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Vumela iziqalo zezitshixo ze-index ezinde ngaphezu kweebhayithi ezingama-767 (kufuneka ifomathi ye-Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 okanye OFF/0; oku kuziphatha ngoku kusoloko kuvuliwe."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Imemori iyonke esetyenziswa yi-InnoDB uku-cache idatha yetafile kunye neye-index."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Iibhayithi; ngokuqhelekileyo yi-25%-80% yememori iyonke yenkqubo."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Bhala amaphepha kabini (i-doublewrite buffer) ukukhusela ukubhalwa kwephepha okungaphelelanga."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON okanye OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "I-pool endala yesichazi-magama sedatha yangaphakathi ye-InnoDB kunye nezakhiwo."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Iibhayithi; ayisasetyenziswa kwiiseva zanamhlanje."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Imizuzwana elindwa yi-transaction ye-InnoDB kwisitshixo somqolo phambi kokuba incame."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Imizuzwana; okusisiseko ngu-50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Indlela esetyenziselwa ukukhuphela idatha kunye neefayile zelog kwidiski."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC, kunye nezifanayo."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Ilawula indlela ilog ye-redo ebhalwa kwaye ikhutshelwa ngayo xa i-transaction igqitywa."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1, okanye 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Isicwangciso esinye esidala see-thread ze-I/O zefayile ye-InnoDB, sathathelwa indawo zizicwangciso zee-thread ze-I/O zokufunda/zokubhala."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Inani elipheleleyo; lithathelwe indawo yi-innodb_read_io_threads kunye ne-innodb_write_io_threads."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Bhala kwaye ukhuphele ilog ye-redo ye-InnoDB rhoqo emva kwemizuzwana eyi-N."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Imizuzwana (1-2700); okusisiseko ngu-1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Inani lee-thread ze-I/O ezisetyenziselwa imisebenzi yokufunda kwi-InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; okusisiseko ngu-4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Inani lee-thread ze-I/O ezisetyenziselwa imisebenzi yokubhala kwi-InnoDB."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Inani lemimandla apho i-buffer pool ye-InnoDB yahlulwe khona."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; i-MariaDB ikususe oku ku-10.6."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Uqikelelo lwemisebenzi ye-I/O ngomzuzwana efumanekayo kwimisebenzi yangasemva ye-InnoDB."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Inani elipheleleyo; sebenzisa amaxabiso aphezulu kugcinelo lwe-SSD/NVMe."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "Elona nani liphezulu le-IOPS elinokusetyenziswa yi-InnoDB xa ukukhuphela kusala ngasemva."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Khuphela amaphepha angcolileyo akufutshane kwi-extent efanayo xa kukhutshelwa iphepha."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1, okanye 2; sebenzisa u-0 kugcinelo lwe-SSD."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Sebenzisa ukubhala okungenakwahlulwa kwehardware (MariaDB) ukuze i-doublewrite buffer ikhubazwe ngokukhuselekileyo."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON okanye OFF; i-MariaDB kuphela."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "Nyanzelisa ukwahlulwa kwe-snapshot okuqinileyo kwii-transaction ze-InnoDB."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON okanye OFF; ibuyiselwe umva kwi-MariaDB 10.6.18+, 10.11.8+ kunye ne-11.4.2+. Cwangcisa u-OFF kwi-poller ye-Cacti."

#: lib/utility.php
msgid "Removed"
msgstr "Isusiwe"

#: lib/utility.php
msgid "Deprecated"
msgstr "Ayisakhuthazwa"

#: lib/utility.php
msgid "Not applicable to this engine"
msgstr "Ayisebenzi kule njini"

#: lib/utility.php
msgid "Supported"
msgstr "Iyaxhaswa"

#: lib/utility.php
#, php-format
msgid "%s Variable Capability Matrix"
msgstr "Imatriksi yokukwazi kwe-Variable ye-%s"

#: lib/utility.php
msgid "Support by engine and version for each Cacti-recommended variable"
msgstr "Inkxaso ngenjini kunye noguqulelo kwi-variable nganye ecetyiswa yi-Cacti"

#: lib/utility.php
msgid "Variable"
msgstr "I-Variable"

#: lib/utility.php
msgid "Available settings:"
msgstr "Izicwangciso ezikhoyo:"

#: lib/utility.php
msgid "N/A - Not applicable to this engine"
msgstr "N/A - Ayisebenzi kule njini"

#: lib/utility.php
msgid "MariaDB 10.11+ and MySQL 8.4+ are the recommended, supported releases for Cacti 1.3.x (available on Rocky Linux 9 through the vendor module streams). Make sure you run the very latest release though which fixes a long standing low level networking issue that was causing spine many issues with reliability."
msgstr "I-MariaDB 10.11+ kunye ne-MySQL 8.4+ zizikhupho ezicetyiswayo nezixhaswayo ze-Cacti 1.3.x (ezifumaneka kwi-Rocky Linux 9 ngokusebenzisa imijelo yemodyuli yomthengisi). Nangona kunjalo, qinisekisa ukuba usebenzisa olona khupho lutsha kakhulu olulungisa ingxaki yothungelwano ekwinqanaba eliphantsi ekudala ikhona eyayibangela i-spine iingxaki ezininzi zokuthembeka."

#: lib/utility.php
#, php-format
msgid "It is STRONGLY recommended that you enable InnoDB in any %s version greater than 5.5.3."
msgstr "Kucetyiswa KAKHULU ukuba uvule i-InnoDB kulo naluphi na uguqulelo lwe-%s olungaphezulu ko-5.5.3."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4_unicode_ci collation type as some characters take more than a single byte."
msgstr "Xa usebenzisa i-Cacti ngezinye iilwimi ngaphandle kwesiNgesi, kubalulekile ukusebenzisa uhlobo lokulandelelanisa oluyi-utf8mb4_unicode_ci njengoko abanye oonobumba bethatha ngaphezulu kwebhayithi enye."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4 character set as some characters take more than a single byte."
msgstr "Xa usebenzisa i-Cacti ngezinye iilwimi ngaphandle kwesiNgesi, kubalulekile ukusebenzisa isethi yoonobumba eyi-utf8mb4 njengoko abanye oonobumba bethatha ngaphezulu kwebhayithi enye."

#: lib/utility.php
#, php-format
msgid "It is recommended that you enable InnoDB in any %s version greater than 5.1."
msgstr "Kucetyiswa ukuba uvule i-InnoDB kulo naluphi na uguqulelo lwe-%s olungaphezulu ko-5.1."

#: lib/utility.php
#, php-format
msgid "Depending on the number of logins and use of spine data collector, %s will need many connections.  The calculation for spine is: total_connections = total_processes * (total_threads + script_servers + 1), then you must leave headroom for user connections, which will change depending on the number of concurrent login accounts."
msgstr "Ngokuxhomekeke kwinani lokungena kunye nokusetyenziswa komqokeleli wedatha we-spine, i-%s iya kufuna unxibelelwano oluninzi. Ubalo lwe-spine luthatha olu hlobo: total_connections = total_processes * (total_threads + script_servers + 1), emva koko kufuneka ushiye isithuba sonxibelelwano lwabasebenzisi, oluya kutshintsha ngokuxhomekeke kwinani lee-akhawunti ezingena ngaxeshanye."

#: lib/utility.php
msgid "Keeping the table cache larger means less file open/close operations when using innodb_file_per_table."
msgstr "Ukugcina i-cache yetafile inkulu kuthetha imisebenzi embalwa yokuvula/ukuvala iifayile xa usebenzisa i-innodb_file_per_table."

#: lib/utility.php
msgid "With Remote polling capabilities, large amounts of data will be synced from the main server to the remote pollers.  Therefore, keep this value at or above 16M."
msgstr "Ngobuchule be-polling ekude, isixa esikhulu sedatha siya kungqamaniswa ukusuka kwiseva engundoqo ukuya kwii-poller ezikude. Ngoko ke, gcina eli xabiso ku-16M okanye ngaphezulu."

#: lib/utility.php
#, php-format
msgid "If using the Cacti Performance Booster and choosing a memory storage engine, you have to be careful to flush your Performance Booster buffer before the system runs out of memory table space.  This is done two ways, first reducing the size of your output column to just the right size.  This column is in the tables poller_output, and poller_output_boost.  The second thing you can do is allocate more memory to memory tables.  We have arbitrarily chosen a recommended value of 10%% of system memory, but if you are using SSD disk drives, or have a smaller system, you may ignore this recommendation or choose a different storage engine.  You may see the expected consumption of the Performance Booster tables under Console -> System Utilities -> View Boost Status."
msgstr "Ukuba usebenzisa i-Cacti Performance Booster kwaye ukhetha injini yokugcina yememori, kufuneka ulumke ucoce i-buffer yakho ye-Performance Booster phambi kokuba inkqubo iphelelwe sisithuba seetheyibhile zememori. Oku kwenziwa ngeendlela ezimbini, okokuqala kukunciphisa ubungakanani bekholamu yakho yemveliso bube ngobuchanekileyo. Le kholamu ikwiitheyibhile ze-poller_output, kunye ne-poller_output_boost. Okwesibini onokukwenza kukwabela imemori eninzi kwiitheyibhile zememori. Sikhethe ixabiso elicetyiswayo le-10%% yememori yenkqubo, kodwa ukuba usebenzisa iidrayivu zediski ze-SSD, okanye unenkqubo encinci, ungasihoya esi siluleko okanye ukhethe injini yokugcina eyahlukileyo. Ungabona ukusetyenziswa okulindelekileyo kweetheyibhile ze-Performance Booster phantsi kwe-Console -> Izixhobo zeNkqubo -> Jonga uBume be-Boost."

#: lib/utility.php
msgid "When executing subqueries, having a larger temporary table size, keep those temporary tables in memory."
msgstr "Xa uqhuba imibuzo engaphantsi (subqueries), ukuba nobungakanani obukhulu beetayibhile zethutyana kugcina ezo theyibhile zethutyana kwimemori."

#: lib/utility.php
msgid "If this number is negative, reduce the innodb_buffer_pool_size until the join_buffer_size turns positive, but allocate approximately from between 25%-50% of memory to the innodb_buffer_pool_size if the database is hosted on the Cacti server, or upto 80% of the systems memory if the database is separate from the Cacti web server.  However, try to not go below the default of 262,144.  When performing joins, if they are below this size, they will be kept in memory and never written to a temporary file.  As this is a per connection memory allocation, care must be taken not to increase it too high.  The sum of the join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + Core MySQL/MariaDB memory should be below 80% if the database is hosted on the Cacti web server and less if you intend to have very large RRDfiles or hundreds of thousands to millions long term."
msgstr "Ukuba eli nani linexabiso elingaphantsi kweqanda, nciphisa i-innodb_buffer_pool_size de i-join_buffer_size ibe ngaphezulu kweqanda, kodwa yabela malunga ne-25%-50% yememori kwi-innodb_buffer_pool_size ukuba isiseko sedatha sigcinwe kwiserver ye-Cacti, okanye ukuya kuthi ga kwi-80% yememori yenkqubo ukuba isiseko sedatha sahlukile kwiserver yewebhu ye-Cacti. Nangona kunjalo, zama ukungahli ngaphantsi kwexabiso elisisiseko eliyi-262,144. Xa usenza ii-join, ukuba zingaphantsi kolu bungakanani, ziya kugcinwa kwimemori kwaye azisayi kuze zibhalwe kwifayile yethutyana. Njengoko oku kululwabiwo lwememori kuqhagamshelo ngalunye, kufuneka kulumkwe ukuze kunganyuswa kakhulu. Isixa se-join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + imemori engundoqo ye-MySQL/MariaDB kufuneka sibe ngaphantsi kwe-80% ukuba isiseko sedatha sigcinwe kwiserver yewebhu ye-Cacti kwaye sibe ngaphantsi ukuba uceba ukuba nee-RRDfiles ezinkulu kakhulu okanye amakhulu amawaka ukuya kwizigidi kwixesha elide."

#: lib/utility.php
msgid "If this number is negative, reduce the innodb_buffer_pool_size until the sort_buffer_size turns positive, but allocate approximately from between 25%-50% of memory to the innodb_buffer_pool_size if the database is hosted on the Cacti server, or upto 80% of the system memory if the database is separate from the Cacti web server.  However, try to not go below the default setting of 2,097,152.  A sort buffer performs sorts for some queries using ORDER BY or GROUP BY. Configuring sort_buffer_size decides how much memory will be allocated for sort queries.  The sort_buffer_size may need to be adjusted from the default if the workload requires a significant number of sort queries. The sort_buffer_size is defined on a per-session variable.  Use the same equation as that of the join_buffer_size to determine the per connection possible memory."
msgstr "Ukuba eli nani linexabiso elingaphantsi kweqanda, nciphisa i-innodb_buffer_pool_size de i-sort_buffer_size ibe ngaphezulu kweqanda, kodwa yabela malunga ne-25%-50% yememori kwi-innodb_buffer_pool_size ukuba isiseko sedatha sigcinwe kwiserver ye-Cacti, okanye ukuya kuthi ga kwi-80% yememori yenkqubo ukuba isiseko sedatha sahlukile kwiserver yewebhu ye-Cacti. Nangona kunjalo, zama ukungahli ngaphantsi koseto olusisiseko oluyi-2,097,152. I-sort buffer yenza uluhlelo lweminye imibuzo esebenzisa u-ORDER BY okanye u-GROUP BY. Ukuqwalasela i-sort_buffer_size kugqiba ukuba yimalini yememori eya kwabelwa imibuzo yokuhlela. I-sort_buffer_size ingafuna ukulungiswa ukusuka kuseto olusisiseko ukuba umthwalo womsebenzi ufuna inani elikhulu lemibuzo yokuhlela. I-sort_buffer_size ichazwa njengotshintsho lweseshoni nganye. Sebenzisa inkqubo efanayo neye-join_buffer_size ukumisela imemori enokubakho kuqhagamshelo ngalunye."

#: lib/utility.php
#, php-format
msgid "When using InnoDB storage it is important to keep your table spaces separate.  This makes managing the tables simpler for long time users of %s.  If you are running with this currently off, you can migrate to the per file storage by enabling the feature, and then running an alter statement on all InnoDB tables."
msgstr "Xa usebenzisa ugcino lwe-InnoDB kubalulekile ukugcina izithuba zakho zeetheyibhile zahlukile. Oku kwenza ukulawula iitheyibhile kube lula kubasebenzisi bexesha elide be-%s. Ukuba ngoku oku kucinyiwe, ungaqhubela kugcino lwefayile nganye ngokuvula eli nqaku, kwaye emva koko uqhube ingxelo ye-alter kuzo zonke iitheyibhile ze-InnoDB."

#: lib/utility.php
msgid "When using innodb_file_per_table, it is important to set the innodb_file_format to Barracuda.  This setting will allow longer indexes important for certain Cacti tables."
msgstr "Xa usebenzisa i-innodb_file_per_table, kubalulekile ukuseta i-innodb_file_format ku-Barracuda. Olu seto luya kuvumela izikhombisi ezide ezibalulekileyo kwiitheyibhile ezithile ze-Cacti."

#: lib/utility.php
msgid "If your tables have very large indexes, you must operate with the Barracuda innodb_file_format and the innodb_large_prefix equal to 1.  Failure to do this may result in plugins that can not properly create tables."
msgstr "Ukuba iitheyibhile zakho zinezikhombisi ezikhulu kakhulu, kufuneka usebenze nge-innodb_file_format ye-Barracuda kunye ne-innodb_large_prefix elingana no-1. Ukungakwenzi oku kunokubangela iiplagini ezingakwaziyo ukudala iitheyibhile ngokufanelekileyo."

#: lib/utility.php
#, no-php-format
msgid "InnoDB will hold as much tables and indexes in system memory as is possible.  Therefore, you should make the innodb_buffer_pool large enough to hold as much of the tables and index in memory.  Checking the size of the /var/lib/mysql/cacti directory will help in determining this value.  We are recommending 25%% of your systems total memory, but your requirements will vary depending on your systems size.  If you database is very large or remote, you can consider increasing this size.  If remote, it can by as high as 80% of the systems memory.  However, cautions must be taken to reduce the swappiness of the system, or to remove swap to keep the system from swapping."
msgstr "I-InnoDB iya kugcina iitheyibhile ezininzi kunye nezikhombisi kwimemori yenkqubo kangangoko kunokwenzeka. Ngoko ke, kufuneka wenze i-innodb_buffer_pool ibe nkulu ngokwaneleyo ukuze igcine iitheyibhile ezininzi kunye nesikhombisi kwimemori. Ukujonga ubungakanani besiqulathi seefayile se-/var/lib/mysql/cacti kuya kunceda ekumiseleni eli xabiso. Sicebisa i-25%% yememori epheleleyo yenkqubo yakho, kodwa iimfuno zakho ziya kwahluka kuxhomekeke kubungakanani benkqubo yakho. Ukuba isiseko sakho sedatha sikhulu kakhulu okanye sikude, ungaqwalasela ukunyusa obu bungakanani. Ukuba sikude, sinokufikelela kwi-80% yememori yenkqubo. Nangona kunjalo, kufuneka kuthathwe izilumkiso zokunciphisa i-swappiness yenkqubo, okanye ukususa i-swap ukuthintela inkqubo ekutshintshiselaneni (swapping)."

#: lib/utility.php
msgid "This setting should remain ON unless your Cacti instances are running on either ZFS or FusionI/O which both have internal journaling to accommodate abrupt system crashes.  However, if you have very good power, and your systems rarely go down and you have backups, turning this setting to OFF can net you almost a 50% increase in database performance."
msgstr "Olu seto kufuneka luhlale lukwi-ON ngaphandle kokuba iimeko zakho ze-Cacti zisebenza kwi-ZFS okanye kwi-FusionI/O zombini ezine-journaling yangaphakathi ukuhlangabezana nokuphazamiseka kwesixokelelwano ngequbuliso. Nangona kunjalo, ukuba unombane ogqibeleleyo, kwaye izixokelelwano zakho azifane zime kwaye unee-backup, ukucima olu seto luye ku-OFF kunokukunika ukonyuka okumalunga nama-50% ekusebenzeni kwedathabheyisi."

#: lib/utility.php
msgid "This is where metadata is stored. If you had a lot of tables, it would be useful to increase this."
msgstr "Apha kulapho kugcinwa khona i-metadata. Ukuba ube neeteyibhile ezininzi, kuya kuba luncedo ukunyusa oku."

#: lib/utility.php
msgid "Rogue queries should not for the database to go offline to others.  Kill these queries before they kill your system."
msgstr "Izicelo eziphambukileyo akufunekanga zinyanzele idathabheyisi ukuba iphume kwintanethi kwabanye. Bulala ezi zicelo phambi kokuba zibulale isixokelelwano sakho."

#: lib/utility.php
msgid "Maximum I/O performance happens when you use the O_DIRECT method to flush pages."
msgstr "Ukusebenza okuphezulu kwe-I/O kwenzeka xa usebenzisa indlela ye-O_DIRECT ukukhupha amaphepha."

#: lib/utility.php
#, php-format
msgid "Setting this value to 2 means that you will flush all transactions every second rather than at commit.  This allows %s to perform writing less often."
msgstr "Ukusetela eli xabiso ku-2 kuthetha ukuba uza kukhupha zonke iintengiselwano rhoqo ngomzuzwana endaweni yaxa kuqinisekiswa. Oku kuvumela i-%s ukuba ibhale kancinci."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple io threads is advantageous for applications with high io characteristics."
msgstr "Ngokugcinwa kohlobo lwe-SSD lwangoku, ukuba nee-thread ze-io ezininzi kuluncedo kwizicelo ezineempawu eziphezulu ze-io."

#: lib/utility.php
#, php-format
msgid "As of %s %s, the you can control how often %s flushes transactions to disk.  The default is 1 second, but in high I/O systems setting to a value greater than 1 can allow disk I/O to be more sequential"
msgstr "Ukususela kwi-%1$s %2$s, unokulawula ukuba i-%3$s izikhupha kangaphi iintengiselwano kwidiski. Okusisiseko ngumzuzwana o-1, kodwa kwizixokelelwano ezine-I/O ephezulu ukusetela kwixabiso elingaphezu ko-1 kunokuvumela i-I/O yediski ukuba ilandelelane ngakumbi"

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Ngokugcinwa kohlobo lwe-SSD lwangoku, ukuba nee-thread zokufunda ze-io ezininzi kuluncedo kwizicelo ezineempawu eziphezulu ze-io. Ngokuxhomekeke kwiinguqulelo zakho ze-MariaDB/MySQL, eli xabiso linokunyuka liye kutsho ku-64. Kodwa zama ukugcina inani lingaphantsi kwe-SMT threads zakho zizonke kwiseva yedathabheyisi."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Ngokugcinwa kohlobo lwe-SSD lwangoku, ukuba nee-thread zokubhala ze-io ezininzi kuluncedo kwizicelo ezineempawu eziphezulu ze-io. Ngokuxhomekeke kwiinguqulelo zakho ze-MariaDB/MySQL, eli xabiso linokunyuka liye kutsho ku-64. Kodwa zama ukugcina inani lingaphantsi kwe-SMT threads zakho zizonke kwiseva yedathabheyisi."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MariaDB less than 10.5.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max the number of CPU cores or 64."
msgstr "I-%s iza kwahlula i-innodb_buffer_pool kwimimandla yememori ukuphucula ukusebenza kwiinguqulelo ze-MariaDB ezingaphantsi kwe-10.5. Elona xabiso liphezulu ngu-64, kodwa akufuneki lidlule kwinani lee-CPU cores/threads. Xa i-innodb_buffer_pool yakho ingaphantsi kwe-1GB, kufuneka usebenzise ubungakanani be-pool obahlulwe ngo-128MB. Qhubeka usebenzisa eli qhalo ukuya kutsho kwinani eliphezulu lee-CPU cores okanye u-64."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MySQL upto and including MySQL 8.0.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max of the number of CPU cores or 64."
msgstr "I-%s iza kwahlula i-innodb_buffer_pool kwimimandla yememori ukuphucula ukusebenza kwiinguqulelo ze-MySQL ukuya kutsho kuquka i-MySQL 8.0. Elona xabiso liphezulu ngu-64, kodwa akufuneki lidlule kwinani lee-CPU cores/threads. Xa i-innodb_buffer_pool yakho ingaphantsi kwe-1GB, kufuneka usebenzise ubungakanani be-pool obahlulwe ngo-128MB. Qhubeka usebenzisa eli qhalo ukuya kutsho kwinani eliphezulu lee-CPU cores okanye u-64."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 200 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 100000 can be used."
msgstr "Ukuba unee-disk ze-SSD, sebenzisa eli cebiso. Ukuba unee-hard drive eziphathekayo, sebenzisa i-200 * inani lee-drive ezisebenzayo kwi-array. Ukuba usebenzisa i-NVMe okanye i-PCIe Flash, amanani amakhulu kakhulu ukuya kutsho ku-100000 anokusetyenziswa."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 2000 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 200000 can be used."
msgstr "Ukuba unee-disk ze-SSD, sebenzisa eli cebiso. Ukuba unee-hard drive eziphathekayo, sebenzisa i-2000 * inani lee-drive ezisebenzayo kwi-array. Ukuba usebenzisa i-NVMe okanye i-PCIe Flash, amanani amakhulu kakhulu ukuya kutsho ku-200000 anokusetyenziswa."

#: lib/utility.php
msgid "If you have SSD disks, set this to 0. Otherwise, do not set this setting."
msgstr "Ukuba unee-disk ze-SSD, seta oku ku-0. Kungenjalo, musa ukuseta olu seto."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics."
msgstr "Ngokugcinwa kohlobo lwe-SSD lwangoku, ukuba nee-thread zokufunda ze-io ezininzi kuluncedo kwizicelo ezineempawu eziphezulu ze-io."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics."
msgstr "Ngokugcinwa kohlobo lwe-SSD lwangoku, ukuba nee-thread zokubhala ze-io ezininzi kuluncedo kwizicelo ezineempawu eziphezulu ze-io."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, this setting should be off if atomic writes are enabled.  Therefore, please enable atomic writes instead of the double write buffer as it will increase performance."
msgstr "Xa usebenzisa i-MariaDB 10.2.4 nangaphezulu, olu seto kufuneka lucinywe ukuba ii-atomic writes zivuliwe. Ngoko ke, nceda uvule ii-atomic writes endaweni ye-double write buffer kuba oko kuya kunyusa ukusebenza."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, you can use atomic writes over the doublewrite buffer to increase performance."
msgstr "Xa usebenzisa i-MariaDB 10.2.4 nangaphezulu, unokusebenzisa ii-atomic writes endaweni ye-doublewrite buffer ukunyusa ukusebenza."

#: lib/utility.php
msgid "MariaDB 11.8 enabled innodb_snapshot_isolation=ON by default. This causes severe lock contention: UPDATE statements can block for tens of thousands of seconds on small tables under concurrent load, which stalls the Cacti poller. Set innodb_snapshot_isolation=OFF in your [mysqld] configuration. See MDEV-39628."
msgstr "I-MariaDB 11.8 ivule i-innodb_snapshot_isolation=ON ngokungagqibekanga. Oku kubangela ungquzulwano olunzima lwezitshixo: iingxelo ze-UPDATE zinokuthintela amashumi amawaka emizuzwana kwiiteyibhile ezincinci phantsi komthwalo oqhubekayo ngaxeshanye, nto leyo emisa i-poller ye-Cacti. Seta i-innodb_snapshot_isolation=OFF kuqwalaselo lwakho lwe-[mysqld]. Jonga ku-MDEV-39628."

