msgstr "Indlela i-Cacti emayixhase ngayo iMihla yoMxumi ngokusekelwe kwizoni yexesha yesikhangeli soMxumi."

#: include/global_settings.php
msgid "Date Display Format"
msgstr "Ifomathi yokuBonisa uMhla"

#: include/global_settings.php
msgid "The System default date format to use in Cacti."
msgstr "Ifomathi yomhla esisiseko yeNkqubo emayisetyenziswe kwi-Cacti."

#: include/global_settings.php
