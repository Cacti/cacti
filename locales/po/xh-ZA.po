msgstr "Iinkqubo Zomiyalelo Ye-Poller Ezisebenza Ngaxeshanye"

#: include/global_settings.php
msgid "The number of concurrent Poller Command processes.  The will be at most one concurrent command per host within the Poller Command pool."
msgstr "Inani leenkqubo zoMiyalelo ye-Poller ezisebenza ngaxeshanye. Kuya kubakho umyalelo omnye kuphela osebenza ngaxeshanye ngexesha kwi-host nganye ngaphakathi kwiqela loMiyalelo ye-Poller."

#: include/global_settings.php
