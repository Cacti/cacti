#: include/global_settings.php
msgid "Days to retain the latest failed RRD update before explicit discard."
msgstr "Iintsuku zokugcina uhlaziyo lwamva nje lwe-RRD olusileleyo phambi kokuba lulahlwe ngokucacileyo."

