msgstr "Ushicilelo lomnwe lwesitshixo sikawonke-wonke se-RSA esisetyenziswa yi-proxy ngoku. Oku kuyafuneka ukuseka uqhagamshelwano oluthembekileyo."

#: include/global_settings.php
msgid "RRDtool Proxy Server - Backup"
msgstr "Iseva ye-Proxy ye-RRDtool - Ugcino"

#: include/global_settings.php
msgid "Load Balancing"
msgstr "Ukulinganisa Umthwalo"

#: include/global_settings.php
msgid "If both main and backup proxy are receivable this option allows to spread all requests against RRDtool."
msgstr "Ukuba zombini i-proxy engundoqo neyogcino ziyafikeleleka, olu khetho luvumela ukusasaza zonke izicelo ezisingise kwi-RRDtool."

#: include/global_settings.php
msgid "The DNS hostname or IP address of the RRDtool backup proxy server if proxy is running in MSR mode."
msgstr "Igama lomamkeli le-DNS okanye idilesi ye-IP yeseva ye-proxy yogcino ye-RRDtool ukuba i-proxy isebenza kwimowudi ye-MSR."

#: include/global_settings.php
msgid "TCP port for encrypted communication with the backup proxy."
