msgid "Failed RRD Retry Budget"
msgstr "Umyinge Wokuphinda Uzame i-RRD Esileleyo"

#: include/global_settings.php
msgid "Maximum queued RRD destinations retried by one scheduled Boost run."
msgstr "Ubuninzi beendawo ze-RRD ezikumgca eziphindwa zizanywe luhambo olucwangcisiweyo olunye lwe-Boost."

