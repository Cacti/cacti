msgstr "ou=people,dc=example,dc=com"

#: login_providers.php
msgid "Search Filter"
msgstr "Isihluzo sokuKhangela"

#: login_providers.php
msgid "Search filter to use to locate the user in the LDAP directory, such as for windows: <i>\"(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))\"</i> or for OpenLDAP: <i>\"(&(objectClass=account)(uid=&lt;username&gt))\"</i>.  \"&lt;username&gt\" is replaced with the username that was supplied at the login prompt."
msgstr "Isihluzi sokukhangela esisetyenziswa ukufumana umsebenzisi kuluhlu lwe-LDAP, njengakwi-Windows: <i>\"(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))\"</i> okanye kwi-OpenLDAP: <i>\"(&(objectClass=account)(uid=&lt;username&gt))\"</i>. \"&lt;username&gt\" ithatyathelwa indawo ligama lomsebenzisi elinikwe kwisibizo sokungena."

#: login_providers.php
msgid "(&(objectClass=account)(uid=<username>))"
msgstr "(&(objectClass=account)(uid=<username>))"

