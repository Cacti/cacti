msgstr "Chonga ngokuzenzekelayo xa kuPhindwa uku-Indeksa"

#: include/global_form.php
msgid "Auto Detect/Set on first Re-Index"
msgstr "Chonga/Seta ngokuzenzekelayo xa kuPhindwa uku-Indeksa okokuqala"

