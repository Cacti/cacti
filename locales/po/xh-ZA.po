msgid "Maximum RRD Update Script Run Time"
msgstr "Elona xesha lide lokuSebenza kweSkripthi sokuHlaziya i-RRD"

#: include/global_settings.php
msgid "If the boost poller exceeds this runtime, a warning will be placed in the cacti log,"
msgstr "Ukuba i-poller ye-Boost idlula kweli xesha lokusebenza, isilumkiso siya kufakwa kwilogi ye-Cacti,"

