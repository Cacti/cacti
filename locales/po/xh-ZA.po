msgstr "I-Cacti iquka inkxaso yeziQhubi zoGuqulelo loLwimi ezininzi ezahlukeneyo. Ukuba akukho nasinye esikhethiweyo i-Cacti iya kuzama ukusebenzisa esokuqala esifunyenweyo."

#: include/global_settings.php
msgid "Client TimeZone Support"
msgstr "Inkxaso yeZoni yeXesha yoMxumi"

#: include/global_settings.php
