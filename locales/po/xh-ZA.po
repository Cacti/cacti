msgstr "Rekhoda xa iinkalo zesicelo zifikelelwa ngaphandle kokudlula kuqinisekiso lwegalelo olufanelekileyo"

#: include/global_settings.php
msgid "Data Source Tracing"
msgstr "Ukulandelelwa koMthombo weDatha"

#: include/global_settings.php
msgid "A developer only option to trace the creation of Data Sources mainly around checks for uniqueness"
msgstr "Ukhetho lwabaphuhlisi kuphela lokulandelela ukudalwa kweMithombo yeDatha ingakumbi malunga nokujonga ubukhethekile"

#: include/global_settings.php
