msgstr "Isahluli somhla esisiseko seNkqubo esiza kusetyenziswa kwi-Cacti."

#: include/global_settings.php
msgid "Other Settings"
msgstr "Olunye Useto"

#: include/global_settings.php
msgid "Show only site specific locations"
msgstr "Bonisa kuphela iindawo ezizodwa zesayithi"

#: include/global_settings.php
msgid "Show only locations that are available at a devices selected site."
msgstr "Bonisa kuphela iindawo ezifumanekayo kwisayithi ekhethiweyo yesixhobo."

#: include/global_settings.php
msgid "Has Graphs/Data Sources Checked"
msgstr "Ineegrafu/iMithombo yeDatha iKhethiwe"

#: include/global_settings.php
msgid "Should the Has Graphs and Has Data Sources be Checked by Default."
msgstr "Ngaba i-Has Graphs kunye ne-Has Data Sources mazikhethwe ngokuzenzekelayo."

#: include/global_settings.php utilities.php
msgid "RRDtool Version"
msgstr "Uguqulelo lwe-RRDtool"

#: include/global_settings.php
