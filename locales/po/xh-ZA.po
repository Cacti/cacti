msgid "Remote Pollers are used to access networks that are not readily accessible to the Primary site."
msgstr "IiPoller eziKude zisetyenziselwa ukufikelela kwiinethiwekhi ezingafikeleleki lula kwindawo ePhambili."

#: lib/installer.php
msgid "The following information has been determined from Cacti's configuration file. If it is not correct, please edit \"include/config.php\" before continuing."
msgstr "Olu lwazi lulandelayo lufunyenwe kwifayile yoqwalaselo ye-Cacti. Ukuba aluchanekanga, nceda uhlele i-\"include/config.php\" ngaphambi kokuba uqhubeke."

#: lib/installer.php
