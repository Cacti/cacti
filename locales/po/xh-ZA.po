msgstr "Tshixa ii-Akhawunti"

#: include/global_settings.php
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "Tshixa i-akhawunti emva kweli nani leenzame ezingaphumelelanga kwiyure e-1."

#: include/global_settings.php
msgid "1 Attempt"
msgstr "Inzame e-1"

#: include/global_settings.php
#, php-format
