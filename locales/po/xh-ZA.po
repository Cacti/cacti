msgstr "Elona nani liphezulu Leziqulathi Zezixhobo eziza kudalwa ngokusekelwe kwii-ID Zezixhobo ezine-hash."

#: include/global_settings.php
msgid "Proxy Server"
msgstr "Iseva ye-Proxy"

#: include/global_settings.php
msgid "The DNS hostname or IP address of the RRDtool proxy server."
msgstr "Igama lomamkeli le-DNS okanye idilesi ye-IP yeseva ye-proxy ye-RRDtool."

#: include/global_settings.php
msgid "Proxy Port Number"
msgstr "Inombolo Yezibuko Ye-Proxy"

#: include/global_settings.php
msgid "TCP port for encrypted communication."
msgstr "Izibuko le-TCP lonxibelelwano olufihliweyo."

#: include/global_settings.php support.php
msgid "RSA Fingerprint"
msgstr "Ushicilelo Lomnwe Lwe-RSA"

#: include/global_settings.php
