msgstr "Inani elikhulu lememori ye-Cacti Poller ne-Boost Poller"

#: include/global_settings.php
msgid "Maximum RRD Update Script Run Time"
msgstr "Isikhathi Esikhulu Sokusebenza Kweskripthi Sokubuyekeza I-RRD"

#: include/global_settings.php
msgid "If the boost poller exceeds this runtime, a warning will be placed in the cacti log,"
msgstr "Uma i-poller ye-Boost idlula lesi sikhathi sokusebenza, isixwayiso sizofakwa kulogi ye-Cacti,"

#: include/global_settings.php
msgid "Maximum Failed RRDs Queued"
msgstr "Inani Eliphezulu Lama-RRD Ahlulekile Asemugqeni"

#: include/global_settings.php
msgid "Maximum number of RRD destinations retained for automatic Boost retry. Only the latest complete failed update is retained per destination."
msgstr "Inani eliphezulu lezindawo zokuya ze-RRD ezigcinelwe ukuzama kabusha okuzenzakalelayo kwe-Boost. Isibuyekezo sakamuva esiphelele esehlulekile kuphela esigcinwayo ngendawo ngayinye."

#: include/global_settings.php
msgid "Failed RRD Retry Budget"
msgstr "Isabelo Sokuzama Kabusha I-RRD Ehlulekile"

#: include/global_settings.php
msgid "Maximum queued RRD destinations retried by one scheduled Boost run."
msgstr "Inani eliphezulu lezindawo zokuya ze-RRD ezisemugqeni ezizanywa kabusha ngokusebenza okukodwa okuhleliwe kwe-Boost."

#: include/global_settings.php
msgid "Maximum Failed RRD Retries"
msgstr "Inani Eliphezulu Lokuzama Kabusha I-RRD Ehlulekile"

#: include/global_settings.php
msgid "Queued RRD updates are explicitly discarded after this many failed automatic attempts."
msgstr "Izibuyekezo ze-RRD ezisemugqeni zilahlwa ngokuqondile ngemva kwaleli nani lemizamo yokuzenzakalelayo ehlulekile."

#: include/global_settings.php
msgid "Maximum Failed RRD Age"
msgstr "Ubudala Obuphezulu Be-RRD Ehlulekile"

#: include/global_settings.php
msgid "Days to retain the latest failed RRD update before explicit discard."
msgstr "Izinsuku zokugcina isibuyekezo sakamuva se-RRD esehlulekile ngaphambi kokulahlwa ngokuqondile."

