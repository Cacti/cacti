#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "Ukuhlelwa okuzenzakalelayo okusetshenziswa yiseva lapho yakha amadathabheyisi namathebula."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "isb. utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Isethi yezinhlamvu ezenzakalelayo esetshenziswa yiseva."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "isb. utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Isethi yezinhlamvu esetshenziswa iklayenti lapho ithumela izitatimende kuseva."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Inani eliphezulu lokuxhumana kwamaklayenti ngesikhathi esisodwa elivunyelwe."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Inombolo ephelele; okuzenzakalelayo 151. Vumela okwanele ama-poller kanye nokungena kwabasebenzisi."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Igama elidala le-cache yamathebula avuliwe; laqanjwa kabusha ngokuthi table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Inombolo ephelele. Sebenzisa i-table_open_cache kumaseva esimanje."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Usayizi omkhulu wephakhethi elilodwa noma noma yiluphi uchungechunge olukhiqiziwe/oluphakathi."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Amabhayithi; gcina ku-16M noma ngaphezulu kuma-poller akude."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Usayizi omkhulu amathebula e-MEMORY akhiwe ngumsebenzisi angakhula kuwo."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Amabhayithi; usayizi obalwa ngokuya ngememori ephelele yesistimu."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Usayizi omkhulu wamathebula esikhashana angaphakathi ememorini ngaphambi kokuba adlulele kudiski."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Amabhayithi; inani elikhulu ligcina amathebula esikhashana ememorini."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Usayizi omncane we-buffer nge-join ngayinye kuma-join angasebenzisi ama-index."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Amabhayithi; isabelo ngoxhumano ngalunye, okuzenzakalelayo ngu-262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "I-buffer yeseshini ngayinye eyabelwe ukuhlunga (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Amabhayithi; isabelo ngoxhumano ngalunye, okuzenzakalelayo ngu-2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Gcina ithebula ngalinye le-InnoDB nama-index alo efayeleni lalo le-tablespace elingu-.ibd."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON noma OFF; kunconywa u-ON."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "Ifomethi yefayela ye-InnoDB kudiski (Antelope noma Barracuda); i-Barracuda manje iyona kuphela ifomethi."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Vumela iziqalo zokhiye be-index ezinde kunamabhayithi angu-767 (kudinga ifomethi ye-Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 noma OFF/0; lokhu kuziphatha manje kuhlala kunikwe amandla njalo."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Imemori ephelele esetshenziswa yi-InnoDB uku-cache idatha yethebula neye-index."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Amabhayithi; ngokuvamile u-25%-80% wememori ephelele yesistimu."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Bhala amakhasi kabili (i-doublewrite buffer) ukuze uvikele ekubhalweni kwengxenye yekhasi."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON noma OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "I-pool endala yesichazamazwi sedatha sangaphakathi se-InnoDB kanye nezakhiwo."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Amabhayithi; akusasebenzi kumaseva esimanje."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Amasekhondi umsebenzi we-InnoDB olinda ngawo ukukhiywa komugqa ngaphambi kokudela."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Amasekhondi; okuzenzakalelayo ngu-50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Indlela esetshenziswayo ukuhlanza idatha namafayela elogi kudiski."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC, nokufana nakho."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Ilawula ukuthi i-redo log ibhalwa futhi ihlanjwe kanjani lapho umsebenzi uqinisekiswa."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1, noma 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Isilungiselelo esidala esisodwa sama-thread e-I/O efayela le-InnoDB, esithathelwe indawo yizilungiselelo zama-thread e-I/O okufunda/okubhala."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Inombolo ephelele; ithathelwe indawo yi-innodb_read_io_threads ne-innodb_write_io_threads."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Bhala futhi uhlanze i-redo log ye-InnoDB njalo ngamasekhondi angu-N."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Amasekhondi (1-2700); okuzenzakalelayo ngu-1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Inani lama-thread e-I/O asetshenziselwa imisebenzi yokufunda ku-InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; okuzenzakalelayo ngu-4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Inani lama-thread e-I/O asetshenziselwa imisebenzi yokubhala ku-InnoDB."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Inani lezifunda i-buffer pool ye-InnoDB ehlukaniswe ngazo."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; i-MariaDB ikususile lokhu ku-10.6."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Imisebenzi ye-I/O elinganiselwe ngomzuzwana etholakala emisebenzini yangemuva ye-InnoDB."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Inombolo ephelele; sebenzisa amanani aphezulu kwisitoreji se-SSD/NVMe."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "I-IOPS ephezulu i-InnoDB engayisebenzisa lapho ukuhlanza kusalela emuva."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Hlanza amakhasi angcolile angomakhelwane ku-extent efanayo lapho uhlanza ikhasi."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1, noma 2; sebenzisa u-0 kwisitoreji se-SSD."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Sebenzisa ukubhala kwe-atomic kwezingxenyekazi zekhompyutha (MariaDB) ukuze i-doublewrite buffer ikhutshazwe ngokuphepha."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON noma OFF; i-MariaDB kuphela."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "Phoqelela ukuhlukaniswa kwe-snapshot okuqinile kwemisebenzi ye-InnoDB."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON noma OFF; kubuyiselwe emuva ku-MariaDB 10.6.18+, 10.11.8+ kanye no-11.4.2+. Setha ku-OFF ku-poller ye-Cacti."

#: lib/utility.php
msgid "Removed"
msgstr "Kususiwe"

#: lib/utility.php
msgid "Deprecated"
msgstr "Kuphelelwe yisikhathi"

#: lib/utility.php
msgid "Not applicable to this engine"
msgstr "Akusebenzi kule njini"

#: lib/utility.php
msgid "Supported"
msgstr "Kuyasekelwa"

#: lib/utility.php
#, php-format
msgid "%s Variable Capability Matrix"
msgstr "I-Matrix Yamakhono E-Variable ye-%s"

#: lib/utility.php
msgid "Support by engine and version for each Cacti-recommended variable"
msgstr "Ukusekelwa ngenjini nenguqulo nge-variable ngayinye enconywe yi-Cacti"

#: lib/utility.php
msgid "Variable"
msgstr "I-Variable"

#: lib/utility.php
msgid "Available settings:"
msgstr "Izilungiselelo ezitholakalayo:"

#: lib/utility.php
msgid "N/A - Not applicable to this engine"
msgstr "N/A - Akusebenzi kule njini"

#: lib/utility.php
msgid "MariaDB 10.11+ and MySQL 8.4+ are the recommended, supported releases for Cacti 1.3.x (available on Rocky Linux 9 through the vendor module streams). Make sure you run the very latest release though which fixes a long standing low level networking issue that was causing spine many issues with reliability."
msgstr "I-MariaDB 10.11+ ne-MySQL 8.4+ yizona zinguqulo ezinconyiwe nezisekelwayo ze-Cacti 1.3.x (ezitholakala ku-Rocky Linux 9 ngokusebenzisa ama-vendor module stream). Qiniseka ukuthi usebenzisa inguqulo yakamuva kakhulu nokho, elungisa inkinga yakudala yenethiwekhi esezingeni eliphansi ebidala izinkinga eziningi zokuthembeka ku-spine."

#: lib/utility.php
#, php-format
msgid "It is STRONGLY recommended that you enable InnoDB in any %s version greater than 5.5.3."
msgstr "Kunconywa KAKHULU ukuthi unike amandla i-InnoDB kunoma iyiphi inguqulo ye-%s enkulu kuno-5.5.3."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4_unicode_ci collation type as some characters take more than a single byte."
msgstr "Uma usebenzisa i-Cacti ngezilimi ezingesona isiNgisi, kubalulekile ukusebenzisa uhlobo lokuhlunga olungu-utf8mb4_unicode_ci njengoba ezinye izinhlamvu zithatha ngaphezu kwebhayithi elilodwa."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4 character set as some characters take more than a single byte."
msgstr "Uma usebenzisa i-Cacti ngezilimi ezingesona isiNgisi, kubalulekile ukusebenzisa iqoqo lezinhlamvu elingu-utf8mb4 njengoba ezinye izinhlamvu zithatha ngaphezu kwebhayithi elilodwa."

#: lib/utility.php
#, php-format
msgid "It is recommended that you enable InnoDB in any %s version greater than 5.1."
msgstr "Kunconywa ukuthi unike amandla i-InnoDB kunoma iyiphi inguqulo ye-%s enkulu kuno-5.1."

#: lib/utility.php
#, php-format
msgid "Depending on the number of logins and use of spine data collector, %s will need many connections.  The calculation for spine is: total_connections = total_processes * (total_threads + script_servers + 1), then you must leave headroom for user connections, which will change depending on the number of concurrent login accounts."
msgstr "Kuye ngenani lokungena nokusetshenziswa komqoqi wedatha we-spine, i-%s izodinga ukuxhumana okuningi. Isibalo se-spine sithi: total_connections = total_processes * (total_threads + script_servers + 1), bese kumele ushiye isikhala esengeziwe sokuxhumana kwabasebenzisi, okuzoshintsha kuye ngenani lama-akhawunti angena ngesikhathi esisodwa."

#: lib/utility.php
msgid "Keeping the table cache larger means less file open/close operations when using innodb_file_per_table."
msgstr "Ukugcina i-cache yamathebula inkulu kusho imisebenzi embalwa yokuvula/yokuvala amafayela lapho usebenzisa i-innodb_file_per_table."

#: lib/utility.php
msgid "With Remote polling capabilities, large amounts of data will be synced from the main server to the remote pollers.  Therefore, keep this value at or above 16M."
msgstr "Ngamakhono e-polling ekude, inani elikhulu ledatha lizovumelaniswa lisuka kuseva enkulu liya kuma-poller akude. Ngakho-ke, gcina leli nani liku-16M noma ngaphezulu."

#: lib/utility.php
#, php-format
msgid "If using the Cacti Performance Booster and choosing a memory storage engine, you have to be careful to flush your Performance Booster buffer before the system runs out of memory table space.  This is done two ways, first reducing the size of your output column to just the right size.  This column is in the tables poller_output, and poller_output_boost.  The second thing you can do is allocate more memory to memory tables.  We have arbitrarily chosen a recommended value of 10%% of system memory, but if you are using SSD disk drives, or have a smaller system, you may ignore this recommendation or choose a different storage engine.  You may see the expected consumption of the Performance Booster tables under Console -> System Utilities -> View Boost Status."
msgstr "Uma usebenzisa i-Cacti Performance Booster futhi ukhetha injini yokugcinwa kwedatha enkumbulweni, kufanele uqaphele ukukhuculula ibhafa yakho ye-Performance Booster ngaphambi kokuba isistimu iphelelwe yisikhala samathebula enkumbulo. Lokhu kwenziwa ngezindlela ezimbili, okokuqala ukunciphisa usayizi wekholomu yakho yokukhipha ibe ngusayizi ofanele nje. Le kholomu itholakala emathebuleni athi poller_output, kanye nelithi poller_output_boost. Okwesibili ongakwenza ukwaba inkumbulo eyengeziwe emathebuleni enkumbulo. Sikhethe nje inani elinconyiwe eliyi-10%% yenkumbulo yesistimu, kodwa uma usebenzisa amadrayivu ediski e-SSD, noma unesistimu encane, ungayishaya indiva le ncomo noma ukhethe enye injini yokugcinwa kwedatha. Ungabona ukusetshenziswa okulindelekile kwamathebula e-Performance Booster ngaphansi kokuthi Ikhonsoli -> Izinsiza Zesistimu -> Buka Isimo Se-Boost."

#: lib/utility.php
msgid "When executing subqueries, having a larger temporary table size, keep those temporary tables in memory."
msgstr "Lapho kwenziwa ama-subquery, ukuba nosayizi omkhulu wethebula lesikhashana kugcina lawo mathebula esikhashana enkumbulweni."

#: lib/utility.php
msgid "If this number is negative, reduce the innodb_buffer_pool_size until the join_buffer_size turns positive, but allocate approximately from between 25%-50% of memory to the innodb_buffer_pool_size if the database is hosted on the Cacti server, or upto 80% of the systems memory if the database is separate from the Cacti web server.  However, try to not go below the default of 262,144.  When performing joins, if they are below this size, they will be kept in memory and never written to a temporary file.  As this is a per connection memory allocation, care must be taken not to increase it too high.  The sum of the join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + Core MySQL/MariaDB memory should be below 80% if the database is hosted on the Cacti web server and less if you intend to have very large RRDfiles or hundreds of thousands to millions long term."
msgstr "Uma le nombolo iyinegethivu, nciphisa i-innodb_buffer_pool_size kuze kube yilapho i-join_buffer_size iba phozithivu, kodwa yaba cishe phakathi kuka-25%-50% yenkumbulo ku-innodb_buffer_pool_size uma isizindalwazi sigcinwe kuseva ye-Cacti, noma kufika ku-80% yenkumbulo yesistimu uma isizindalwazi sihlukene neseva yewebhu ye-Cacti. Nokho, zama ukungahambi ngaphansi kwenani elizenzakalelayo elingu-262,144. Lapho wenza ama-join, uma engaphansi kwalo sayizi, azogcinwa enkumbulweni futhi awasoze abhalwa efayeleni lesikhashana. Njengoba lokhu kuwukwabiwa kwenkumbulo koxhumo ngalunye, kufanele kuqashelwe ukuthi kungakhushulwa ngokweqile. Isamba se-join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + inkumbulo eyisisekelo ye-MySQL/MariaDB kufanele sibe ngaphansi kuka-80% uma isizindalwazi sigcinwe kuseva yewebhu ye-Cacti futhi sibe ngaphansi uma uhlela ukuba nama-RRDfiles amakhulu kakhulu noma amakhulu ezinkulungwane kuya ezigidini esikhathini eside."

#: lib/utility.php
msgid "If this number is negative, reduce the innodb_buffer_pool_size until the sort_buffer_size turns positive, but allocate approximately from between 25%-50% of memory to the innodb_buffer_pool_size if the database is hosted on the Cacti server, or upto 80% of the system memory if the database is separate from the Cacti web server.  However, try to not go below the default setting of 2,097,152.  A sort buffer performs sorts for some queries using ORDER BY or GROUP BY. Configuring sort_buffer_size decides how much memory will be allocated for sort queries.  The sort_buffer_size may need to be adjusted from the default if the workload requires a significant number of sort queries. The sort_buffer_size is defined on a per-session variable.  Use the same equation as that of the join_buffer_size to determine the per connection possible memory."
msgstr "Uma le nombolo iyinegethivu, nciphisa i-innodb_buffer_pool_size kuze kube yilapho i-sort_buffer_size iba phozithivu, kodwa yaba cishe phakathi kuka-25%-50% yenkumbulo ku-innodb_buffer_pool_size uma isizindalwazi sigcinwe kuseva ye-Cacti, noma kufika ku-80% yenkumbulo yesistimu uma isizindalwazi sihlukene neseva yewebhu ye-Cacti. Nokho, zama ukungahambi ngaphansi kwesethingi ezenzakalelayo engu-2,097,152. Ibhafa yokuhlunga yenza ukuhlunga kweminye imibuzo esebenzisa u-ORDER BY noma u-GROUP BY. Ukumisa i-sort_buffer_size kunquma ukuthi ingakanani inkumbulo ezokwabelwa imibuzo yokuhlunga. I-sort_buffer_size ingadinga ukulungiswa isuka kunani elizenzakalelayo uma umsebenzi udinga inani elikhulu lemibuzo yokuhlunga. I-sort_buffer_size ichazwa njengokuguquguqukayo kweseshini ngayinye. Sebenzisa isibalo esifanayo nese-join_buffer_size ukuze unqume inkumbulo engase isetshenziswe koxhumo ngalunye."

#: lib/utility.php
#, php-format
msgid "When using InnoDB storage it is important to keep your table spaces separate.  This makes managing the tables simpler for long time users of %s.  If you are running with this currently off, you can migrate to the per file storage by enabling the feature, and then running an alter statement on all InnoDB tables."
msgstr "Lapho usebenzisa isitoreji se-InnoDB kubalulekile ukugcina izikhala zamathebula akho zihlukene. Lokhu kwenza ukuphatha amathebula kube lula kubasebenzisi besikhathi eside be-%s. Uma okwamanje usebenza lokhu kuvaliwe, ungathuthela esitorejini sefayela ngalinye ngokuvula lesi sici, bese usebenzisa isitatimende se-alter kuwo wonke amathebula e-InnoDB."

#: lib/utility.php
msgid "When using innodb_file_per_table, it is important to set the innodb_file_format to Barracuda.  This setting will allow longer indexes important for certain Cacti tables."
msgstr "Lapho usebenzisa i-innodb_file_per_table, kubalulekile ukusetha i-innodb_file_format ibe ngu-Barracuda. Le sethingi izovumela ama-index amade abalulekile kumathebula athile e-Cacti."

#: lib/utility.php
msgid "If your tables have very large indexes, you must operate with the Barracuda innodb_file_format and the innodb_large_prefix equal to 1.  Failure to do this may result in plugins that can not properly create tables."
msgstr "Uma amathebula akho enama-index amakhulu kakhulu, kufanele usebenze nge-innodb_file_format engu-Barracuda kanye ne-innodb_large_prefix elingana no-1. Ukwehluleka ukwenza lokhu kungaholela kuma-plugin angakwazi ukudala amathebula ngendlela efanele."

#: lib/utility.php
#, no-php-format
msgid "InnoDB will hold as much tables and indexes in system memory as is possible.  Therefore, you should make the innodb_buffer_pool large enough to hold as much of the tables and index in memory.  Checking the size of the /var/lib/mysql/cacti directory will help in determining this value.  We are recommending 25%% of your systems total memory, but your requirements will vary depending on your systems size.  If you database is very large or remote, you can consider increasing this size.  If remote, it can by as high as 80% of the systems memory.  However, cautions must be taken to reduce the swappiness of the system, or to remove swap to keep the system from swapping."
msgstr "I-InnoDB izobamba amathebula nama-index amaningi enkumbulweni yesistimu ngangokunokwenzeka. Ngakho-ke, kufanele wenze i-innodb_buffer_pool ibe nkulu ngokwanele ukubamba ingxenye enkulu yamathebula nama-index enkumbulweni. Ukuhlola usayizi wohla lwemibhalo lwe-/var/lib/mysql/cacti kuzosiza ekunqumeni leli nani. Sincoma u-25%% wenkumbulo ephelele yesistimu yakho, kodwa izidingo zakho zizohluka kuye ngosayizi wesistimu yakho. Uma isizindalwazi sakho sikhulu kakhulu noma sikude, ungacabangela ukwandisa lo sayizi. Uma sikude, kungafika ku-80% yenkumbulo yesistimu. Nokho, kufanele kuthathwe izinyathelo zokuqapha ukunciphisa ukusetshenziswa kwe-swap kwesistimu, noma ukususa i-swap ukuze kuvinjwe isistimu ekwenzeni i-swapping."

#: lib/utility.php
msgid "This setting should remain ON unless your Cacti instances are running on either ZFS or FusionI/O which both have internal journaling to accommodate abrupt system crashes.  However, if you have very good power, and your systems rarely go down and you have backups, turning this setting to OFF can net you almost a 50% increase in database performance."
msgstr "Lesi silungiselelo kufanele sihlale siku-ON ngaphandle uma ama-instance akho e-Cacti asebenza ku-ZFS noma ku-FusionI/O kokubili okune-journaling yangaphakathi yokubhekana nokuphahlazeka kwesistimu okungazelele. Nokho, uma unogesi othembekile kakhulu, amasistimu akho engavamile ukuwa futhi unezipele, ukusetha lesi silungiselelo ku-OFF kungakutholela ukukhuphuka okucishe kube ngu-50% ekusebenzeni kwesizindalwazi."

#: lib/utility.php
msgid "This is where metadata is stored. If you had a lot of tables, it would be useful to increase this."
msgstr "Lapha kulondolozwa khona i-metadata. Uma unamathebula amaningi, kungaba wusizo ukwandisa lokhu."

#: lib/utility.php
msgid "Rogue queries should not for the database to go offline to others.  Kill these queries before they kill your system."
msgstr "Imibuzo engalawuleki akufanele iphoqe isizindalwazi ukuthi singatholakali kwabanye. Qeda le mibuzo ngaphambi kokuba ibulale isistimu yakho."

#: lib/utility.php
msgid "Maximum I/O performance happens when you use the O_DIRECT method to flush pages."
msgstr "Ukusebenza okuphezulu kakhulu kwe-I/O kwenzeka uma usebenzisa indlela ye-O_DIRECT ukuze uthulule amakhasi."

#: lib/utility.php
#, php-format
msgid "Setting this value to 2 means that you will flush all transactions every second rather than at commit.  This allows %s to perform writing less often."
msgstr "Ukusetha leli nani ku-2 kusho ukuthi uzothulula wonke ama-transaction njalo ngomzuzwana kunokuthi ukwenze ngesikhathi soku-commit. Lokhu kuvumela i-%s ukuthi ingabhali njalonjalo."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple io threads is advantageous for applications with high io characteristics."
msgstr "Ngesitoreji sesimanje sohlobo lwe-SSD, ukuba nama-io thread amaningi kunenzuzo ezinhlelweni ezinezici ze-io ephezulu."

#: lib/utility.php
#, php-format
msgid "As of %s %s, the you can control how often %s flushes transactions to disk.  The default is 1 second, but in high I/O systems setting to a value greater than 1 can allow disk I/O to be more sequential"
msgstr "Kusukela ku-%1$s %2$s, ungalawula ukuthi i-%3$s iwathulula kangaki ama-transaction kudiski. Okuzenzakalelayo ngumzuzwana ongu-1, kodwa kumasistimu ane-I/O ephezulu ukusetha inani elikhulu kuno-1 kungavumela i-I/O yediski ukuthi ilandelane kakhudlwana"

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Ngesitoreji sesimanje sohlobo lwe-SSD, ukuba nama-read io thread amaningi kunenzuzo ezinhlelweni ezinezici ze-io ephezulu. Kuye ngezinguqulo zakho ze-MariaDB/MySQL, leli nani lingafika ku-64. Kodwa zama ukugcina inombolo ingaphansi kwenani eliphelele lama-SMT thread kuseva yakho yesizindalwazi."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Ngesitoreji sesimanje sohlobo lwe-SSD, ukuba nama-write io thread amaningi kunenzuzo ezinhlelweni ezinezici ze-io ephezulu. Kuye ngezinguqulo zakho ze-MariaDB/MySQL, leli nani lingafika ku-64. Kodwa zama ukugcina inombolo ingaphansi kwenani eliphelele lama-SMT thread kuseva yakho yesizindalwazi."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MariaDB less than 10.5.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max the number of CPU cores or 64."
msgstr "I-%s izohlukanisa i-innodb_buffer_pool ibe yizindawo zememori ukuze ithuthukise ukusebenza ezinguqulweni ze-MariaDB ezingaphansi kwe-10.5. Inani eliphezulu ngu-64, kodwa akufanele lidlule enanini lama-core/thread e-CPU. Uma i-innodb_buffer_pool yakho ingaphansi kuka-1GB, kufanele usebenzise usayizi we-pool uhlukaniswe ngo-128MB. Qhubeka usebenzisa leli zibalo kuze kufike enanini eliphezulu lama-core e-CPU noma u-64."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MySQL upto and including MySQL 8.0.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max of the number of CPU cores or 64."
msgstr "I-%s izohlukanisa i-innodb_buffer_pool ibe yizindawo zememori ukuze ithuthukise ukusebenza ezinguqulweni ze-MySQL kuze kufike futhi kuhlanganise ne-MySQL 8.0. Inani eliphezulu ngu-64, kodwa akufanele lidlule enanini lama-core/thread e-CPU. Uma i-innodb_buffer_pool yakho ingaphansi kuka-1GB, kufanele usebenzise usayizi we-pool uhlukaniswe ngo-128MB. Qhubeka usebenzisa leli zibalo kuze kufike enanini eliphezulu lama-core e-CPU noma u-64."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 200 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 100000 can be used."
msgstr "Uma unamadiski e-SSD, sebenzisa lesi siphakamiso. Uma unama-hard drive angokoqobo, sebenzisa u-200 * inombolo yamadrayivu asebenzayo ku-array. Uma usebenzisa i-NVMe noma i-PCIe Flash, izinombolo ezinkulu kakhulu ezifika ku-100000 zingasetshenziswa."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 2000 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 200000 can be used."
msgstr "Uma unamadiski e-SSD, sebenzisa lesi siphakamiso. Uma unama-hard drive angokoqobo, sebenzisa u-2000 * inombolo yamadrayivu asebenzayo ku-array. Uma usebenzisa i-NVMe noma i-PCIe Flash, izinombolo ezinkulu kakhulu ezifika ku-200000 zingasetshenziswa."

#: lib/utility.php
msgid "If you have SSD disks, set this to 0. Otherwise, do not set this setting."
msgstr "Uma unamadiski e-SSD, setha lokhu ku-0. Ngaphandle kwalokho, ungasisethi lesi silungiselelo."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics."
msgstr "Ngesitoreji sesimanje sohlobo lwe-SSD, ukuba nama-read io thread amaningi kunenzuzo ezinhlelweni ezinezici ze-io ephezulu."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics."
msgstr "Ngesitoreji sesimanje sohlobo lwe-SSD, ukuba nama-write io thread amaningi kunenzuzo ezinhlelweni ezinezici ze-io ephezulu."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, this setting should be off if atomic writes are enabled.  Therefore, please enable atomic writes instead of the double write buffer as it will increase performance."
msgstr "Uma usebenzisa i-MariaDB 10.2.4 nangaphezulu, lesi silungiselelo kufanele sivalwe uma ama-atomic write enikwe amandla. Ngakho-ke, sicela unike amandla ama-atomic write esikhundleni se-double write buffer njengoba lokho kuzokwandisa ukusebenza."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, you can use atomic writes over the doublewrite buffer to increase performance."
msgstr "Uma usebenzisa i-MariaDB 10.2.4 nangaphezulu, ungasebenzisa ama-atomic write esikhundleni se-doublewrite buffer ukuze wandise ukusebenza."

#: lib/utility.php
msgid "MariaDB 11.8 enabled innodb_snapshot_isolation=ON by default. This causes severe lock contention: UPDATE statements can block for tens of thousands of seconds on small tables under concurrent load, which stalls the Cacti poller. Set innodb_snapshot_isolation=OFF in your [mysqld] configuration. See MDEV-39628."
msgstr "I-MariaDB 11.8 inike amandla i-innodb_snapshot_isolation=ON ngokuzenzakalelayo. Lokhu kubangela umbango omkhulu wokukhiya: izitatimende ze-UPDATE zingavimba amashumi ezinkulungwane zemizuzwana emathebuleni amancane ngaphansi komthwalo oqhubeka kanyekanye, okwenza i-poller ye-Cacti ime. Setha i-innodb_snapshot_isolation=OFF ekucushweni kwakho kwe-[mysqld]. Bheka i-MDEV-39628."

