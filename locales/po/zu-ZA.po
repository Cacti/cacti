msgstr "Iphrothokholi yokugunyaza ye-SNMPv3 ezenzakalelayo yawo wonke amadivayisi amasha."

#: include/global_settings.php
msgid "Auth User (v3)"
msgstr "Umsebenzisi wokufakazela (v3)"

#: include/global_settings.php
