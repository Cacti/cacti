#: include/global_settings.php
msgid "SMTP Password"
msgstr "Iphasiwedi ye-SMTP"

#: include/global_settings.php
msgid "The password to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Iphasiwedi yokufakazela ubuqiniso uma uthumela nge-SMTP. (Shiya kungenalutho uma ungadingi ukufakazela ubuqiniso.)"

#: include/global_settings.php
msgid "SMTP Security"
msgstr "Ukuvikeleka kwe-SMTP"

