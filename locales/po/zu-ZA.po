msgstr "Phelelisa Isikhathi Iphasiwedi"

#: include/global_settings.php
msgid "This is maximum number of days before a password is set to expire."
msgstr "Leli inani eliphakeme lezinsuku ngaphambi kokuba iphasiwedi ihlelelwe ukuphelelwa yisikhathi."

#: include/global_settings.php
msgid "Password History"
msgstr "Umlando Wephasiwedi"

#: include/global_settings.php
msgid "Remember this number of old passwords and disallow reusing them."
msgstr "Khumbula leli nani lamaphasiwedi amadala futhi wenqabele ukusetshenziswa kwawo futhi."

#: include/global_settings.php
msgid "1 Change"
msgstr "Ushintsho olu-1"

#: include/global_settings.php
#, php-format
msgid "%d Changes"
msgstr "Izinguquko ezi-%d"

#: include/global_settings.php
msgid "Account Locking"
msgstr "Ukukhiya I-akhawunti"

#: include/global_settings.php
msgid "Lock Accounts"
msgstr "Khiya Ama-akhawunti"

#: include/global_settings.php
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "Khiya i-akhawunti ngemva kwale mizamo ehlulekile ehoreni elingu-1."

#: include/global_settings.php
msgid "1 Attempt"
msgstr "Umzamo O-1"

#: include/global_settings.php
#, php-format
msgid "%d Attempts"
msgstr "Imizamo Engu-%d"

#: include/global_settings.php
msgid "Auto Unlock"
msgstr "Vula Ngokuzenzakalelayo"

#: include/global_settings.php
msgid "An account will automatically be unlocked after this many minutes.  Even if the correct password is entered, the account will not unlock until this time limit has been met.  Max of 1440 minutes (1 Day)"
msgstr "I-akhawunti izovulwa ngokuzenzakalelayo ngemva kwale mizuzu. Ngisho noma kufakwe iphasiwedi efanele, i-akhawunti ngeke ivuleke kuze kufinyelelwe lo mkhawulo wesikhathi. Ubuningi imizuzu engu-1440 (Usuku Olu-1)"

#: include/global_settings.php
msgid "1 Day"
msgstr "Usuku Olu-1"

#: include/global_settings.php
msgid "LDAP General Settings"
msgstr "Izilungiselelo Ezijwayelekile ze-LDAP"

#: include/global_settings.php user_domains.php
msgid "Server(s)"
msgstr "Iseva(amaseva)"

#: include/global_settings.php user_domains.php
msgid "A space delimited list of DNS hostnames or IP addresses for valid LDAP servers.  Cacti will attempt to use the LDAP servers from left to right to authenticate a user.<br><br>For One-Time Password (OTP/MFA) logins, do not use a space delimited multi-server list.  On a failed bind Cacti advances to the next server and re-binds with the same credentials, and the already-consumed one-time code will be rejected.  Instead enter a single, resilient DNS name fronted by a DNS load balancer (VIP) so that server failover is handled below Cacti and only one authentication bind is ever performed."
msgstr "Uhlu oluhlukaniswe ngesikhala lwamagama e-host e-DNS noma amakheli e-IP amaseva e-LDAP avumelekile. I-Cacti izozama ukusebenzisa amaseva e-LDAP ukusuka kwesobunxele kuya kwesokudla ukuze iqinisekise umsebenzisi.<br><br>Ekungeneni ngePhasiwedi Yesikhathi Esisodwa (OTP/MFA), ungasebenzisi uhlu lwamaseva amaningi oluhlukaniswe ngesikhala. Uma ukubopha (bind) kwehluleka, i-Cacti idlulela kuseva elandelayo futhi izame ukubopha futhi ngemininingwane efanayo, kanti ikhodi yesikhathi esisodwa esivele isetshenzisiwe izokwenqatshwa. Kunalokho, faka igama elilodwa le-DNS elizinzile eliholwa yi-DNS load balancer (VIP) ukuze ukushintshwa kweseva (failover) kusingathwe ngaphansi kwe-Cacti futhi kwenziwe ukubopha kokuqinisekisa okukodwa kuphela."

#: include/global_settings.php user_domains.php
msgid "Port Standard"
msgstr "Imbobo Ejwayelekile"

#: include/global_settings.php
msgid "TCP port for Non-SSL communications including LDAP + TLS.  Default is 389."
msgstr "Imbobo ye-TCP yokuxhumana okungekona okwe-SSL okubandakanya i-LDAP + TLS. Okuzenzakalelayo ngu-389."

#: include/global_settings.php user_domains.php
msgid "Port SSL"
msgstr "Imbobo ye-SSL"

#: include/global_settings.php
msgid "TCP port for LDAPS for SSL communications.  Default is 636."
msgstr "Imbobo ye-TCP ye-LDAPS yokuxhumana kwe-SSL. Okuzenzakalelayo ngu-636."

#: include/global_settings.php user_domains.php
msgid "Protocol Version"
msgstr "Inguqulo Yephrothokholi"

#: include/global_settings.php
msgid "Protocol Version to connect to the server with."
msgstr "Inguqulo Yephrothokholi yokuxhuma kuseva ngayo."

#: include/global_settings.php
msgid "Connect Timeout"
msgstr "Isikhathi Sokuphela Kokuxhuma"

#: include/global_settings.php
msgid "The Network Connect Timeout in seconds."
msgstr "Isikhathi Sokuphela Kokuxhuma Kwenethiwekhi ngamasekhondi."

#: include/global_settings.php
msgid "Bind Timeout"
msgstr "Ukuphela Kwesikhathi Se-Bind"

#: include/global_settings.php
msgid "The Bind Timeout in seconds."
msgstr "Isikhathi Sokuphela Kokubopha ngamasekhondi."

#: include/global_settings.php
msgid "LDAP Debug Mode"
msgstr "Imodi Yokulungisa Iphutha ye-LDAP"

#: include/global_settings.php
msgid "If Checked Cacti will log extra LDAP information to the Cacti log during Binding and Searching activities."
msgstr "Uma Kumakiwe i-Cacti izorekhoda ulwazi olwengeziwe lwe-LDAP kulogi ye-Cacti ngesikhathi semisebenzi yokubopha nokusesha."

#: include/global_settings.php user_domains.php
msgid "Encryption"
msgstr "Ukubethela"

#: include/global_settings.php
msgid "Encryption that the server supports. NOTE: When using LDAP + TLS you must use version 3."
msgstr "Ukubethela okusekelwa yiseva. QAPHELA: Uma usebenzisa i-LDAP + TLS kumele usebenzise inguqulo 3."

#: include/global_settings.php
msgid "TLS Certificate Requirements"
msgstr "Izidingo Zesitifiketi Se-TLS"

#: include/global_settings.php
msgid "Should LDAP verify TLS Certificates when received by the Client."
msgstr "Ingabe i-LDAP kufanele iqinisekise Izitifiketi Ze-TLS lapho zamukelwa Yiklayenti."

#: include/global_settings.php user_domains.php
msgid "Referrals"
msgstr "Ukudluliselwa"

#: include/global_settings.php user_domains.php
msgid "Enable or Disable LDAP referrals.  If disabled, it may increase the speed of searches."
msgstr "Nika amandla noma khubaza ukudluliselwa kwe-LDAP. Uma kukhutshaziwe, kungakhuphula isivinini sokusesha."

#: include/global_settings.php user_domains.php
msgid "Mode"
msgstr "Imodi"

#: include/global_settings.php
msgid "Mode which cacti will attempt to authenticate against the LDAP server.<blockquote><i>No Searching</i> - No Distinguished Name (DN) searching occurs, just attempt to bind with the provided Distinguished Name (DN) format.<br><br><i>Anonymous Searching</i> - Attempts to search for username against LDAP directory via anonymous binding to locate the user's Distinguished Name (DN).<br><br><i>Specific Searching</i> - Attempts search for username against LDAP directory via Specific Distinguished Name (DN) and Specific Password for binding to locate the user's Distinguished Name (DN).<br><br><i>One-Time Passwords (OTP/MFA)</i> - Cacti binds the user's password only once, during final authentication.  <i>No Searching</i> performs no directory lookup and binds directly using the Distinguished Name (DN) template, so it is safe for OTP when the DN template alone identifies the user.  When a directory lookup is required to resolve the DN, use <i>Specific Searching</i> with a dedicated service account (or <i>Anonymous Searching</i> where the directory permits it) so the lookup never consumes the user's single-use code.  For resilient OTP deployments use a single DNS load balancer name in the Server(s) field rather than a space delimited multi-server list, which would re-attempt the bind with an already-consumed one-time password."
msgstr "Indlela lapho i-Cacti izozama khona ukuqinisekisa ukuba ngumsebenzisi kweseva ye-LDAP.<blockquote><i>Akukho Ukusesha</i> - Akukho ukusesha kwe-Distinguished Name (DN) okwenzekayo, izama nje ukuxhuma ngefomethi ye-Distinguished Name (DN) enikeziwe.<br><br><i>Ukusesha Okungaziwa</i> - Izama ukusesha igama lomsebenzisi kuhla lwemibhalo lwe-LDAP ngokuxhuma okungaziwa ukuthola i-Distinguished Name (DN) yomsebenzisi.<br><br><i>Ukusesha Okuqondile</i> - Izama ukusesha igama lomsebenzisi kuhla lwemibhalo lwe-LDAP nge-Distinguished Name (DN) Eqondile kanye Nephasiwedi Eqondile yokuxhuma ukuze ithole i-Distinguished Name (DN) yomsebenzisi.<br><br><i>Amaphasiwedi Esikhathi Esinye (OTP/MFA)</i> - I-Cacti ixhuma iphasiwedi yomsebenzisi kanye kuphela, ngesikhathi sokuqinisekisa okokugcina. <i>Akukho Ukusesha</i> akwenzi ukuhlola kohla lwemibhalo futhi kuxhuma ngqo kusetshenziswa isifanekiso se-Distinguished Name (DN), ngakho kuphephile ku-OTP uma isifanekiso se-DN sodwa sikhomba umsebenzisi. Uma ukuhlola kohla lwemibhalo kudingeka ukuxazulula i-DN, sebenzisa <i>Ukusesha Okuqondile</i> nge-akhawunti yesevisi ezinikele (noma <i>Ukusesha Okungaziwa</i> lapho uhla lwemibhalo lukuvumela khona) ukuze ukuhlola kungaze kudle ikhodi yomsebenzisi esetshenziswa kanye kuphela. Ekusetshenzisweni kwe-OTP okuqinile sebenzisa igama elilodwa le-load balancer ye-DNS enkundleni ethi Amaseva kunohlu lwamaseva amaningi oluhlukaniswe ngezikhala, olungazama ukuxhuma futhi ngephasiwedi yesikhathi esinye esesetshenzisiwe."

#: include/global_settings.php user_domains.php
msgid "Distinguished Name (DN)"
msgstr "Igama Elihlukile (DN)"

#: include/global_settings.php user_domains.php
msgid "The \"Distinguished Name\" syntax, applicable for both OpenLDAP and Windows AD configurations, offers flexibility in defining user identity. For OpenLDAP, the format follows this structure: <i>\"uid=&lt;username&gt;,ou=people,dc=domain,dc=local\"</i>. Windows AD provides an alternative syntax: <i>\"&lt;username&gt;@win2kdomain.local\"</i>, commonly known as \"userPrincipalName (UPN)\". In this context, \"&lt;username&gt;\" represents the specific username provided during the login prompt. This is particularly pertinent when operating in \"No Searching\" mode, or \"Require Group Membership\" enabled."
msgstr "Uhlelo lwe-\"Igama Elihlukile\" (Distinguished Name), olusebenza kuzo zombili izilungiselelo ze-OpenLDAP neze-Windows AD, lunikeza ukuguquguquka ekuchazeni ubuwena bomsebenzisi. Ku-OpenLDAP, ifomethi ilandela lesi sakhiwo: <i>\"uid=&lt;username&gt;,ou=people,dc=domain,dc=local\"</i>. I-Windows AD inikeza olunye uhlelo: <i>\"&lt;username&gt;@win2kdomain.local\"</i>, oluvame ukwaziwa ngokuthi i-\"userPrincipalName (UPN)\". Kulo mongo, u-\"&lt;username&gt;\" umele igama lomsebenzisi eliqondile elinikezwe ngesikhathi sokucelwa kokungena. Lokhu kubaluleke kakhulu uma usebenza kumodi ye-\"Akukho Ukusesha\", noma uma u-\"Dinga Ubulungu Beqembu\" unikwe amandla."

#: include/global_settings.php user_domains.php
msgid "Require Group Membership"
msgstr "Dinga Ubulungu Beqembu"

#: include/global_settings.php user_domains.php
msgid "Require user to be member of group to authenticate. Group settings must be set for this to work, enabling without proper group settings will cause authentication failure."
msgstr "Dinga ukuthi umsebenzisi abe yilungu leqembu ukuze aqinisekiswe. Izilungiselelo zeqembu kufanele zisethwe ukuze lokhu kusebenze, ukunika amandla ngaphandle kwezilungiselelo zeqembu ezifanele kuzodala ukwehluleka kokuqinisekisa."

#: include/global_settings.php user_domains.php
msgid "LDAP Group Settings"
msgstr "Izilungiselelo Zeqembu Le-LDAP"

#: include/global_settings.php user_domains.php
msgid "Group Distinguished Name (DN)"
msgstr "Igama Elihlukile Leqembu (DN)"

#: include/global_settings.php user_domains.php
msgid "Distinguished Name of the group that user must have membership."
msgstr "I-Distinguished Name yeqembu lapho umsebenzisi kufanele abe nobulungu khona."

#: include/global_settings.php user_domains.php
msgid "Group Member Attribute"
msgstr "Isibaluli Selungu Leqembu"

#: include/global_settings.php user_domains.php
msgid "This refers to the specific attribute within the LDAP directory that holds the usernames of group members. It is crucial to ensure that the attribute value aligns with the configuration specified in the \"Distinguished Name\" or that the actual attribute value is searchable using the settings outlined in the \"Distinguished Name\"."
msgstr "Lokhu kubhekisela kusibaluli esiqondile ngaphakathi kohla lwe-LDAP esigcina amagama abasebenzisi bamalungu eqembu. Kubaluleke kakhulu ukuqinisekisa ukuthi inani lesibaluli lihambisana nokulungiselelwe okushiwo ku-\"Igama Elihlukile\" (Distinguished Name) noma ukuthi inani langempela lesibaluli liyasesheka kusetshenziswa izilungiselelo ezivezwe ku-\"Igama Elihlukile\"."

#: include/global_settings.php user_domains.php
msgid "Group Member Type"
msgstr "Uhlobo Lwelungu Leqembu"

#: include/global_settings.php user_domains.php
msgid "Defines if users use full Distinguished Name or just Username in the defined Group Member Attribute."
msgstr "Kuchaza ukuthi abasebenzisi basebenzisa Igama Elihlukile (DN) eligcwele noma Igama Lomsebenzisi kuphela Kusibaluli Selungu Leqembu esichaziwe."

#: include/global_settings.php
msgid "Distinguished Name"
msgstr "I-Distinguished Name"

#: include/global_settings.php user_domains.php
msgid "LDAP Specific Search Settings"
msgstr "Izilungiselelo Zokusesha Okuqondile Kwe-LDAP"

#: include/global_settings.php user_domains.php
msgid "Search Base"
msgstr "Isisekelo Sokusesha"

#: include/global_settings.php
msgid "Search base for searching the LDAP directory, such as <i>'dc=win2kdomain,dc=local'</i> or <i>'ou=people,dc=domain,dc=local'</i>."
msgstr "Isisekelo sokusesha sokusesha uhla lwemibhalo lwe-LDAP, njengokuthi <i>'dc=win2kdomain,dc=local'</i> noma <i>'ou=people,dc=domain,dc=local'</i>."

#: include/global_settings.php user_domains.php
msgid "Search Filter"
msgstr "Isihlungi Sokusesha"

#: include/global_settings.php
msgid "Search filter to use to locate the user in the LDAP directory, such as for windows: <i>'(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))'</i> or for OpenLDAP: <i>'(&(objectClass=account)(uid=&lt;username&gt))'</i>.  '&lt;username&gt' is replaced with the username that was supplied at the login prompt. "
msgstr "Isihlungi sokusesha esizosetshenziswa ukuthola umsebenzisi kuhla lwemibhalo lwe-LDAP, njengase-Windows: <i>'(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))'</i> noma ku-OpenLDAP: <i>'(&(objectClass=account)(uid=&lt;username&gt))'</i>.  '&lt;username&gt' ishintshwa ngegama lomsebenzisi elinikezwe emyalweni wokungena ngemvume. "

#: include/global_settings.php user_domains.php
msgid "Search Distinguished Name (DN)"
msgstr "Igama Elihlukile Lokusesha (DN)"

#: include/global_settings.php user_domains.php
msgid "Distinguished Name for Specific Searching binding to the LDAP directory."
msgstr "Igama Elihlukile lokuhlangana Lokusesha Okukhethekile kuhla lwemibhalo lwe-LDAP."

#: include/global_settings.php user_domains.php
msgid "Search Password"
msgstr "Iphasiwedi Yokusesha"

#: include/global_settings.php user_domains.php
msgid "Password for Specific Searching binding to the LDAP directory."
msgstr "Iphasiwedi yokuhlangana Lokusesha Okukhethekile kuhla lwemibhalo lwe-LDAP."

#: include/global_settings.php user_domains.php
msgid "LDAP CN Settings"
msgstr "Izilungiselelo Ze-CN Ye-LDAP"

#: include/global_settings.php user_domains.php
msgid "Field that will replace the Full Name when creating a new user, taken from LDAP. (on windows: displayname) "
msgstr "Inkundla ezongena esikhundleni Segama Eligcwele lapho kwakhiwa umsebenzisi omusha, ethathwe ku-LDAP. (ku-Windows: displayname) "

