msgstr "Омогући локализовану 2FA"

#: include/global_settings.php
msgid "Check this option if you wish users to locally enable Two Factor Authentication for their accounts.  Note that most Enterprise level MFA does not require intervention by the Cacti Administrator."
msgstr "Означите ову опцију ако желите да корисници локално омогуће двофакторску аутентификацију за своје налоге. Напомена: већина MFA решења на нивоу предузећа не захтева интервенцију Cacti администратора."

#: include/global_settings.php
msgid "Token Lifetime"
msgstr "Трајање токена"

#: include/global_settings.php
msgid "How long the Two Factor Auth Token lasts before being rechecked up to a max of 1 week."
msgstr "Колико дуго важи токен двофакторске аутентификације пре поновне провере, највише до 1 недеље."

#: include/global_settings.php
msgid "Basic Authentication Settings"
msgstr "Подешавања основне аутентификације"

#: include/global_settings.php
msgid "Basic Auth Login Failure Message"
msgstr "Порука о неуспешној пријави код основне аутентификације"

#: include/global_settings.php
msgid "When using basic authentication, if there are issues mapping the username to a valid Cacti account, the message included here will be displayed to users.  It can include both text and HTML."
msgstr "Када користите основну аутентификацију, ако дође до проблема при мапирању корисничког имена на важећи Cacti налог, корисницима ће бити приказана порука унета овде. Може да садржи и текст и HTML."

#: include/global_settings.php
msgid "Basic Auth Mapfile"
msgstr "Датотека за мапирање основне аутентификације"

#: include/global_settings.php
msgid "When using basic authentication, if the basic account needs to be translated to a different login account, you can specify a CSV file here to map the basic account to the desired login account."
msgstr "Када користите основну аутентификацију, ако основни налог треба превести у други налог за пријаву, овде можете навести CSV датотеку за мапирање основног налога на жељени налог за пријаву."

#: include/global_settings.php
msgid "Local Account Complexity Requirements"
msgstr "Захтеви за сложеност локалног налога"

#: include/global_settings.php
msgid "Minimum Length"
msgstr "Минимална дужина"

#: include/global_settings.php
msgid "This is minimal length of allowed passwords."
msgstr "Ово је минимална дужина дозвољених лозинки."

#: include/global_settings.php
msgid "Require Mix Case"
msgstr "Захтевај велика и мала слова"

#: include/global_settings.php
msgid "This will require new passwords to contains both lower and upper-case characters."
msgstr "Ово ће захтевати да нове лозинке садрже и мала и велика слова."

#: include/global_settings.php
msgid "Require Number"
msgstr "Захтевај број"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 numerical character."
msgstr "Ово ће захтевати да нове лозинке садрже најмање 1 нумерички знак."

#: include/global_settings.php
msgid "Require Special Character"
msgstr "Захтевај специјални знак"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 special character."
msgstr "Ово ће захтевати да нове лозинке садрже најмање 1 специјални знак."

#: include/global_settings.php
msgid "Force Complexity Upon Old Passwords"
msgstr "Наметни сложеност старим лозинкама"

#: include/global_settings.php
msgid "This will require all old passwords to also meet the new complexity requirements upon login.  If not met, it will force a password change."
msgstr "Ово ће захтевати да све старе лозинке такође испуњавају нове захтеве сложености приликом пријављивања. Ако не испуњавају, биће наметнута промена лозинке."

#: include/global_settings.php
msgid "Expire Inactive Accounts"
msgstr "Истек неактивних налога"

#: include/global_settings.php
msgid "This is maximum number of days before inactive accounts are disabled.  The Admin account is excluded from this policy."
msgstr "Ово је максималан број дана пре него што неактивни налози буду онемогућени. Admin налог је изузет из ове политике."

#: include/global_settings.php
msgid "Expire Password"
msgstr "Истек лозинке"

#: include/global_settings.php
msgid "This is maximum number of days before a password is set to expire."
msgstr "Ово је максималан број дана пре него што лозинка истекне."

#: include/global_settings.php
msgid "Password History"
msgstr "Историја лозинки"

#: include/global_settings.php
msgid "Remember this number of old passwords and disallow reusing them."
msgstr "Запамти овај број старих лозинки и онемогући њихово поновно коришћење."

#: include/global_settings.php
