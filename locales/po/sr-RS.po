#: include/global_settings.php
msgid "Monthly on Sunady"
msgstr "Месечно недељом"

#: include/global_settings.php
msgid "Background Timeout and Concurrent Process Settings"
msgstr "Подешавања временског ограничења у позадини и истовремених процеса"

#: include/global_settings.php
msgid "Report Generation Timeout"
msgstr "Временско ограничење за генерисање извештаја"

