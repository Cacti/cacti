msgstr "LDAP атрибут који ће попунити пуно име новог корисника, нпр. \"displayName\" на Active Directory или \"cn\" на већини OpenLDAP сервера."

#: login_providers.php
msgid "Email Attribute"
msgstr "Атрибут е-поште"

