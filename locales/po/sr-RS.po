msgid "Field that will replace the Email taken from LDAP. (on windows: mail)"
msgstr "Поље које ће заменити е-пошту преузету из LDAP-а. (на Windows-у: mail)"

#: include/global_settings.php
msgid "URL Linking"
msgstr "URL повезивање"

