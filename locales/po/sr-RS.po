msgstr "Онемогући функцију закључавања система Cacti"

#: include/global_settings.php
msgid "Primary Admin (all logins)"
msgstr "Примарни администратор (све пријаве)"

#: include/global_settings.php
msgid "Primary Admin (lockout session only)"
msgstr "Примарни администратор (само сесија закључавања)"

#: include/global_settings.php
