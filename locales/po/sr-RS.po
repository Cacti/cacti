msgstr "Фонт који се користи за легенде графикона. Унесите или важећу True Type Font датотеку или важећу Pango font-config вредност."

#: include/global_settings.php
msgid "Axis Font Size"
msgstr "Величина фонта осе"

#: include/global_settings.php
msgid "The size of the font used for Graph Axis"
msgstr "Величина фонта који се користи за осе графикона"

#: include/global_settings.php
msgid "Axis Font Setting"
msgstr "Подешавање фонта осе"

#: include/global_settings.php
msgid "The font to use for Graph Axis items.  Enter either a valid True Type Font file or valid Pango font-config value."
msgstr "Фонт који се користи за ставке оса графикона. Унесите или важећу True Type Font датотеку или важећу Pango font-config вредност."

#: include/global_settings.php
