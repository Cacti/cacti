msgstr "Подешавања статуса активан/недоступан"

#: include/global_settings.php
msgid "Failure Count"
msgstr "Број неуспеха"

#: include/global_settings.php
msgid "The number of polling intervals a Device must be down before logging an error and reporting Device as down."
msgstr "Број интервала анкетирања током којих уређај мора бити недоступан пре него што се забележи грешка и уређај пријави као недоступан."

#: include/global_settings.php
msgid "Recovery Count"
