msgstr "Изаберите упит података који ће се применити на ово правило."

#: include/global_form.php
msgid "Choose any of the available Graph Types to apply to this rule."
msgstr "Изаберите било који од доступних типова графикона који ће се применити на ово правило."

#: include/global_form.php
msgid "Enable Rule"
msgstr "Омогући правило"

#: include/global_form.php
msgid "Check this box to enable this rule."
msgstr "Означите ово поље да бисте омогућили ово правило."

#: include/global_form.php
msgid "Choose a Tree for the new Tree Items."
msgstr "Изаберите стабло за нове ставке стабла."

#: include/global_form.php
msgid "The Item Type that shall be dynamically added to the tree."
msgstr "Тип ставке који ће бити динамички додат у стабло."

#: include/global_form.php
msgid "Choose how graphs are grouped when drawn for this particular host on the tree."
msgstr "Изаберите како се графикони групишу приликом исцртавања за овог одређеног домаћина на стаблу."

#: include/global_form.php
msgid "Optional: Sub-Tree Item"
msgstr "Опционо: ставка подстабла"

#: include/global_form.php
msgid "Choose a Sub-Tree Item to hook in.<br>Make sure, that it is still there when this rule is executed!"
msgstr "Изаберите ставку подстабла за повезивање.<br>Уверите се да је и даље ту када се ово правило изврши!"

#: include/global_form.php
msgid "Choose an Object to build a new Sub-header."
msgstr "Изаберите објекат за прављење новог подзаглавља."

#: include/global_form.php
msgid "Propagate Changes"
msgstr "Пропагирај измене"

#: include/global_form.php
msgid "Propagate all options on this form (except for 'Title') to all child 'Header' items."
msgstr "Пропагирај све опције са овог обрасца (осим поља 'Наслов') на све подређене ставке 'Заглавље'."

#: include/global_form.php
msgid "The String Pattern (Regular Expression) to match against.<br>Enclosing '/' must <strong>NOT</strong> be provided!"
msgstr "Образац ниске (регуларни израз) са којим се врши подударање.<br>Ограђујући '/' <strong>НЕ</strong> сме бити наведен!"

#: include/global_form.php lib/api_automation.php
msgid "Replacement Pattern"
msgstr "Образац замене"

#: include/global_form.php
msgid "The Replacement String Pattern for use as a Tree Header.<br>Refer to a Match by e.g. <strong>\\${1}</strong> for the first match!"
msgstr "Образац ниске замене за коришћење као заглавље стабла.<br>На подударање се позовите, на пример, помоћу <strong>\\${1}</strong> за прво подударање!"

