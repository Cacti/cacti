msgstr "Приказуј радно време само радним данима."

#: include/global_settings.php
msgid "Show business hours"
msgstr "Прикажи радно време"

#: include/global_settings.php
msgid "Display business hours on rrd graphs."
msgstr "Прикажи радно време на rrd графиконима."

#: include/global_settings.php
msgid "Color to use for business hours"
msgstr "Боја која се користи за радно време"

#: include/global_settings.php
msgid "The color to be shown for business hours"
msgstr "Боја која се приказује за радно време"

#: include/global_settings.php
