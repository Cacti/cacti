#: include/global_settings.php
msgid "Enable Lotus Notes (R) tweak"
msgstr "Омогући прилагођавање за Lotus Notes (R)"

#: include/global_settings.php
msgid "Enable code tweak for specific handling of Lotus Notes Mail Clients."
msgstr "Омогући прилагођавање кода за посебно руковање клијентима е-поште Lotus Notes."

#: include/global_settings.php
msgid "DNS Options"
msgstr "DNS опције"

#: include/global_settings.php
msgid "Primary DNS IP Address"
msgstr "Примарна DNS IP адреса"

#: include/global_settings.php
msgid "Enter the primary DNS IP Address to utilize for reverse lookups."
msgstr "Унесите примарну DNS IP адресу која ће се користити за обрнуте претраге."

#: include/global_settings.php
