msgstr "Формат идентификатора субјекта који ће Cacti затражити од пружаоца идентитета."

#: login_providers.php
msgid "Persistent"
msgstr "Трајни"

#: login_providers.php
msgid "Sign AuthnRequests"
msgstr "Потпиши AuthnRequests"

#: login_providers.php
