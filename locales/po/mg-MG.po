msgstr "Fantaro ho azy amin'ny famerenana fanondroana"

#: include/global_form.php
msgid "Auto Detect/Set on first Re-Index"
msgstr "Fantaro/Apetraho ho azy amin'ny famerenana fanondroana voalohany"

