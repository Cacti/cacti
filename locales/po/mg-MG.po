msgstr "Mpampiasa fanamarinana SNMP v3 voafaritra mialoha ho an'ireo Fitaovana vaovao rehetra."

#: include/global_settings.php
msgid "Auth Passphrase (v3)"
msgstr "Andian-tenimiafina fanamarinana (v3)"

#: include/global_settings.php
msgid "Default SNMP v3 Authorization Passphrase for all new Devices."
msgstr "Andian-tenimiafina fanamarinana SNMP v3 voafaritra mialoha ho an'ireo Fitaovana vaovao rehetra."

#: include/global_settings.php
msgid "Privacy Protocol (v3)"
msgstr "Prôtôkôly tsiambaratelo (v3)"

#: include/global_settings.php
msgid "Default SNMPv3 Privacy Protocol for all new Devices."
msgstr "Prôtôkôly tsiambaratelo SNMPv3 voafaritra mialoha ho an'ireo Fitaovana vaovao rehetra."

#: include/global_settings.php
msgid "Privacy Passphrase (v3)"
msgstr "Andian-tenimiafina tsiambaratelo (v3)"

