#: include/global_settings.php
msgid "Auth Protocol (v3)"
msgstr "Prôtôkôly fanamarinana (v3)"

#: include/global_settings.php
msgid "Default SNMPv3 Authorization Protocol for all new Devices."
msgstr "Prôtôkôly fanamarinana SNMPv3 voafaritra mialoha ho an'ireo Fitaovana vaovao rehetra."

#: include/global_settings.php
