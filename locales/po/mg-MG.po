msgstr "Mpizara voalohany vaovao"

#: lib/installer.php
msgid "New Remote Poller"
msgstr "Poller lavitra vaovao"

#: lib/installer.php
msgid "Remote Pollers are used to access networks that are not readily accessible to the Primary site."
msgstr "Ny Poller lavitra dia ampiasaina hidirana amin'ny tambajotra izay tsy mora idiran'ny toerana voalohany."

#: lib/installer.php
msgid "The following information has been determined from Cacti's configuration file. If it is not correct, please edit \"include/config.php\" before continuing."
msgstr "Ireto fampahalalana manaraka ireto dia hita avy amin'ny rakitra kirakiran'ny Cacti. Raha tsy marina izany, dia ahitsio ny \"include/config.php\" alohan'ny hanohizana."

#: lib/installer.php
msgid "Local Database Connection Information"
msgstr "Fampahalalana momba ny fifandraisana amin'ny angon-drakitra eo an-toerana"

#: lib/installer.php
#, php-format
msgid "Database: <b>%s</b>"
msgstr "Angon-drakitra: <b>%s</b>"

#: lib/installer.php
#, php-format
msgid "Database User: <b>%s</b>"
msgstr "Mpampiasa ny angon-drakitra: <b>%s</b>"

#: lib/installer.php
#, php-format
msgid "Database Hostname: <b>%s</b>"
msgstr "Anaran'ny mpampiantrano ny angon-drakitra: <b>%s</b>"

