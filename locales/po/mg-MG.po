#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Andian-tsoratra mahazatra ampiasain'ny lohamilina."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "oh. utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Andian-tsoratra ampiasain'ny mpanjifa rehefa mandefa baiko any amin'ny lohamilina."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Isan'ny fifandraisan'ny mpanjifa miaraka be indrindra azo ekena."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Isa feno; 151 no mahazatra. Omeo ampy ho an'ireo mpanangona angona miampy ny fidiran'ny mpampiasa."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Anarana taloha ho an'ny cache-n'ny tabilao misokatra; novaina ho table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Isa feno. Ampiasao ny table_open_cache amin'ny mpizara maoderina."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Haben'ny fonosana iray na tady voaforona/anelanelany fara-fahabetsany."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Octets; tazomy ho 16M na mihoatra ho an'ny mpanangona angona lavitra."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Habe fara-fahabetsany mety hitomboan'ny tabilao MEMORY noforonin'ny mpampiasa."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Octets; ferana mifanaraka amin'ny fitambaran'ny fitadidian'ny rafitra."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Habe fara-fahabetsany ho an'ny tabilao vonjimaika anatiny ao anaty fitadidiana alohan'ny hamindrana azy any amin'ny kapila."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Octets; ny sanda lehibe kokoa dia mitazona ny tabilao vonjimaika ao anaty fitadidiana."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Habe farany ambany ho an'ny buffer isaky ny fampifandraisana ho an'ny fampifandraisana tsy mampiasa tondro."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Octets; fanokanana isaky ny fifandraisana, 262144 amin'ny fomba mahazatra."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "Buffer isaky ny fivoriana voatokana ho an'ny fandaminana (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Octets; fanokanana isaky ny fifandraisana, 2097152 amin'ny fomba mahazatra."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Mitahiry ny tabilao InnoDB tsirairay sy ny tondrony ao amin'ny rakitra tablespace .ibd azy manokana."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON na OFF; soso-kevitra ny ON."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "Endriky ny rakitra InnoDB eo amin'ny kapila (Antelope na Barracuda); Barracuda sisa no hany endrika ankehitriny."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Mamela ny tovonan'ny fanalahidin'ny tondro lava mihoatra ny 767 octets (mitaky ny endrika Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 na OFF/0; alefa foana io fiasa io ankehitriny."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Fitambaran'ny fitadidiana ampiasain'ny InnoDB hitahirizana vonjimaika ny angon'ny tabilao sy ny tondro."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Octets; matetika 25%-80% amin'ny fitambaran'ny fitadidian'ny rafitra."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Manoratra ny pejy indroa (ny doublewrite buffer) mba hiarovana amin'ny fanoratana pejy tsy feno."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON na OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "Fitehirizana taloha ho an'ny rakibolana angona anatiny sy ny rafitra InnoDB."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Octets; lany andro amin'ny mpizara maoderina."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Segondra hiandrasan'ny fifanakalozana InnoDB ny fanidiana andalana alohan'ny hijanonana."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Segondra; 50 amin'ny fomba mahazatra."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Fomba ampiasaina hanosehana ny angona sy ny rakitra tatitra any amin'ny kapila."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC, sy ny mitovy aminy."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Mifehy ny fomba fanoratana sy fanosehana ny redo log rehefa vita ny fifanakalozana."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1, na 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Fikirana tokana taloha ho an'ny thread I/O-n'ny rakitra InnoDB, nosoloina ny fikirana thread I/O famakiana/fanoratana."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Isa feno; nosoloan'ny innodb_read_io_threads sy innodb_write_io_threads."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Manoratra sy manosika ny redo log InnoDB isaky ny N segondra."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Segondra (1-2700); 1 amin'ny fomba mahazatra."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Isan'ny thread I/O ampiasaina amin'ny asa famakiana ao amin'ny InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; 4 amin'ny fomba mahazatra."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Isan'ny thread I/O ampiasaina amin'ny asa fanoratana ao amin'ny InnoDB."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Isan'ny faritra izarana ny buffer pool InnoDB."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; nesorin'ny MariaDB tamin'ny 10.6 izany."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Tomban'isan'ny asa I/O isan-tsegondra azo ampiasaina ho an'ny asa ao ambadiky ny InnoDB."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Isa feno; ampiasao sanda ambony kokoa ho an'ny fitehirizana SSD/NVMe."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "IOPS fara-fahabetsany azon'ny InnoDB ampiasaina rehefa tara ny fanosehana."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Manosika ny pejy voaova mifanila ao anatin'ny extent iray ihany rehefa manosika pejy iray."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1, na 2; ampiasao ny 0 amin'ny fitehirizana SSD."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Mampiasa fanoratana atômika ara-pitaovana (MariaDB) mba hahafahana manafoana am-pilaminana ny doublewrite buffer."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON na OFF; ho an'ny MariaDB ihany."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "Mampihatra fitokana-monina saripika hentitra ho an'ny fifanakalozana InnoDB."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON na OFF; naverina nampidirina tao amin'ny MariaDB 10.6.18+, 10.11.8+ ary 11.4.2+. Ataovy OFF ho an'ny mpanangona angona Cacti."

#: lib/utility.php
