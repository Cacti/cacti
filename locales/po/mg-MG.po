msgstr "Ny isa ambony indrindra amin'ny lahatahiry fitaovana hoforonina mifototra amin'ny ID-n'ny fitaovana voa-hash."

#: include/global_settings.php
msgid "Proxy Server"
msgstr "Mpizara mpanelanelana"

#: include/global_settings.php
msgid "The DNS hostname or IP address of the RRDtool proxy server."
msgstr "Ny anaran'ny mpampiantrano DNS na ny adiresy IP an'ny mpizara mpanelanelana RRDtool."

