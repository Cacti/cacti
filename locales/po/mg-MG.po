msgstr "Laharan'ny seranan'ny mpanelanelana"

#: include/global_settings.php
msgid "TCP port for encrypted communication."
msgstr "Seranana TCP ho an'ny fifandraisana voafenina."

#: include/global_settings.php utilities.php
msgid "RSA Fingerprint"
msgstr "Diantanana RSA"

#: include/global_settings.php
msgid "The fingerprint of the current public RSA key the proxy is using. This is required to establish a trusted connection."
msgstr "Ny diantanana an'ny fanalahidy RSA ho an'ny daholobe ampiasain'ny mpanelanelana amin'izao fotoana izao. Ilaina izany mba hanorenana fifandraisana azo itokisana."

#: include/global_settings.php
msgid "RRDtool Proxy Server - Backup"
msgstr "Mpizara mpanelanelana RRDtool - Tahiry fiarovana"

#: include/global_settings.php
