msgstr "Sanda farany ambony (\"U\" raha tsy misy farany ambony)"

#: include/global_form.php
msgid "The maximum value of data that is allowed to be collected."
msgstr "Ny sanda farany ambony amin'ny angona azo angonina."

#: include/global_form.php
msgid "Data Source Type"
msgstr "Karazana loharanom-baovao"

#: include/global_form.php
