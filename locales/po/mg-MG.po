msgstr "Safidio ny anarana tokana hisolo tena ity singa angona ity ao anatin'ny RRDfile."

#: include/global_form.php
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "Sanda farany ambany (\"U\" raha tsy misy farany ambany)"

#: include/global_form.php
