#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "Mpangilio chaguomsingi wa herufi unaotumiwa na seva wakati wa kuunda hifadhidata na majedwali."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "k.m. utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Seti ya herufi chaguomsingi inayotumiwa na seva."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "k.m. utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Seti ya herufi ambayo mteja hutumia anapotuma kauli kwa seva."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Idadi ya juu ya miunganisho ya wateja ya wakati mmoja inayoruhusiwa."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Nambari kamili; chaguomsingi 151. Ruhusu ya kutosha kwa wakusanyaji pamoja na kuingia kwa watumiaji."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Jina la zamani la kache ya majedwali yaliyo wazi; lilibadilishwa kuwa table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Nambari kamili. Tumia table_open_cache kwenye seva za kisasa."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Kiwango cha juu cha ukubwa wa pakiti moja au tungo yoyote iliyozalishwa/ya kati."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Baiti; weka kwenye 16M au zaidi kwa wakusanyaji wa mbali."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Kiwango cha juu cha ukubwa ambacho majedwali ya MEMORY yaliyoundwa na mtumiaji yanaweza kufikia."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Baiti; hupimwa kulingana na jumla ya kumbukumbu ya mfumo."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Kiwango cha juu cha ukubwa wa majedwali ya muda ya ndani kwenye kumbukumbu kabla hayajahamia kwenye diski."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Baiti; thamani kubwa zaidi huweka majedwali ya muda kwenye kumbukumbu."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Kiwango cha chini cha ukubwa wa bafa kwa kila muungano kwa miungano isiyotumia faharasa."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Baiti; mgao kwa kila muunganisho, chaguo-msingi 262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "Bafa kwa kila kipindi iliyotengwa kwa upangaji (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Baiti; mgao kwa kila muunganisho, chaguo-msingi 2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Hifadhi kila jedwali la InnoDB na faharasa zake katika faili yake binafsi ya tablespace ya .ibd."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON au OFF; ON inapendekezwa."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "Muundo wa faili wa InnoDB kwenye diski (Antelope au Barracuda); Barracuda sasa ndio muundo pekee."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Ruhusu viambishi awali vya ufunguo wa faharasa virefu kuliko baiti 767 (inahitaji muundo wa Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 au OFF/0; tabia hii sasa huwashwa kila wakati."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Jumla ya kumbukumbu ambayo InnoDB hutumia kuhifadhi data ya majedwali na faharasa kwenye kache."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Baiti; kwa kawaida 25%-80% ya jumla ya kumbukumbu ya mfumo."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Andika kurasa mara mbili (bafa ya doublewrite) ili kulinda dhidi ya uandikaji wa kurasa usio kamili."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON au OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "Hifadhi ya zamani ya kamusi ya ndani ya data ya InnoDB na miundo yake."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Baiti; imepitwa na wakati kwenye seva za kisasa."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Sekunde ambazo muamala wa InnoDB husubiri kufuli ya safu mlalo kabla ya kusitisha."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Sekunde; chaguo-msingi 50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Mbinu inayotumika kuandika moja kwa moja data na faili za kumbukumbu kwenye diski."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC, na zinazofanana."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Hudhibiti jinsi kumbukumbu ya redo inavyoandikwa na kusukumwa kwenye diski wakati wa uthibitishaji wa muamala."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1, au 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Mpangilio mmoja wa zamani wa nyuzi za I/O za faili za InnoDB, uliobadilishwa na mipangilio ya nyuzi za I/O za kusoma/kuandika."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Nambari kamili; ilipitwa na kuchukuliwa nafasi na innodb_read_io_threads na innodb_write_io_threads."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Andika na usukume kwenye diski kumbukumbu ya redo ya InnoDB kila sekunde N."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Sekunde (1-2700); chaguo-msingi 1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Idadi ya nyuzi za I/O zinazotumika kwa shughuli za kusoma katika InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; chaguo-msingi 4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Idadi ya nyuzi za I/O zinazotumika kwa shughuli za kuandika katika InnoDB."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Idadi ya sehemu ambazo hifadhi ya bafa ya InnoDB imegawanywa."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; MariaDB iliondoa hii katika toleo la 10.6."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Kadirio la shughuli za I/O kwa sekunde zinazopatikana kwa kazi za chinichini za InnoDB."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Nambari kamili; tumia thamani za juu zaidi kwa hifadhi ya SSD/NVMe."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "Kiwango cha juu cha IOPS ambacho InnoDB inaweza kutumia wakati uandikaji kwenye diski unapochelewa."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Andika kwenye diski kurasa jirani zisizohifadhiwa katika sehemu moja unapohamisha ukurasa."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1, au 2; tumia 0 kwenye hifadhi ya SSD."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Tumia uandikaji atomiki wa maunzi (MariaDB) ili bafa ya doublewrite iweze kuzimwa kwa usalama."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON au OFF; MariaDB pekee."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "Tekeleza utenganishaji mkali wa picha ya muda kwa miamala ya InnoDB."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON au OFF; imerejeshwa kwa matoleo ya awali ya MariaDB 10.6.18+, 10.11.8+ na 11.4.2+. Weka OFF kwa mkusanyaji wa Cacti."

