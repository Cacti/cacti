msgstr "Edebebeghị data na nchekwa data MySQL TimeZone gị.  Biko tinye data na nchekwa data a tupu ịga n'ihu."

#: lib/installer.php
msgid "Your Cacti database login account does not have access to the MySQL TimeZone database.  Please provide the Cacti database account \"select\" access to the \"time_zone_name\" table in the \"mysql\" database, and populate MySQL's TimeZone information before proceeding."
msgstr "Akaụntụ nbanye nchekwa data Cacti gị enweghị ohere ịbanye na nchekwa data MySQL TimeZone.  Biko nye akaụntụ nchekwa data Cacti ikike \"select\" maka tebụl \"time_zone_name\" dị na nchekwa data \"mysql\", ma tinye ozi TimeZone nke MySQL tupu ịga n'ihu."

#: lib/installer.php
msgid "Your Cacti database account has access to the MySQL TimeZone database and that database is populated with global TimeZone information."
msgstr "Akaụntụ nchekwa data Cacti gị nwere ohere ịbanye na nchekwa data MySQL TimeZone ma nchekwa data ahụ nwere ozi TimeZone zuru ụwa ọnụ."

