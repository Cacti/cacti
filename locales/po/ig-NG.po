#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "Nhazi mkpụrụedemede (collation) ndabere nke sava na-eji mgbe ọ na-emepụta nchekwa data na tebụl."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "dịka ọmụmaatụ utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Ntọala mkpụrụedemede ndabere nke sava na-eji."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "dịka ọmụmaatụ utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Ntọala mkpụrụedemede nke onye ahịa na-eji mgbe ọ na-eziga nkwupụta na sava."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Ọnụọgụgụ kachasị nke njikọ ndị ahịa n'otu oge ekwere."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Nọmba zuru ezu; ndabere 151. Kwe ka o zuo maka pollers gbakwunyere mbanye ndị ọrụ."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Aha ochie maka ebe nchekwa tebụl mepere emepe; e degharịrị ya aha ka ọ bụrụ table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Ọnụọgụgụ zuru ezu. Jiri table_open_cache na sava ọgbara ọhụrụ."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Nha kachasị nke otu ngwugwu ma ọ bụ eriri ederede ọ bụla e mepụtara ma ọ bụ nke etiti."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Baịtị; debe ya na 16M ma ọ bụ karịa maka ndị nnyocha dịpụrụ adịpụ."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Nha kachasị nke tebụl MEMORY ndị ọrụ mepụtara nwere ike itolite ruo."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Baịtị; a tụrụ nha ya dabere na ngụkọta ebe nchekwa sistemụ."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Nha kachasị nke tebụl nwa oge dị n'ime ebe nchekwa tupu ha abanye na diski."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Baịtị; ọnụọgụgụ buru ibu na-edebe tebụl nwa oge n'ime ebe nchekwa."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Nha nchekwa nwa oge kacha nta maka njikọ nke ọ bụla na-adịghị eji ndeksi."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Baịtị; oke e kenyere njikọ nke ọ bụla, nke ndabara bụ 262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "Ebe nchekwa nwa oge nke oge ọrụ ọ bụla e kenyere maka nhazi (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Baịtị; oke e kenyere njikọ nke ọ bụla, nke ndabara bụ 2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Chekwaa tebụl InnoDB nke ọ bụla na ndeksi ya n'ime faịlụ ohere tebụl .ibd nke ya."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON ma ọ bụ OFF; a na-atụ aro ON."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "Ụdị faịlụ InnoDB dị na diski (Antelope ma ọ bụ Barracuda); Barracuda bụ naanị ụdị dị ugbu a."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Kwe ka mbido igodo ndeksi karịrị baịtị 767 (chọrọ ụdị Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 ma ọ bụ OFF/0; a na-agbanye omume a mgbe niile ugbu a."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Ngụkọta ebe nchekwa InnoDB na-eji echekwa data tebụl na nke ndeksi."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Baịtị; na-abụkarị 25%-80% nke ngụkọta ebe nchekwa sistemụ."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Dee peeji ugboro abụọ (ebe nchekwa doublewrite) iji chebe pụọ na ndenye peeji na-ezughị oke."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON ma ọ bụ OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "Ebe nchekwa ochie maka akwụkwọ ọkọwa okwu data dị n'ime InnoDB na nhazi ya."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Baịtị; anaghịzi eji ya na sava ọgbara ọhụrụ."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Sekọnd nke azụmahịa InnoDB na-eche maka mkpọchi ahịrị tupu ọ kwụsị."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Sekọnd; nke ndabara bụ 50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Ụzọ e si ebufe data na faịlụ ndekọ n'ime diski."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC, na ndị yiri ha."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Na-achịkwa otu e si ede ma ebufe ndekọ redo na diski mgbe a kwadoro azụmahịa."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1, ma ọ bụ 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Otu ntọala ochie maka eriri I/O faịlụ InnoDB, nke e ji ntọala eriri I/O ọgụgụ/ọdịde dochie."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Ọnụọgụgụ zuru ezu; innodb_read_io_threads na innodb_write_io_threads anọchiwo ya."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Dee ma bufe ndekọ redo nke InnoDB na diski kwa sekọnd N ọ bụla."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Sekọnd (1-2700); nke ndabara bụ 1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Ọnụọgụgụ eriri I/O a na-eji maka ọrụ ọgụgụ na InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; nke ndabara bụ 4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Ọnụọgụgụ eriri I/O a na-eji maka ọrụ odide na InnoDB."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Ọnụọgụgụ mpaghara e kewara ebe nchekwa InnoDB ụzọ."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; MariaDB wepụrụ nke a na 10.6."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Atụmatụ ọrụ I/O kwa sekọnd dị maka ọrụ azụ nke InnoDB."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Ọnụọgụgụ zuru ezu; jiri ọnụọgụgụ dị elu maka nchekwa SSD/NVMe."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "IOPS kachasị InnoDB nwere ike iji mgbe mbufe data na diski dara azụ."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Bufe peeji rụrụ arụ dị nso n'otu mpaghara ahụ n'ime diski mgbe a na-ebufe peeji."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1, ma ọ bụ 2; jiri 0 na nchekwa SSD."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Jiri odide atomic nke ngwaike (MariaDB) ka e wee nwee ike gbanyụọ ebe nchekwa doublewrite n'enweghị nsogbu."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON ma ọ bụ OFF; naanị MariaDB."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "Manye ikewapụ foto data siri ike maka azụmahịa InnoDB."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON ma ọ bụ OFF; e weghachiri ya na MariaDB 10.6.18+, 10.11.8+ na 11.4.2+. Tọọ ya ka ọ bụrụ OFF maka onye nnyocha Cacti."

