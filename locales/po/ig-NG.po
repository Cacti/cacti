msgid "Choose if RRDs will be stored locally or being handled by an external RRDtool proxy server."
msgstr "Họrọ ma a ga-echekwa RRD n'ime ebe a ma ọ bụ ma sava proxy RRDtool dị n'èzí ga-ahụ maka ya."

