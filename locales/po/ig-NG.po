#: include/global_form.php
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
msgstr "[HRULE|VRULE]: Uru nke ihe eserese.<br/> [TICK]: Nkebi maka ahịrị akara.<br/> [SHIFT]: Mgbanwe oge na sekọnd."

#: include/global_form.php
msgid "GPRINT Type"
msgstr "Ụdị GPRINT"

#: include/global_form.php
msgid "If this graph item is a GPRINT, you can optionally choose another format here. You can define additional types under \"GPRINT Presets\"."
msgstr "Ọ bụrụ na ihe eserese a bụ GPRINT, ị nwere ike ịhọrọ usoro ọzọ ebe a ma ọ bụrụ na ịchọrọ. Ị nwere ike ịkọwa ụdị ndị ọzọ n'okpuru \"Ntọala GPRINT\"."

