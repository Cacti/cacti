msgstr "Oge kacha ogologo nwere ike ịgafe tupu e tinye data dị ka 'amaghị'. (Ọ na-abụkarị 2x300=600)"

#: include/global_form.php lib/html_utility.php
msgid "Not Selected"
msgstr "Ahọpụtaghị"

#: include/global_form.php
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "Mgbe a chịkọtara data, a ga-etinye data maka mpaghara a n'ime isi mmalite data a."

#: include/global_form.php
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "Tinye aha maka ntọala GPRINT a, hụ na ọ bụ ihe ị maara."

#: include/global_form.php
msgid "GPRINT Text"
msgstr "Ederede GPRINT"

#: include/global_form.php
msgid "Enter the custom GPRINT string here."
msgstr "Tinye eriri GPRINT ahaziri ebe a."

#: include/global_form.php
msgid "Common Options"
msgstr "Nhọrọ Ndị A Na-ahụkarị"

#: include/global_form.php
msgid "Title (--title)"
msgstr "Aha (--title)"

#: include/global_form.php
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Cacti documentation."
msgstr "Aha e bipụtara na eserese ahụ.  Ọ nwere ike ịgụnye mgbanwe nnọchi dịka |host_description| ma ọ bụ |query_fieldName|.  Maka ndepụta zuru ezu nke mkpado nnọchi a kwadoro, biko lee akwụkwọ nkọwa Cacti."

#: include/global_form.php
msgid "Vertical Label (--vertical-label)"
msgstr "Aha Kwụ Ọtọ (--vertical-label)"

#: include/global_form.php
msgid "The label vertically printed to the left of the graph."
msgstr "Aha e bipụtara kwụ ọtọ n'aka ekpe nke eserese ahụ."

#: include/global_form.php
msgid "Image Format (--imgformat)"
msgstr "Ụdị Onyonyo (--imgformat)"

#: include/global_form.php
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "Ụdị eserese a na-emepụta; PNG, GIF ma ọ bụ SVG.  Nhọrọ nke ụdị onyonyo eserese dabere nnukwu na RRDtool."

#: include/global_form.php
msgid "Height (--height)"
msgstr "Ịdị Elu (--height)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Ogo (na pikselụ) nke mpaghara eserese dị n'ime eserese ahụ. Mpaghara a anaghị agụnye ndepụta akara, ndepụta akara aksịsị, ma ọ bụ isiokwu."

#: include/global_form.php
msgid "Width (--width)"
msgstr "Obosara (--width)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Obosara (na pikselụ) nke mpaghara eserese dị n'ime eserese ahụ. Mpaghara a anaghị agụnye ndepụta akara, ndepụta akara aksịsị, ma ọ bụ isiokwu."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "Ọnụọgụgụ Ntọala (--base)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Ekwesịrị ịtọ ya na 1024 maka ebe nchekwa yana 1000 maka nha okporo ụzọ data."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "Ọnọdụ Mkpọda (--slope-mode)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Iji Ọnọdụ Mkpọda na-eme ka ọdịdị eserese dị larịị ma ọ na-ebelata ụfọdụ idoanya ihuenyo."

#: include/global_form.php
msgid "Scaling Options"
msgstr "Nhọrọ Nhazi Nha"

#: include/global_form.php
msgid "Auto Scale"
msgstr "Nhazi Nha Akpaghị Aka"

#: include/global_form.php
msgid "Auto scale the y-axis instead of defining an upper and lower limit. Note: if this is check both the Upper and Lower limit will be ignored."
msgstr "Hazie nha aksịsị-y akpaghị aka kama ịkọwa oke elu na oke ala. Rịba ama: ọ bụrụ na a họrọ nke a, a ga-eleghara ma Oke Elu ma Oke Ala anya."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "Nhọrọ Nhazi Nha Akpaghị Aka"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Jiri <br> --alt-autoscale iji hazie nha ruo nke kacha nta na nke kacha elu <br> --alt-autoscale-max iji hazie nha ruo ọnụọgụgụ kacha elu, na-eji oke ala e nyere <br> --alt-autoscale-min iji hazie nha ruo ọnụọgụgụ kacha nta, na-eji oke elu e nyere <br> --alt-autoscale (nwere oke) iji hazie nha site n'iji ma oke ala ma oke elu (ndabara RRDtool) <br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Jiri --alt-autoscale (na-eleghara oke e nyere anya)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Jiri --alt-autoscale-max (na-anabata oke ala)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Jiri --alt-autoscale-min (na-anabata oke elu)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Jiri --alt-autoscale (na-anabata oke abụọ ahụ, ndabara RRDtool)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Nhazi Nha Logaritimik (--logarithmic)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "Jiri nhazi nha aksịsị-y Logaritimik"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "Nkeji SI maka Nhazi Nha Logaritimik (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Jiri Nkeji SI maka Nhazi Nha Logaritimik kama iji akara ike ọnụọgụgụ.<br> Rịba ama: Eserese kwụ ọtọ na-eji akara SI na ndabara."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Ọnọdụ Oke Sịrị Ike (--rigid)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Agbasawanyela oke ala na oke elu ma ọ bụrụ na eserese ahụ nwere ọnụọgụgụ dị n'èzí oke ziri ezi."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "Oke Elu (--upper-limit)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "Ọnụọgụgụ kwụ ọtọ kacha elu maka eserese ahụ."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "Oke Ala (--lower-limit)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "Ọnụọgụgụ kwụ ọtọ kacha nta maka eserese ahụ."

#: include/global_form.php
msgid "Grid Options"
msgstr "Nhọrọ Grịdị"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Ọnụọgụgụ Grịdị Nkeji (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Na-edozi ọnụọgụgụ ike na aksịsị-Y maka ọnụọgụgụ. Rịba ama: Nhọrọ a agbaala ochie ma jiri nhọrọ --y-grid dochie ya. Na nhọrọ a, ahịrị grịdị aksịsị-Y na-apụta n'oge nzọụkwụ grịdị ọ bụla. A na-etinye akara n'ahịrị ọ bụla nke ihe mụbaa akara."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Ọnụọgụgụ Ike Nkeji (--units-exponent)"

#: include/global_form.php
msgid "What unit Cacti should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Nkeji Cacti kwesịrị iji na aksịsị-Y. Jiri 3 iji gosi ihe niile na \"k\" ma ọ bụ -6 iji gosi ihe niile na \"u\" (maịkro)."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Ogologo Nkeji (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Ọnụọgụgụ ole ka RRDtool kwesịrị iche na akara aksịsị-y ga-abụ? Ị nwere ike ịkwesị iji nhọrọ a mee ohere zuru ezu ozugbo ị malitere ịhazigharị akara aksịsị-y."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "Enweghị Ndozi Grịdị (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "Iji gbochie mmetụta mgbawa na-eme ka ihe gbarie agbari, RRDtool na-ejikọta ntụpọ na pikselụ idoanya ngwaọrụ, nke a na-eme ka ọ dị nkọ karị. Ọ bụrụ na nke a adịghị gị mma, ị nwere ike iji ntụgharị a gbanyụọ omume a.<br><strong>Rịba ama: </strong>A na-agbanyụ ndozi grịdị maka mmepụta PDF, EPS, SVG na ndabara."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Grịdị Y Ọzọ (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Algọridim ahụ na-ahụ na ị nwere grịdị mgbe niile, na ahịrị grịdị zuru ezu ma ha adịghị ọtụtụ karịa, nakwa na grịdị ahụ bụ nke metrik. Paramiita a ga-ahụkwa na e gosipụtara desịmalụ zuru ezu ọ bụladị ma eserese gị si na 69.998 gaa na 70.001.<br><strong>Rịba ama: </strong>Paramiita a nwere ike imetụta nhọrọ --alt-autoscale."

#: include/global_form.php
msgid "Axis Options"
msgstr "Nhọrọ Aksịsị"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Aksịsị Aka Nri (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "A ga-ese aksịsị nke abụọ n'aka nri nke eserese ahụ. E jikọtara ya na aksịsị aka ekpe site na paramiita nha na mbugharị."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Akara Aksịsị Aka Nri (--right-axis-label &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "Akara maka aksịsị aka nri."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Ụdị Aksịsị Aka Nri (--right-axis-format &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Site na ndabara, a na-ekpebi usoro nke aha axis na-akpaghị aka. Ọ bụrụ na ịchọrọ ime nke a n'onwe gị, jiri nhọrọ a nwere otu arụmụka %lf ndị ị maara site na iwu PRINT na GPRINT."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Ngwa Nhazi Axis Aka Nri (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Mgbe ị na-ahazi ntinye aha axis aka nri, tinye iwu na usoro data. Usoro ndị a na-akwado gụnyere \"numeric\" ebe a na-ewere data dị ka nọmba, \"timestamp\" ebe a na-akọwa uru dị ka akara oge UNIX (ọnụọgụ sekọnd kemgbe Jenụwarị 1970) ma gosipụta ya site na iji usoro strftime (ndabara bụ \"%Y-%m-%d %H:%M:%S\"). Leekwa --units-length na --right-axis-format. N'ikpeazụ \"duration\" ebe a na-akọwa uru dị ka oge dị na milisekọnd. Nhazi usoro na-agbaso iwu nke PRINT/GPRINT tozuru oke na valstrfduration."

#: include/global_form.php
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Ngwa Nhazi Axis Aka Ekpe (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Mgbe ị na-ahazi ntinye aha axis aka ekpe, tinye iwu na usoro data. Usoro ndị a na-akwado gụnyere \"numeric\" ebe a na-ewere data dị ka nọmba, \"timestamp\" ebe a na-akọwa uru dị ka akara oge UNIX (ọnụọgụ sekọnd kemgbe Jenụwarị 1970) ma gosipụta ya site na iji usoro strftime (ndabara bụ \"%Y-%m-%d %H:%M:%S\"). Leekwa --units-length. N'ikpeazụ \"duration\" ebe a na-akọwa uru dị ka oge dị na milisekọnd. Nhazi usoro na-agbaso iwu nke PRINT/GPRINT tozuru oke na valstrfduration."

#: include/global_form.php
msgid "Legend Options"
msgstr "Nhọrọ Nkọwa Eserese"

#: include/global_form.php
msgid "Auto Padding"
msgstr "Ntinye Oghere Akpaaka"

#: include/global_form.php
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Tinye oghere na ederede ka nkọwa eserese na data eserese wee dịrị n'otu ahịrị mgbe niile. Rịba ama: nke a nwere ike ime ka eserese were ogologo oge iji gosipụta n'ihi nnukwu ibu ọrụ. Ọzọkwa, Ntinye Oghere Akpaaka nwere ike ghara izi ezi n'ụdị eserese niile, itinye aha kwụsiri ike na-enyekarị aka."

#: include/global_form.php
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Aha Na-agbanwe Agbanwe (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "See akara ahịrị dị ka ahịrị."

#: include/global_form.php
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Manye Nkọwa Iwu (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Manye mmepụta nke nkọwa HRULE na VRULE."

#: include/global_form.php
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Obosara Tab (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Site na ndabara, obosara tab bụ pikselụ 40, jiri nhọrọ a gbanwee ya."

#: include/global_form.php
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Ọnọdụ Nkọwa Eserese (--legend-position=&lt;position&gt;)"

#: include/global_form.php
msgid "Place the legend at the given side of the graph."
msgstr "Debe nkọwa eserese n'akụkụ eserese e nyere."

#: include/global_form.php
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Ntụziaka Nkọwa Eserese (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php
msgid "Place the legend items in the given vertical order."
msgstr "Debe ihe nkọwa eserese n'usoro kwụ ọtọ e nyere."

#: include/global_form.php lib/api_aggregate.php lib/html.php
msgid "Graph Item Type"
msgstr "Ụdị Ihe Eserese"

#: include/global_form.php
msgid "How data for this item is represented visually on the graph."
msgstr "Otu e si egosipụta data maka ihe a n'anya n'eserese."

#: include/global_form.php
msgid "The data source to use for this graph item."
msgstr "Isi iyi data a ga-eji maka ihe eserese a."

#: include/global_form.php
msgid "The color to use for the legend."
msgstr "Agba a ga-eji maka nkọwa eserese."

#: include/global_form.php
msgid "Opacity/Alpha Channel"
msgstr "Ngosipụta/Ọwa Alpha"

#: include/global_form.php
msgid "The opacity/alpha channel of the color."
msgstr "Ngosipụta/ọwa alpha nke agba ahụ."

#: include/global_form.php lib/rrd.php
msgid "Consolidation Function"
msgstr "Ọrụ Nchịkọta"

#: include/global_form.php
msgid "How data for this item is represented statistically on the graph."
msgstr "Otu e si egosipụta data maka ihe a n'ọnụọgụgụ n'eserese."

#: include/global_form.php
msgid "CDEF Function"
msgstr "Ọrụ CDEF"

#: include/global_form.php
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "Ọrụ CDEF (mgbakọ na mwepụ) a ga-etinye n'ihe a n'eserese ma ọ bụ na nkọwa eserese."

#: include/global_form.php
msgid "VDEF Function"
msgstr "Ọrụ VDEF"

#: include/global_form.php
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "Ọrụ VDEF (mgbakọ na mwepụ) a ga-etinye n'ihe a na nkọwa eserese."

#: include/global_form.php
msgid "Shift Data"
msgstr "Bugharịa Data"

#: include/global_form.php
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "Gbanwee ọnọdụ data gị na axis oge (x-axis) site n'ogo a kapịrị ọnụ n'ọhịa 'value'."

#: include/global_form.php
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
msgstr "[HRULE|VRULE]: Uru nke ihe eserese.<br/> [TICK]: Nkebi maka ahịrị akara.<br/> [SHIFT]: Mgbanwe oge na sekọnd."

#: include/global_form.php
msgid "GPRINT Type"
msgstr "Ụdị GPRINT"

#: include/global_form.php
msgid "If this graph item is a GPRINT, you can optionally choose another format here. You can define additional types under \"GPRINT Presets\"."
msgstr "Ọ bụrụ na ihe eserese a bụ GPRINT, ị nwere ike ịhọrọ usoro ọzọ ebe a ma ọ bụrụ na ịchọrọ. Ị nwere ike ịkọwa ụdị ndị ọzọ n'okpuru \"Ntọala GPRINT\"."

#: include/global_form.php
msgid "Text Alignment (TEXTALIGN)"
msgstr "Nhazi Ahịrị Ederede (TEXTALIGN)"

#: include/global_form.php
msgid "All subsequent legend line(s) will be aligned as given here.  You may use this command multiple times in a single graph.  This command does not produce tabular layout.<br/><strong>Note: </strong>You may want to insert a &lt;HR&gt; on the preceding graph item.<br/> <strong>Note: </strong>A &lt;HR&gt; on this legend line will obsolete this setting!"
msgstr "Ahịrị nkọwa eserese niile na-esonụ ga-adị n'usoro dị ka e nyere ebe a. Ị nwere ike iji iwu a ọtụtụ ugboro n'otu eserese. Iwu a anaghị emepụta nhazi tebụl.<br/><strong>Rịba ama: </strong>Ị nwere ike ịchọ itinye &lt;HR&gt; n'ihe eserese bu ụzọ.<br/> <strong>Rịba ama: </strong>&lt;HR&gt; dị n'ahịrị nkọwa eserese a ga-eme ka ntọala a ghara ịrụ ọrụ!"

#: include/global_form.php
msgid "Text Format"
msgstr "Usoro Ederede"

#: include/global_form.php
msgid "Text that will be displayed on the legend for this graph item."
msgstr "Ederede a ga-egosipụta na nkọwa eserese maka ihe eserese a."

#: include/global_form.php
msgid "Insert Hard Return"
msgstr "Tinye Nlaghachi Ahịrị Ike"

#: include/global_form.php
msgid "Forces the legend to the next line after this item."
msgstr "Na-amanye nkọwa eserese ịga n'ahịrị na-esote mgbe ihe a gasịrị."

#: include/global_form.php
msgid "Line Width (decimal)"
msgstr "Obosara Ahịrị (desimal)"

#: include/global_form.php
msgid "In case LINE was chosen, specify width of line here.  You must include a decimal precision, for example 2.00"
