msgstr "Isi nchọta maka ịchọ na ndekọ LDAP, dịka <i>'dc=win2kdomain,dc=local'</i> maọbụ <i>'ou=people,dc=domain,dc=local'</i>."

#: include/global_settings.php user_domains.php
