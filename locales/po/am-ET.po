#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "አገልጋዩ የውሂብ ጎታዎችን እና ሰንጠረዦችን ሲፈጥር የሚጠቀምበት ነባሪ ማወዳደሪያ (Collation)."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "ለምሳሌ utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "አገልጋዩ የሚጠቀምበት ነባሪ የቁምፊ ስብስብ (Character Set)."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "ለምሳሌ utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "ደንበኛው (Client) መግለጫዎችን ወደ አገልጋዩ ሲልክ የሚጠቀምበት የቁምፊ ስብስብ."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "በአንድ ጊዜ የሚፈቀዱ ከፍተኛ የደንበኛ ግንኙነቶች ብዛት."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "ሙሉ ቁጥር፤ ነባሪ 151። ለፖለሮች እና ለተጠቃሚ መግቢያዎች በቂ ቦታ ይፍቀዱ."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "ለክፍት ሰንጠረዥ መሸጎጫ የቆየ ስም፤ ወደ table_open_cache ተቀይሯል."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "ሙሉ ቁጥር። በዘመናዊ አገልጋዮች ላይ table_open_cache ይጠቀሙ."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "የአንድ ፓኬት ወይም የማንኛውም የተፈጠረ/መካከለኛ ሕብረቁምፊ ከፍተኛ መጠን."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "ባይቶች፤ ለሩቅ ፖለሮች 16M ወይም ከዚያ በላይ ያድርጉት."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "በተጠቃሚ የተፈጠሩ MEMORY ሰንጠረዦች ሊያድጉ የሚችሉበት ከፍተኛ መጠን."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "ባይቶች፤ ከአጠቃላይ የስርዓት ማህደረ ትውስታ አንጻር የሚመጠን."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "ውስጣዊ በማህደረ ትውስታ ውስጥ ያሉ ጊዜያዊ ሰንጠረዦች ወደ ዲስክ ከመፍሰሳቸው በፊት ያላቸው ከፍተኛ መጠን."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "ባይቶች፤ ትልቅ እሴት ጊዜያዊ ሰንጠረዦችን በማህደረ ትውስታ ውስጥ ያቆያል."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "መረጃ ጠቋሚዎችን (indexes) ለማይጠቀሙ መቀላቀሎች (joins) በአንድ መቀላቀል የሚመደብ ዝቅተኛ የቋት መጠን."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "ባይቶች፤ በእያንዳንዱ ግንኙነት የሚመደብ፣ ነባሪው 262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "ለድርደራዎች (ORDER BY / GROUP BY) በእያንዳንዱ ክፍለ ጊዜ የሚመደብ ቋት."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "ባይቶች፤ በእያንዳንዱ ግንኙነት የሚመደብ፣ ነባሪው 2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "እያንዳንዱን የInnoDB ሰንጠረዥ እና መረጃ ጠቋሚዎቹን በራሱ .ibd የሰንጠረዥ ቦታ ፋይል ውስጥ ያከማቹ."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON ወይም OFF፤ ON ይመከራል."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "የInnoDB በዲስክ ላይ የፋይል ቅርጸት (Antelope ወይም Barracuda)፤ አሁን ብቸኛው ቅርጸት Barracuda ነው."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope፣ Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "ከ767 ባይቶች በላይ ርዝመት ያላቸውን የመረጃ ጠቋሚ ቁልፍ ቅድመ-ቅጥያዎች ይፍቀዱ (የBarracuda ቅርጸትን ይፈልጋል)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 ወይም OFF/0፤ ይህ ባህሪ አሁን ሁልጊዜ ነቅቷል."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "InnoDB የሰንጠረዥ እና የመረጃ ጠቋሚ ውሂብን ለመሸጎጥ የሚጠቀምበት አጠቃላይ ማህደረ ትውስታ."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "ባይቶች፤ በተለምዶ ከአጠቃላይ የስርዓት ማህደረ ትውስታ 25%-80%."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "ከከፊል የገጽ ጽሑፎች ለመከላከል ገጾችን ሁለት ጊዜ ይጻፉ (doublewrite ቋት)."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON ወይም OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "ለInnoDB ውስጣዊ የውሂብ መዝገበ-ቃላት እና መዋቅሮች የቆየ ገንዳ (pool)."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "ባይቶች፤ በዘመናዊ አገልጋዮች ላይ ጊዜው ያለፈበት."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "አንድ የInnoDB ግብይት ተስፋ ከመቁረጡ በፊት ለረድፍ መቆለፊያ የሚጠብቅባቸው ሰከንዶች."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "ሰከንዶች፤ ነባሪው 50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "ውሂብን እና የምዝግብ ማስታወሻ ፋይሎችን ወደ ዲስክ ለማፍሰስ (flush) ጥቅም ላይ የሚውል ዘዴ."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT፣ fsync፣ O_DSYNC እና ተመሳሳይ."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "በግብይት ማረጋገጫ (commit) ጊዜ የredo ምዝግብ ማስታወሻው እንዴት እንደሚጻፍ እና ወደ ዲስክ እንደሚወርድ ይቆጣጠራል."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0፣ 1 ወይም 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "ለInnoDB ፋይል I/O ክሮች የቆየ ነጠላ ቅንብር፣ በማንበብ/መጻፍ I/O ክር ቅንብሮች ተተክቷል."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "ሙሉ ቁጥር፤ በinnodb_read_io_threads እና innodb_write_io_threads ተተክቷል."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "በየ N ሰከንዶች የInnoDB redo ምዝግብ ማስታወሻን ይጻፉ እና ወደ ዲስክ ያፍስሱ."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "ሰከንዶች (1-2700)፤ ነባሪው 1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "በInnoDB ውስጥ ለማንበብ ስራዎች ጥቅም ላይ የሚውሉ የI/O ክሮች ብዛት."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64፤ ነባሪው 4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "በInnoDB ውስጥ ለመጻፍ ስራዎች ጥቅም ላይ የሚውሉ የI/O ክሮች ብዛት."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "የInnoDB ቋት ገንዳ (buffer pool) የሚከፈልባቸው ክልሎች ብዛት."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64፤ MariaDB ይህንን በ10.6 አስወግዶታል."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "ለInnoDB የጀርባ ስራዎች በሰከንድ የሚገኙ ግምታዊ የI/O ስራዎች."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "ሙሉ ቁጥር፤ ለSSD/NVMe ማከማቻ ከፍ ያሉ እሴቶችን ይጠቀሙ."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "ወደ ዲስክ ማፍሰስ (flushing) ወደኋላ ሲቀር InnoDB ሊጠቀምበት የሚችለው ከፍተኛ IOPS."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "አንድን ገጽ ወደ ዲስክ ሲያፈስሱ በተመሳሳይ extent ውስጥ ያሉ ጎረቤት ያልተጸዱ (dirty) ገጾችንም ያፍስሱ."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0፣ 1 ወይም 2፤ በSSD ማከማቻ ላይ 0 ይጠቀሙ."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "የdoublewrite ቋቱ በደህና እንዲቦዝን የሃርድዌር አቶሚክ ጽሑፎችን (MariaDB) ይጠቀሙ."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON ወይም OFF፤ MariaDB ብቻ."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "ለInnoDB ግብይቶች ጥብቅ የቅጽበታዊ ገጽ እይታ መለያየትን (snapshot isolation) ተግባራዊ ያድርጉ."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON ወይም OFF፤ ወደ MariaDB 10.6.18+፣ 10.11.8+ እና 11.4.2+ ተመልሶ ተካቷል። ለCacti ፖለር OFF ያድርጉ."

#: lib/utility.php
msgid "Removed"
msgstr "ተወግዷል"

#: lib/utility.php
msgid "Deprecated"
msgstr "ጊዜው ያለፈበት"

#: lib/utility.php
msgid "Not applicable to this engine"
msgstr "ለዚህ ሞተር (engine) አይተገበርም"

#: lib/utility.php
msgid "Supported"
msgstr "የሚደገፍ"

#: lib/utility.php
#, php-format
msgid "%s Variable Capability Matrix"
msgstr "የ%s ተለዋዋጭ አቅም ማትሪክስ"

#: lib/utility.php
msgid "Support by engine and version for each Cacti-recommended variable"
msgstr "በCacti ለሚመከር እያንዳንዱ ተለዋዋጭ በሞተር እና በስሪት የሚሰጥ ድጋፍ"

#: lib/utility.php
msgid "Variable"
msgstr "ተለዋዋጭ"

#: lib/utility.php
msgid "Available settings:"
msgstr "ያሉ ቅንብሮች:"

#: lib/utility.php
msgid "N/A - Not applicable to this engine"
msgstr "N/A - ለዚህ ሞተር አይተገበርም"

#: lib/utility.php
msgid "MariaDB 10.5+ and MySQL 8.0+ are the recommended, supported releases (for example, the default database streams on Rocky Linux 9). Make sure you run the very latest release though which fixes a long standing low level networking issue that was causing spine many issues with reliability."
msgstr "MariaDB 10.5+ እና MySQL 8.0+ የሚመከሩ እና የሚደገፉ ስሪቶች ናቸው (ለምሳሌ፣ በRocky Linux 9 ላይ ያሉ ነባሪ የውሂብ ጎታ streams)። ይሁን እንጂ ለረጅም ጊዜ የቆየውንና በspine አስተማማኝነት ላይ ብዙ ችግሮችን ይፈጥር የነበረውን ዝቅተኛ ደረጃ የአውታረ መረብ ችግር የሚያስተካክለውን በጣም የቅርብ ጊዜውን ስሪት ማሄድዎን ያረጋግጡ."

#: lib/utility.php
#, php-format
msgid "It is STRONGLY recommended that you enable InnoDB in any %s version greater than 5.5.3."
msgstr "ከ5.5.3 በላይ በሆነ ማንኛውም የ%s ስሪት ውስጥ InnoDBን እንዲያነቁ በጥብቅ ይመከራል."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4_unicode_ci collation type as some characters take more than a single byte."
msgstr "Cactiን ከእንግሊዝኛ ሌላ ቋንቋዎች ጋር ሲጠቀሙ፣ አንዳንድ ቁምፊዎች ከአንድ ባይት በላይ ስለሚወስዱ utf8mb4_unicode_ci የማወዳደሪያ (collation) አይነት መጠቀም አስፈላጊ ነው."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4 character set as some characters take more than a single byte."
msgstr "Cactiን ከእንግሊዝኛ ሌላ ቋንቋዎች ጋር ሲጠቀሙ፣ አንዳንድ ቁምፊዎች ከአንድ ባይት በላይ ስለሚወስዱ የutf8mb4 ቁምፊ ስብስብን (character set) መጠቀም አስፈላጊ ነው."

#: lib/utility.php
#, php-format
msgid "It is recommended that you enable InnoDB in any %s version greater than 5.1."
msgstr "ከ5.1 በላይ በሆነ ማንኛውም የ%s ስሪት ውስጥ InnoDBን እንዲያነቁ ይመከራል."

#: lib/utility.php
#, php-format
msgid "Depending on the number of logins and use of spine data collector, %s will need many connections.  The calculation for spine is: total_connections = total_processes * (total_threads + script_servers + 1), then you must leave headroom for user connections, which will change depending on the number of concurrent login accounts."
msgstr "በመግቢያዎች ብዛት እና በSpine የውሂብ ሰብሳቢ አጠቃቀም ላይ በመመስረት፣ %s ብዙ ግንኙነቶችን ይፈልጋል። የSpine ስሌት ይህ ነው፦ total_connections = total_processes * (total_threads + script_servers + 1)፣ ከዚያም በተመሳሳይ ጊዜ በሚገቡ መለያዎች ብዛት ላይ ተመስርቶ ለሚለዋወጡ የተጠቃሚ ግንኙነቶች ተጨማሪ ቦታ መተው አለብዎት."

#: lib/utility.php
msgid "Keeping the table cache larger means less file open/close operations when using innodb_file_per_table."
msgstr "የሰንጠረዥ መሸጎጫውን ትልቅ ማድረግ innodb_file_per_table ሲጠቀሙ አነስተኛ የፋይል መክፈቻ/መዝጊያ ስራዎችን ማለት ነው."

#: lib/utility.php
msgid "With Remote polling capabilities, large amounts of data will be synced from the main server to the remote pollers.  Therefore, keep this value at or above 16M."
msgstr "በሩቅ ፖሊንግ (Remote polling) ችሎታዎች፣ ከፍተኛ መጠን ያለው ውሂብ ከዋናው አገልጋይ ወደ ሩቅ ፖለሮች ይመሳሰላል። ስለዚህ፣ ይህንን እሴት 16M ወይም ከዚያ በላይ ያድርጉት."

#: lib/utility.php
#, php-format
msgid "If using the Cacti Performance Booster and choosing a memory storage engine, you have to be careful to flush your Performance Booster buffer before the system runs out of memory table space.  This is done two ways, first reducing the size of your output column to just the right size.  This column is in the tables poller_output, and poller_output_boost.  The second thing you can do is allocate more memory to memory tables.  We have arbitrarily chosen a recommended value of 10%% of system memory, but if you are using SSD disk drives, or have a smaller system, you may ignore this recommendation or choose a different storage engine.  You may see the expected consumption of the Performance Booster tables under Console -> System Utilities -> View Boost Status."
msgstr "የ Cacti Performance Booster ን እየተጠቀሙ ከሆነ እና የማህደረ ትውስታ ማከማቻ ሞተርን (memory storage engine) ከመረጡ፣ ስርዓቱ የማህደረ ትውስታ ሰንጠረዥ ቦታ ከማለቁ በፊት የ Performance Booster ቋትዎን (buffer) በጥንቃቄ ማጽዳት (flush) አለብዎት። ይህ በሁለት መንገዶች ይከናወናል፤ በመጀመሪያ የውጤት አምድዎን መጠን ወደ ትክክለኛው መጠን መቀነስ ነው። ይህ አምድ በ poller_output እና በ poller_output_boost ሰንጠረዦች ውስጥ ይገኛል። ሁለተኛው ማድረግ የሚችሉት ነገር ለማህደረ ትውስታ ሰንጠረዦች ተጨማሪ ማህደረ ትውስታ መመደብ ነው። የስርዓት ማህደረ ትውስታ 10%% የሚሆነውን የሚመከር እሴት በዘፈቀደ መርጠናል፣ ነገር ግን የ SSD ዲስክ አንጻፊዎችን እየተጠቀሙ ከሆነ ወይም አነስተኛ ስርዓት ካለዎት ይህንን ምክር ችላ ማለት ወይም ሌላ የማከማቻ ሞተር መምረጥ ይችላሉ። የሚጠበቀውን የ Performance Booster ሰንጠረዦች ፍጆታ በ ኮንሶል -> የስርዓት መገልገያዎች -> የ Boost ሁኔታን ይመልከቱ ስር ማየት ይችላሉ."

#: lib/utility.php
msgid "When executing subqueries, having a larger temporary table size, keep those temporary tables in memory."
msgstr "ንዑስ መጠይቆችን (subqueries) በሚያስፈጽሙበት ጊዜ፣ ትልቅ ጊዜያዊ የሰንጠረዥ መጠን መኖሩ እነዚያን ጊዜያዊ ሰንጠረዦች በማህደረ ትውስታ ውስጥ እንዲቆዩ ያደርጋል."

#: lib/utility.php
msgid "When performing joins, if they are below this size, they will be kept in memory and never written to a temporary file.  As this is a per connection memory allocation, care must be taken not to increase it too high.  The sum of the join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + Core MySQL/MariaDB memory should be below 80%.  If the recommendation is negative, you must decrease this and or the sort_buffer_size until the recommendation fits within the allowable memory."
msgstr "መጋጠሚያዎችን (joins) በሚያከናውኑበት ጊዜ ከዚህ መጠን በታች ከሆኑ በማህደረ ትውስታ ውስጥ ይቀመጣሉ እና በጭራሽ ወደ ጊዜያዊ ፋይል አይጻፉም።  ይህ በእያንዳንዱ ግንኙነት የሚመደብ ማህደረ ትውስታ ስለሆነ በጣም እንዳይጨምር ጥንቃቄ መደረግ አለበት።  የjoin_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + ዋናው የMySQL/MariaDB ማህደረ ትውስታ ድምር ከ80% በታች መሆን አለበት።  ምክሩ አሉታዊ ከሆነ ምክሩ በተፈቀደው ማህደረ ትውስታ ውስጥ እስኪገባ ድረስ ይህንን እና/ወይም sort_buffer_size መቀነስ አለብዎት."

#: lib/utility.php
#, php-format
msgid "When using InnoDB storage it is important to keep your table spaces separate.  This makes managing the tables simpler for long time users of %s.  If you are running with this currently off, you can migrate to the per file storage by enabling the feature, and then running an alter statement on all InnoDB tables."
msgstr "የ InnoDB ማከማቻን ሲጠቀሙ የሰንጠረዥ ቦታዎችዎን (table spaces) ለይተው ማስቀመጥ አስፈላጊ ነው። ይህ ለረጅም ጊዜ የ %s ተጠቃሚዎች ሰንጠረዦችን ማስተዳደርን ቀላል ያደርገዋል። በአሁኑ ጊዜ ይህንን ጠፍቶ እያሄዱ ከሆነ፣ ባህሪውን በማንቃት እና ከዚያ በሁሉም የ InnoDB ሰንጠረዦች ላይ የ alter መግለጫ በማሄድ ወደ በየፋይል ማከማቻ (per file storage) መሸጋገር ይችላሉ."

#: lib/utility.php
msgid "When using innodb_file_per_table, it is important to set the innodb_file_format to Barracuda.  This setting will allow longer indexes important for certain Cacti tables."
msgstr "innodb_file_per_table ን ሲጠቀሙ፣ innodb_file_format ን ወደ Barracuda ማቀናበር አስፈላጊ ነው። ይህ ቅንብር ለተወሰኑ የ Cacti ሰንጠረዦች አስፈላጊ የሆኑ ረጃጅም መረጃ ጠቋሚዎችን (indexes) ይፈቅዳል."

#: lib/utility.php
msgid "If your tables have very large indexes, you must operate with the Barracuda innodb_file_format and the innodb_large_prefix equal to 1.  Failure to do this may result in plugins that can not properly create tables."
msgstr "ሰንጠረዦችዎ በጣም ትላልቅ መረጃ ጠቋሚዎች (indexes) ካሏቸው፣ ከ Barracuda innodb_file_format እና ከ 1 ጋር እኩል በሆነ innodb_large_prefix መስራት አለብዎት። ይህን አለማድረግ ሰንጠረዦችን በትክክል መፍጠር የማይችሉ ተሰኪዎችን (plugins) ሊያስከትል ይችላል."

#: lib/utility.php
#, php-format
msgid "InnoDB will hold as much tables and indexes in system memory as is possible.  Therefore, you should make the innodb_buffer_pool large enough to hold as much of the tables and index in memory.  Checking the size of the /var/lib/mysql/cacti directory will help in determining this value.  We are recommending 25%% of your systems total memory, but your requirements will vary depending on your systems size."
msgstr "InnoDB በተቻለ መጠን ብዙ ሰንጠረዦችን እና መረጃ ጠቋሚዎችን (indexes) በስርዓት ማህደረ ትውስታ ውስጥ ይይዛል።  ስለዚህ በማህደረ ትውስታ ውስጥ ብዙ ሰንጠረዦችን እና መረጃ ጠቋሚዎችን ለመያዝ የinnodb_buffer_pool በቂ ትልቅ ማድረግ አለብዎት።  የ/var/lib/mysql/cacti ማውጫ መጠንን መፈተሽ ይህንን እሴት ለመወሰን ይረዳል።  ከስርዓትዎ ጠቅላላ ማህደረ ትውስታ 25%% እንዲሆን እንመክራለን፣ ነገር ግን ፍላጎቶችዎ እንደ ስርዓትዎ መጠን ይለያያሉ."

#: lib/utility.php
msgid "This settings should remain ON unless your Cacti instances is running on either ZFS or FusionI/O which both have internal journaling to accommodate abrupt system crashes.  However, if you have very good power, and your systems rarely go down and you have backups, turning this setting to OFF can net you almost a 50% increase in database performance."
msgstr "የCacti ስርዓትዎ ድንገተኛ የስርዓት ብልሽቶችን ለመቋቋም ውስጣዊ journaling ባላቸው ZFS ወይም FusionI/O ላይ ካልሰራ በስተቀር ይህ ቅንብር ON ሆኖ መቆየት አለበት።  ይሁን እንጂ በጣም ጥሩ የኃይል አቅርቦት ካለዎት፣ ስርዓቶችዎ አልፎ አልፎ ብቻ የሚጠፉ ከሆነ እና መጠባበቂያዎች (backups) ካሉዎት፣ ይህንን ቅንብር ወደ OFF መቀየር በውሂብ ጎታ አፈጻጸም ላይ ወደ 50% የሚጠጋ ጭማሪ ሊያስገኝልዎ ይችላል."

#: lib/utility.php
msgid "This is where metadata is stored. If you had a lot of tables, it would be useful to increase this."
msgstr "ሜታዳታ የሚቀመጥበት ቦታ ይህ ነው። ብዙ ሰንጠረዦች ካሉዎት ይህን መጨመር ጠቃሚ ይሆናል."

#: lib/utility.php
msgid "Rogue queries should not for the database to go offline to others.  Kill these queries before they kill your system."
msgstr "ያልተፈቀዱ መጠይቆች የውሂብ ጎታው ለሌሎች ከመስመር ውጪ እንዲሆን ማስገደድ የለባቸውም። እነዚህን መጠይቆች ስርዓትዎን ከማውደማቸው በፊት ያቋርጧቸው."

#: lib/utility.php
msgid "Maximum I/O performance happens when you use the O_DIRECT method to flush pages."
msgstr "ገጾችን ወደ ዲስክ ለማስተላለፍ የO_DIRECT ዘዴን ሲጠቀሙ ከፍተኛ የI/O አፈጻጸም ይገኛል."

#: lib/utility.php
#, php-format
msgid "Setting this value to 2 means that you will flush all transactions every second rather than at commit.  This allows %s to perform writing less often."
msgstr "ይህን እሴት ወደ 2 ማቀናበር ማለት ሁሉንም ግብይቶች በእያንዳንዱ commit ጊዜ ሳይሆን በየሴኮንዱ ወደ ዲስክ ያስተላልፋሉ ማለት ነው። ይህ %s የመጻፍ ስራውን በአነስተኛ ድግግሞሽ እንዲያከናውን ያስችለዋል."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple io threads is advantageous for applications with high io characteristics."
msgstr "ዘመናዊ የSSD አይነት ማከማቻዎች ሲኖሩ፣ ብዙ የio ክሮች መኖር ከፍተኛ የio ባህሪ ላላቸው መተግበሪያዎች ጠቃሚ ነው."

#: lib/utility.php
#, php-format
msgid "As of %s %s, the you can control how often %s flushes transactions to disk.  The default is 1 second, but in high I/O systems setting to a value greater than 1 can allow disk I/O to be more sequential"
msgstr "ከ%1$s %2$s ጀምሮ %3$s ግብይቶችን በምን ያህል ድግግሞሽ ወደ ዲስክ እንደሚልክ መቆጣጠር ይችላሉ። ነባሪው 1 ሴኮንድ ነው፣ ነገር ግን ከፍተኛ I/O ባላቸው ስርዓቶች ላይ ከ1 በላይ የሆነ እሴት ማቀናበር የዲስክ I/O ይበልጥ በቅደም ተከተል እንዲከናወን ያስችላል"

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "ዘመናዊ የSSD አይነት ማከማቻዎች ሲኖሩ፣ ብዙ የንባብ io ክሮች መኖር ከፍተኛ የio ባህሪ ላላቸው መተግበሪያዎች ጠቃሚ ነው። እንደ እርስዎ የMariaDB/MySQL ስሪቶች ሁኔታ ይህ እሴት እስከ 64 ሊደርስ ይችላል። ነገር ግን ቁጥሩን በውሂብ ጎታ አገልጋዩ ላይ ካሉት አጠቃላይ የSMT ክሮች ብዛት ያነሰ እንዲሆን ለማድረግ ይሞክሩ."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "ዘመናዊ የSSD አይነት ማከማቻዎች ሲኖሩ፣ ብዙ የመጻፊያ io ክሮች መኖር ከፍተኛ የio ባህሪ ላላቸው መተግበሪያዎች ጠቃሚ ነው። እንደ እርስዎ የMariaDB/MySQL ስሪቶች ሁኔታ ይህ እሴት እስከ 64 ሊደርስ ይችላል። ነገር ግን ቁጥሩን በውሂብ ጎታ አገልጋዩ ላይ ካሉት አጠቃላይ የSMT ክሮች ብዛት ያነሰ እንዲሆን ለማድረግ ይሞክሩ."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MariaDB less than 10.5.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max the number of CPU cores or 64."
msgstr "%s ከ10.5 በታች ለሆኑ የMariaDB ስሪቶች አፈጻጸምን ለማሻሻል innodb_buffer_poolን ወደ ማህደረ ትውስታ ክልሎች ይከፍለዋል። ከፍተኛው እሴት 64 ነው፣ ነገር ግን ከCPU ኮሮች/ክሮች ብዛት መብለጥ የለበትም። የእርስዎ innodb_buffer_pool ከ1GB በታች ሲሆን፣ የፑል መጠኑን ለ128MB በማካፈል የተገኘውን ውጤት መጠቀም አለብዎት። እስከ ከፍተኛው የCPU ኮሮች ብዛት ወይም 64 ድረስ ይህንን ስሌት መጠቀምዎን ይቀጥሉ."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MySQL upto and including MySQL 8.0.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max of the number of CPU cores or 64."
msgstr "%s እስከ MySQL 8.0 ድረስ ላሉት የMySQL ስሪቶች (MySQL 8.0ን ጨምሮ) አፈጻጸምን ለማሻሻል innodb_buffer_poolን ወደ ማህደረ ትውስታ ክልሎች ይከፍለዋል። ከፍተኛው እሴት 64 ነው፣ ነገር ግን ከCPU ኮሮች/ክሮች ብዛት መብለጥ የለበትም። የእርስዎ innodb_buffer_pool ከ1GB በታች ሲሆን፣ የፑል መጠኑን ለ128MB በማካፈል የተገኘውን ውጤት መጠቀም አለብዎት። እስከ ከፍተኛው የCPU ኮሮች ብዛት ወይም 64 ድረስ ይህንን ስሌት መጠቀምዎን ይቀጥሉ."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 200 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 100000 can be used."
msgstr "የSSD ዲስኮች ካሉዎት ይህን ጥቆማ ይጠቀሙ። አካላዊ ሃርድ ድራይቮች ካሉዎት፣ በድርድሩ (array) ውስጥ ያሉትን ንቁ ድራይቮች ብዛት በ200 ያባዙ። NVMe ወይም PCIe Flash የሚጠቀሙ ከሆነ፣ እስከ 100000 የሚደርሱ እጅግ ትላልቅ ቁጥሮችን መጠቀም ይቻላል."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 2000 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 200000 can be used."
msgstr "የSSD ዲስኮች ካሉዎት ይህን ጥቆማ ይጠቀሙ። አካላዊ ሃርድ ድራይቮች ካሉዎት፣ በድርድሩ (array) ውስጥ ያሉትን ንቁ ድራይቮች ብዛት በ2000 ያባዙ። NVMe ወይም PCIe Flash የሚጠቀሙ ከሆነ፣ እስከ 200000 የሚደርሱ እጅግ ትላልቅ ቁጥሮችን መጠቀም ይቻላል."

#: lib/utility.php
msgid "If you have SSD disks, set this to 0. Otherwise, do not set this setting."
msgstr "የSSD ዲስኮች ካሉዎት ይህን ወደ 0 ያቀናብሩ። አለበለዚያ ይህን ቅንብር አያቀናብሩ."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics."
msgstr "ዘመናዊ የSSD አይነት ማከማቻዎች ሲኖሩ፣ ብዙ የንባብ io ክሮች መኖር ከፍተኛ የio ባህሪ ላላቸው መተግበሪያዎች ጠቃሚ ነው."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics."
msgstr "ዘመናዊ የSSD አይነት ማከማቻዎች ሲኖሩ፣ ብዙ የመጻፊያ io ክሮች መኖር ከፍተኛ የio ባህሪ ላላቸው መተግበሪያዎች ጠቃሚ ነው."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, this setting should be off if atomic writes are enabled.  Therefore, please enable atomic writes instead of the double write buffer as it will increase performance."
msgstr "MariaDB 10.2.4 እና ከዚያ በላይ ሲጠቀሙ፣ atomic writes ከነቁ ይህ ቅንብር መጥፋት (off) አለበት። ስለዚህ አፈጻጸምን ስለሚጨምር በdouble write buffer ምትክ atomic writesን ያንቁ."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, you can use atomic writes over the doublewrite buffer to increase performance."
msgstr "MariaDB 10.2.4 እና ከዚያ በላይ ሲጠቀሙ፣ አፈጻጸምን ለመጨመር በdoublewrite buffer ፋንታ atomic writesን መጠቀም ይችላሉ."

