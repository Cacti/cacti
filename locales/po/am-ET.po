msgstr "LDAP + TLS ን ጨምሮ SSL ላልሆኑ ግንኙነቶች የሚያገለግል የ TCP ወደብ (port)። ነባሪው 389 ነው."

#: include/global_settings.php user_domains.php
msgid "Port SSL"
msgstr "የSSL ወደብ"

#: include/global_settings.php
msgid "TCP port for LDAPS for SSL communications.  Default is 636."
msgstr "ለ SSL ግንኙነቶች ለ LDAPS የሚያገለግል የ TCP ወደብ (port)። ነባሪው 636 ነው."

#: include/global_settings.php user_domains.php
msgid "Protocol Version"
msgstr "የፕሮቶኮል ስሪት"

