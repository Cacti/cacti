msgid "Default UDP Port for all new Devices.  Typically 161."
msgstr "Verstek UDP-poort vir alle nuwe toestelle. Gewoonlik 161."

#: include/global_settings.php
msgid "Default SNMP timeout in milli-seconds for all new Devices."
msgstr "Verstek SNMP-uitteltyd in millisekondes vir alle nuwe toestelle."

#: include/global_settings.php
msgid "must be a positive integer (milliseconds)."
msgstr "moet 'n positiewe heelgetal (millisekondes) wees."

#: include/global_settings.php
msgid "must be between {{ min }} and {{ max }}."
msgstr "moet tussen {{ min }} en {{ max }} wees."

#: include/global_settings.php
