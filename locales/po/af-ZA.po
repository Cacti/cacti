msgstr "Die lettertipe om vir grafiekas-items te gebruik. Voer óf 'n geldige TrueType-lettertipelêer óf 'n geldige Pango font-config-waarde in."

#: include/global_settings.php
msgid "Unit Font Size"
msgstr "Eenheidslettertipe-grootte"

#: include/global_settings.php
msgid "The size of the font used for Graph Units"
msgstr "Die grootte van die lettertipe wat vir grafiekeenhede gebruik word"

#: include/global_settings.php
