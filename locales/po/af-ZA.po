msgstr "Die verstek aantal rye om terug te stuur vanaf 'n outovoltooiing-gebaseerde keusepatroonpassing."

#: include/global_settings.php
msgid "Minimum Tree Width"
msgstr "Minimum Boombreedte"

#: include/global_settings.php
msgid "The Minimum width of the Tree to contract to."
msgstr "Die Minimum breedte waarna die Boom saamgetrek kan word."

#: include/global_settings.php
msgid "Maximum Tree Width"
