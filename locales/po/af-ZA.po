msgstr "Verstek SNMP v3-enjin-ID vir alle nuwe toestelle. Laat hierdie veld leeg om die SNMP-enjin-ID te gebruik wat per SNMPv3-kennisgewingontvanger gedefinieer word."

#: include/global_settings.php
msgid "Port Number"
msgstr "Poortnommer"

#: include/global_settings.php
