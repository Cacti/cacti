msgstr "Verstek UDP-poort vir alle nuwe toestelle. Gewoonlik 161."

#: include/global_settings.php
msgid "Default SNMP timeout in milli-seconds for all new Devices."
msgstr "Verstek SNMP-uitteltyd in millisekondes vir alle nuwe toestelle."

#: include/global_settings.php
