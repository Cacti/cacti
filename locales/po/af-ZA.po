msgid "Security Level"
msgstr "Sekuriteitsvlak"

#: include/global_settings.php
msgid "Default SNMP v3 Security Level for all new Devices."
msgstr "Verstek SNMP v3-sekuriteitsvlak vir alle nuwe toestelle."

