#: include/global_form.php
msgid "Height (--height)"
msgstr "Hoogte (--height)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Die hoogte (in piksels) van die grafiekarea binne die grafiek. Hierdie area sluit nie die legende, aslegendes of titel in nie."

#: include/global_form.php
