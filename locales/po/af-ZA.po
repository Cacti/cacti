msgid "Theme"
msgstr "Tema"

#: include/global_settings.php
msgid "Please select one of the available Themes to skin your Cacti with."
msgstr "Kies asseblief een van die beskikbare Temas om u Cacti mee te stileer."

#: include/global_settings.php
