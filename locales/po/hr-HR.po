msgstr "Ako je postavljeno na Jednostavno, grafikoni i izvori podataka mogu se stvarati samo iz opcije Novi grafikoni. Ako je postavljeno na Napredno, podržano je naslijeđeno stvaranje grafikona i izvora podataka."

#: include/global_settings.php
msgid "Simple"
msgstr "Jednostavno"

