#: include/global_form.php
msgid "The script/source used to gather data for this data source."
msgstr "Skripta/izvor koji se koristi za prikupljanje podataka za ovaj izvor podataka."

#: include/global_form.php package_import.php
msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "Odaberite profil izvora podataka. Profil izvora podataka upravlja intervalom prozivanja, agregacijom podataka i pravilima zadržavanja za dobivene izvore podataka."

#: include/global_form.php
msgid "The amount of time in seconds between expected updates."
msgstr "Vremenski raspon u sekundama između očekivanih ažuriranja."

#: include/global_form.php
msgid "Data Source Active"
msgstr "Izvor podataka aktivan"

#: include/global_form.php
msgid "Whether Cacti should gather data for this data source or not."
msgstr "Treba li Cacti prikupljati podatke za ovaj izvor podataka ili ne."

#: include/global_form.php
msgid "Internal Data Source Name"
msgstr "Interni naziv izvora podataka"

#: include/global_form.php
msgid "Choose unique name to represent this piece of data inside of the RRDfile."
msgstr "Odaberite jedinstveni naziv koji predstavlja ovaj podatak unutar datoteke RRDfile."

#: include/global_form.php
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "Minimalna vrijednost (\"U\" za bez minimuma)"

#: include/global_form.php
msgid "The minimum value of data that is allowed to be collected."
msgstr "Minimalna vrijednost podataka koju je dopušteno prikupljati."

#: include/global_form.php
msgid "Maximum Value (\"U\" for No Maximum)"
msgstr "Maksimalna vrijednost (\"U\" za bez maksimuma)"

#: include/global_form.php
msgid "The maximum value of data that is allowed to be collected."
msgstr "Maksimalna vrijednost podataka koju je dopušteno prikupljati."

#: include/global_form.php
msgid "Data Source Type"
msgstr "Vrsta izvora podataka"

#: include/global_form.php
msgid "How data is represented in the RRA."
msgstr "Način na koji su podaci predstavljeni u RRA-u."

#: include/global_form.php
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "Maksimalna količina vremena koja može proći prije nego što se podaci unesu kao 'nepoznato'. (Obično 2x300=600)"

#: include/global_form.php lib/html_utility.php
msgid "Not Selected"
msgstr "Nije odabrano"

#: include/global_form.php
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "Kada se podaci prikupe, podaci za ovo polje bit će spremljeni u ovaj izvor podataka."

#: include/global_form.php
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "Unesite naziv za ovu unaprijed definiranu GPRINT postavku; pazite da bude nešto što prepoznajete."

#: include/global_form.php
msgid "GPRINT Text"
msgstr "GPRINT tekst"

#: include/global_form.php
msgid "Enter the custom GPRINT string here."
msgstr "Ovdje unesite prilagođeni GPRINT niz."

#: include/global_form.php
msgid "Common Options"
msgstr "Uobičajene mogućnosti"

#: include/global_form.php
msgid "Title (--title)"
msgstr "Naslov (--title)"

#: include/global_form.php
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Cacti documentation."
msgstr "Naziv koji se ispisuje na grafikonu. Može sadržavati zamjenske varijable kao što su |host_description| ili |query_fieldName|. Za potpuni popis podržanih zamjenskih oznaka pogledajte dokumentaciju za Cacti."

#: include/global_form.php
msgid "Vertical Label (--vertical-label)"
msgstr "Okomita oznaka (--vertical-label)"

#: include/global_form.php
msgid "The label vertically printed to the left of the graph."
msgstr "Oznaka okomito ispisana lijevo od grafikona."

#: include/global_form.php
msgid "Image Format (--imgformat)"
msgstr "Format slike (--imgformat)"

#: include/global_form.php
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "Vrsta grafikona koja se generira; PNG, GIF ili SVG. Odabir vrste slike grafikona uvelike ovisi o alatu RRDtool."

#: include/global_form.php
msgid "Height (--height)"
msgstr "Visina (--height)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Visina (u pikselima) područja grafikona unutar samog grafikona. Ovo područje ne uključuje legendu, oznake osi ni naslov."

#: include/global_form.php
msgid "Width (--width)"
msgstr "Širina (--width)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Širina (u pikselima) područja grafikona unutar samog grafikona. Ovo područje ne uključuje legendu, oznake osi ni naslov."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "Osnovna vrijednost (--base)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Treba postaviti na 1024 za memoriju i 1000 za mjerenja prometa."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "Način nagiba (--slope-mode)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Korištenje načina nagiba zaglađuje oblik grafikona nauštrb dijela razlučivosti na zaslonu."

#: include/global_form.php
msgid "Scaling Options"
msgstr "Mogućnosti skaliranja"

#: include/global_form.php
msgid "Auto Scale"
msgstr "Automatsko skaliranje"

#: include/global_form.php
msgid "Auto scale the y-axis instead of defining an upper and lower limit. Note: if this is check both the Upper and Lower limit will be ignored."
msgstr "Automatski skaliraj y-os umjesto definiranja gornje i donje granice. Napomena: ako je ovo označeno, i gornja i donja granica bit će zanemarene."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "Mogućnosti automatskog skaliranja"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Upotrijebite <br> --alt-autoscale za skaliranje na apsolutni minimum i maksimum <br> --alt-autoscale-max za skaliranje na maksimalnu vrijednost pomoću zadane donje granice <br> --alt-autoscale-min za skaliranje na minimalnu vrijednost pomoću zadane gornje granice <br> --alt-autoscale (s granicama) za skaliranje pomoću donje i gornje granice (zadano za RRDtool) <br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Upotrijebite --alt-autoscale (zanemarujući zadane granice)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Upotrijebite --alt-autoscale-max (prihvaćajući donju granicu)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Upotrijebite --alt-autoscale-min (prihvaćajući gornju granicu)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Upotrijebite --alt-autoscale (prihvaćajući obje granice, zadano za RRDtool)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Logaritamsko skaliranje (--logarithmic)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "Upotrijebi logaritamsko skaliranje y-osi"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "SI jedinice za logaritamsko skaliranje (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Upotrijebite SI jedinice za logaritamsko skaliranje umjesto eksponencijalne notacije.<br> Napomena: Linearni grafikoni prema zadanim postavkama upotrebljavaju SI notaciju."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Način strogih granica (--rigid)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Ne proširuj donju i gornju granicu ako grafikon sadrži vrijednost izvan valjanog raspona."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "Gornja granica (--upper-limit)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "Maksimalna okomita vrijednost za grafikon."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "Donja granica (--lower-limit)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "Minimalna okomita vrijednost za grafikon."

#: include/global_form.php
msgid "Grid Options"
msgstr "Opcije mreže"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Jedinična vrijednost mreže (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Postavlja vrijednost eksponenta za brojeve na Y-osi. Napomena: Ova je opcija zastarjela i zamijenjena opcijom --y-grid. U ovoj opciji crte mreže Y-osi pojavljuju se na svakom intervalu koraka mreže. Oznake se postavljaju na svakih nekoliko crta prema faktoru oznake."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Vrijednost eksponenta jedinice (--units-exponent)"

#: include/global_form.php
msgid "What unit Cacti should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Koju jedinicu Cacti treba upotrebljavati na Y-osi. Upotrijebite 3 za prikaz svega u \"k\" ili -6 za prikaz svega u \"u\" (mikro)."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Duljina jedinice (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Koliko znamenki RRDtool treba pretpostaviti za oznake y-osi? Možda ćete morati upotrijebiti ovu opciju kako biste oslobodili dovoljno prostora nakon što počnete mijenjati označavanje y-osi."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "Bez prilagodbe mreži (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "Kako bi se izbjegli učinci zamućenja zbog zaglađivanja rubova, RRDtool poravnava točke s pikselima razlučivosti uređaja, što rezultira oštrijim prikazom. Ako vam to ne odgovara, možete upotrijebiti ovaj prekidač da biste isključili to ponašanje.<br><strong>Napomena: </strong>Prilagodba mreži prema zadanim je postavkama isključena za izlaz u PDF, EPS i SVG."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Alternativna Y mreža (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Algoritam osigurava da uvijek imate mrežu, da postoji dovoljno crta mreže, ali ne previše, te da je mreža metrička. Ovaj parametar također će osigurati prikaz dovoljnog broja decimala čak i ako vaš grafikon ide od 69.998 do 70.001.<br><strong>Napomena: </strong>Ovaj parametar može ometati opcije --alt-autoscale."

#: include/global_form.php
msgid "Axis Options"
msgstr "Opcije osi"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Desna os (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "Druga os bit će iscrtana s desne strane grafikona. Povezana je s lijevom osi putem parametara mjerila i pomaka."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Oznaka desne osi (--right-axis-label &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "Oznaka za desnu os."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Format desne osi (--right-axis-format &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Prema zadanim postavkama format oznaka osi određuje se automatski. Ako to želite učiniti sami, upotrijebite ovu opciju s istim %lf argumentima koje poznajete iz naredbi PRINT i GPRINT."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Alat za oblikovanje desne osi (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Kada postavljate označavanje desne osi, primijenite pravilo na format podataka. Podržani formati uključuju \"numeric\", gdje se podatci tretiraju kao numerički, \"timestamp\", gdje se vrijednosti tumače kao UNIX vremenske oznake (broj sekundi od siječnja 1970.) i izražavaju pomoću formata strftime (zadano je \"%Y-%m-%d %H:%M:%S\"). Pogledajte također --units-length i --right-axis-format. Konačno, \"duration\", gdje se vrijednosti tumače kao trajanje u milisekundama. Oblikovanje prati pravila za PRINT/GPRINT kvalificirane s valstrfduration."

#: include/global_form.php
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Alat za oblikovanje lijeve osi (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Kada postavljate označavanje lijeve osi, primijenite pravilo na format podataka. Podržani formati uključuju \"numeric\" gdje se podatci tretiraju kao brojčani, \"timestamp\" gdje se vrijednosti tumače kao UNIX vremenske oznake (broj sekundi od siječnja 1970.) i izražavaju pomoću strftime formata (zadano je \"%Y-%m-%d %H:%M:%S\"). Pogledajte i --units-length. Konačno, \"duration\" gdje se vrijednosti tumače kao trajanje u milisekundama. Formatiranje slijedi pravila za valstrfduration kvalificirani PRINT/GPRINT."

#: include/global_form.php
msgid "Legend Options"
msgstr "Mogućnosti legende"

#: include/global_form.php
msgid "Auto Padding"
msgstr "Automatsko poravnanje"

#: include/global_form.php
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Popunite tekst razmacima kako bi se legenda i podatci grafikona uvijek poravnali. Napomena: ovo može uzrokovati dulje iscrtavanje grafikona zbog većeg opterećenja. Također, Automatsko poravnanje možda neće biti točno na svim vrstama grafikona; dosljedno označavanje obično pomaže."

#: include/global_form.php
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Dinamične oznake (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "Iscrtaj oznake linija kao liniju."

#: include/global_form.php
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Prisili legendu pravila (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Prisili generiranje HRULE i VRULE legendi."

#: include/global_form.php
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Širina tabulatora (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Zadana širina tabulatora je 40 piksela; upotrijebite ovu mogućnost za promjenu."

#: include/global_form.php
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Položaj legende (--legend-position=&lt;position&gt;)"

#: include/global_form.php
msgid "Place the legend at the given side of the graph."
msgstr "Postavite legendu na navedenu stranu grafikona."

#: include/global_form.php
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Smjer legende (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php
msgid "Place the legend items in the given vertical order."
msgstr "Postavite stavke legende navedenim okomitim redoslijedom."

#: include/global_form.php lib/api_aggregate.php lib/html.php
msgid "Graph Item Type"
msgstr "Vrsta stavke grafikona"

#: include/global_form.php
msgid "How data for this item is represented visually on the graph."
msgstr "Kako su podatci za ovu stavku vizualno prikazani na grafikonu."

#: include/global_form.php
msgid "The data source to use for this graph item."
msgstr "Izvor podataka koji se koristi za ovu stavku grafikona."

#: include/global_form.php
msgid "The color to use for the legend."
msgstr "Boja koja se koristi za legendu."

#: include/global_form.php
msgid "Opacity/Alpha Channel"
msgstr "Neprozirnost/alfa-kanal"

#: include/global_form.php
msgid "The opacity/alpha channel of the color."
msgstr "Neprozirnost/alfa-kanal boje."

#: include/global_form.php lib/rrd.php
msgid "Consolidation Function"
msgstr "Funkcija konsolidacije"

#: include/global_form.php
msgid "How data for this item is represented statistically on the graph."
msgstr "Kako su podatci za ovu stavku statistički prikazani na grafikonu."

#: include/global_form.php
msgid "CDEF Function"
msgstr "CDEF funkcija"

#: include/global_form.php
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "CDEF (matematička) funkcija koja se primjenjuje na ovu stavku na grafikonu ili u legendi."

#: include/global_form.php
msgid "VDEF Function"
msgstr "VDEF funkcija"

#: include/global_form.php
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "VDEF (matematička) funkcija koja se primjenjuje na ovu stavku u legendi grafikona."

#: include/global_form.php
msgid "Shift Data"
msgstr "Pomak podataka"

#: include/global_form.php
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "Pomaknite podatke na vremenskoj osi (osi x) za iznos naveden u polju 'vrijednost'."

#: include/global_form.php
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
msgstr "[HRULE|VRULE]: Vrijednost stavke grafikona.<br/> [TICK]: Razlomak za crticu oznake.<br/> [SHIFT]: Vremenski pomak u sekundama."

#: include/global_form.php
msgid "GPRINT Type"
msgstr "Vrsta GPRINT-a"

#: include/global_form.php
msgid "If this graph item is a GPRINT, you can optionally choose another format here. You can define additional types under \"GPRINT Presets\"."
msgstr "Ako je ova stavka grafikona GPRINT, ovdje možete neobavezno odabrati drugi format. Dodatne vrste možete definirati pod \"GPRINT predlošci\"."

#: include/global_form.php
msgid "Text Alignment (TEXTALIGN)"
msgstr "Poravnanje teksta (TEXTALIGN)"

#: include/global_form.php
msgid "All subsequent legend line(s) will be aligned as given here.  You may use this command multiple times in a single graph.  This command does not produce tabular layout.<br/><strong>Note: </strong>You may want to insert a &lt;HR&gt; on the preceding graph item.<br/> <strong>Note: </strong>A &lt;HR&gt; on this legend line will obsolete this setting!"
msgstr "Svi sljedeći retci legende bit će poravnati kako je ovdje zadano. Ovu naredbu možete upotrijebiti više puta na jednom grafikonu. Ova naredba ne proizvodi tablični raspored.<br/><strong>Napomena: </strong>Možda ćete htjeti umetnuti &lt;HR&gt; na prethodnoj stavci grafikona.<br/> <strong>Napomena: </strong>&lt;HR&gt; u ovom retku legende poništit će ovu postavku!"

#: include/global_form.php
msgid "Text Format"
msgstr "Format teksta"

#: include/global_form.php
msgid "Text that will be displayed on the legend for this graph item."
msgstr "Tekst koji će se prikazivati u legendi za ovu stavku grafikona."

#: include/global_form.php
msgid "Insert Hard Return"
msgstr "Umetni tvrdi prijelom retka"

#: include/global_form.php
msgid "Forces the legend to the next line after this item."
msgstr "Prebacuje legendu u sljedeći redak nakon ove stavke."

#: include/global_form.php
msgid "Line Width (decimal)"
msgstr "Širina linije (decimalno)"

#: include/global_form.php
msgid "In case LINE was chosen, specify width of line here.  You must include a decimal precision, for example 2.00"
msgstr "Ako je odabrana opcija LINE, ovdje navedite širinu linije. Morate uključiti decimalnu preciznost, na primjer 2.00"

#: include/global_form.php
msgid "Dashes (dashes[=on_s[,off_s[,on_s,off_s]...]])"
msgstr "Crtice (dashes[=on_s[,off_s[,on_s,off_s]...]])"

#: include/global_form.php
msgid "The dashes modifier enables dashed line style."
msgstr "Modifikator dashes omogućuje isprekidani stil linije."

#: include/global_form.php
msgid "Dash Offset (dash-offset=offset)"
msgstr "Pomak crtice (dash-offset=offset)"

#: include/global_form.php
msgid "The dash-offset parameter specifies an offset into the pattern at which the stroke begins."
msgstr "Parametar dash-offset određuje pomak u uzorku na kojem potez počinje."

#: include/global_form.php
msgid "The name given to this graph template."
msgstr "Naziv dodijeljen ovom predlošku grafikona."

#: include/global_form.php
msgid "Multiple Instances"
msgstr "Višestruke instance"

#: include/global_form.php
