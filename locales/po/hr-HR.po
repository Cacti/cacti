#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "Zadana kolacija koju poslužitelj koristi pri izradi baza podataka i tablica."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "npr. utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Zadani skup znakova koji koristi poslužitelj."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "npr. utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Skup znakova koji klijent koristi prilikom slanja naredbi poslužitelju."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Najveći dopušteni broj istodobnih klijentskih veza."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Cijeli broj; zadano 151. Omogućite dovoljno za pollere i korisničke prijave."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Zastarjeli naziv za predmemoriju otvorenih tablica; preimenovano u table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Cijeli broj. Koristite table_open_cache na suvremenim poslužiteljima."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Najveća veličina jednog paketa ili bilo kojeg generiranog ili međupohranjenog niza znakova."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Bajtovi; zadržite na 16M ili više za udaljene pollere."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Najveća veličina do koje mogu rasti MEMORY tablice koje je izradio korisnik."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Bajtovi; veličina u odnosu na ukupnu memoriju sustava."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Najveća veličina internih privremenih tablica u memoriji prije nego što se prenesu na disk."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Bajtovi; veća vrijednost zadržava privremene tablice u memoriji."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Najmanja veličina međuspremnika po spajanju za spajanja koja ne koriste indekse."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Bajtovi; dodjela po vezi, zadano 262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "Međuspremnik po sesiji dodijeljen za sortiranja (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Bajtovi; dodjela po vezi, zadano 2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Pohranite svaku InnoDB tablicu i njezine indekse u vlastitu .ibd datoteku tabličnog prostora."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON ili OFF; preporučuje se ON."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "InnoDB format datoteke na disku (Antelope ili Barracuda); Barracuda je sada jedini format."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "Dopusti prefikse indeksnih ključeva dulje od 767 bajtova (zahtijeva format Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 ili OFF/0; ovo je ponašanje sada uvijek omogućeno."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Ukupna memorija koju InnoDB koristi za predmemoriranje podataka tablica i indeksa."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Bajtovi; obično 25%-80% ukupne memorije sustava."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Zapisuj stranice dvaput (doublewrite međuspremnik) radi zaštite od djelomičnog zapisivanja stranica."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON ili OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "Zastarjeli skup memorije za interni rječnik podataka i strukture sustava InnoDB."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Bajtovi; zastarjelo na suvremenim poslužiteljima."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Sekunde koliko InnoDB transakcija čeka na zaključavanje retka prije odustajanja."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Sekunde; zadano 50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Metoda koja se koristi za pražnjenje podataka i datoteka zapisnika na disk."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC i slično."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Upravlja načinom zapisivanja i pražnjenja zapisnika ponavljanja (redo log) prilikom potvrde transakcije."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1 ili 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Zastarjela jedinstvena postavka za InnoDB U/I niti datoteka, zamijenjena postavkama U/I niti za čitanje/zapisivanje."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Cijeli broj; zamijenjeno s innodb_read_io_threads i innodb_write_io_threads."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Zapisuj i prazni InnoDB zapisnik ponavljanja svakih N sekundi."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Sekunde (1-2700); zadano 1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Broj U/I niti koje se koriste za operacije čitanja u sustavu InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; zadano 4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Broj I/O niti koje se koriste za operacije pisanja u InnoDB-u."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Broj regija na koje je podijeljen InnoDB međuspremnik."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; MariaDB je ovo uklonio u inačici 10.6."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Procijenjeni broj I/O operacija u sekundi dostupan pozadinskim zadacima sustava InnoDB."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Cijeli broj; upotrijebite veće vrijednosti za SSD/NVMe pohranu."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "Najveći broj IOPS-a koji InnoDB može upotrijebiti kada pražnjenje zaostaje."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Isprazni susjedne izmijenjene stranice u istom opsegu prilikom pražnjenja stranice."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1 ili 2; upotrijebite 0 na SSD pohrani."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Koristi hardversko atomsko pisanje (MariaDB) kako bi se međuspremnik za dvostruko pisanje mogao sigurno onemogućiti."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON ili OFF; samo za MariaDB."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "Nametni strogu izolaciju snimke stanja za InnoDB transakcije."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON ili OFF; naknadno ugrađeno u MariaDB 10.6.18+, 10.11.8+ i 11.4.2+. Postavite na OFF za Cacti poller."

