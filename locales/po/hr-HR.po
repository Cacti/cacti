msgstr "SAML atribut koji sadrži članstvo korisnika u grupi, npr. \"memberOf\" ili \"groups\". Ostavite prazno za preskakanje provjere grupe."

#: login_providers.php
msgid "memberOf"
msgstr "memberOf"

#: login_providers.php
msgid "Required Group"
msgstr "Potrebna grupa"

#: login_providers.php
msgid "The group name/DN that must appear in the Group Claim Attribute above for the user to be allowed to login. Leave blank to allow any successfully authenticated user to login."
msgstr "Naziv grupe/DN koji se mora nalaziti u gornjem atributu tvrdnje grupe kako bi se korisniku dopustila prijava. Ostavite prazno kako biste dopustili prijavu svakom uspješno autentificiranom korisniku."

#: login_providers.php
