msgstr "Maksimalna količina memorije za Cacti ispitivač i Boost ispitivač"

#: include/global_settings.php
msgid "Maximum RRD Update Script Run Time"
msgstr "Maksimalno vrijeme izvođenja skripte za ažuriranje RRD datoteka"

#: include/global_settings.php
msgid "If the boost poller exceeds this runtime, a warning will be placed in the cacti log,"
msgstr "Ako Boost ispitivač premaši ovo vrijeme izvođenja, upozorenje će biti zapisano u Cacti zapisnik,"

#: include/global_settings.php
msgid "Maximum Failed RRDs Queued"
msgstr "Najveći broj neuspjelih RRD-ova u redu čekanja"

#: include/global_settings.php
msgid "Maximum number of RRD destinations retained for automatic Boost retry. Only the latest complete failed update is retained per destination."
msgstr "Najveći broj RRD odredišta zadržanih za automatski ponovni pokušaj za Boost. Po odredištu se zadržava samo najnovije cjelovito neuspjelo ažuriranje."

#: include/global_settings.php
msgid "Failed RRD Retry Budget"
msgstr "Kvota ponovnih pokušaja za neuspjele RRD-ove"

#: include/global_settings.php
msgid "Maximum queued RRD destinations retried by one scheduled Boost run."
msgstr "Najveći broj RRD odredišta u redu čekanja za koje će se ponovno pokušati obrada u jednom zakazanom pokretanju sustava Boost."

#: include/global_settings.php
msgid "Maximum Failed RRD Retries"
msgstr "Najveći broj ponovnih pokušaja za neuspjeli RRD"

#: include/global_settings.php
msgid "Queued RRD updates are explicitly discarded after this many failed automatic attempts."
msgstr "Ažuriranja RRD-a u redu čekanja izričito se odbacuju nakon ovoliko neuspjelih automatskih pokušaja."

#: include/global_settings.php
msgid "Maximum Failed RRD Age"
msgstr "Najveća starost neuspjelog RRD-a"

#: include/global_settings.php
msgid "Days to retain the latest failed RRD update before explicit discard."
msgstr "Broj dana zadržavanja najnovijeg neuspjelog ažuriranja RRD-a prije izričitog odbacivanja."

#: include/global_settings.php
msgid "Boost Debug Log"
msgstr "Zapisnik otklanjanja pogrešaka za Boost"

#: include/global_settings.php
msgid "If this field is non-blank, Boost will log RRDUpdate output from the boost\tpoller process."
msgstr "Ako ovo polje nije prazno, Boost će bilježiti izlaz naredbe RRDUpdate iz procesa boost\tpoller."

