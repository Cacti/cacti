msgstr "Igihe ntarengwa gisanzwe cya SNMP mu milisegonda ku bikoresho bishya byose."

#: include/global_settings.php
msgid "must be a positive integer (milliseconds)."
msgstr "igomba kuba umubare wuzuye urenga zeru (milisegonda)."

#: include/global_settings.php
msgid "must be between {{ min }} and {{ max }}."
msgstr "igomba kuba hagati ya {{ min }} na {{ max }}."

