msgstr "Uburebure bw'igishushanyo busanzwe bugomba gukoreshwa ku nyandikorugero z'ibishushanyo nshya zose."

#: include/global_settings.php
msgid "The default Graph Width to be used for all new Graph Templates."
msgstr "Ubugari bw'igishushanyo busanzwe bugomba gukoreshwa ku nyandikorugero z'ibishushanyo nshya zose."

