msgid "Require Mix Case"
msgstr "Saba kuvanga inyuguti nkuru n'intoya"

#: include/global_settings.php
msgid "This will require new passwords to contains both lower and upper-case characters."
msgstr "Ibi bizasaba ko amajambo y'ibanga mashya aba arimo inyuguti ntoya n'inyuguti nkuru."

#: include/global_settings.php
msgid "Require Number"
msgstr "Saba umubare"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 numerical character."
msgstr "Ibi bizasaba ko amajambo y'ibanga mashya aba arimo nibura ikimenyetso 1 cy'umubare."

#: include/global_settings.php
msgid "Require Special Character"
msgstr "Saba ikimenyetso cyihariye"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 special character."
msgstr "Ibi bizasaba ko amajambo y'ibanga mashya aba arimo nibura ikimenyetso 1 cyihariye."

