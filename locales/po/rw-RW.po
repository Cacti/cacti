msgid "When using basic authentication, if the basic account needs to be translated to a different login account, you can specify a CSV file here to map the basic account to the desired login account."
msgstr "Iyo ukoresha uburyo bwo kwemeza kw'ibanze, niba konti y'ibanze ikeneye guhindurwamo indi konti yo kwinjiriraho, ushobora gushyiraho idosiye ya CSV hano kugira ngo ihuze konti y'ibanze na konti yo kwinjiriraho yifuzwa."

#: include/global_settings.php
msgid "Local Account Complexity Requirements"
msgstr "Ibisabwa ku bukomezi bwa konti z'imbere"

#: include/global_settings.php
msgid "Minimum Length"
msgstr "Uburebure bwo hasi busabwa"

