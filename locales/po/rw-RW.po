msgstr "Bigena niba abakoresha bakoresha Izina Rihariwe ryuzuye cyangwa Izina ry'umukoresha gusa mu Kirango cy'Umunyamuryango w'Itsinda cyagenwe."

#: login_providers.php
msgid "Search Settings"
msgstr "Igenamiterere ry'Ishakisha"

#: login_providers.php
msgid "Search Base"
msgstr "Ishingiro ry'Ishakisha"

#: login_providers.php
msgid "Search base for searching the LDAP directory, such as <i>\"dc=win2kdomain,dc=local\"</i> or <i>\"ou=people,dc=domain,dc=local\"</i>."
msgstr "Ishingiro ry'ishakisha ryo gushakisha mu bubiko bwa LDAP, nka <i>\"dc=win2kdomain,dc=local\"</i> cyangwa <i>\"ou=people,dc=domain,dc=local\"</i>."

