msgstr "Uko Cacti igomba gushyigikira amatariki y'umukoresha ishingiye ku isaha y'akarere ka mushakisha y'umukoresha."

#: include/global_settings.php
msgid "Date Display Format"
msgstr "Imiterere y'igaragazwa ry'itariki"

#: include/global_settings.php
msgid "The System default date format to use in Cacti."
msgstr "Imiterere y'itariki isanzwe ya sisitemu ikoreshwa muri Cacti."

#: include/global_settings.php
msgid "Date Separator"
msgstr "Igitandukanya itariki"

#: include/global_settings.php
