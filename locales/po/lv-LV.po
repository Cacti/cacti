msgid "Memory Limit for Boost and Poller"
msgstr "Boost un Poller atmiņas ierobežojums"

#: include/global_settings.php
msgid "The maximum amount of memory for the Cacti Poller and Boosts Poller"
msgstr "Maksimālais Cacti Poller un Boosts Poller atmiņas apjoms"

#: include/global_settings.php
msgid "Maximum RRD Update Script Run Time"
msgstr "Maksimālais RRD atjaunināšanas skripta izpildes laiks"

#: include/global_settings.php
msgid "If the boost poller exceeds this runtime, a warning will be placed in the cacti log,"
msgstr "Ja pastiprināšanas pollers pārsniedz šo izpildlaiku, kaktusu žurnālā tiks ievietots brīdinājums,"

#: include/global_settings.php
msgid "Enable direct population of poller_output_boost table"
msgstr "Iespējot tiešo tabulas poller_output_boost populāciju"

#: include/global_settings.php
