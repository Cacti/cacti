msgid "Auto Detect on Re-Index"
msgstr "Automātiska noteikšana atkārtoti indeksējot"

#: include/global_form.php
msgid "Auto Detect/Set on first Re-Index"
msgstr "Automātiska noteikšana/iestatīšana pirmajā atkārtotajā indeksā"

