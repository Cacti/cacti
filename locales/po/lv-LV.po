msgstr "GPRINT teksts"

#: include/global_form.php
msgid "Enter the custom GPRINT string here."
msgstr "Šeit ievadiet pielāgoto GPRINT virkni."

#: include/global_form.php
msgid "Common Options"
msgstr "Kopējās opcijas"

#: include/global_form.php
msgid "Title (--title)"
msgstr "Nosaukums (--title)"

#: include/global_form.php
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Cacti documentation."
msgstr "Diagrammā uzdrukātais nosaukums. Tas var ietvert aizvietošanas mainīgos, piemēram, |host_description| vai |query_fieldName|. Pilnu atbalstīto aizstājējbirku sarakstu skatiet Cacti dokumentācijā."

#: include/global_form.php
msgid "Vertical Label (--vertical-label)"
msgstr "Vertikālā etiķete (--vertical-label)"

#: include/global_form.php
msgid "The label vertically printed to the left of the graph."
msgstr "Etiķete ir drukāta vertikāli pa kreisi no diagrammas."

#: include/global_form.php
msgid "Image Format (--imgformat)"
msgstr "Attēla formāts (--imgformat)"

#: include/global_form.php
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "ģenerētā grafika veids; PNG, GIF vai SVG. Grafika attēla veida izvēle ir ļoti atkarīga no RRDrīka."

#: include/global_form.php
msgid "Height (--height)"
msgstr "Augstums (--augstums)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Diagrammas apgabala augstums (pikseļos) diagrammā. Šajā apgabalā nav ietverta leģenda, ass leģendas vai nosaukums."

#: include/global_form.php
msgid "Width (--width)"
msgstr "Platums (--platums)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Diagrammas apgabala platums (pikseļos) diagrammā. Šajā apgabalā nav ietverta leģenda, ass leģendas vai nosaukums."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "Bāzes vērtība (--bāze)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Jāiestata uz 1024 atmiņai un 1000 satiksmes mērījumiem."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "Slīpuma režīms (--slīpuma režīms)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Izmantojot slīpuma režīmu, diagrammu forma tiek izlīdzināta uz ekrāna izšķirtspējas rēķina."

#: include/global_form.php
msgid "Scaling Options"
msgstr "Mērogošanas opcijas"

#: include/global_form.php
msgid "Auto Scale"
msgstr "Auto Mērogs"

#: include/global_form.php
msgid "Auto scale the y-axis instead of defining an upper and lower limit. Note: if this is check both the Upper and Lower limit will be ignored."
msgstr "Automātiski mērogojiet y asi, nevis definējiet augšējo un apakšējo robežu. Piezīme: ja tas ir atzīmēts, gan augšējā, gan apakšējā robeža tiks ignorēta."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "Automātiskās mērogošanas opcijas"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Izmantot<br> --alt-autoscale, lai mērogotu līdz absolūtajam minimumam un maksimumam<br> --alt-autoscale-max, lai mērogotu līdz maksimālajai vērtībai, izmantojot norādīto apakšējo robežu<br> --alt-autoscale-min, lai mērogotu līdz minimālajai vērtībai, izmantojot norādīto augšējo robežu<br> --alt-autoscale (ar ierobežojumiem), lai mērogotu, izmantojot gan apakšējo, gan augšējo robežu (RRDtool noklusējums)<br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Izmantojiet --alt-autoscale (ignorējot norādītos ierobežojumus)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Izmantojiet --alt-autoscale-max (akceptējot zemāko robežu)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Izmantojiet --alt-autoscale-min (akceptējot augšējo robežu)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Izmantojiet --alt-autoscale (pieņem abus ierobežojumus, RRDtool noklusējums)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Logaritmiskā mērogošana (-logaritmiska)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "Izmantojiet logaritmisko y-ass mērogošanu"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "SI vienības logaritmiskai mērogošanai (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Izmantojiet SI vienības logaritmiskai mērogošanai, nevis izmantojiet eksponenciālo apzīmējumu.<br> Piezīme. Lineārajos grafikos pēc noklusējuma tiek izmantots SI apzīmējums."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Stingru robežu režīms (--stingrs)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Neizvērsiet apakšējo un augšējo robežu, ja diagrammā ir vērtība, kas ir ārpus derīgā diapazona."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "Augšējais ierobežojums (--augšējais ierobežojums)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "Diagrammas maksimālā vertikālā vērtība."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "Apakšējais ierobežojums (--zemākais ierobežojums)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "Diagrammas minimālā vertikālā vērtība."

#: include/global_form.php
msgid "Grid Options"
msgstr "Režģa opcijas"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Vienības režģa vērtība (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Iestata eksponenta vērtību uz Y ass skaitļiem. Piezīme. Šī opcija ir novecojusi un aizstāta ar opciju --y-grid. Šajā opcijā Y ass režģa līnijas parādās katrā režģa soļu intervālā. Etiķetes tiek novietotas katrā etiķetes faktoru līnijā."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Vienības eksponenta vērtība (--vienības-eksponents)"

#: include/global_form.php
msgid "What unit Cacti should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Kādu vienību kaktusi vajadzētu izmantot uz Y ass. Izmantojiet 3, lai visu parādītu ar \"k\" vai -6, lai visu parādītu ar \"u\" (mikro)."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Vienības garums (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Cik cipariem RRDtool vajadzētu pieņemt, ka y ass etiķetes ir? Iespējams, jums būs jāizmanto šī opcija, lai atbrīvotu pietiekami daudz vietas, kad sākat ķerties pie y ass marķējuma."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "Nav Gridfit (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "Lai izvairītos no pretizplūduma efektiem, RRDtool piesaista punktus ierīces izšķirtspējas pikseļiem, tādējādi iegūstot izteiksmīgāku izskatu. Ja tas jums nepatīk, varat izmantot šo slēdzi, lai izslēgtu šo darbību.<br> <strong>Piezīme.</strong> Gridfitting ir izslēgts PDF, EPS, SVG izvadei pēc noklusējuma."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Alternatīvais Y režģis (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Algoritms nodrošina, ka jums vienmēr ir režģis, ka ir pietiekami daudz, bet ne pārāk daudz režģa līniju, un ka režģis ir metrisks. Šis parametrs arī nodrošinās, ka tiek parādīts pietiekami daudz decimāldaļu pat tad, ja diagramma mainās no 69 998 līdz 70 001.<br> <strong>Piezīme.</strong> Šis parametrs var traucēt --alt-autoscale opcijām."

#: include/global_form.php
msgid "Axis Options"
msgstr "Ass opcijas"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Labā ass (--labā ass &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "Otrā ass tiks uzzīmēta pa labi no grafika. Tas ir saistīts ar kreiso asi, izmantojot skalas un maiņas parametrus."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Labās ass etiķete (--labās ass apzīmējums &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "Labās ass etiķete."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Labās ass formāts (--labās ass-formāts &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Pēc noklusējuma asu etiķešu formāts tiek noteikts automātiski. Ja vēlaties to izdarīt pats, izmantojiet šo opciju ar tiem pašiem %lf argumentiem, ko zināt no komandām PRINT un GPRINT."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Labās ass formatētājs (--labās ass-formatētājs &lt;formāta nosaukums&gt;)"

#: include/global_form.php
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Iestatot labās ass marķējumu, piemērojiet kārtulu datu formātam. Atbalstītie formāti ietver \"ciparu\", kur dati tiek apstrādāti kā skaitļi, \"laikspiedols\", kur vērtības tiek interpretētas kā UNIX laikspiedoli (sekunžu skaits kopš 1970. gada janvāra) un izteiktas, izmantojot strftime formātu (noklusējums ir \"%Y-%m-%d %H\". :%JAUNKUNDZE\"). Skatiet arī --units-length un --right-axis-format. Visbeidzot \"ilgums\", kur vērtības tiek interpretētas kā ilgums milisekundēs. Formatēšana notiek saskaņā ar valstrfduration qualified PRINT/GPRINT noteikumiem."

#: include/global_form.php
#, fuzzy
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Iestatot kreisās ass marķējumu, piemērojiet kārtulu datu formātam. Atbalstītie formāti ietver \"ciparu\", kur dati tiek apstrādāti kā skaitļi, \"laikspiedols\", kur vērtības tiek interpretētas kā UNIX laikspiedoli (sekunžu skaits kopš 1970. gada janvāra) un izteiktas, izmantojot strftime formātu (noklusējums ir \"%Y-%m-%d %H\". :%JAUNKUNDZE\"). Skatīt arī --units-long. Visbeidzot \"ilgums\", kur vērtības tiek interpretētas kā ilgums milisekundēs. Formatēšana notiek saskaņā ar valstrfduration qualified PRINT/GPRINT noteikumiem."

#: include/global_form.php
msgid "Legend Options"
msgstr "Leģendas opcijas"

#: include/global_form.php
msgid "Auto Padding"
msgstr "Automātiskais polsterējums"

#: include/global_form.php
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Iestatiet tekstu tā, lai leģendas un diagrammas dati vienmēr sakristu. Piezīme. Tādējādi diagrammu renderēšana var aizņemt ilgāku laiku, jo ir lielākas izmaksas. Arī automātiskais polsterējums var nebūt precīzs visu veidu diagrammās, konsekventa marķēšana parasti palīdz."

#: include/global_form.php
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Dinamiskās iezīmes (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "Zīmējiet līniju marķierus kā līniju."

#: include/global_form.php
#, fuzzy
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Force Rules Legend (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Piespiediet HRULE un VRULE leģendu ģenerēšanu."

#: include/global_form.php
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Cilnes platums (--tabwidth &lt;pikseļi&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Pēc noklusējuma cilnes platums ir 40 pikseļi. Izmantojiet šo opciju, lai to mainītu."

#: include/global_form.php
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Leģendas pozīcija (--legend-position=&lt;position&gt;)"

#: include/global_form.php
msgid "Place the legend at the given side of the graph."
msgstr "Novietojiet leģendu diagrammas norādītajā pusē."

#: include/global_form.php
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Leģendas virziens (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php
msgid "Place the legend items in the given vertical order."
msgstr "Novietojiet leģendas vienumus norādītajā vertikālajā secībā."

#: include/global_form.php lib/api_aggregate.php lib/html.php
msgid "Graph Item Type"
msgstr "Grafika elementa tips"

#: include/global_form.php
msgid "How data for this item is represented visually on the graph."
msgstr "Kā šī elementa dati tiek vizuāli attēloti grafikā."

#: include/global_form.php
msgid "The data source to use for this graph item."
msgstr "Datu avots, ko izmantot šim grafikas elementam."

#: include/global_form.php
msgid "The color to use for the legend."
msgstr "Leģendai izmantojamā krāsa."

#: include/global_form.php
msgid "Opacity/Alpha Channel"
msgstr "Necaurredzamība/Alfa kanāls"

#: include/global_form.php
msgid "The opacity/alpha channel of the color."
msgstr "Krāsas necaurredzamības/alfa kanāls."

#: include/global_form.php lib/rrd.php
msgid "Consolidation Function"
msgstr "Konsolidācijas funkcija"

#: include/global_form.php
msgid "How data for this item is represented statistically on the graph."
msgstr "Kā šī elementa dati tiek statistiski attēloti grafikā."

#: include/global_form.php
msgid "CDEF Function"
msgstr "CDEF funkcija"

#: include/global_form.php
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "CDEF (matemātikā) funkcija, ko piemērot šim elementam grafikā vai leģendā."

#: include/global_form.php
msgid "VDEF Function"
msgstr "VDEF funkcija"

#: include/global_form.php
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "VDEF (matemātikā) funkcija, ko piemērot šim elementam grafikas leģendā."

#: include/global_form.php
msgid "Shift Data"
msgstr "Shift Data"

#: include/global_form.php
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "Nobīdiet savus datus uz laika ass (x ass) par vērtību, kas norādīta laukā \"vērtība\"."

#: include/global_form.php
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
msgstr "[HRULE|VRULE]: grafikas elementa vērtība.<br/> [TICK]: atzīmes līnijas daļa.<br/> [SHIFT]: laika nobīde sekundēs."

#: include/global_form.php
msgid "GPRINT Type"
msgstr "GPRINT tips"

#: include/global_form.php
msgid "If this graph item is a GPRINT, you can optionally choose another format here. You can define additional types under \"GPRINT Presets\"."
