msgstr "Αυτός είναι ο κατάλογος όπου τα αρχεία RRD <strong>μετακινούνται</strong> για αρχειοθέτηση"

#: include/global_settings.php:304
msgid "Log Settings"
msgstr "Ρυθμίσεις καταγραφής"

