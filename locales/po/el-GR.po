#: include/global_settings.php:2138
msgid "This is the path to sendmail on your server. (Only used if Sendmail is selected as the Mail Service)"
msgstr "Αυτή είναι η διαδρομή για την αποστολή μηνυμάτων ηλεκτρονικού ταχυδρομείου στον διακομιστή σας. (Χρησιμοποιείται μόνο εάν το Sendmail έχει επιλεγεί ως η Υπηρεσία Αλληλογραφίας)"

#: include/global_settings.php:2146
msgid "SMTP Options"
msgstr "Επιλογές SMTP"

#: include/global_settings.php:2151
msgid "SMTP Hostname"
msgstr "Όνομα κεντρικού υπολογιστή SMTP"

#: include/global_settings.php:2152
msgid "This is the hostname/IP of the SMTP Server you will send the Email to. For failover, separate your hosts using a semi-colon."
msgstr "Αυτό είναι το όνομα κεντρικού υπολογιστή/IP του διακομιστή SMTP στον οποίο θα στείλετε το μήνυμα ηλεκτρονικού ταχυδρομείου. Για το failover, διαχωρίστε τους οικοδεσπότες σας χρησιμοποιώντας ένα ερωτηματικό."

#: include/global_settings.php:2158
msgid "SMTP Port"
msgstr "SMTP Port"

#: include/global_settings.php:2159
msgid "The port on the SMTP Server to use."
msgstr "Η θύρα στον διακομιστή SMTP που θα χρησιμοποιηθεί."

#: include/global_settings.php:2166
msgid "SMTP Username"
msgstr "ως όνομα χρήστη"

#: include/global_settings.php:2167
msgid "The username to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Το όνομα χρήστη με το οποίο θα γίνεται ο έλεγχος ταυτότητας κατά την αποστολή μέσω SMTP. (Αφήστε κενό εάν δεν απαιτείται έλεγχος ταυτότητας.)"

#: include/global_settings.php:2172
msgid "SMTP Password"
msgstr "Κωδικός πρόσβασης SMTP"

#: include/global_settings.php:2173
msgid "The password to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Ο κωδικός πρόσβασης για τον έλεγχο ταυτότητας με κατά την αποστολή μέσω SMTP. (Αφήστε κενό εάν δεν απαιτείται έλεγχος ταυτότητας.)"

#: include/global_settings.php:2178
msgid "SMTP Security"
msgstr "Ασφάλεια SMTP"

#: include/global_settings.php:2179
msgid "The encryption method to use for the Email."
msgstr "Η μέθοδος κρυπτογράφησης που θα χρησιμοποιηθεί για το Email."

#: include/global_settings.php:2183
msgid "SSL"
msgstr "SSL"

#: include/global_settings.php:2184
msgid "TLS"
msgstr "TLS"

#: include/global_settings.php:2189
msgid "SMTP Timeout"
msgstr "Λήξη χρονικού ορίου SMTP"

#: include/global_settings.php:2190
msgid "Please enter the SMTP timeout in seconds."
msgstr "Εισαγάγετε το χρονικό όριο SMTP σε δευτερόλεπτα."

#: include/global_settings.php:2197
msgid "Reporting Presets"
msgstr "Προεπιλογές αναφοράς"

#: include/global_settings.php:2202
msgid "Default Graph Image Format"
msgstr "Προεπιλεγμένη μορφή εικόνας γραφήματος"

#: include/global_settings.php:2203
msgid "When creating a new report, what image type should be used for the inline graphs."
msgstr "Κατά τη δημιουργία μιας νέας αναφοράς, ποιος τύπος εικόνας θα πρέπει να χρησιμοποιείται για τα ενσωματωμένα γραφήματα."

#: include/global_settings.php:2209
msgid "Maximum E-Mail Size"
msgstr "Μέγιστο μέγεθος email"

#: include/global_settings.php:2210
msgid "The maximum size of the E-Mail message including all attachments."
msgstr "Το μέγιστο μέγεθος του μηνύματος ηλεκτρονικού ταχυδρομείου, συμπεριλαμβανομένων όλων των συνημμένων."

#: include/global_settings.php:2216
msgid "Poller Logging Level for Cacti Reporting"
msgstr "Επίπεδο καταγραφής δημοσκοπήσεων για την αναφορά Cacti"

#: include/global_settings.php:2217
msgid "What level of detail do you want sent to the log file. WARNING: Leaving in any other status than NONE or LOW can exhaust your disk space rapidly."
msgstr "Τι επίπεδο λεπτομέρειας θέλετε να σταλεί στο αρχείο καταγραφής. ΠΡΟΕΙΔΟΠΟΙΗΣΗ: Η αναχώρηση σε οποιαδήποτε άλλη κατάσταση εκτός από ΜΗΔΕΝΙΚΗ ή ΧΑΜΗΛΗ μπορεί να εξαντλήσει γρήγορα το χώρο στο δίσκο σας."

#: include/global_settings.php:2223
msgid "Enable Lotus Notes (R) tweak"
msgstr "Ενεργοποίηση τροποποίησης Lotus Notes (R)"

#: include/global_settings.php:2224
msgid "Enable code tweak for specific handling of Lotus Notes Mail Clients."
msgstr "Ενεργοποίηση τροποποίησης κώδικα για συγκεκριμένο χειρισμό των Lotus Notes Mail Clients."

#: include/global_settings.php:2229
msgid "DNS Options"
msgstr "Επιλογές DNS"

#: include/global_settings.php:2234
msgid "Primary DNS IP Address"
msgstr "Κύρια διεύθυνση IP DNS"

#: include/global_settings.php:2235
msgid "Enter the primary DNS IP Address to utilize for reverse lookups."
msgstr "Εισαγάγετε την κύρια διεύθυνση IP DNS που θα χρησιμοποιηθεί για αντίστροφες αναζητήσεις."

#: include/global_settings.php:2241
msgid "Secondary DNS IP Address"
msgstr "Δευτερεύουσα διεύθυνση IP DNS"

#: include/global_settings.php:2242
msgid "Enter the secondary DNS IP Address to utilize for reverse lookups."
msgstr "Εισαγάγετε τη δευτερεύουσα διεύθυνση IP DNS που θα χρησιμοποιηθεί για αντίστροφες αναζητήσεις."

#: include/global_settings.php:2248
msgid "DNS Timeout"
msgstr "Τέλος χρόνου"

#: include/global_settings.php:2249
msgid "Please enter the DNS timeout in milliseconds.  Cacti uses a PHP based DNS resolver."
msgstr "Εισαγάγετε το χρονικό όριο DNS σε χιλιοστά του δευτερολέπτου. Το Cacti χρησιμοποιεί έναν αναλυτή DNS που βασίζεται στην PHP."

#: include/global_settings.php:2256
msgid "Internet Proxy Settings"
msgstr "Ρυθμίσεις Internet Proxy"

#: include/global_settings.php:2261
msgid "Internet Proxy Address"
msgstr "Διεύθυνση διαδικτυακού πληρεξουσίου"

#: include/global_settings.php:2262
msgid "For either core Cacti Services or Plugins that require internet access, enter the proxy server and port here in the following format IP:PORT.  For example 192.168.1.1:8080."
msgstr "Για τις βασικές υπηρεσίες Cacti ή τα πρόσθετα που απαιτούν πρόσβαση στο διαδίκτυο, εισαγάγετε τον διακομιστή μεσολάβησης και τη θύρα εδώ με την ακόλουθη μορφή IP:PORT.  Για παράδειγμα 192.168.1.1:8080."

#: include/global_settings.php:2269
msgid "Internet Proxy User"
msgstr "Χρήστης Internet Proxy"

#: include/global_settings.php:2270
msgid "If your Internet Proxy requires a username, enter it here."
msgstr "Εάν ο διακομιστής μεσολάβησης Internet απαιτεί όνομα χρήστη, πληκτρολογήστε το εδώ."

#: include/global_settings.php:2277
msgid "Internet Proxy Password"
msgstr "Κωδικός πρόσβασης Internet Proxy"

#: include/global_settings.php:2278
msgid "If your Internet Proxy requires a password, enter it here."
msgstr "Εάν ο Internet Proxy σας απαιτεί κωδικό πρόσβασης, πληκτρολογήστε τον εδώ."

#: include/global_settings.php:2288
msgid "On-demand RRD Update Settings"
msgstr "Ρυθμίσεις ενημέρωσης RRD κατ 'απαίτηση"

#: include/global_settings.php:2293
msgid "Enable On-demand RRD Updating"
msgstr "Ενεργοποίηση ενημέρωσης RRD κατ 'απαίτηση"

#: include/global_settings.php:2294
msgid "Should Boost enable on demand RRD updating in Cacti?  If you disable, this change will not take affect until after the next polling cycle.  When you have Remote Data Collectors, this settings is required to be on."
msgstr "Πρέπει το Boost να ενεργοποιεί την ενημέρωση RRD κατ 'απαίτηση στους κάκτους;  Εάν απενεργοποιήσετε τη λειτουργία, αυτή η αλλαγή δεν θα επηρεαστεί παρά μόνο μετά τον επόμενο κύκλο ψηφοφορίας.  Όταν έχετε Απομακρυσμένους Συλλέκτες Δεδομένων, αυτές οι ρυθμίσεις πρέπει να είναι ενεργοποιημένες."

#: include/global_settings.php:2299
msgid "System Level RRD Updater"
msgstr "Ενημερωτής RRD επιπέδου συστήματος"

#: include/global_settings.php:2300
msgid "Before RRD On-demand Update Can be Cleared, a poller run must always pass"
msgstr "Πριν από την εκκαθάριση της κατ 'απαίτηση ενημέρωσης RRD, πρέπει πάντα να περνάει μια δημοσκόπηση"

#: include/global_settings.php:2305
msgid "How Often Should Boost Update All RRDs"
msgstr "Πόσο συχνά πρέπει να ενισχύεται η ενημέρωση όλων των RRD"

#: include/global_settings.php:2306
msgid "When you enable boost, your RRD files are only updated when they are requested by a user, or when this time period elapses."
msgstr "Όταν ενεργοποιείτε την Boost, τα αρχεία RRD ενημερώνονται μόνο όταν ζητούνται από έναν χρήστη ή όταν παρέλθει αυτό το χρονικό διάστημα."

#: include/global_settings.php:2312
msgid "Number of Boost Processes"
msgstr "Αριθμός διαδικασιών ενίσχυσης"

#: include/global_settings.php:2313
msgid "The number of concurrent boost processes to use to use to process all of the RRDs in the boost table."
msgstr "Ο αριθμός των ταυτόχρονων διαδικασιών ώθησης που θα χρησιμοποιηθούν για την επεξεργασία όλων των RRD στον πίνακα ώθησης."

#: include/global_settings.php:2340
msgid "Maximum Records"
msgstr "Μέγιστος αριθμός εγγραφών"

#: include/global_settings.php:2341
msgid "If the boost output table exceeds this size, in records, an update will take place."
msgstr "Εάν ο πίνακας εξόδου ώθησης υπερβαίνει αυτό το μέγεθος, σε εγγραφές, θα πραγματοποιηθεί ενημέρωση."

#: include/global_settings.php:2348
msgid "Maximum Data Source Items Per Pass"
msgstr "Μέγιστα στοιχεία προέλευσης δεδομένων ανά πέρασμα"

#: include/global_settings.php:2349
msgid "To optimize performance, the boost RRD updater needs to know how many Data Source Items should be retrieved in one pass.  Please be careful not to set too high as graphing performance during major updates can be compromised.  If you encounter graphing or polling slowness during updates, lower this number.  The default value is 50000."
msgstr "Για να βελτιστοποιηθεί η απόδοση, το πρόγραμμα ενημέρωσης Boost RRD πρέπει να γνωρίζει πόσα στοιχεία προέλευσης δεδομένων πρέπει να ανακτηθούν σε ένα πέρασμα.  Προσέξτε να μην ορίσετε πολύ υψηλή τιμή, καθώς μπορεί να διακυβευτεί η απόδοση της γραφικής παράστασης κατά τη διάρκεια σημαντικών ενημερώσεων.  Εάν αντιμετωπίσετε βραδύτητα γραφημάτων ή δημοσκοπήσεων κατά τη διάρκεια ενημερώσεων, μειώστε αυτόν τον αριθμό.  Η προεπιλεγμένη τιμή είναι 50000."

#: include/global_settings.php:2355
msgid "Maximum Argument Length"
msgstr "Μέγιστο μήκος επιχειρήματος"

#: include/global_settings.php:2356
msgid "When boost sends update commands to RRDtool, it must not exceed the operating systems Maximum Argument Length.  This varies by operating system and kernel level.  For example: Windows 2000 <= 2048, FreeBSD <= 65535, Linux 2.6.22-- <= 131072, Linux 2.6.23++ unlimited"
msgstr "Όταν το Boost στέλνει εντολές ενημέρωσης στο εργαλείο RRD, δεν πρέπει να υπερβαίνει το μέγιστο μήκος ορίσματος των λειτουργικών συστημάτων.  Αυτό ποικίλλει ανάλογα με το λειτουργικό σύστημα και το επίπεδο πυρήνα.  Για παράδειγμα: Windows 2000 <= 2048, FreeBSD <= 65535, Linux 2.6.22-- <= 131072, Linux 2.6.23++ unlimited"

#: include/global_settings.php:2363
msgid "Memory Limit for Boost and Poller"
msgstr "Όριο μνήμης για Boost και Poller"

#: include/global_settings.php:2364
msgid "The maximum amount of memory for the Cacti Poller and Boosts Poller"
msgstr "Η μέγιστη ποσότητα μνήμης για το Cacti Poller and Boosts Poller"

#: include/global_settings.php:2370
msgid "Maximum RRD Update Script Run Time"
msgstr "Μέγιστος χρόνος εκτέλεσης σεναρίου ενημέρωσης RRD"

#: include/global_settings.php:2371
msgid "If the boost poller exceeds this runtime, a warning will be placed in the cacti log,"
msgstr "Εάν ο ενισχυτής γύρης υπερβεί αυτόν τον χρόνο εκτέλεσης, θα τοποθετηθεί μια προειδοποίηση στο ημερολόγιο των κάκτων,"

#: include/global_settings.php:2377
msgid "Enable Direct Population of Boost Table"
msgstr "Ενεργοποίηση Άμεσου Πληθυσμού του Πίνακα Ενίσχυσης"

#: include/global_settings.php:2378
msgid "Enables direct insert of records into poller output boost table with results in a 25% time reduction in each poll cycle."
msgstr "Επιτρέπει την άμεση εισαγωγή των εγγραφών στον πίνακα ώθησης εξόδου δημοσκόπησης με αποτέλεσμα τη μείωση κατά 25 % ti me σε κάθε κύκλο δημοσκόπησης."

#: include/global_settings.php:2383
msgid "Enable Boost Debugging"
msgstr "Ενεργοποίηση Ενίσχυσης Αποσφαλμάτωσης"

#: include/global_settings.php:2384
msgid "If set, Boost will log debug information directly to the Boost log file.  Please note, enabling can cause a high I/O rate on the local file system."
msgstr "Εάν οριστεί, το Boost θα καταγράψει πληροφορίες εντοπισμού σφαλμάτων απευθείας στο αρχείο καταγραφής Boost.  Λάβετε υπόψη ότι η ενεργοποίηση μπορεί να προκαλέσει υψηλό ρυθμό εισόδου/εξόδου στο τοπικό σύστημα αρχείων."

#: include/global_settings.php:2389 utilities.php:1805
msgid "Image Caching"
msgstr "Προσωρινή αποθήκευση εικόνων"

#: include/global_settings.php:2394
msgid "Enable Image Caching"
msgstr "Ενεργοποίηση προσωρινής αποθήκευσης εικόνων"

#: include/global_settings.php:2395
msgid "Should image caching be enabled?"
msgstr "Πρέπει να ενεργοποιηθεί η προσωρινή αποθήκευση εικόνων;"

#: include/global_settings.php:2400
msgid "Location for Image Files"
msgstr "Τοποθεσία για αρχεία εικόνας"

#: include/global_settings.php:2401
msgid "Specify the location where Boost should place your image files.  These files will be automatically purged by the poller when they expire."
msgstr "Καθορίστε την τοποθεσία όπου θα πρέπει να τοποθετήσει τα αρχεία εικόνας σας το Boost.  Αυτά τα αρχεία θα εκκαθαριστούν αυτόματα από τον δημοσκόπο όταν λήξουν."

#: include/global_settings.php:2410
msgid "Data Sources Statistics"
msgstr "Στατιστικά πηγών δεδομένων"

#: include/global_settings.php:2415
msgid "Enable Data Source Statistics Collection"
msgstr "Ενεργοποίηση συλλογής στατιστικών προέλευσης δεδομένων"

#: include/global_settings.php:2416
msgid "Should Data Source Statistics be collected for this Cacti system?"
msgstr "Πρέπει να συλλέγονται στατιστικά στοιχεία πηγής δεδομένων για αυτό το σύστημα Cacti;"

#: include/global_settings.php:2421
msgid "Data Collection Method"
msgstr "Μέθοδος Συλλογής Δεδομένων"

#: include/global_settings.php:2422
msgid "Data Source Statistics can use a legacy method where it will determine peak and average values, or an advanced mode which will calculated several additional statistical values in addition to peak and average.  Using All Statistical Metrics can place additional CPU and IO load on the system."
msgstr "Οι στατιστικές προέλευσης δεδομένων μπορούν να χρησιμοποιήσουν μια μέθοδο παλαιού τύπου, όπου θα προσδιορίζουν τις μέγιστες και τις μέσες τιμές, ή μια προηγμένη λειτουργία, η οποία θα υπολογίζει αρκετές πρόσθετες στατιστικές τιμές εκτός από τις μέγιστες και τις μέσες τιμές.  Η χρήση όλων των στατιστικών μετρήσεων μπορεί να τοποθετήσει επιπλέον φορτίο CPU και IO στο σύστημα."

#: include/global_settings.php:2426
msgid "Peak/Average Only"
msgstr "Μόνο αιχμή/μέσος όρος"

#: include/global_settings.php:2427
msgid "All Statistical Metrics"
msgstr "Όλες οι στατιστικές μετρήσεις"

#: include/global_settings.php:2431
msgid "Calculate Peaks Stats in Addition to Average Stats"
msgstr "Υπολογισμός στατιστικών κορυφών σε προσθήκη στα μέσα στατιστικά"

#: include/global_settings.php:2432
msgid "This option will double the data collection time.  If will use the MAX consolidation function and calculate statistics from the max values in each of the respective time ranges."
msgstr "Αυτή η επιλογή θα διπλασιάσει τον χρόνο συλλογής δεδομένων. Το if θα χρησιμοποιήσει τη συνάρτηση ΜΕΓΙΣΤΗΣ ενοποίησης και θα υπολογίσει τα στατιστικά στοιχεία από τις μέγιστες τιμές σε κάθε ένα από τα αντίστοιχα χρονικά διαστήματα."

#: include/global_settings.php:2437
msgid "Number of DSStats Processes"
msgstr "Αριθμός διεργασιών DSStats"

#: include/global_settings.php:2438
msgid "The number of concurrent DSStats processes to use to use to process all of the Data Sources."
msgstr "Ο αριθμός των ταυτόχρονων διαδικασιών DSStats που θα χρησιμοποιηθούν για την επεξεργασία όλων των πηγών δεδομένων."

#: include/global_settings.php:2465
msgid "Daily Update Frequency"
msgstr "Συχνότητα καθημερινής ενημέρωσης"

#: include/global_settings.php:2466
msgid "How frequent should Daily Stats be updated?"
msgstr "Πόσο συχνά πρέπει να ενημερώνονται τα Ημερήσια Στατιστικά;"

#: include/global_settings.php:2472
msgid "Hourly Average Window"
msgstr "Ωριαίο μέσο παράθυρο"

#: include/global_settings.php:2473
msgid "The number of consecutive hours that represent the hourly average.  Keep in mind that a setting too high can result in very large memory tables"
msgstr "Ο αριθμός των διαδοχικών ωρών που αντιπροσωπεύουν τον ωριαίο μέσο όρο.  Λάβετε υπόψη ότι μια ρύθμιση πολύ υψηλή μπορεί να οδηγήσει σε πολύ μεγάλους πίνακες μνήμης"

#: include/global_settings.php:2479
msgid "Maintenance Time"
msgstr "Χρόνος συντήρησης"

#: include/global_settings.php:2480
msgid "What time of day should Weekly, Monthly, and Yearly Data be updated?  Format is HH:MM [am/pm]"
msgstr "Ποια ώρα της ημέρας πρέπει να ενημερώνονται τα Εβδομαδιαία, Μηνιαία και Ετήσια Δεδομένα; Η μορφή είναι ΩΩ:ΛΛ [am/pm]"

#: include/global_settings.php:2487
msgid "Memory Limit for Data Source Statistics Data Collector"
msgstr "Όριο Μνήμης για Συλλέκτη Δεδομένων Στατιστικής Προέλευσης Δεδομένων"

#: include/global_settings.php:2488
msgid "The maximum amount of memory for the Cacti Poller and Data Source Statistics Poller"
msgstr "Η μέγιστη ποσότητα μνήμης για το Cacti Poller και το Data Source Statistics Poller"

#: include/global_settings.php:2494
msgid "Data Source Retention Settings"
msgstr "Ρυθμίσεις διατήρησης πηγής δεδομένων"

#: include/global_settings.php:2499
msgid "Save Historical Data in Database Tables"
msgstr "Αποθήκευση ιστορικών δεδομένων σε πίνακες βάσεων δεδομένων"

#: include/global_settings.php:2500
msgid "Check this setting in order to keep a table for each day, week, month, and year data.  The times that these tables will be created will be based upon the following formula: Daily - One partition per day, Weekly - One Partition per Week, Monthly - One partition per Month, Yearly - One Partition per Year.  All tables will have the following suffixes by type Daily: YYYYDDD, Weekly: YYYYWW, Monthly: YYYYMM, and Yearly: YYYY suffixes."
msgstr ""

#: include/global_settings.php:2505
msgid "Daily Partition Retention"
msgstr "Καθημερινή διατήρηση διαμερίσματος"

#: include/global_settings.php:2506
msgid "The number of Days, Weeks, Months, or Years to keep daily statistics."
msgstr "Ο αριθμός των ημερών, εβδομάδων, μηνών ή ετών για την τήρηση ημερήσιων στατιστικών στοιχείων."

#: include/global_settings.php:2512
msgid "Weekly Partition Retention"
msgstr "Εβδομαδιαία διατήρηση κατατμήσεων"

#: include/global_settings.php:2513
msgid "The number of Days, Weeks, Months, or Years to keep weekly statistics."
msgstr "Ο αριθμός των ημερών, εβδομάδων, μηνών ή ετών για την τήρηση εβδομαδιαίων στατιστικών στοιχείων."

#: include/global_settings.php:2519
msgid "Monthly Partition Retention"
msgstr "Μηνιαία διατήρηση κατατμήσεων"

#: include/global_settings.php:2520
msgid "The number of Days, Weeks, Months, or Years to keep monthly statistics."
msgstr "Ο αριθμός των ημερών, εβδομάδων, μηνών ή ετών για την τήρηση μηνιαίων στατιστικών στοιχείων."

#: include/global_settings.php:2526
msgid "Yearly Partition Retention"
msgstr "Ετήσια διατήρηση κατατμήσεων"

#: include/global_settings.php:2527
msgid "The number of Days, Weeks, Months, or Years to keep yearly statistics."
msgstr "Ο αριθμός των ημερών, εβδομάδων, μηνών ή ετών για την τήρηση ετήσιων στατιστικών στοιχείων."

#: include/global_settings.php:2533
msgid "RRDfile Check"
msgstr "Έλεγχος αρχείου RRD"

#: include/global_settings.php:2538
msgid "Enable RRDfile Check"
msgstr "Ενεργοποίηση ελέγχου αρχείου RRD"

#: include/global_settings.php:2539
msgid "Should RRDfile Check be enabled for this Cacti system?"
msgstr "Πρέπει να ενεργοποιηθεί ο έλεγχος αρχείου RRD για αυτό το σύστημα Cacti;"

#: include/global_settings.php:2544
msgid "Number of RRDfile Check Processes"
msgstr "Αριθμός διαδικασιών ελέγχου φακέλου RRD"

#: include/global_settings.php:2545
