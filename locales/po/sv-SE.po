msgstr "Placera förklaringen på den angivna sidan av grafen."

#: include/global_form.php:969
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Förklaringens riktning (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php:973
