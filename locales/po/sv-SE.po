msgstr "Text placerad längst ned i varje graf."

#: include/global_settings.php:1242
msgid "Custom Date Format"
msgstr "Anpassat datumformat"

#: include/global_settings.php:1243
msgid "To be used when formatting |date_time| on a graph"
msgstr "Används vid formatering | date_time | på en graf"

#: include/global_settings.php:1250
msgid "Disable RRDtool Watermark"
msgstr "RRDtool Graph Watermark"

#: include/global_settings.php:1251
