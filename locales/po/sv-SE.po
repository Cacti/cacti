msgstr "Med mall / datasökning"

#: include/global_settings.php:1156
msgid "Log Management"
msgstr "Loghantering"

#: include/global_settings.php:1161
msgid "Default Log Tail Lines"
msgstr "Standard Log Tail Lines"

#: include/global_settings.php:1162
msgid "Default number of lines of the Cacti log file to tail."
msgstr "Standard antal linjer i Cacti loggfilen till svans."

#: include/global_settings.php:1168
msgid "Maximum number of rows per page"
msgstr "Maximalt antal rader per sida"

#: include/global_settings.php:1169
