#, php-format
msgid "%d Changes"
msgstr "%d Förändringar"

#: include/global_settings.php:2000
msgid "Account Email Notification"
msgstr "E-postavisering av konto"

#: include/global_settings.php:2005
msgid "Send email to new user"
msgstr "Skicka e-post till ny användare"

#: include/global_settings.php:2006
msgid "When an admin creates a new account and an email address is entered, send an informational email to it."
msgstr "När en administratör skapar ett nytt konto och anger en e-postadress skickar du ett informationsmeddelande till den."

#: include/global_settings.php:2011
msgid "Subject of new user message"
msgstr "Ämne för meddelande till ny användare"

#: include/global_settings.php:2012
msgid "This is the Email subject that will be used for new user message."
msgstr "Detta är e-postämnet som kommer att användas för nya användarmeddelanden."

#: include/global_settings.php:2019
msgid "Email body for new user message"
msgstr "E-posttext för meddelande till ny användare"

#: include/global_settings.php:2020
msgid "This is the message that will be send to new user account. Max 1024 characters. HTML is allowed. There are several common replacement tags that may be used in include &#060CACTIURL&#062 &#060USERNAME&#062 &#060PASSWORD&#062"
msgstr "Detta är det meddelande som kommer att skickas till det nya användarkontot. Max 1024 tecken. HTML är tillåtet. Det finns flera vanliga ersättningstaggar som kan användas i include &#060CACTIURL&#062 &#060USERNAME&#062 &#060PASSWORD&#062"

#: include/global_settings.php:2025
msgid "New user created. <br>Server: <a href=\"<CACTIURL>\"><CACTIURL></a><br>Username: <USERNAME><br>To login and set a new password, use <a href=\"<PWDRESETLINK>\">the following link</a><br><br>"
msgstr "Ny användare skapad. <br>Server: <a href=\"<CACTIURL>\"><CACTIURL></a><br>Användarnamn: <USERNAME><br>För att logga in och ange ett nytt lösenord, använd <a href=\"<PWDRESETLINK>\">följande länk</a><br><br>"

#: include/global_settings.php:2028
msgid "Send email when an admin changes a user password"
msgstr "Skicka e-post när en administratör ändrar en användares lösenord"

#: include/global_settings.php:2029
msgid "When an admin changes the password of an account and the email address for that account is entered, send an informational email to that address."
msgstr "När en administratör ändrar lösenordet för ett konto och e-postadressen för det kontot anges, skickar du ett informationsmeddelande till den adressen."

#: include/global_settings.php:2034
msgid "Subject of reset password message"
msgstr "Ämne för meddelande om återställning av lösenord"

#: include/global_settings.php:2035
msgid "This is the Email subject that will be used when admin change user password or user use 'Forgot password'."
msgstr "Det här är e-postadressen som används när administratören ändrar användarens lösenord eller när användaren använder \"Glömt lösenord\"."

#: include/global_settings.php:2037
msgid "Cacti - password reset"
msgstr "Cacti - återställning av lösenord"

#: include/global_settings.php:2042
msgid "Email body for reset password message"
msgstr "E-posttext för meddelande om återställning av lösenord"

#: include/global_settings.php:2043
msgid "This is the message that will be sent when a user requests a password reset. Max 1024 characters. HTML is allowed. There are several common replacement tags that may be used in include &#060CACTIURL&#062 &#060USERNAME&#062 &#060PASSWORD&#062"
msgstr "Detta är det meddelande som skickas när en användare begär en återställning av lösenordet. Max 1024 tecken. HTML är tillåtet. Det finns flera vanliga ersättningstaggar som kan användas i include &#060CACTIURL&#062 &#060USERNAME&#062 &#060PASSWORD&#062"

#: include/global_settings.php:2048
msgid "User's password has been reset. <br>Server: <a href=\"<CACTIURL>\"><CACTIURL></a><br>Username: <USERNAME><br>To set a new password, use <a href=\"<PWDRESETLINK>\">the following link</a><br><br>"
msgstr "Användarens lösenord har återställts. <br>Server: <a href=\"<CACTIURL>\"><CACTIURL></a><br>Användarnamn: <USERNAME><br>För att ställa in ett nytt lösenord, använd <a href=\"<PWDRESETLINK>\">följande länk</a><br><br>"

#: include/global_settings.php:2051
msgid "Reset link validity"
msgstr "Återställ länkens giltighet"

#: include/global_settings.php:2052
msgid "How long the resetlink is valid in minutes"
msgstr "Hur länge reset-länken är giltig i minuter"

#: include/global_settings.php:2066
msgid "URL Linking"
msgstr "URL-länkning"

#: include/global_settings.php:2071
msgid "Server Base URL"
msgstr "Serverbasadress"

#: include/global_settings.php:2072
msgid "This is a the server location that will be used for links to the Cacti site. This should include the subdirectory if Cacti does not run from root folder."
msgstr ""
"Detta är en serverplats som ska användas för länkar till Cacti-webbplatsen."

#: include/global_settings.php:2079
msgid "Emailing Options"
msgstr "Emailing Options"

#: include/global_settings.php:2083
msgid "Notify Primary Admin of Issues"
msgstr "Meddela primäradministratör av problem"

#: include/global_settings.php:2084
msgid "In cases where the Cacti server is experiencing problems, should the Primary Administrator be notified by Email?  The Primary Administrator's Cacti user account is specified under the Authentication tab on Cacti's settings page. It defaults to the 'admin' account."
msgstr ""
"Om Cacti-servern upplever problem, ska den primära administratören meddelas "
"via e-post? Den primära administratörens Cacti-användarkonto anges under "
"fliken Autentisering på Cacti-inställningssidan. Det är standard för "
"&quot;admin&quot; -kontot."

#: include/global_settings.php:2089
msgid "Test Email"
msgstr "Testa e-post"

#: include/global_settings.php:2090
msgid "This is a Email account used for sending a test message to ensure everything is working properly."
msgstr ""
"Det här är ett e-postkonto som används för att skicka ett testmeddelande för "
"att säkerställa att allt fungerar korrekt."

#: include/global_settings.php:2095
msgid "Mail Services"
msgstr "Posttjänster"

#: include/global_settings.php:2096
msgid "Which mail service to use in order to send mail"
msgstr "Vilken posttjänst som ska användas för att skicka mail"

#: include/global_settings.php:2102
msgid "Ping Mail Server"
msgstr "Ping Mail Server"

#: include/global_settings.php:2103
msgid "Ping the Mail Server before sending test Email?"
msgstr "Ping Mail Server innan du skickar test Email?"

#: include/global_settings.php:2112 lib/html_reports.php:185
msgid "From Email Address"
msgstr "Från E-post"

#: include/global_settings.php:2113
msgid "This is the Email address that the Email will appear from."
msgstr ""
"Det här är den e-postadress som e-postmeddelandet kommer att visas från."

#: include/global_settings.php:2118 lib/html_reports.php:177
msgid "From Name"
msgstr "Från namn"

#: include/global_settings.php:2119
msgid "This is the actual name that the Email will appear from."
msgstr "Detta är det faktiska namn som e-postmeddelandet kommer att visas från."

#: include/global_settings.php:2124
msgid "Word Wrap"
msgstr "Bryt rader mellan ord"

#: include/global_settings.php:2125
msgid "This is how many characters will be allowed before a line in the Email is automatically word wrapped. (0 = Disabled)"
msgstr ""
"Det här är hur många tecken kommer att tillåtas innan en rad i e-posten är "
"automatiskt ordförpackad. (0 = Inaktiverad)"

#: include/global_settings.php:2132
msgid "Sendmail Options"
msgstr "Sendmail Alternativ"

#: include/global_settings.php:2137 lib/functions.php:5851
msgid "Sendmail Path"
msgstr "Sendmail-sökvägen"

#: include/global_settings.php:2138
msgid "This is the path to sendmail on your server. (Only used if Sendmail is selected as the Mail Service)"
msgstr ""
"Detta är sökvägen till sendmail på din server. (Används endast om Sendmail "
"är valt som posttjänst)"

#: include/global_settings.php:2146
msgid "SMTP Options"
msgstr "SMTP-alternativ"

#: include/global_settings.php:2151
msgid "SMTP Hostname"
msgstr "SMTP-värdnamn"

#: include/global_settings.php:2152
msgid "This is the hostname/IP of the SMTP Server you will send the Email to. For failover, separate your hosts using a semi-colon."
msgstr ""
"Det här är värdnamnet / IP för SMTP-servern som du skickar E-post till. För "
"failover, separera dina värdar med en halvkolon."

#: include/global_settings.php:2158
msgid "SMTP Port"
msgstr "SMTP-port"

#: include/global_settings.php:2159
msgid "The port on the SMTP Server to use."
msgstr "Porten på SMTP-servern som ska användas."

#: include/global_settings.php:2166
msgid "SMTP Username"
msgstr "Utgående SMTP-server"

#: include/global_settings.php:2167
msgid "The username to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr ""
"Användarnamnet att verifiera med när du skickar via SMTP. (Lämna tomma om du "
"inte behöver autentisering.)"

#: include/global_settings.php:2172
msgid "SMTP Password"
msgstr "SMTP Lösenord"

#: include/global_settings.php:2173
msgid "The password to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr ""
"Lösenordet för att autentisera med när du skickar via SMTP. (Lämna tomma om "
"du inte behöver autentisering.)"

#: include/global_settings.php:2178
msgid "SMTP Security"
msgstr "SMTP-säkerhet"

#: include/global_settings.php:2179
msgid "The encryption method to use for the Email."
msgstr "Krypteringsmetoden som ska användas för e-post."

#: include/global_settings.php:2183
msgid "SSL"
msgstr "SSL"

#: include/global_settings.php:2184
msgid "TLS"
msgstr "TLS"

#: include/global_settings.php:2189
msgid "SMTP Timeout"
msgstr "SMTP Timeout"

#: include/global_settings.php:2190
msgid "Please enter the SMTP timeout in seconds."
msgstr "Vänligen ange SMTP-timeout på några sekunder."

#: include/global_settings.php:2197
msgid "Reporting Presets"
msgstr "Rapportering förinställningar"

#: include/global_settings.php:2202
msgid "Default Graph Image Format"
msgstr "Standard grafbildsformat"

#: include/global_settings.php:2203
msgid "When creating a new report, what image type should be used for the inline graphs."
msgstr "När du skapar en ny rapport, vilken bildtyp ska användas för inline-graferna."

#: include/global_settings.php:2209
msgid "Maximum E-Mail Size"
msgstr "Maximal e-poststorlek"

#: include/global_settings.php:2210
msgid "The maximum size of the E-Mail message including all attachments."
msgstr "Maximal storlek på E-postmeddelandet inklusive alla bilagor."

#: include/global_settings.php:2216
msgid "Poller Logging Level for Cacti Reporting"
msgstr "Poller Logging Level för Cacti Reporting"

#: include/global_settings.php:2217
msgid "What level of detail do you want sent to the log file. WARNING: Leaving in any other status than NONE or LOW can exhaust your disk space rapidly."
msgstr ""
"Vilken detaljnivå vill du ha skickat till loggfilen. VARNING: Om du lämnar "
"någon annan status än NONE eller LOW kan du snabbt utnyttja ditt diskutrymme."

#: include/global_settings.php:2223
msgid "Enable Lotus Notes (R) tweak"
msgstr "Aktivera Lotus Notes (R) tweak"

#: include/global_settings.php:2224
msgid "Enable code tweak for specific handling of Lotus Notes Mail Clients."
msgstr "Aktivera kodjusteringar för specifik hantering av Lotus Notes Mail Clients."

#: include/global_settings.php:2229
msgid "DNS Options"
msgstr "DNS-alternativ"

#: include/global_settings.php:2234
msgid "Primary DNS IP Address"
msgstr "Primär DNS IP-adress"

#: include/global_settings.php:2235
msgid "Enter the primary DNS IP Address to utilize for reverse lookups."
msgstr "Ange den primära DNS-IP-adressen för att använda för omvända sökningar."

#: include/global_settings.php:2241
msgid "Secondary DNS IP Address"
msgstr "Sekundär DNS IP-adress"

#: include/global_settings.php:2242
msgid "Enter the secondary DNS IP Address to utilize for reverse lookups."
msgstr ""
"Ange den sekundära DNS-IP-adressen för att använda för omvända sökningar."

#: include/global_settings.php:2248
msgid "DNS Timeout"
msgstr "DNS Timeout"

#: include/global_settings.php:2249
msgid "Please enter the DNS timeout in milliseconds.  Cacti uses a PHP based DNS resolver."
msgstr ""
"Ange DNS-timeout i millisekunder. Cacti använder en PHP-baserad DNS-resolver."

#: include/global_settings.php:2256
msgid "Internet Proxy Settings"
msgstr "Inställningar för Internet-proxy"

#: include/global_settings.php:2261
msgid "Internet Proxy Address"
msgstr "Proxy-adress för Internet"

#: include/global_settings.php:2262
msgid "For either core Cacti Services or Plugins that require internet access, enter the proxy server and port here in the following format IP:PORT.  For example 192.168.1.1:8080."
msgstr ""
"För antingen Cacti Core Services eller Plugins som kräver internetåtkomst "
"anger du proxyservern och porten här i följande format IP:PORT.  Till "
"exempel 192.168.1.1:8080."

#: include/global_settings.php:2269
msgid "Internet Proxy User"
msgstr "Internet Proxy-användare"

#: include/global_settings.php:2270
msgid "If your Internet Proxy requires a username, enter it here."
msgstr "Om din Internet Proxy kräver ett användarnamn, ange det här."

#: include/global_settings.php:2277
msgid "Internet Proxy Password"
msgstr "Internet Proxy Lösenord"

#: include/global_settings.php:2278
msgid "If your Internet Proxy requires a password, enter it here."
msgstr "Om din Internet Proxy kräver ett lösenord, ange det här."

#: include/global_settings.php:2288
msgid "On-demand RRD Update Settings"
msgstr "På begäran RRD-uppdateringsinställningar"

#: include/global_settings.php:2293
msgid "Enable On-demand RRD Updating"
msgstr "Aktivera RRD-uppdatering på begäran"

#: include/global_settings.php:2294
msgid "Should Boost enable on demand RRD updating in Cacti?  If you disable, this change will not take affect until after the next polling cycle.  When you have Remote Data Collectors, this settings is required to be on."
msgstr ""
"Bör Boost aktivera efterfrågan RRD uppdatering i Cacti? Om du inaktiverar "
"kommer denna ändring inte att träda i kraft förrän efter nästa "
"omröstningscykel. När du har fjärrdatasamlare måste dessa inställningar vara "
"på."

#: include/global_settings.php:2299
msgid "System Level RRD Updater"
msgstr "Systemnivå RRD Updater"

#: include/global_settings.php:2300
msgid "Before RRD On-demand Update Can be Cleared, a poller run must always pass"
msgstr "Innan RRD On-demand Update kan rensas, måste en pollare run passera"

#: include/global_settings.php:2305
msgid "How Often Should Boost Update All RRDs"
msgstr "Hur ofta borde öka Uppdatera alla RRDs"

#: include/global_settings.php:2306
msgid "When you enable boost, your RRD files are only updated when they are requested by a user, or when this time period elapses."
msgstr ""
"När du aktiverar uppstart uppdateras dina RRD-filer bara när de begärs av en "
"användare, eller när denna tidsperiod löper ut."

#: include/global_settings.php:2312
msgid "Number of Boost Processes"
msgstr "Antal Boost Processer"

#: include/global_settings.php:2313
msgid "The number of concurrent boost processes to use to use to process all of the RRDs in the boost table."
msgstr ""
"Antalet samtidiga boostprocesser som ska användas för att bearbeta alla RRD "
"i boost-tabellen."

#: include/global_settings.php:2340
msgid "Maximum Records"
msgstr "Maximala poster"

#: include/global_settings.php:2341
msgid "If the boost output table exceeds this size, in records, an update will take place."
msgstr ""
"Om boostutmatningstabellen överstiger denna storlek, kommer en uppdatering "
"att ske i register."

#: include/global_settings.php:2348
msgid "Maximum Data Source Items Per Pass"
msgstr "Maximal datakälla per pass"

#: include/global_settings.php:2349
msgid "To optimize performance, the boost RRD updater needs to know how many Data Source Items should be retrieved in one pass.  Please be careful not to set too high as graphing performance during major updates can be compromised.  If you encounter graphing or polling slowness during updates, lower this number.  The default value is 50000."
msgstr ""
"För att optimera prestanda behöver boost RRD updater veta hur många "
"datakällans artiklar som ska hämtas i ett pass. Var försiktig så att du inte "
"ställer in för högt som grafisk prestanda under större uppdateringar kan "
"äventyras. Om du stöter på grafer eller polling slowown under uppdateringar, "
"sänk detta nummer. Standardvärdet är 50000."

#: include/global_settings.php:2355
msgid "Maximum Argument Length"
msgstr "Maximal argumentlängd"

#: include/global_settings.php:2356
msgid "When boost sends update commands to RRDtool, it must not exceed the operating systems Maximum Argument Length.  This varies by operating system and kernel level.  For example: Windows 2000 <= 2048, FreeBSD <= 65535, Linux 2.6.22-- <= 131072, Linux 2.6.23++ unlimited"
msgstr ""
"När boost skickar uppdateringskommandon till RRDtool, får den inte överstiga "
"operativsystemens maximala argumentlängd. Detta varierar beroende på "
"operativsystem och kärnnivå. Till exempel: Windows 2000 &lt;= 2048, FreeBSD "
"&lt;= 65535, Linux 2.6.22-- &lt;= 131072, Linux 2.6.23 ++ obegränsad"

#: include/global_settings.php:2363
msgid "Memory Limit for Boost and Poller"
msgstr "Minnesgräns för Boost och Poller"

#: include/global_settings.php:2364
msgid "The maximum amount of memory for the Cacti Poller and Boosts Poller"
msgstr "Den maximala mängden minne för Cacti Poller och Boosts Poller"

#: include/global_settings.php:2370
msgid "Maximum RRD Update Script Run Time"
msgstr "Maximal RRD Update Script Run Time"

#: include/global_settings.php:2371
msgid "If the boost poller exceeds this runtime, a warning will be placed in the cacti log,"
msgstr ""
"Om boost pollen execeds denna körtid, kommer en varning att placeras i Cacti-"
"loggen,"

#: include/global_settings.php:2377
msgid "Enable Direct Population of Boost Table"
msgstr "Aktivera direkt population av Boost-tabellen"

#: include/global_settings.php:2378
msgid "Enables direct insert of records into poller output boost table with results in a 25% time reduction in each poll cycle."
msgstr "Möjliggör direkt inmatning av poster i pollerutgångens boost-tabell med resultat i en 25% time minskning i varje pollcykel."

#: include/global_settings.php:2383
msgid "Enable Boost Debugging"
msgstr "Aktivera Boost-felsökning"

#: include/global_settings.php:2384
msgid "If set, Boost will log debug information directly to the Boost log file.  Please note, enabling can cause a high I/O rate on the local file system."
msgstr "Om den är inställd kommer Boost att logga felsökningsinformation direkt till Boosts loggfil.  Observera att aktivering kan orsaka en hög I/O-hastighet på det lokala filsystemet."

#: include/global_settings.php:2389 utilities.php:1805
msgid "Image Caching"
msgstr "Bildhantering"

#: include/global_settings.php:2394
msgid "Enable Image Caching"
msgstr "Aktivera bildcaching"

#: include/global_settings.php:2395
msgid "Should image caching be enabled?"
msgstr "Ska bildhantering aktiveras?"

#: include/global_settings.php:2400
msgid "Location for Image Files"
msgstr "Plats för bildfiler"

#: include/global_settings.php:2401
msgid "Specify the location where Boost should place your image files.  These files will be automatically purged by the poller when they expire."
msgstr ""
"Ange platsen där Boost ska placera dina bildfiler. Dessa filer kommer "
"automatiskt att rensas av pollen när de upphör att gälla."

#: include/global_settings.php:2410
msgid "Data Sources Statistics"
msgstr "Datakällor Statistik"

#: include/global_settings.php:2415
msgid "Enable Data Source Statistics Collection"
msgstr "Aktivera datakällans statistiksamling"

#: include/global_settings.php:2416
msgid "Should Data Source Statistics be collected for this Cacti system?"
msgstr "Ska datakällans statistik samlas in för detta Cacti-system?"

#: include/global_settings.php:2421
msgid "Data Collection Method"
msgstr "Metod för datainsamling"

#: include/global_settings.php:2422
msgid "Data Source Statistics can use a legacy method where it will determine peak and average values, or an advanced mode which will calculated several additional statistical values in addition to peak and average.  Using All Statistical Metrics can place additional CPU and IO load on the system."
msgstr "Data Source Statistics kan använda en äldre metod där topp- och genomsnittsvärden fastställs, eller ett avancerat läge där flera ytterligare statistiska värden beräknas utöver topp- och genomsnittsvärden.  Om du använder alla statistiska mätvärden kan systemet belastas med ytterligare CPU- och IO-belastning."

#: include/global_settings.php:2426
msgid "Peak/Average Only"
msgstr "Endast topp/medelvärde"

#: include/global_settings.php:2427
msgid "All Statistical Metrics"
msgstr "Alla statistiska mått"

#: include/global_settings.php:2431
msgid "Calculate Peaks Stats in Addition to Average Stats"
msgstr "Beräkna toppstatistik i tillägg till genomsnittlig statistik"

#: include/global_settings.php:2432
msgid "This option will double the data collection time.  If will use the MAX consolidation function and calculate statistics from the max values in each of the respective time ranges."
msgstr "Detta alternativ fördubblar datainsamlingstiden.  If kommer att använda konsolideringsfunktionen MAX och beräkna statistik från maxvärdena i vart och ett av de respektive tidsintervallen."

#: include/global_settings.php:2437
msgid "Number of DSStats Processes"
msgstr "Antal Boost Processer"

#: include/global_settings.php:2438
msgid "The number of concurrent DSStats processes to use to use to process all of the Data Sources."
msgstr ""
"Antalet samtidiga boostprocesser som ska användas för att bearbeta alla RRD "
"i boost-tabellen."

#: include/global_settings.php:2465
msgid "Daily Update Frequency"
msgstr "Daglig uppdateringsfrekvens"

#: include/global_settings.php:2466
msgid "How frequent should Daily Stats be updated?"
msgstr "Hur ofta ska dagliga statistik uppdateras?"

#: include/global_settings.php:2472
msgid "Hourly Average Window"
msgstr "Frekvens per timme"

#: include/global_settings.php:2473
msgid "The number of consecutive hours that represent the hourly average.  Keep in mind that a setting too high can result in very large memory tables"
msgstr ""
"Antalet på varandra följande timmar som representerar timmedelvärdet. Tänk "
"på att en inställning för hög kan resultera i mycket stora minnetabeller"

#: include/global_settings.php:2479
msgid "Maintenance Time"
msgstr "Underhållstid"

#: include/global_settings.php:2480
msgid "What time of day should Weekly, Monthly, and Yearly Data be updated?  Format is HH:MM [am/pm]"
msgstr ""
"Vilken tid på dagen ska uppdateras veckovis, månadsvis och årlig data? "
"Formatet är HH: MM [am / pm]"

#: include/global_settings.php:2487
msgid "Memory Limit for Data Source Statistics Data Collector"
msgstr "Minnesgräns för datakällans statistikdatainsamlare"

#: include/global_settings.php:2488
msgid "The maximum amount of memory for the Cacti Poller and Data Source Statistics Poller"
msgstr "Den maximala mängden minne för Cacti Poller och Data Source Statistics Poller"

#: include/global_settings.php:2494
msgid "Data Source Retention Settings"
msgstr "Inställningar för bevarande av datakälla"

#: include/global_settings.php:2499
msgid "Save Historical Data in Database Tables"
msgstr "Spara historiska data i databastabeller"

#: include/global_settings.php:2500
msgid "Check this setting in order to keep a table for each day, week, month, and year data.  The times that these tables will be created will be based upon the following formula: Daily - One partition per day, Weekly - One Partition per Week, Monthly - One partition per Month, Yearly - One Partition per Year.  All tables will have the following suffixes by type Daily: YYYYDDD, Weekly: YYYYWW, Monthly: YYYYMM, and Yearly: YYYY suffixes."
msgstr "Markera den här inställningen om du vill ha en tabell för varje dag, vecka, månad och år.  De tidpunkter då dessa tabeller skapas baseras på följande formel: Daily - En partition per dag, Weekly - En partition per vecka, Monthly - En partition per månad, Yearly - En partition per år.  Alla tabeller kommer att ha följande suffix efter typ Daily: ÅÅÅÅDDD, Veckovis: YYYYWW, Månadsvis: YYYYMM och Yearly: YYYY suffix."

