msgstr ""
"Användardefinierat antal linjer för CLOG till svans när du väljer &quot;Alla "
"linjer&quot;."

#: include/global_settings.php:1176
msgid "Log Tail Refresh"
msgstr "Log Hail Refresh"

#: include/global_settings.php:1177
