msgstr ""
"Om en enhets datakälla ingår i en aggregerad graf visas grafen tillsammans "
"med enhetens övriga grafer"

#: include/global_settings.php:2930
msgid "Enable Horizontal Scrolling"
msgstr "Aktivera horisontell rullning"

#: include/global_settings.php:2931
msgid "Enable Horizontal Scrolling of Tables, Disabling Responsive Column Visibility."
