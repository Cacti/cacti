msgstr "Ka-durugga Xariiqda Goosgoosan (dash-offset=offset)"

#: include/global_form.php
msgid "The dash-offset parameter specifies an offset into the pattern at which the stroke begins."
msgstr "Halbeegga dash-offset wuxuu qeexaa ka-durugga qaabka uu ka bilaabmo xariiqdu."

