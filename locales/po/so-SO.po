msgstr "Dhererka ugu badan ee goobta Weydiinta Xogta."

#: include/global_settings.php
msgid "Graph Creation"
msgstr "Samaynta Garaafka"

#: include/global_settings.php
msgid "Default Graph Type"
msgstr "Nooca Garaafka Caadiga ah"

#: include/global_settings.php
msgid "When creating graphs, what Graph Type would you like preselected?"
msgstr "Marka la samaynayo garaafyada, Noocee Garaaf ah ayaad jeclaan lahayd in horay loo sii doorto?"

#: include/global_settings.php
msgid "All Types"
msgstr "Dhammaan Noocyada"

#: include/global_settings.php
msgid "By Template/Data Query"
msgstr "Qaab-dhismeed (Template)/Weydiinta Xogta ahaan"

#: include/global_settings.php
msgid "Log Management"
msgstr "Maareynta Diiwaanka"

#: include/global_settings.php
msgid "Default Log Tail Lines"
msgstr "Safafka Ugu Dambeeya Diiwaanka ee Caadiga ah"

#: include/global_settings.php
msgid "Default number of lines of the Cacti log file to tail."
msgstr "Tirada caadiga ah ee safafka faylka diiwaanka Cacti ee laga soo raaco dhammaadka."

#: include/global_settings.php
msgid "Maximum number of rows per page"
msgstr "Tirada ugu badan ee safafka boggiiba"

#: include/global_settings.php
msgid "User defined number of lines for the CLOG to tail when selecting 'All lines'."
msgstr "Tirada safafka uu adeegsaduhu go'aamiyo ee CLOG ka soo raaco dhammaadka marka la doorto 'Dhammaan safafka'."

#: include/global_settings.php
msgid "Log Tail Refresh"
msgstr "Cusboonaysiinta Raacidda Diiwaanka"

#: include/global_settings.php
