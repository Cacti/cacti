#: lib/utility.php
msgid "Default collation used by the server when creating databases and tables."
msgstr "Isbarbardhigga caadiga ah (collation) ee uu adeegsado server-ku marka la abuurayo kaydka xogta iyo miisaska."

#: lib/utility.php
msgid "e.g. utf8mb4_unicode_ci, utf8mb4_general_ci."
msgstr "tusaale ahaan utf8mb4_unicode_ci, utf8mb4_general_ci."

#: lib/utility.php
msgid "Default character set used by the server."
msgstr "Qaybta xarfaha caadiga ah ee uu adeegsado server-ku."

#: lib/utility.php
msgid "e.g. utf8mb4, utf8, latin1."
msgstr "tusaale ahaan utf8mb4, utf8, latin1."

#: lib/utility.php
msgid "Character set the client uses when sending statements to the server."
msgstr "Qaybta xarfaha ee macmiilku adeegsado marka uu bayaannada u dirayo server-ka."

#: lib/utility.php
msgid "Maximum number of simultaneous client connections permitted."
msgstr "Tirada ugu badan ee isku xirnaanta macaamiisha isku mar la oggol yahay."

#: lib/utility.php
msgid "Integer; default 151. Allow enough for the pollers plus user logins."
msgstr "Tiro buuxda; caadiga ah 151. U oggolow ku filan cod-bixiyeyaasha (pollers) iyo gelitaannada isticmaalayaasha."

#: lib/utility.php
msgid "Legacy name for the open-table cache; renamed to table_open_cache."
msgstr "Magacii hore ee kaydka jadwallada furan; waxaa loo beddelay table_open_cache."

#: lib/utility.php
msgid "Integer. Use table_open_cache on modern servers."
msgstr "Tiro buuxda. Ka isticmaal table_open_cache adeegayaasha casriga ah."

#: lib/utility.php
msgid "Maximum size of one packet or any generated/intermediate string."
msgstr "Cabbirka ugu badan ee hal xirmo ama xadhig kasta oo la soo saaray/dhexdhexaad ah."

#: lib/utility.php
msgid "Bytes; keep at or above 16M for remote pollers."
msgstr "Baytyo; ku hay 16M ama wixii ka sarreeya xog-ururiyayaasha fog."

#: lib/utility.php
msgid "Maximum size to which user-created MEMORY tables may grow."
msgstr "Cabbirka ugu badan ee ay gaadhi karaan jadwallada MEMORY ee uu isticmaaluhu abuuray."

#: lib/utility.php
msgid "Bytes; sized relative to total system memory."
msgstr "Baytyo; cabbirkeedu wuxuu ku xidhan yahay wadarta xusuusta nidaamka."

#: lib/utility.php
msgid "Maximum size of internal in-memory temporary tables before they spill to disk."
msgstr "Cabbirka ugu badan ee jadwallada ku-meel-gaarka ah ee gudaha xusuusta ka hor inta aanay u daadan saxanka."

#: lib/utility.php
msgid "Bytes; a larger value keeps temporary tables in memory."
msgstr "Baytyo; qiime weyn wuxuu ku hayaa jadwallada ku-meel-gaarka ah xusuusta dhexdeeda."

#: lib/utility.php
msgid "Minimum per-join buffer size for joins that do not use indexes."
msgstr "Cabbirka ugu yar ee kaydka ku-meel-gaarka ah ee isku-xidh kasta oo aan isticmaalin tusmooyin."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 262144."
msgstr "Baytyo; qoondaynta xidhiidhkiiba, qiimaha caadiga ahi waa 262144."

#: lib/utility.php
msgid "Per-session buffer allocated for sorts (ORDER BY / GROUP BY)."
msgstr "Kaydka ku-meel-gaarka ah ee kulankiiba loo qoondeeyo kala-soocidda (ORDER BY / GROUP BY)."

#: lib/utility.php
msgid "Bytes; per-connection allocation, default 2097152."
msgstr "Baytyo; qoondaynta xidhiidhkiiba, qiimaha caadiga ahi waa 2097152."

#: lib/utility.php
msgid "Store each InnoDB table and its indexes in its own .ibd tablespace file."
msgstr "Ku kaydi jadwal kasta oo InnoDB ah iyo tusmooyinkiisa faylkiisa goonida ah ee booska jadwalka .ibd."

#: lib/utility.php
msgid "ON or OFF; ON is recommended."
msgstr "ON ama OFF; ON ayaa lagula talinayaa."

#: lib/utility.php
msgid "InnoDB on-disk file format (Antelope or Barracuda); Barracuda is now the only format."
msgstr "Qaabka faylka saxanka ee InnoDB (Antelope ama Barracuda); Barracuda hadda waa qaabka keliya."

#: lib/utility.php
msgid "Antelope, Barracuda."
msgstr "Antelope, Barracuda."

#: lib/utility.php
msgid "Allow index key prefixes longer than 767 bytes (requires the Barracuda format)."
msgstr "U oggolow horgalayaasha furaha tusmada inay ka dheeraadaan 767 bayt (waxay u baahan tahay qaabka Barracuda)."

#: lib/utility.php
msgid "ON/1 or OFF/0; this behaviour is now always enabled."
msgstr "ON/1 ama OFF/0; hab-dhaqankani hadda mar walba waa shidan yahay."

#: lib/utility.php
msgid "Total memory InnoDB uses to cache table and index data."
msgstr "Wadarta xusuusta uu InnoDB u isticmaalo inuu ku kaydiyo xogta jadwalka iyo tusmada."

#: lib/utility.php
msgid "Bytes; commonly 25%-80% of total system memory."
msgstr "Baytyo; badanaa waa 25%-80% wadarta xusuusta nidaamka."

#: lib/utility.php
msgid "Write pages twice (the doublewrite buffer) to protect against partial page writes."
msgstr "Qor boggaga laba jeer (kaydka doublewrite) si looga ilaaliyo qorista bogga ee aan dhammaystirnayn."

#: lib/utility.php
msgid "ON or OFF."
msgstr "ON ama OFF."

#: lib/utility.php
msgid "Legacy pool for the InnoDB internal data dictionary and structures."
msgstr "Barkadda kaydka ee hore ee qaamuuska xogta gudaha iyo qaab-dhismeedyada InnoDB."

#: lib/utility.php
msgid "Bytes; obsolete on modern servers."
msgstr "Baytyo; waa ka duugoobay adeegayaasha casriga ah."

#: lib/utility.php
msgid "Seconds an InnoDB transaction waits for a row lock before giving up."
msgstr "Ilbiriqsiyada uu hawlgalka InnoDB sugo qufulka safka ka hor inta aanu ka tanaasulin."

#: lib/utility.php
msgid "Seconds; default 50."
msgstr "Ilbiriqsiyo; qiimaha caadiga ahi waa 50."

#: lib/utility.php
msgid "Method used to flush data and log files to disk."
msgstr "Habka loo isticmaalo in xogta iyo faylasha diiwaanka loogu qoro saxanka."

#: lib/utility.php
msgid "O_DIRECT, fsync, O_DSYNC, and similar."
msgstr "O_DIRECT, fsync, O_DSYNC, iyo wixii la mid ah."

#: lib/utility.php
msgid "Controls how the redo log is written and flushed at transaction commit."
msgstr "Waxay xakamaysaa sida diiwaanka dib-u-samaynta (redo log) loo qoro looguna kaydiyo saxanka marka hawlgalka la xaqiijiyo."

#: lib/utility.php
msgid "0, 1, or 2."
msgstr "0, 1, ama 2."

#: lib/utility.php
msgid "Legacy single setting for InnoDB file I/O threads, replaced by the read/write I/O thread settings."
msgstr "Dejintii hore ee kelida ahayd ee dunaha I/O faylka InnoDB, taas oo lagu beddelay dejinta dunaha I/O ee akhriska/qorista."

#: lib/utility.php
msgid "Integer; superseded by innodb_read_io_threads and innodb_write_io_threads."
msgstr "Tiro buuxda; waxaa beddelay innodb_read_io_threads iyo innodb_write_io_threads."

#: lib/utility.php
msgid "Write and flush the InnoDB redo log every N seconds."
msgstr "Qor oo ku kaydi saxanka diiwaanka dib-u-samaynta ee InnoDB N ilbiriqsi kasta."

#: lib/utility.php
msgid "Seconds (1-2700); default 1."
msgstr "Ilbiriqsiyo (1-2700); qiimaha caadiga ahi waa 1."

#: lib/utility.php
msgid "Number of I/O threads used for read operations in InnoDB."
msgstr "Tirada dunaha I/O ee loo isticmaalo hawlaha akhriska gudaha InnoDB."

#: lib/utility.php
msgid "1-64; default 4."
msgstr "1-64; qiimaha caadiga ahi waa 4."

#: lib/utility.php
msgid "Number of I/O threads used for write operations in InnoDB."
msgstr "Tirada dunaha I/O ee loo isticmaalo hawlaha qorista gudaha InnoDB."

#: lib/utility.php
msgid "Number of regions the InnoDB buffer pool is divided into."
msgstr "Tirada gobollada loo qaybiyo barkadda kaydka ee InnoDB."

#: lib/utility.php
msgid "1-64; MariaDB removed this in 10.6."
msgstr "1-64; MariaDB waxay tan ka saartay 10.6."

#: lib/utility.php
msgid "Estimated I/O operations per second available to InnoDB background tasks."
msgstr "Qiyaasta hawlaha I/O ilbiriqsigiiba ee u diyaarsan hawlaha dambe ee InnoDB."

#: lib/utility.php
msgid "Integer; use higher values for SSD/NVMe storage."
msgstr "Tiro buuxda; u isticmaal qiimayaal sare kaydinta SSD/NVMe."

#: lib/utility.php
msgid "Maximum IOPS InnoDB may use when flushing falls behind."
msgstr "IOPS-ka ugu badan ee uu InnoDB isticmaali karo marka qorista saxanku ay dib u dhacdo."

#: lib/utility.php
msgid "Flush neighbouring dirty pages in the same extent when flushing a page."
msgstr "Saxanka ku qor boggaga wasakhaysan ee deriska ah ee ku jira isla baaxadda marka bog la qorayo."

#: lib/utility.php
msgid "0, 1, or 2; use 0 on SSD storage."
msgstr "0, 1, ama 2; u isticmaal 0 kaydinta SSD."

#: lib/utility.php
msgid "Use hardware atomic writes (MariaDB) so the doublewrite buffer can be safely disabled."
msgstr "Isticmaal qorista atomigga ah ee qalabka (MariaDB) si kaydka doublewrite si ammaan ah looga damiyo."

#: lib/utility.php
msgid "ON or OFF; MariaDB only."
msgstr "ON ama OFF; MariaDB keliya."

#: lib/utility.php
msgid "Enforce strict snapshot isolation for InnoDB transactions."
msgstr "Ku dhaqan go'doominta sawir-qaadista adag hawlgallada InnoDB."

#: lib/utility.php
msgid "ON or OFF; back-ported to MariaDB 10.6.18+, 10.11.8+ and 11.4.2+. Set OFF for the Cacti poller."
msgstr "ON ama OFF; dib loogu daray MariaDB 10.6.18+, 10.11.8+ iyo 11.4.2+. Ku deji OFF xog-ururiyaha Cacti."

#: lib/utility.php
msgid "Removed"
msgstr "La saaray"

#: lib/utility.php
msgid "Deprecated"
msgstr "Laga guuray"

#: lib/utility.php
msgid "Not applicable to this engine"
msgstr "Kuma khusayso matoorkan"

#: lib/utility.php
msgid "Supported"
msgstr "Waa la taageeraa"

#: lib/utility.php
#, php-format
msgid "%s Variable Capability Matrix"
msgstr "Shaxda Awoodda Doorsoomaha %s"

#: lib/utility.php
msgid "Support by engine and version for each Cacti-recommended variable"
msgstr "Taageerada matoor iyo nooc kasta ee doorsoome kasta oo ay Cacti ku talisay"

#: lib/utility.php
msgid "Variable"
msgstr "Doorsoome"

#: lib/utility.php
msgid "Available settings:"
msgstr "Dejinnada la heli karo:"

#: lib/utility.php
msgid "N/A - Not applicable to this engine"
msgstr "N/A - Kuma khusayso matoorkan"

#: lib/utility.php
msgid "MariaDB 10.5+ and MySQL 8.0+ are the recommended, supported releases (for example, the default database streams on Rocky Linux 9). Make sure you run the very latest release though which fixes a long standing low level networking issue that was causing spine many issues with reliability."
msgstr "MariaDB 10.5+ iyo MySQL 8.0+ waa noocyada lagu taliyo ee la taageero (tusaale ahaan, xogta kaydka ee caadiga ah ee ku jirta Rocky Linux 9). Hubi inaad isticmaasho sii-deyntii ugu dambaysay taas oo xallisa arrin shabakadeed oo heer hoose ah oo muddo dheer jirtay, taas oo Spine u keenaysay dhibaatooyin badan oo dhanka isku-hallaynta ah."

#: lib/utility.php
#, php-format
msgid "It is STRONGLY recommended that you enable InnoDB in any %s version greater than 5.5.3."
msgstr "Waxaa SI XOOGGAN lagugula talinayaa inaad daarto InnoDB nooc kasta oo %s ah oo ka weyn 5.5.3."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4_unicode_ci collation type as some characters take more than a single byte."
msgstr "Marka aad Cacti la isticmaalayso luqado aan ahayn Ingiriisi, waxaa muhiim ah inaad isticmaasho nooca kala-soocidda ee utf8mb4_unicode_ci maadaama xarfaha qaarkood ay qaataan wax ka badan hal bayt."

#: lib/utility.php
msgid "When using Cacti with languages other than English, it is important to use the utf8mb4 character set as some characters take more than a single byte."
msgstr "Marka aad Cacti la isticmaalayso luqado aan ahayn Ingiriisi, waxaa muhiim ah inaad isticmaasho kooxda xarfaha ee utf8mb4 maadaama xarfaha qaarkood ay qaataan wax ka badan hal bayt."

#: lib/utility.php
#, php-format
msgid "It is recommended that you enable InnoDB in any %s version greater than 5.1."
msgstr "Waxaa lagugula talinayaa inaad daarto InnoDB nooc kasta oo %s ah oo ka weyn 5.1."

#: lib/utility.php
#, php-format
msgid "Depending on the number of logins and use of spine data collector, %s will need many connections.  The calculation for spine is: total_connections = total_processes * (total_threads + script_servers + 1), then you must leave headroom for user connections, which will change depending on the number of concurrent login accounts."
msgstr "Iyadoo ku xidhan tirada gelitaannada iyo isticmaalka xog-ururiyaha Spine, %s wuxuu u baahan doonaa xidhiidhyo badan. Xisaabinta Spine waa: total_connections = total_processes * (total_threads + script_servers + 1), ka dibna waa inaad u dhaaftaa meel bannaan xidhiidhyada isticmaalaha, taas oo isbeddeli doonta iyadoo ku xidhan tirada koontooyinka gelitaanka ee isku mar shaqaynaya."

#: lib/utility.php
msgid "Keeping the table cache larger means less file open/close operations when using innodb_file_per_table."
msgstr "Ku haynta kaydka jadwalka mid weyn waxay ka dhigan tahay hawlo furid/xidhid faylal ah oo yar marka la isticmaalayo innodb_file_per_table."

#: lib/utility.php
msgid "With Remote polling capabilities, large amounts of data will be synced from the main server to the remote pollers.  Therefore, keep this value at or above 16M."
msgstr "Iyadoo la adeegsanayo awoodaha xog-ururinta fog, xaddi badan oo xog ah ayaa laga waafajin doonaa adeegaha weyn ilaa xog-ururiyayaasha fog. Sidaa darteed, ku hay qiimahan 16M ama wixii ka sarreeya."

#: lib/utility.php
#, php-format
msgid "If using the Cacti Performance Booster and choosing a memory storage engine, you have to be careful to flush your Performance Booster buffer before the system runs out of memory table space.  This is done two ways, first reducing the size of your output column to just the right size.  This column is in the tables poller_output, and poller_output_boost.  The second thing you can do is allocate more memory to memory tables.  We have arbitrarily chosen a recommended value of 10%% of system memory, but if you are using SSD disk drives, or have a smaller system, you may ignore this recommendation or choose a different storage engine.  You may see the expected consumption of the Performance Booster tables under Console -> System Utilities -> View Boost Status."
msgstr "Haddii aad isticmaalayso Cacti Performance Booster oo aad dooranayso matoorka kaydinta xusuusta (memory storage engine), waa inaad ka taxaddartaa inaad nadiifiso kaydka ku-meelgaarka ah (buffer) ee Performance Booster ka hor inta uusan nidaamku ka dhammaanin booska miiska xusuusta. Tan waxaa lagu sameeyaa laba hab: marka hore yaree cabbirka tiirka soo-saarkaaga (output column) ilaa cabbirka saxda ah. Tiirkani wuxuu ku jiraa miisaska poller_output, iyo poller_output_boost. Waxyaabaha labaad ee aad samayn karto waa inaad xusuus dheeraad ah u qoondayso miisaska xusuusta. Waxaan si aan kala sooc lahayn u doorannay qiime lagula taliyo oo ah 10%% ee xusuusta nidaamka, laakiin haddii aad isticmaalayso disk-yada SSD, ama aad haysato nidaam ka yar, waad iska indho-tiri kartaa taladan ama waxaad dooran kartaa matoor kaydin oo kale. Waxaad ka arki kartaa isticmaalka la filayo ee miisaska Performance Booster hoosta Console -> Adeegyada Nidaamka -> Eeg Xaaladda Boost."

#: lib/utility.php
msgid "When executing subqueries, having a larger temporary table size, keep those temporary tables in memory."
msgstr "Marka aad fulinayso weydiimo-hoosaadyada (subqueries), lahaanshaha cabbir ka weyn oo miiska ku-meelgaarka ah waxay miisaskaas ku-meelgaarka ah ku haysaa xusuusta."

#: lib/utility.php
msgid "When performing joins, if they are below this size, they will be kept in memory and never written to a temporary file.  As this is a per connection memory allocation, care must be taken not to increase it too high.  The sum of the join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + Core MySQL/MariaDB memory should be below 80%.  If the recommendation is negative, you must decrease this and or the sort_buffer_size until the recommendation fits within the allowable memory."
msgstr "Marka la samaynayo isku-darka (joins), haddii ay ka yar yihiin cabbirkan, waxaa lagu hayn doonaa xusuusta mana loo qori doono fayl ku-meel-gaar ah.  Maadaama tani ay tahay qoondayn xusuus oo xiriirkiiba gaar u ah, waa in laga taxaddaraa inaan aad loo kordhin.  Wadarta join_buffer_size + sort_buffer_size + read_buffer_size + read_rnd_buffer_size + thread_stack + binlog_cache_size + xusuusta asaasiga ah ee MySQL/MariaDB waa inay ka hoosaysaa 80%.  Haddii taladu ay tahay taban, waa inaad yaraysaa kan iyo ama sort_buffer_size ilaa taladu ay ku habboonaato xusuusta la oggol yahay."

#: lib/utility.php
#, php-format
msgid "When using InnoDB storage it is important to keep your table spaces separate.  This makes managing the tables simpler for long time users of %s.  If you are running with this currently off, you can migrate to the per file storage by enabling the feature, and then running an alter statement on all InnoDB tables."
msgstr "Marka la isticmaalayo kaydinta InnoDB waxaa muhiim ah in boosaskaaga miisaska la kala saaro. Tani waxay maareynta miisaska u fududaysaa isticmaalayaasha muddada dheer ee %s. Haddii aad hadda ku socoto iyadoo tani dansan tahay, waxaad u guuri kartaa kaydinta halkii faylba adigoo shidaya astaanta, ka dibna ku fulinaya bayaanka ALTER dhammaan miisaska InnoDB."

#: lib/utility.php
msgid "When using innodb_file_per_table, it is important to set the innodb_file_format to Barracuda.  This setting will allow longer indexes important for certain Cacti tables."
msgstr "Marka la isticmaalayo innodb_file_per_table, waxaa muhiim ah in innodb_file_format loo dejiyo Barracuda. Dejintani waxay oggolaan doontaa tusmooyin (indexes) ka dhaadheer oo muhiim u ah miisaska qaarkood ee Cacti."

#: lib/utility.php
msgid "If your tables have very large indexes, you must operate with the Barracuda innodb_file_format and the innodb_large_prefix equal to 1.  Failure to do this may result in plugins that can not properly create tables."
msgstr "Haddii miisaskaagu leeyihiin tusmooyin (indexes) aad u waaweyn, waa inaad ku shaqeysaa Barracuda innodb_file_format iyo innodb_large_prefix oo u dhiganta 1. Ku guul-darraysiga samaynta tan waxay keeni kartaa in kordhinada (plugins) aysan si sax ah u abuuri karin miisas."

#: lib/utility.php
#, php-format
msgid "InnoDB will hold as much tables and indexes in system memory as is possible.  Therefore, you should make the innodb_buffer_pool large enough to hold as much of the tables and index in memory.  Checking the size of the /var/lib/mysql/cacti directory will help in determining this value.  We are recommending 25%% of your systems total memory, but your requirements will vary depending on your systems size."
msgstr "InnoDB wuxuu ku hayn doonaa xusuusta nidaamka jadwallo iyo tusmooyin inta ugu badan ee suurtogal ah.  Sidaa darteed, waa inaad ka dhigtaa innodb_buffer_pool mid ku filan oo xusuusta ku haysa inta badan jadwallada iyo tusmooyinka.  Hubinta cabbirka galka /var/lib/mysql/cacti waxay kaa caawin doontaa go'aaminta qiimahan.  Waxaan ku talinaynaa 25%% oo ka mid ah wadarta xusuusta nidaamkaaga, laakiin baahiyahaagu way kala duwanaan doonaan iyadoo ku xiran cabbirka nidaamkaaga."

#: lib/utility.php
msgid "This settings should remain ON unless your Cacti instances is running on either ZFS or FusionI/O which both have internal journaling to accommodate abrupt system crashes.  However, if you have very good power, and your systems rarely go down and you have backups, turning this setting to OFF can net you almost a 50% increase in database performance."
msgstr "Dejintani waa inay ahaataa ON ilaa xaaladahaaga Cacti ay ku shaqaynayaan ZFS ama FusionI/O oo labaduba leh diiwaangelin gudaha ah si ay u maareeyaan shilalka kediska ah ee nidaamka.  Si kastaba ha ahaatee, haddii aad leedahay koronto aad u wanaagsan, nidaamyadaaduna marar dhif ah ayay go'aan oo aad leedahay kayd (backups), u beddelidda dejintan OFF waxay kuu keeni kartaa ku dhowaad 50% koror xagga waxqabadka xogta kaydka ah."

#: lib/utility.php
msgid "This is where metadata is stored. If you had a lot of tables, it would be useful to increase this."
msgstr "Tani waa halka lagu keydiyo xogta-xogta (metadata). Haddii aad leedahay shaxanno badan, waxaa faa'iido leh in la kordhiyo tan."

#: lib/utility.php
msgid "Rogue queries should not for the database to go offline to others.  Kill these queries before they kill your system."
msgstr "Weydiimaha qaldan ma aha inay sababaan in xog-ururintu ka baxdo khadka kuwa kale. Jooji weydiimahan ka hor inta aysan joojin nidaamkaaga."

#: lib/utility.php
msgid "Maximum I/O performance happens when you use the O_DIRECT method to flush pages."
msgstr "Waxqabadka ugu sarreeya ee I/O wuxuu dhacaa marka aad adeegsato habka O_DIRECT si aad boggaga u nadiifiso."

#: lib/utility.php
#, php-format
msgid "Setting this value to 2 means that you will flush all transactions every second rather than at commit.  This allows %s to perform writing less often."
msgstr "U dejinta qiimahan 2 waxay ka dhigan tahay inaad nadiifin doonto dhammaan macaamilada ilbiriqsi kasta halkii aad ka nadiifin lahayd marka la xaqiijiyo. Tani waxay u ogolaaneysaa %s inuu wax qoro marar ka yar."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple io threads is advantageous for applications with high io characteristics."
msgstr "Marka la adeegsanayo kaydinta casriga ah ee nooca SSD, lahaanshaha dunta I/O badan waxay faa'iido u leedahay barnaamijyada leh sifooyinka I/O ee sarreeya."

#: lib/utility.php
#, php-format
msgid "As of %s %s, the you can control how often %s flushes transactions to disk.  The default is 1 second, but in high I/O systems setting to a value greater than 1 can allow disk I/O to be more sequential"
msgstr "Laga bilaabo %1$s %2$s, waxaad xakameyn kartaa inta jeer ee %3$s u nadiifiyo macaamilada saxanka. Qiimaha caadiga ahi waa 1 ilbiriqsi, laakiin nidaamyada I/O ee sarreeya u dejinta qiime ka weyn 1 waxay u ogolaan kartaa I/O saxanka inuu noqdo mid isku xiga"

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Marka la adeegsanayo kaydinta casriga ah ee nooca SSD, lahaanshaha dunta akhriska I/O badan waxay faa'iido u leedahay barnaamijyada leh sifooyinka I/O ee sarreeya. Iyadoo ku xiran noocyadaada MariaDB/MySQL, qiimahani wuxuu gaari karaa ilaa 64. Laakiin isku day inaad tirada ka dhigto mid ka yar wadarta duntaada SMT ee ku jira adeegaha xog-ururinta."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics.  Depending on your MariaDB/MySQL versions, this value can go as high as 64.  But try to keep the number less than your total SMT threads on the database server."
msgstr "Marka la adeegsanayo kaydinta casriga ah ee nooca SSD, lahaanshaha dunta qorista I/O badan waxay faa'iido u leedahay barnaamijyada leh sifooyinka I/O ee sarreeya. Iyadoo ku xiran noocyadaada MariaDB/MySQL, qiimahani wuxuu gaari karaa ilaa 64. Laakiin isku day inaad tirada ka dhigto mid ka yar wadarta duntaada SMT ee ku jira adeegaha xog-ururinta."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MariaDB less than 10.5.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max the number of CPU cores or 64."
msgstr "%s wuxuu u qaybin doonaa innodb_buffer_pool gobollo xusuus ah si uu u hagaajiyo waxqabadka noocyada MariaDB ee ka yar 10.5. Qiimaha ugu badan waa 64, laakiin waa inuusan ka badnaan tirada xudumaha/dunta CPU. Marka innodb_buffer_pool-kaagu ka yar yahay 1GB, waa inaad adeegsataa cabbirka barkadda oo loo qaybiyay 128MB. Sii wad adeegsiga xisaabtan ilaa ugu badnaan tirada xudumaha CPU ama 64."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MySQL upto and including MySQL 8.0.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max of the number of CPU cores or 64."
msgstr "%s wuxuu u qaybin doonaa innodb_buffer_pool gobollo xusuus ah si uu u hagaajiyo waxqabadka noocyada MySQL ilaa iyo marka lagu daro MySQL 8.0. Qiimaha ugu badan waa 64, laakiin waa inuusan ka badnaan tirada xudumaha/dunta CPU. Marka innodb_buffer_pool-kaagu ka yar yahay 1GB, waa inaad adeegsataa cabbirka barkadda oo loo qaybiyay 128MB. Sii wad adeegsiga xisaabtan ilaa ugu badnaan tirada xudumaha CPU ama 64."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 200 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 100000 can be used."
msgstr "Haddii aad leedahay saxanno SSD ah, adeegso taladan. Haddii aad leedahay darawallo adag oo jireed, adeegso 200 * tirada darawallada firfircoon ee ku jira taxanaha. Haddii la adeegsanayo NVMe ama PCIe Flash, tirooyin aad u waaweyn oo gaaraya ilaa 100000 ayaa la adeegsan karaa."

#: lib/utility.php
msgid "If you have SSD disks, use this suggestion.  If you have physical hard drives, use 2000 * the number of active drives in the array.  If using NVMe or PCIe Flash, much larger numbers as high as 200000 can be used."
msgstr "Haddii aad leedahay saxanno SSD ah, adeegso taladan. Haddii aad leedahay darawallo adag oo jireed, adeegso 2000 * tirada darawallada firfircoon ee ku jira taxanaha. Haddii la adeegsanayo NVMe ama PCIe Flash, tirooyin aad u waaweyn oo gaaraya ilaa 200000 ayaa la adeegsan karaa."

#: lib/utility.php
msgid "If you have SSD disks, set this to 0. Otherwise, do not set this setting."
msgstr "Haddii aad leedahay saxanno SSD ah, tan u deji 0. Haddii kale, ha dejin dejintan."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple read io threads is advantageous for applications with high io characteristics."
msgstr "Marka la adeegsanayo kaydinta casriga ah ee nooca SSD, lahaanshaha dunta akhriska I/O badan waxay faa'iido u leedahay barnaamijyada leh sifooyinka I/O ee sarreeya."

#: lib/utility.php
msgid "With modern SSD type storage, having multiple write io threads is advantageous for applications with high io characteristics."
msgstr "Marka la adeegsanayo kaydinta casriga ah ee nooca SSD, lahaanshaha dunta qorista I/O badan waxay faa'iido u leedahay barnaamijyada leh sifooyinka I/O ee sarreeya."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, this setting should be off if atomic writes are enabled.  Therefore, please enable atomic writes instead of the double write buffer as it will increase performance."
msgstr "Marka la adeegsanayo MariaDB 10.2.4 iyo wixii ka sarreeya, dejintani waa inay dansanaataa haddii qorista atomigga ah ay daaran tahay. Sidaa darteed, fadlan daar qorista atomigga ah halkii aad ka adeegsan lahayd kaydiyaha labanlaabka qorista maadaama ay kordhinayso waxqabadka."

#: lib/utility.php
msgid "When using MariaDB 10.2.4 and above, you can use atomic writes over the doublewrite buffer to increase performance."
msgstr "Marka la adeegsanayo MariaDB 10.2.4 iyo wixii ka sarreeya, waxaad ka doorbidi kartaa qorista atomigga ah kaydiyaha doublewrite si aad u kordhiso waxqabadka."

#: lib/utility.php
#, php-format
msgid "%s Tuning"
msgstr "Hagaajinta %s"

#: lib/utility.php
msgid "Note: Many changes below require a database restart"
msgstr "Fiiro gaar ah: Isbeddelo badan oo hoos ku xusan waxay u baahan yihiin dib-u-bilowga xog-ururinta"

#: lib/utility.php
msgid "Current Value"
msgstr "Qiimaha Hadda"

#: lib/utility.php
msgid "Recommended Value"
msgstr "Qiimaha Lagu Talinayo"

#: lib/utility.php
msgid "Comments"
msgstr "Faallooyin"

#: lib/utility.php
#, php-format
msgid "PHP %s is the minimum version"
msgstr "PHP %s waa nooca ugu yar"

#: lib/utility.php
#, php-format
msgid "A minimum of %s memory limit"
msgstr "Ugu yaraan %s xadka xusuusta"

#: lib/utility.php
#, php-format
msgid "A minimum of %s m execution time"
msgstr "Ugu yaraan %s m waqtiga fulinta"

#: lib/utility.php
msgid "A valid timezone that matches MySQL and the system"
msgstr "Aag waqti oo sax ah oo u dhigma MySQL iyo nidaamka"

#: lib/vdef.php
msgid "A useful name for this VDEF."
msgstr "Magac waxtar leh oo loogu talagalay VDEF-kan."

#: link.php
#, php-format
msgid "External Link ID '%s' with Title '%s' attempted to inject an invalid URL and was blocked!"
msgstr "Aqoonsiga Xiriirka Dibadda '%1$s' ee leh Cinwaanka '%2$s' wuxuu isku dayay inuu geliyo URL aan sax ahayn waana la xannibay!"

