msgstr "Qoraal la dhigo bartamaha hoose ee Garaaf kasta."

#: include/global_settings.php
msgid "Custom Date Format"
msgstr "Qaabka Taariikhda Gaarka ah"

#: include/global_settings.php
msgid "To be used when formatting |date_time| on a graph"
msgstr "Waxaa la isticmaalaa marka la habaynayo |date_time| ee garaafka korkiisa"

#: include/global_settings.php
msgid "Disable RRDtool Watermark"
msgstr "Dami Calaamad-biyoodka RRDtool"

#: include/global_settings.php
msgid "Provided your RRDtool version supports it, you may disable RRDtool advertisement on your Graphs by checking this option."
msgstr "Haddii nooca RRDtool-kaagu uu taageerayo, waxaad damin kartaa xayaysiinta RRDtool ee Garaafyadaada adigoo calaamadaynaya ikhtiyaarkan."

#: include/global_settings.php
