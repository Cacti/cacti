#: include/global_settings.php
msgid "Record when request fields are accessed without going through proper input validation"
msgstr "Diiwaangeli marka goobaha codsiga la galo iyadoo aan la marin xaqiijin gelin oo sax ah"

#: include/global_settings.php
msgid "Data Source Tracing"
msgstr "Raadinta Isha Xogta"

#: include/global_settings.php
msgid "A developer only option to trace the creation of Data Sources mainly around checks for uniqueness"
msgstr "Ikhtiyaar horumariyayaasha oo keliya ah oo lagu raaco abuurista Ilaha Xogta gaar ahaan hubinta gaarnimada"

#: include/global_settings.php
msgid "Log Ignored General Errors"
