#: include/global_form.php
#, php-format
msgid "Enter a name for this %s field.  Note: If using name value pairs in your script, for example: NAME:VALUE, it is important that the name matches your output field name identically to the script output name or names."
msgstr "Geli magac goobtan %s.  Fiiro gaar ah: Haddii aad qoraalkaaga (script) ku adeegsanayso lammaane magac-qiime ah, tusaale ahaan: NAME:VALUE, waxaa muhiim ah in magacu si buuxda ula mid noqdo magaca goobta soo-saarkaaga iyo magaca ama magacyada soo-saarka qoraalka."

#: include/global_form.php
msgid "Update RRDfile"
