#: lib/installer.php
msgid "The following information has been determined from Cacti's configuration file. If it is not correct, please edit \"include/config.php\" before continuing."
msgstr "Macluumaadka soo socda waxaa laga soo saaray faylka habaynta Cacti. Haddii uusan sax ahayn, fadlan wax ka beddel \"include/config.php\" ka hor intaadan sii wadin."

#: lib/installer.php
msgid "Local Database Connection Information"
msgstr "Macluumaadka Xidhiidhka Kaydka Xogta Gudaha"

#: lib/installer.php
#, php-format
