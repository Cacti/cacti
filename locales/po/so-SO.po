msgstr "Iswaafajinta Odhaahda Joogtada ah"

#: include/global_form.php
msgid "If you want to require a certain regular expression to be matched against input data, enter it here (preg_match format)."
msgstr "Haddii aad rabto inaad u baahato odhaah joogto ah oo gaar ah in lala waafajiyo xogta gelinta, halkan geli (qaabka preg_match)."

#: include/global_form.php
msgid "Allow Empty Input"
msgstr "Oggolow Gelin Madhan"

#: include/global_form.php
msgid "Check here if you want to allow NULL input in this field from the user."
msgstr "Halkan calaamadee haddii aad rabto inaad u oggolaato gelinta NULL ee goobtan ee ka timaadda isticmaalaha."

#: include/global_form.php
