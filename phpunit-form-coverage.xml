<phpunit bootstrap="tests/bootstrap-unit.php" beStrictAboutOutputDuringTests="false">
    <php>
        <ini name="error_reporting" value="-1"/>
        <env name="CACTI_TEST_BOOTSTRAP" value="1"/>
    </php>
    <source>
        <include>
            <file>lib/CactiForm.php</file>
        </include>
    </source>
    <testsuites>
        <testsuite name="Form coverage">
            <file>tests/Unit/CactiFormTest.php</file>
            <file>tests/integration/CactiFormIntegrationTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
