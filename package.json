{
  "name": "cacti-frontend-assets",
  "version": "0.0.0",
  "description": "Build tooling for Cacti's front-end JavaScript libraries. Sources the vendored copies under include/js/ from npm so Dependabot can track them.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build:js": "node build/sync-js.mjs",
    "postinstall": "patch-package && node build/sync-js.mjs",
    "test": "node --test tests/js/*.test.js tests/js/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/js/sync_js.test.mjs"
  },
  "dependencies": {
    "big.js": "7.0.1",
    "billboard.js": "4.0.3",
    "d3": "7.9.0",
    "dompurify": "3.4.14",
    "htmx.org": "2.0.10",
    "jquery": "4.0.0",
    "jquery-ui": "1.14.2",
    "jquery-validation": "1.22.1",
    "jstree": "3.3.17",
    "lzjs": "1.3.1",
    "pace-js": "1.2.4",
    "screenfull": "6.0.2",
    "tablesorter": "2.32.0"
  },
  "devDependencies": {
    "patch-package": "8.0.1"
  }
}
