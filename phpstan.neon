parameters:
    level: 5
    paths:
        - lib/cacti_exec.php
        - lib/cacti_http.php
        - lib/cacti_dispatch.php
        - lib/cacti_request.php
    excludePaths:
        - vendor/*
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Function cacti_log not found#'
        - '#Function read_config_option not found#'
        - '#Function get_nfilter_request_var not found#'
        - '#Function get_client_addr not found#'
        - '#Function is_realm_allowed not found#'
        - '#Function html_escape not found#'
        - '#Function db_qstr not found#'
        - '#Function db_fetch_cell_prepared not found#'
        - '#Function db_execute_prepared not found#'
        - '#Function cacti_escapeshellcmd not found#'
        - '#Function cacti_escapeshellarg not found#'
        - '#Function cacti_sizeof not found#'
        - '#Function cacti_cookie_set not found#'
        - '#Function kill_session_var not found#'
        - '#Function raise_ajax_permission_denied not found#'
        - '#Constant POLLER_VERBOSITY_DEBUG not found#'
        - '#Constant POLLER_VERBOSITY_MEDIUM not found#'
