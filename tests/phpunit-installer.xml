<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="bootstrap-unit.php" beStrictAboutOutputDuringTests="false">
    <php>
        <ini name="error_reporting" value="-1"/>
        <env name="CACTI_TEST_BOOTSTRAP" value="1"/>
    </php>
    <testsuites>
        <testsuite name="Installer Unit">
            <directory>Unit/Installer</directory>
            <file>Unit/Security/Csrf/InstallerCsrfRecoveryTest.php</file>
            <!-- Covers the lib/utility.php MySQL capability helpers that the installer's recommendations step relies on. -->
            <file>Unit/Ui/Utility/MysqlCapabilityMatrixTest.php</file>
        </testsuite>
        <testsuite name="Installer Integration">
            <file>integration/InstallerComposerContractTest.php</file>
            <file>integration/InstallerVendorRefreshContractTest.php</file>
            <file>integration/Issue7343InstallerCsrfRecoveryIntegrationTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <file>../lib/installer.php</file>
            <file>../install/functions.php</file>
            <file>../lib/utility.php</file>
        </include>
    </source>
</phpunit>
