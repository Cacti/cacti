<phpunit bootstrap="bootstrap-unit.php" beStrictAboutOutputDuringTests="false">
    <php>
        <ini name="error_reporting" value="-1"/>
        <env name="CACTI_TEST_BOOTSTRAP" value="1"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>Unit</directory>
            <!-- Defines dedicated SNMP stubs and must only run via phpunit-snmp.xml. -->
            <exclude>Unit/DataCollection/Snmp/SnmpCoverageTest.php</exclude>
        </testsuite>
		<testsuite name="Integration">
			<directory>integration</directory>
			<!-- Uses dedicated CDEF database fixtures and runs via phpunit-cdef-integration.xml. -->
			<exclude>integration/CdefDatabaseIntegrationTest.php</exclude>
		</testsuite>
        <testsuite name="HandOff">
            <directory>HandOff</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../lib</directory>
        </include>
    </source>
</phpunit>
