        <ini name="error_reporting" value="-1"/>
        <env name="CACTI_TEST_BOOTSTRAP" value="1"/>
    </php>
    <source>
        <include>
            <file>lib/CactiEmailChannel.php</file>
            <file>lib/CactiNotification.php</file>
