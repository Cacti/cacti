parameters:
	ignoreErrors:
		-
			message: '#^Variable \$calculated_index in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.variable
			count: 1
			path: cli/rrdresize.php

		-
			message: '#^Parameter \#6 \$gc of function session_set_save_handler expects callable\(int\)\: bool, ''cacti_db_session…'' given\.$#'
			identifier: argument.type
			count: 1
			path: include/session.php

		-
			message: '#^Variable \$dep_hash_cache might not be defined\.$#'
			identifier: variable.undefined
			count: 41
			path: lib/import.php
