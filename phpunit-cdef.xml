<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/Helpers/CdefCoverageBootstrap.php" beStrictAboutOutputDuringTests="false">
	<php>
		<ini name="error_reporting" value="-1"/>
		<env name="CACTI_TEST_BOOTSTRAP" value="1"/>
	</php>
	<coverage>
		<include>
			<file>lib/cdef.php</file>
		</include>
	</coverage>
	<testsuites>
		<testsuite name="CDEF coverage">
			<file>tests/Coverage/CdefCoverageTest.php</file>
		</testsuite>
	</testsuites>
</phpunit>
