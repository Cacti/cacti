{% for item in rows %}
	{% set disabled = item.graphs != 0 or item.templates != 0 %}
	{{ cacti_row(item.id, false, disabled) }}
	{{ cacti_cell(cacti_filter(item.name, search, cacti_url('gprint_presets.php', {action: 'edit', id: item.id})), item.id) }}
	{{ cacti_cell(item.gprint_text, item.id, 'right') }}
	{{ cacti_cell(disabled ? labels.no : labels.yes, item.id, 'right') }}
	{{ cacti_cell(cacti_number(item.graphs, -1), item.id, 'right') }}
	{{ cacti_cell(cacti_number(item.templates, -1), item.id, 'right') }}
	{{ cacti_checkbox(item.name, item.id, disabled) }}
	</tr>
{% else %}
	<tr class="tableRow odd"><td colspan="6"><em>{{ labels.empty }}</em></td></tr>
{% endfor %}
