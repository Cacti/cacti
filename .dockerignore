.git
.github
# check-changelog.py is a composer 'check' step
!.github/scripts
*.md
!README.md
LICENSE
.pre-commit-config.yaml
.env
.env.local
docker-compose.override.yml
data/
cache/
# the tracked redirect guards are part of the sink inventory
!cache/index.php
!cache/**/index.php
log/
!log/index.php
rra/*.rrd
*.log

# Local runtime configuration and credentials never belong in build layers.
.env.*
!.env.example
**/.env
**/.env.*
**/.ssh
**/.aws
**/.gnupg
include/config.php
include/config_local.php
include/vendor/
node_modules/
**/node_modules/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.DS_Store
