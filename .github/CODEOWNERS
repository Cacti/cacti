/auth_profile.php          @Cacti/cacti-developers @Cacti/cacti-security
/remote_agent.php          @Cacti/cacti-developers @Cacti/cacti-security

# Database and query layer.
/lib/database.php          @Cacti/cacti-developers @Cacti/cacti-security

