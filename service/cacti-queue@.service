[Unit]
Description=Cacti Queue Worker (%i)
After=network.target

[Service]
Type=simple
# Match User and Group to the account that runs Cacti (apache on RHEL, www-data on Debian);
# override them with a systemd drop-in instead of editing this template.
User=apache
Group=apache
ExecStart=/usr/bin/php /var/www/html/cacti/cli/queue_worker.php --queue=%i
Restart=always
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
